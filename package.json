{
  "name": "lrc-vuepress",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "VuePress site for LRC albums",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:clean-dev": "vuepress dev docs --clean-cache",
    "docs:dev": "vuepress dev docs",
    "docs:prod": "live-server docs/.vuepress/dist",
    "generate-md": "python3 .github/scripts/generate_md.py",
    "generate-api": "python3 .github/scripts/generate_api.py",
    "test-meta": "python3 .github/scripts/test_meta.py",
    "update-meta-dates": "python3 .github/scripts/update_meta_dates.py",
    "upgrade": "pnpm dlx vp-update",
    "test:node": "node --test 'test/*.test.mjs'",
    "test:component": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vuepress/bundler-vite": "2.0.0-rc.19",
    "@vuepress/plugin-search": "2.0.0-rc.74",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.74",
    "happy-dom": "^20.12.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vuepress": "2.0.0-rc.19",
    "vuepress-theme-hope": "2.0.0-rc.71"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "monaco-editor": "^0.55.1",
    "opencc-js": "^1.4.2",
    "vue-scriptx": "^0.2.7",
    "vuepress-plugin-alert": "0.0.5"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@^3.13.1": "3.15.1",
      "js-yaml@^4.1.0": "4.3.1"
    }
  }
}
