{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lrc-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "observability": { "enabled": true },

  "routes": [
    { "pattern": "ingest.lrc.voidcarve.com", "custom_domain": true },
    { "pattern": "lrc.voidcarve.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "../docs/.vuepress/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/upload/*", "/api/ingest/*", "/api/workspace/*", "/api/auth/*", "/api/library/*"]
  },

  // 曲库网关：EdgeSonic 的 StudioGateway 入口只经服务绑定可达，工作站以当前用户身份调用
  "services": [
    { "binding": "EDGESONIC", "service": "edgesonic", "entrypoint": "StudioGateway" }
  ],

  "r2_buckets": [
    { "binding": "UPLOAD_BUCKET", "bucket_name": "lrc-upload" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "JOB", "class_name": "IngestJob" },
      { "name": "RUNNER", "class_name": "PipelineRunner" },
      { "name": "USERS", "class_name": "UserDirectory" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IngestJob", "PipelineRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDirectory"] }
  ],

  "containers": [
    {
      "class_name": "PipelineRunner",
      "image": "../runner/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 5
    }
  ],

  "vars": {
    "GH_REPO": "lsy-404/LRC",
    "REVIEW_TIMEOUT_HOURS": "72",
    "REQUIRED_LYRIC_MAKER": "",
    "SSO_ISSUER": "https://id.voidcarve.com",
    "SSO_CLIENT_ID": "lrc-studio",
    "SSO_PROVIDER_NAME": "Voidcarve Access",
    "LIBRARY_UPLOAD_ROOT": "LRC"
  }
}
