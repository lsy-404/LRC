    {
      "title": "06 Faith Ballads",
      "file": "06 Faith Ballads.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "06 Faith Ballads"
        },
        {
          "time": 1.0,
          "text": "作词 : 砂妍Lumean"
        },
        {
          "time": 2.0,
          "text": "作曲 : 七简/夜屠灵"
        },
        {
          "time": 3.17,
          "text": "作编混: 七简 调教: 风继阳"
        },
        {
          "time": 4.16,
          "text": "浪花淹没黄沙被消抹"
        },
        {
          "time": 7.42,
          "text": "旋转冲刷出了簇簇泡沫"
        },
        {
          "time": 10.92,
          "text": "试探着抚平所有沟壑"
        },
        {
          "time": 14.17,
          "text": "将风化流逝的时间 记录着"
        },
        {
          "time": 17.17,
          "text": "00:31.660]"
        },
        {
          "time": 18.17,
          "text": "泪水漾上悬崖被淹没"
        },
        {
          "time": 21.67,
          "text": "亲吻着浅滩留下的柔和"
        },
        {
          "time": 25.41,
          "text": "无知的孩子却拾走了"
        },
        {
          "time": 28.66,
          "text": "我曾经镌刻下烙痕的壳"
        },
        {
          "time": 32.41,
          "text": "蜃影般的梦 无法"
        },
        {
          "time": 39.66,
          "text": "再回忆触碰 浮空的城"
        },
        {
          "time": 46.67,
          "text": "倒映 变成了 倒影"
        },
        {
          "time": 53.17,
          "text": "00:31.660]"
        },
        {
          "time": 54.17,
          "text": "描绘着 勾勒着 言不由衷"
        },
        {
          "time": 57.67,
          "text": "描摹着 升温着 沉溺其中"
        },
        {
          "time": 61.41,
          "text": "切割了 自我的 愚蠢冲动"
        },
        {
          "time": 64.66,
          "text": "失去 残缺后 仍于心歌颂"
        },
        {
          "time": 67.92,
          "text": "00:31.660]"
        },
        {
          "time": 68.41,
          "text": "用灭亡"
        },
        {
          "time": 71.66,
          "text": "向黎明交界线朝圣"
        },
        {
          "time": 77.17,
          "text": "曾追逐永恒 泡沫一捧"
        },
        {
          "time": 82.91,
          "text": "黑暗中"
        },
        {
          "time": 86.17,
          "text": "尸身堆砌成珊瑚城"
        },
        {
          "time": 91.92,
          "text": "游鱼们"
        },
        {
          "time": 95.16,
          "text": "将蜗居在这"
        },
        {
          "time": 98.67,
          "text": "海底庇护所"
        },
        {
          "time": 104.66,
          "text": "00:31.660]"
        },
        {
          "time": 120.92,
          "text": "蜃影般的梦 触碰"
        },
        {
          "time": 127.92,
          "text": "到珊瑚礁城 异常坚硬"
        },
        {
          "time": 135.16,
          "text": "作天空伴生 俯瞰"
        },
        {
          "time": 142.17,
          "text": "错误的 偏差的 划上止终"
        },
        {
          "time": 145.91,
          "text": "缠绕的 缠结的 撕开裂缝"
        },
        {
          "time": 149.42,
          "text": "切割了 自我后 眷恋着生"
        },
        {
          "time": 152.91,
          "text": "旋舞 挣扎着 嘶吼着 发声"
        },
        {
          "time": 156.16,
          "text": "00:31.660]"
        },
        {
          "time": 156.67,
          "text": "用灭亡"
        },
        {
          "time": 159.66,
          "text": "向黎明交界线朝圣"
        },
        {
          "time": 165.16,
          "text": "曾追逐永恒 泡沫一捧"
        },
        {
          "time": 170.91,
          "text": "黑暗中"
        },
        {
          "time": 174.17,
          "text": "尸身堆砌成珊瑚城"
        },
        {
          "time": 180.16,
          "text": "游鱼们"
        },
        {
          "time": 183.16,
          "text": "将蜗居在这"
        },
        {
          "time": 186.92,
          "text": "海底庇护所"
        },
        {
          "time": 189.41,
          "text": "00:31.660]"
        },
        {
          "time": 189.67,
          "text": "轻盈的"
        },
        {
          "time": 192.16,
          "text": "唱起一支灰色挽歌"
        },
        {
          "time": 197.67,
          "text": "无法被听到 海中的我"
        },
        {
          "time": 203.41,
          "text": "漂浮着"
        },
        {
          "time": 206.68,
          "text": "浪花溅起水沫凉薄"
        },
        {
          "time": 212.67,
          "text": "铭记下"
        },
        {
          "time": 215.66,
          "text": "缝不起的因"
        },
        {
          "time": 219.42,
          "text": "连不上的果"
        }
      ]
    },
    {
      "title": "07 月下潮汐",
      "file": "07 月下潮汐.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "07 月下潮汐"
