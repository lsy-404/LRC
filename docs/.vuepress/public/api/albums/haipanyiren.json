        },
        {
          "time": 86.16,
          "text": "好像谁 在为我 哭泣"
        },
        {
          "time": 92.9,
          "text": "月光下的潮汐"
        },
        {
          "time": 99.66,
          "text": "沉浮我的宿命"
        },
        {
          "time": 106.66,
          "text": "爱太累了 我想要放弃"
        },
        {
          "time": 112.91,
          "text": "可你身影 总挥之不去"
        },
        {
          "time": 133.4,
          "text": "一直以为 这不过是一场游戏"
        },
        {
          "time": 139.66,
          "text": "再爱的人 都有可能 有叛逆期"
        },
        {
          "time": 146.41,
          "text": "可是当我 真的看你 抱她远去"
        },
        {
          "time": 152.9,
          "text": "明白自己 该走出 梦境"
        },
        {
          "time": 159.91,
          "text": "月光下的潮汐"
        },
        {
          "time": 166.4,
          "text": "照亮海畔的伊"
        },
        {
          "time": 172.91,
          "text": "涌来浪花 拍打着 心的堤岸"
        },
        {
          "time": 179.41,
          "text": "好像谁 在为我 哭泣"
        },
        {
          "time": 186.41,
          "text": "月光下的潮汐"
        },
        {
          "time": 193.15,
          "text": "燃烧我的美丽"
        },
        {
          "time": 199.91,
          "text": "爱太累了 我想要放弃"
        },
        {
          "time": 206.41,
          "text": "可你身影 总挥之不去"
        },
        {
          "time": 212.9,
          "text": "想大声地 喊出你的姓名"
        },
        {
          "time": 219.66,
          "text": "发现自己 根本无能为力"
        },
        {
          "time": 226.4,
          "text": "认真删去 有关你的回忆"
        },
        {
          "time": 232.91,
          "text": "月下潮汐 已经悄然退去"
