    {
      "title": "08  枕烟庭深",
      "file": "08  枕烟庭深.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "08 枕烟庭深"
        },
        {
          "time": 2.0,
          "text": "作词 : 离南"
        },
        {
          "time": 4.0,
          "text": "作曲 : 一只冥河随母"
        },
        {
          "time": 6.21,
          "text": "策划：梨半夏 调教：梨梨夜 混音：栗子"
        },
        {
          "time": 31.96,
          "text": "云深处 场景 被描绘的冷清"
        },
        {
          "time": 39.46,
          "text": "雾如烟锁通幽径"
        },
        {
          "time": 46.7,
          "text": "这故事 透明 足迹蔓延入林"
        },
        {
          "time": 53.7,
          "text": "心似残叶惹孤零"
        },
        {
          "time": 61.22,
          "text": "微风摇晃着"
        },
        {
          "time": 64.71,
          "text": "秀木它隐约的 身影"
        },
        {
          "time": 68.21,
          "text": "也将目光 声音 渐渐吸引"
        },
        {
          "time": 74.95,
          "text": "雾锁群山 山似云 云如烟"
        },
        {
          "time": 81.96,
          "text": "萦绕寂静 误入躲藏的人"
        },
        {
          "time": 89.21,
          "text": "水流轻轻 在此间里沉浸"
        },
        {
          "time": 96.71,
          "text": "她却焦乱 将闲事闹雀鸣"
        },
        {
          "time": 119.7,
          "text": "少女的 遗憾 心呼唤着什么"
        },
        {
          "time": 126.45,
          "text": "那记忆里的风景"
        },
        {
          "time": 133.7,
          "text": "目送着 远去 她离开的背影"
        },
        {
          "time": 141.21,
          "text": "画面就留在曾经"
        },
        {
          "time": 148.46,
          "text": "枕畔回响着"
        },
        {
          "time": 155.45,
          "text": "烟雨它轻敲的憧憬"
        },
        {
          "time": 156.46,
          "text": "庭院灯下 温馨 慢慢入侵"
        },
        {
          "time": 161.95,
          "text": "雾锁群山 山似云 云如烟"
        },
        {
          "time": 169.21,
          "text": "枕烟庭深 深茂林间难寻"
        },
        {
          "time": 176.7,
          "text": "难寻旧梦 梦里昔日成冰"
        },
        {
          "time": 184.21,
          "text": "冰凝她的婉叹 你的声音"
        }
      ]
    },
    {
      "title": "09 海中雨",
      "file": "09 海中雨.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "09 海中雨"
        },
        {
          "time": 1.0,
          "text": "作词 : 水螅"
        },
        {
          "time": 2.0,
          "text": "作曲 : 涅不拉几的"
        },
        {
          "time": 3.87,
          "text": "无垠的海漏下了雨点"
        },
        {
          "time": 7.47,
          "text": "滴落在我干涸的心田"
        },
        {
          "time": 10.98,
          "text": "缓缓渗入缝隙 把悲伤溶解"
        },
        {
          "time": 18.3,
          "text": "暗流之下涌动的欲念"
        },
        {
          "time": 21.48,
          "text": "留在从未寄出的信件"
        },
        {
          "time": 25.29,
          "text": "那晕开的墨点 往事能想 起来吗"
        },
        {
          "time": 62.61,
          "text": "波纹 一圈一圈"
        },
        {
          "time": 66.27,
          "text": "装点 你的裙边"
        },
        {
          "time": 70.08,
          "text": "微光射入了礁岩 照亮你笑靥"
        },
        {
          "time": 77.25,
          "text": "犹记短短的一句寒暄"
        },
        {
          "time": 80.7,
          "text": "暧昧的关系从此改变"
        },
        {
          "time": 84.39,
          "text": "相似的灵魂必能相互理解"
        },
        {
          "time": 91.59,
          "text": "你皱眉会使温度都骤降"
        },
        {
          "time": 95.1,
          "text": "心中的海洋飘飞起寒霜"
        },
        {
          "time": 99.15,
          "text": "水晶球里的城 唯由你和我 分享"
        },
        {
          "time": 105.18,
          "text": "副歌"
        },
        {
          "time": 105.9,
          "text": "海中 倾盆大雨 落下 化作 无数雪花"
        },
        {
          "time": 110.37,
          "text": "歉意能否传达 我要 听你回答"
        },
        {
          "time": 114.09,
          "text": "别把我丢下 任由浪花 吞覆年华"
        },
        {
          "time": 120.21,
          "text": "让"
        },
        {
          "time": 121.11,
          "text": "倾盆大雨落下 夹杂 无数谎话"
        },
        {
          "time": 124.74,
          "text": "我仍驻足于此 只是 习惯不了虚假"
        },
        {
          "time": 131.4,
          "text": "你会回来吗"
        },
        {
          "time": 135.03,
          "text": "雨落下 a~雨落下"
        },
        {
          "time": 149.34,
          "text": "烈日 灼烫海面"
        },
        {
          "time": 153.15,
          "text": "沸腾 然后熄灭"
        },
        {
          "time": 156.99,
          "text": "巨鲸栖息的海底 有剧目上演"
        },
        {
          "time": 164.07,
          "text": "忘记吐露的真切誓言"
        },
        {
          "time": 167.55,
          "text": "暧昧的关系从此改变"
        },
        {
          "time": 171.33,
          "text": "天生一对未必 能相互理解"
        },
        {
          "time": 178.47,
          "text": "你皱眉会使温度都骤降"
        },
        {
          "time": 181.98,
          "text": "心中的海洋飘飞起寒霜"
        },
        {
          "time": 186.0,
          "text": "水晶球里的城 有落寞的人 流浪"
        },
        {
          "time": 194.58,
          "text": "海中 倾盆大雨 落下 化作 无数雪花"
        },
        {
          "time": 199.02,
          "text": "歉意能否传达 不要 装聋作哑"
        },
        {
          "time": 202.86,
          "text": "别把我丢下 孤独可不 好受啊"
