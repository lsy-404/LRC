        },
        {
          "time": 3.0,
          "text": "作曲 : 夜屠灵"
        },
        {
          "time": 4.41,
          "text": "演唱：海伊 调教：星葵 后期：栗子"
        },
        {
          "time": 6.91,
          "text": "--------------------------------------------------"
        },
        {
          "time": 13.4,
          "text": "一个人坐 在屋檐下 等雨停"
        },
        {
          "time": 19.66,
          "text": "颤抖的心 就快要 失去勇气"
        },
        {
          "time": 26.41,
          "text": "闭上双眼 再看不见 你的狠心"
        },
        {
          "time": 32.9,
          "text": "逼着自己 逃离困境"
        },
        {
          "time": 40.15,
          "text": "一直以为 这不过是一场游戏"
        },
        {
          "time": 46.4,
          "text": "再爱的人 都有可能 有叛逆期"
        },
        {
          "time": 53.16,
          "text": "可是当我 真的看你 抱她远去"
        },
        {
          "time": 59.66,
          "text": "明白自己 该走出 梦境"
        },
        {
          "time": 66.41,
          "text": "月光下的潮汐"
        },
        {
          "time": 73.15,
          "text": "嘲笑我的坚定"
