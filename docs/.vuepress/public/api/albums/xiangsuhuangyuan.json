      "file": "7 卧室森林 feat.诗岸.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "卧室森林"
        },
        {
          "time": 24.99,
          "text": "生锈的琴弦划过指尖"
        },
        {
          "time": 34.0,
          "text": "音符的记录 好像有直觉"
        },
        {
          "time": 41.4,
          "text": "桌面的盆栽不会蔓延"
        },
        {
          "time": 45.22,
          "text": "想象吧"
        },
        {
          "time": 49.75,
          "text": "和卧室地面的代谢 与万物溶解"
