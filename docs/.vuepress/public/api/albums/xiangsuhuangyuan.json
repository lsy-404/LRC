        {
          "time": 29.73,
          "text": "虚空飘渺般的 高贵灵魂"
        },
        {
          "time": 34.21,
          "text": "想必也是徒有其说吧"
        },
        {
          "time": 36.94,
          "text": "不断探寻着"
        },
        {
          "time": 39.17,
          "text": "走不出的迷宫里有着"
        },
        {
          "time": 43.29,
          "text": "怎样的人格"
        },
        {
          "time": 45.67,
          "text": "他们也都在哪里欺骗我呀"
        },
        {
          "time": 52.86,
          "text": "保持自己沉默还是开朗"
        },
        {
          "time": 56.31,
          "text": "都显得不重要吧"
        },
        {
          "time": 58.53,
          "text": "每个人都在迷宫里"
        },
        {
          "time": 60.93,
          "text": "重复着说谎"
        },
        {
          "time": 63.09,
          "text": "节省自身能量"
        },
        {
          "time": 65.01,
          "text": "换来的安心感还是冰凉"
        },
        {
          "time": 69.34,
          "text": "就这样"
        },
        {
          "time": 70.45,
          "text": "再见吧"
        },
        {
          "time": 97.9,
          "text": "不断探寻着"
        },
        {
          "time": 100.22,
          "text": "心底深处的奥秘有着"
        },
        {
          "time": 104.34,
          "text": "多少的划刻"
        },
        {
          "time": 106.75,
          "text": "一撇一捺 勾勒出我的轮廓"
        },
        {
          "time": 114.15,
          "text": "不停朝着远方那座高墙"
        },
        {
          "time": 117.42,
          "text": "不知疲惫的奔跑"
        },
        {
          "time": 119.52,
          "text": "想找到藏在某处"
        },
        {
          "time": 121.6,
          "text": "那真实的自我"
        },
        {
          "time": 124.27,
          "text": "通感神经交错"
        },
        {
          "time": 126.04,
          "text": "却还是感受不到的灯火"
        },
        {
          "time": 130.03,
          "text": "请不要熄灭了"
