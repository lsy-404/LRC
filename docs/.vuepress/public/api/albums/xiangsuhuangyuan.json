        {
          "time": 59.12,
          "text": "脑海里闪烁不断的残片"
        },
        {
          "time": 63.3,
          "text": "试着把它们拼凑成谁的脸"
        },
        {
          "time": 66.41,
          "text": "试着把它们都忘却"
        },
        {
          "time": 68.68,
          "text": "把蜷缩在上的荒原"
        },
        {
          "time": 72.55,
          "text": "能够长出森林的一边"
        },
        {
          "time": 75.36,
          "text": "蚕食着地下的空缺"
        },
        {
          "time": 95.91,
          "text": "生锈的琴弦划破指尖"
        },
        {
          "time": 104.86,
          "text": "音符的记录 快失去知觉"
        },
        {
