    {
      "title": "6 谜 feat.诗岸",
      "file": "6 谜 feat.诗岸.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "谜"
        },
        {
          "time": 18.69,
          "text": "存于困惘"
        },
        {
          "time": 20.91,
          "text": "如同有一张 白色的网"
        },
        {
          "time": 25.41,
          "text": "大家聚集在这迷惑啦 等着那"
