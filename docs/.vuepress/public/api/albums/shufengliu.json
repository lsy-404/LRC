,{"time":75.55,"text":"【苍穹】"},{"time":77.3,"text":"霜甲磨砺  麾下战鼓阵阵敲"},{"time":80.3,"text":"无双风流  挥师江东谁能较"},{"time":82.05,"text":"【赤羽】"},{"time":83.05,"text":"一地才俊  文韬竞武略"},{"time":86.3,"text":"进退指点  应机辄了却"},{"time":89.8,"text":"【苍穹】"},{"time":90.55,"text":"旌旗漫卷  帐前何猎猎"},{"time":94.05,"text":"拔剑挥斥  吴疆取霸业"},{"time":95.55,"text":"【合】"},{"time":97.05,"text":"何处千舟万帆过  连边号角"},{"time":100.8,"text":"旧岁换新朝  山河谁讨"},{"time":104.3,"text":"飒爽容姿策马去  许为至交"},{"time":107.8,"text":"昏昏天不晓  孤枪来挑"},{"time":111.3,"text":"管那大江收不尽  清浊滔滔"},{"time":114.55,"text":"你我走一遭  都付谈笑"},{"time":117.8,"text":"水天烟波太缥缈  东风扶摇"},{"time":121.55,"text":"慷慨趁年少"},{"time":123.55,"text":"【苍穹】"},{"time":124.8,"text":"破六郡  挫雄枭  孰知孙郎有玉貌"},{"time":137.8,"text":"【赤羽】"},{"time":138.55,"text":"三分才  同襟袍  天下事盼君邀"},{"time":150.55,"text":"【赤羽】"},{"time":152.3,"text":"羽箭冲天埋伏四起  将士百战着铁衣"},{"time":155.8,"text":"纵目望去成败运筹在掌心  只待下令"},{"time":159.05,"text":"狼兵虎骑轮番起"},{"time":161.05,"text":"谁率众破阵忽急"},{"time":162.8,"text":"其势如摧枯拉朽无可匹敌  风发意气"},{"time":165.8,"text":"【苍穹】"},{"time":166.8,"text":"烟云几时了  夜下挑灯剑出鞘"},{"time":169.55,"text":"我得意斩宵小  哪屑将军作功曹"},{"time":172.55,"text":"【赤羽】"},{"time":173.05,"text":"平生有幸  何必白头遣寂寥"},{"time":176.05,"text":"几番险战  回首青山应不老"},{"time":178.8,"text":"【苍穹】"},{"time":179.55,"text":"九州入梦  风光只一瞥"},{"time":182.3,"text":"奈何天意  有余不可解"},{"time":185.3,"text":"【赤羽】"},{"time":185.8,"text":"独坐长夜  秉烛算不歇"},{"time":189.8,"text":"飞舟人间  此身赴此约"},{"time":191.8,"text":"【合】"},{"time":193.05,"text":"何处千舟万帆过  连边号角"},{"time":197.05,"text":"旧岁换新朝  山河谁讨"},{"time":200.05,"text":"飒爽容姿策马去  许为至交"},{"time":203.8,"text":"昏昏天不晓  孤枪来挑"},{"time":206.8,"text":"管那大江收不尽  清浊滔滔"},{"time":210.55,"text":"你我走一遭  都付谈笑"},{"time":214.05,"text":"水天烟波太缥缈  东风扶摇"},{"time":217.55,"text":"慷慨趁年少"}]},{"title":"02 大航海家","lyrics":[{"time":0.0,"text":"02 大航海家"},{"time":1.0,"text":"作词 : 惊竹娇"},{"time":2.0,"text":"作曲 : 林华瑞"},{"time":3.22,"text":"编曲：林华瑞"},{"time":3.71,"text":"演唱：赤羽"},{"time":4.23,"text":"混音&母带：林华瑞"},{"time":4.71,"text":"吉他：王旭阳@林森音乐"},{"time":5.22,"text":"弦乐：星舟爱乐乐团"},{"time":5.71,"text":"弦乐编写：Sungeun Han@Aim Strings"},{"time":6.47,"text":"弦乐监制：庞阔"},{"time":16.23,"text":"从前有个叫郑和的外交长"},{"time":19.71,"text":"他来自古老遥远的神秘东方"},{"time":23.96,"text":"皇帝赏识派遣褒奖  理不辞  仁不让  去远航"},{"time":32.47,"text":"后来某天  他挥手告别了脚下的故乡"},{"time":36.96,"text":"准备兴师动众要去哪个地方"},{"time":40.97,"text":"请勇士都登上船舱 他说去远航 快跟上"},{"time":49.22,"text":"这一路上跌跌又是撞撞  打败虾兵蟹将"},{"time":54.21,"text":"骑  鲨鱼  水母和金枪"},{"time":57.23,"text":"快跟上再继续奔向下一个战场"},{"time":61.22,"text":"破风浪  啊快跟上"},{"time":65.21,"text":"这一路上无限秀丽风光叫人心驰神往"},{"time":69.47,"text":"船身和脑袋有点晃"},{"time":72.71,"text":"快跟上再沉入梦乡  寻找星星和月亮"},{"time":76.73,"text":"看马上就能遇见日出大太阳"},{"time":96.72,"text":"先安静  喂  听我讲"},{"time":98.71,"text":"是丈夫就勇敢下西洋"},{"time":100.46,"text":"无论前面的风景怎样"},{"time":102.21,"text":"或有没有理想中的大宝藏"},{"time":104.46,"text":"世界要先拆掉高墙"},{"time":106.21,"text":"才能礼尚往来  又乒乒乓乓"},{"time":108.21,"text":"全天下交响"},{"time":113.23,"text":"他经历过炎炎夏日与温柔的春光"},{"time":117.72,"text":"第几次带领大家来到到到到岸上"},{"time":121.46,"text":"去拜访当地的国王  结友好邻邦"},{"time":125.71,"text":"从此多来往"},{"time":129.97,"text":"这艘船上满载坚定希望 比如宗教信仰"},{"time":134.97,"text":"文明嘛  要乐于分享"},{"time":137.97,"text":"多来往这  还有黑瓷白瓷都倜傥"},{"time":141.73,"text":"勤通商  啊多来往"},{"time":145.73,"text":"这艘船上满载绚丽鲜亮  比如丝绸衣裳"},{"time":150.22,"text":"不逊色宝气和珠光"},{"time":153.47,"text":"多来往这  还有红茶绿茶一般香"},{"time":157.22,"text":"先这样  宣布返航"},{"time":161.47,"text":"这一路上跌跌又是撞撞  打败虾兵蟹将"},{"time":165.46,"text":"骑  鲨鱼  水母和金枪"},{"time":168.71,"text":"快跟上再继续奔向下一个战场"},{"time":172.47,"text":"总共闯七趟"},{"time":177.73,"text":"一路上慷慨激昂  就像上次来的那样"},{"time":182.71,"text":"船身和脑袋有点晃"},{"time":185.97,"text":"快跟上再沉入梦乡  寻找星星和月亮"},{"time":195.43,"text":"去看齐太阳纵使  有飞快流光"},{"time":196.17,"text":"而来日方长  更加响亮"}]},{"title":"03 相虎","lyrics":[{"time":0.0,"text":"03 相虎"},{"time":2.1,"text":"作词：骆栖淮"},{"time":3.25,"text":"作曲：水沐"},{"time":4.52,"text":"编曲：云宏"},{"time":5.32,"text":"Vocal：苍穹"},{"time":6.64,"text":"后期：Mr曾经"},{"time":7.79,"text":"闻道戎马生涯二十春"},{"time":11.62,"text":"江河唏嘘衣衫冷"},{"time":14.38,"text":"性本傲然白眼少年人"},{"time":17.19,"text":"不侍寻常风尘"},{"time":20.79,"text":"无惧鼾似虎哼，视之洞心神"},{"time":26.3,"text":"无惧逝水混沌，桴鼓请伏臣"},{"time":32.04,"text":"待见吴钩重整，浩荡寄东风"},{"time":37.2,"text":"纵四野，不闻漏鼓声"},{"time":43.89,"text":"飞马传诏驰，烽烟绕旧城"},{"time":47.12,"text":"三军赴抖擞，立旗杀振"},{"time":49.99,"text":"扬帆乘险势，定计扫乾坤"},{"time":52.7,"text":"千秋无愧凭论"},{"time":55.46,"text":"红妆催敌众，袖剑惊鬼神"},{"time":58.66,"text":"只等那翎羽，浸透襟纫"},{"time":61.54,"text":"换青史丹心横"},{"time":66.46,"text":"一朝南渡乱世浑无主，举棋无常多缤纷"},{"time":72.98,"text":"一朝女儿扶危定山河，力挽倾覆名承"},{"time":78.49,"text":"一朝梦虎奇谭结良缘，黑白交互试比争"},{"time":84.43,"text":"一朝戎马颠簸二十年，濡沫添霜鬓"},{"time":105.56,"text":"无惧织蒲为屋，甘苦俱与共"},{"time":111.08,"text":"无惧鞍马相依，素衣引铁针"},{"time":116.89,"text":"从来流落避乱，铁甲添红尘"},{"time":122.01,"text":"未曾念，富贵偕老身"},{"time":127.86,"text":"遥望一江风浪涌"},{"time":133.99,"text":"红妆敌众，袖剑鬼神"},{"time":139.54,"text":"只等那翎羽，浸透襟纫"},{"time":145.52,"text":"肯换青史丹心横"},{"time":151.61,"text":"一朝南渡乱世浑无主，举棋无常多缤纷"},{"time":157.64,"text":"一朝女儿扶危定山河，力挽倾覆名承"},{"time":163.38,"text":"一朝梦虎奇谭结良缘，黑白交互试比争"},{"time":169.33,"text":"一朝戎马颠簸二十年，濡沫添霜鬓"},{"time":178.69,"text":"纵横生涯二十春"},{"time":181.25,"text":"江河唏嘘衣衫犹冷"},{"time":184.56,"text":"遥望一江风浪涌"},{"time":187.16,"text":"何时不再闻漏鼓声"},{"time":190.32,"text":"翎羽透襟纫，等青史丹心横"},{"time":195.79,"text":"犹记绣甲跨马提刀沉"}]},{"title":"04 补天裂","lyrics":[{"time":0.0,"text":"04 补天裂"},{"time":0.3,"text":"作曲：litterzy | 作词：冉语优 | 编曲：云宏"},{"time":0.6,"text":"演唱：海伊、星尘Minus"},{"time":0.95,"text":"调教：瑞安Ryan"},{"time":1.25,"text":"吉他：齐成刚"},{"time":1.95,"text":"笛子：囚牛"},{"time":2.25,"text":"和声编写：沈雾敛"},{"time":2.95,"text":"混音：Mr_曾经"},{"time":3.95,"text":"寒衣北望望何处，烽火满杜鹃路"},{"time":19.7,"text":"醉里挑灯看剑，记得梦里当时少年"},{"time":26.96,"text":"马蹄将千里荞花踏遍"},{"time":35.21,"text":"卷起茫茫虏烟，风猎猎，单衫吹如雪"},{"time":42.21,"text":"慨歌多少遍，就渡江边"},{"time":66.21,"text":"临安到中原，的卢只三天"},{"time":71.96,"text":"怎料已过却，此身未北辗转又客南边"},{"time":79.21,"text":"三四十年"},{"time":81.95,"text":"有谁人戏谑，男儿尚能破贼否"},{"time":88.46,"text":"请君看取衣箱前"},{"time":92.21,"text":"旧戎装，都试遍"},{"time":96.96,"text":"休笑我种树南山之间"},{"time":101.21,"text":"辜负将军策万卷"},{"time":104.72,"text":"岂不见终夜，常把书来作枕"},{"time":108.97,"text":"好梦关河连营边"},{"time":128.45,"text":"把栏杆拍遍，依旧事事闲"},{"time":134.45,"text":"鹅湖曾有约，故人老矣与我见字如面"},{"time":141.71,"text":"不堪点检"},{"time":144.21,"text":"恐我先君去，从此有恨无人雪"},{"time":151.21,"text":"如今诸君先我去"},{"time":155.49,"text":"高歌也，为拜别"},{"time":159.22,"text":"休哭冯唐魂去留汉关"},{"time":163.46,"text":"武穆遗恨一千年"},{"time":167.21,"text":"人间行路难，此去早登青天"},{"time":171.71,"text":"为劝天公长开眼"},{"time":176.21,"text":"休笑我命运在朝暮之间"},{"time":179.46,"text":"也敢只手补天裂"},{"time":183.71,"text":"岂不见我名弃疾，肝胆如铁"},{"time":186.96,"text":"独呼“杀敌”时泣血"},{"time":190.46,"text":"休笑我命在朝暮之间"},{"time":194.71,"text":"也敢只手补天裂"},{"time":198.46,"text":"岂不见我名弃疾，肝胆如铁"},{"time":202.46,"text":"独呼“杀敌”时泣血"},{"time":206.96,"text":"谁人他日若祭我，料来此身已在中原"}]},{"title":"05 破云来","lyrics":[{"time":0.0,"text":"破云来"},{"time":1.0,"text":"作词 : 司隶示皇"},{"time":2.0,"text":"作曲 : 陈亦洺"},{"time":3.0,"text":"编曲：李大白"},{"time":4.0,"text":"调教：坐标P"},{"time":6.95,"text":"吉他：大牛"},{"time":8.11,"text":"古筝：紫格哈哈"},{"time":9.24,"text":"琵琶：Bring"},{"time":10.07,"text":"笛萧：丁晓奎"},{"time":10.82,"text":"和声编写：沈雾敛"},{"time":11.79,"text":"混音：Mr_曾经"},{"time":12.68,"text":"题字：公孙不举"},{"time":13.82,"text":"Vocal 赤羽"},{"time":22.83,"text":"筠雾暝/冷清"},{"time":24.19,"text":"灯火中不知倦的影"},{"time":27.88,"text":"竹叶落/幽寂"},{"time":29.2,"text":"却似乱风流云"},{"time":33.28,"text":"或你我执迷"},{"time":34.43,"text":"枯坐星沉月闭"},{"time":37.03,"text":"求而不得 一暝"},{"time":43.47,"text":"无善无恶心之体"},{"time":46.21,"text":"有善有恶意之动"},{"time":48.85,"text":"知善知恶是良知"},{"time":51.31,"text":"为善去恶是格物"},{"time":58.23,"text":"人说长空浩荡偕来"},{"time":60.77,"text":"云中送此君"},{"time":63.12,"text":"却在万山丛中采蕨"},{"time":65.94,"text":"刹那悟此心"},{"time":68.75,"text":"有花不视同 归寂"},{"time":70.99,"text":"灵台万物一"},{"time":73.76,"text":"拨云破月来"},{"time":75.56,"text":"阴阳始分明"},{"time":79.21,"text":"交迫/荒落"},{"time":80.55,"text":"（沉默在天际的远壑）"},{"time":81.82,"text":"寥廓/四合"},{"time":82.88,"text":"（惊醒了先贤的旧说）"},{"time":84.82,"text":"心外无物亦成说"},{"time":86.5,"text":"（走出那好一个从容的洒落）"},{"time":89.45,"text":"息风/引火"},{"time":91.3,"text":"（余烬里飞灰的煊赫）"},{"time":92.23,"text":"浮云/止戈"},{"time":93.46,"text":"（风止后又归安邦护国）"},{"time":95.2,"text":"一朝看破"},{"time":97.71,"text":"（俯仰自无愧怍）"},{"time":106.06,"text":"筠雾暝/冷清"},{"time":108.19,"text":"灯火中不知倦的影"},{"time":111.58,"text":"霜叶凝/沉寂"},{"time":112.91,"text":"都成浮生往忆"},{"time":116.78,"text":"往者太执迷"},{"time":118.04,"text":"云破月来分明"},{"time":120.3,"text":"了然于心 一息"},{"time":126.6,"text":"无善无恶心之体"},{"time":129.38,"text":"有善有恶意之动"},{"time":132.26,"text":"知善知恶是良知"},{"time":134.6,"text":"为善去恶是格物"},{"time":141.44,"text":"人说长空浩荡偕来"},{"time":144.26,"text":"云中送此君"},{"time":146.52,"text":"却在万山丛中采蕨"},{"time":149.4,"text":"刹那悟此心"},{"time":151.82,"text":"有花不视同 归寂"},{"time":154.37,"text":"灵台万物一"},{"time":157.0,"text":"拨云破月来"},{"time":158.84,"text":"阴阳始分明"},{"time":162.6,"text":"洒脱/磊落"},{"time":163.75,"text":"（踏歌来人心本为乐）"},{"time":165.17,"text":"云丛/轻拨"},{"time":166.58,"text":"（又何必妄欲自缚锁）"},{"time":168.42,"text":"心外无物亦成说"},{"time":169.5,"text":"（走出那好一个从容的洒落）"},{"time":173.1,"text":"返躬/省我"},{"time":175.25,"text":"（夜来时独守的明德）"},{"time":176.19,"text":"此心/澄澈"},{"time":177.56,"text":"（云开后仍是皎洁月色）"},{"time":178.31,"text":"又复何说"},{"time":180.63,"text":"（俯仰自无愧怍）"},{"time":186.32,"text":"雾凝烟轻/此身云中之灵"},{"time":188.28,"text":"霞落尘清/有何不可知意"},{"time":190.41,"text":"一张一翕/万象动静于心"},{"time":192.43,"text":"不破不立/ 合掌知行为一"},{"time":194.43,"text":"无挂无羁/良知岂能自欺"},{"time":196.97,"text":"无偏无倚/乃道此心光明"},{"time":204.36,"text":"人说正心诚意致知"},{"time":206.81,"text":"格物才明理"},{"time":209.57,"text":"却道禀守慎独良知"},{"time":212.0,"text":"方能正我心"},{"time":214.59,"text":"天地本与我为一"},{"time":216.95,"text":"知行此中意"},{"time":219.92,"text":"拨云破月来"},{"time":221.6,"text":"阴阳始分明"},{"time":225.44,"text":"来客/对坐"},{"time":227.64,"text":"垂云/落墨"},{"time":230.37,"text":"立身立德终成说"},{"time":235.69,"text":"此心/求索"},{"time":238.08,"text":"可或/不可"},{"time":240.62,"text":"云天开阔"}]},{"title":"06 归钓吟","lyrics":[{"time":0.0,"text":"06 归钓吟"},{"time":1.7,"text":"作曲：陈亦洺"},{"time":3.7,"text":"作词：狐離肯定行"},{"time":5.7,"text":"编曲：Mzf小慕"},{"time":9.46,"text":"演唱：苍穹"},{"time":10.52,"text":"调教：坐标P"},{"time":11.54,"text":"吉他：齐成刚"},{"time":12.75,"text":"笛子：囚牛"},{"time":13.74,"text":"混音：刘明"},{"time":14.7,"text":"和声编写：沈雾敛"},{"time":15.86,"text":"出品：忘川风华录"},{"time":17.34,"text":"协力：桃源工作室"},{"time":27.37,"text":"蓑衣负雪  一隅天地之间"},{"time":30.41,"text":"皓首不倦  执竿乱世临渊"},{"time":33.46,"text":"何物做饵  独钓渭水边"},{"time":39.33,"text":"朝歌夜宴  鹿台玉苑高悬"},{"time":42.41,"text":"哀鸿肆野  忠良戮尽阶前"},{"time":45.45,"text":"吾有残年  便予姬侯换人间"},{"time":51.28,"text":"将  一诺陈于万山前"},{"time":57.02,"text":"来  金戈铁马  朝天阙"},{"time":62.74,"text":"天命未晓夙夜匪懈"},{"time":66.01,"text":"上伐谋略发矢弓弦"},{"time":69.04,"text":"凤鸣岐山翱于牧野"},{"time":72.04,"text":"书此篇"},{"time":74.91,"text":"幡动遮天旗展风猎"},{"time":77.95,"text":"千军饮血慷慨阵前"},{"time":80.96,"text":"城池烽烟尽覆昆仑雪"},{"time":86.15,"text":"杀伐曲  未歇"},{"time":117.28,"text":"人心几窍  多少欲壑难填"},{"time":120.49,"text":"是非当辨  焚尽虚妄联翩"},{"time":123.43,"text":"王侯枯骨  共史册一页"},{"time":129.25,"text":"乱世书卷  多少功过难写"},{"time":132.28,"text":"难舍难掩  一腔汹涌热血"},{"time":135.39,"text":"千秋功业  始生于一息善念"},{"time":140.91,"text":"破  紫微星曜于旷野"},{"time":147.02,"text":"定  百代礼乐  天子剑"},{"time":152.97,"text":"王图霸业一朝更迭"},{"time":156.0,"text":"冕旒仰止冠剑相连"},{"time":159.06,"text":"八音和鸣万物齐宣"},{"time":162.08,"text":"愿永年"},{"time":165.11,"text":"时维鹰扬顾彼高轩"},{"time":168.01,"text":"定国安邦天命归焉"},{"time":171.0,"text":"列土封疆广厦千万间"},{"time":176.14,"text":"盛世歌  不绝"},{"time":180.08,"text":"但负一愿衔烛擎天"},{"time":183.01,"text":"再饮一斛山河日月"},{"time":186.0,"text":"周而复始方圆人间"},{"time":189.1,"text":"总流连"},{"time":191.97,"text":"见我如见星辰明灭"},{"time":194.98,"text":"淇水翻卷前尘封缄"},{"time":198.07,"text":"惟此一尊不朽亦无言"},{"time":203.29,"text":"待何日  重见"}]},{"title":"07 始见千秋","lyrics":[{"time":0.0,"text":"07 始见千秋"},{"time":0.26,"text":"作曲：PokeR"},{"time":0.52,"text":"作词：择荇"},{"time":0.83,"text":"编曲：周果亦"},{"time":1.22,"text":"演唱：苍穹、海伊、星尘Infinity、赤羽"},{"time":2.45,"text":"秦腔指导：齐爱云"},{"time":3.1,"text":"调教：瑞安Ryan、坐标P"},{"time":3.92,"text":"吉他：周果亦/凌霄堂主"},{"time":4.82,"text":"合成器/手碟/呼麦：周果亦"},{"time":5.88,"text":"弦乐：国际首席爱乐"},{"time":6.61,"text":"和声编写：沈雾敛"},{"time":7.26,"text":"混音/母带：李欣懋（Wuli包子）"},{"time":8.41,"text":"混音助理：刘明"},{"time":9.04,"text":"【苍穹】(秦腔)"},{"time":9.74,"text":"“走马赴秦川，八百里，旧河山，"},{"time":15.34,"text":"问几时明月 几尘关。”"},{"time":25.24,"text":"【海伊】"},{"time":37.26,"text":"青史从渭水转折  气象自崤山巍峨"},{"time":41.59,"text":"谁将在神州的骨血中铭刻"},{"time":47.27,"text":"当群雄披甲操戈  诸子正口若悬河"},{"time":51.61,"text":"御宇内 振长策  震惊后来者"},{"time":56.47,"text":"【星尘Infinity】"},{"time":57.1,"text":"该亮出 剑鞘中 最披靡 的锋芒"},{"time":61.43,"text":"叩问普天之下  最广袤的土壤"},{"time":66.99,"text":"该怒吼 陇塬上 最苍凉 的老腔"},{"time":71.32,"text":"千年后多少人  还传唱"},{"time":76.65,"text":"【赤羽】"},{"time":78.42,"text":"天地开  驰骋的车辙奔逐四海"},{"time":83.63,"text":"去远方或更远的关隘"},{"time":88.35,"text":"挥笔来  古隶书留给竹简承载"},{"time":93.51,"text":"千秋之后读罢 依旧慷慨"},{"time":97.02,"text":"【苍穹】(秦腔)"},{"time":97.23,"text":"虎视何雄哉！"},{"time":123.53,"text":"【苍穹】"},{"time":123.84,"text":"提剑的孤勇刺客  旷世的击弦悲歌"},{"time":128.17,"text":"谁会在壮阔的狂澜中抉择"},{"time":133.5,"text":"烽烟曾纵横捭阖  将版图蜿蜒勾勒，"},{"time":138.11,"text":"履至尊 制六合  与风云跋涉。"},{"time":142.09,"text":"【星尘Infinity&海伊】"},{"time":143.71,"text":"要麾师 几万场 据函关 出咸阳"},{"time":148.11,"text":"沿途堑山堙谷  凿百川 贯千江"},{"time":153.6,"text":"要修筑 群山上 永不倒 的城墙"},{"time":157.99,"text":"登烽燧 举烈火  守四方"},{"time":160.89,"text":"【苍穹】"},{"time":164.98,"text":"天地开  驰骋的车辙奔逐四海"},{"time":170.23,"text":"去远方或更远的关隘"},{"time":172.81,"text":"【赤羽】"},{"time":175.03,"text":"挥笔来  古隶书留给竹简承载"},{"time":180.14,"text":"千秋之后读罢 依旧慷慨"},{"time":184.8,"text":"兴亡外  泥土铸千军列阵殿台，"},{"time":189.9,"text":"【赤羽/苍穹/海伊/星尘Infinity(低八)】"},{"time":191.64,"text":"苏醒在翻天覆地的未来"},{"time":194.67,"text":"旧朝代  衡量成古币洒落尘埃"},{"time":199.22,"text":"千秋之后开始流光溢彩"},{"time":200.25,"text":"【苍穹】(秦腔)"},{"time":200.77,"text":"“两千年，星天换，"},{"time":203.4,"text":"问宫阙万间可今安。”"}]},{"title":"08 临川浮梦","lyrics":[{"time":0.0,"text":"08 临川浮梦"},{"time":0.59,"text":"作词：慕清明"},{"time":0.75,"text":"作曲：陈亦洺、小可"},{"time":0.92,"text":"编曲：崔博源"},{"time":1.09,"text":"演唱：赤羽、星尘Infinity"},{"time":1.29,"text":"调教：瑞安Ryan"},{"time":1.44,"text":"笛子萧：囚牛"},{"time":1.61,"text":"吉他：Guitar_RK"},{"time":1.84,"text":"二胡：二胡妹"},{"time":2.15,"text":"和声编写：沈雾敛"},{"time":2.43,"text":"混音：Mr_曾经"},{"time":3.99,"text":"【赤羽】(昆曲)"},{"time":7.35,"text":"“不到园林，怎知春色如许”"},{"time":34.91,"text":"【星尘infinity】"},{"time":35.0,"text":"一滴梦沿着笔锋摔落"},{"time":41.21,"text":"洇开了满纸鲜活"},{"time":47.26,"text":"梅花岭畔月  留待多情者"},{"time":59.06,"text":"荒唐、荒乱、荒凉的哪种结局更配我"},{"time":64.84,"text":"人间、人生、人心何曾被现实放过"},{"time":70.0,"text":"我病着与生俱来的反骨"},{"time":76.31,"text":"戏中人各饮一杯哭"},{"time":81.58,"text":"【赤羽】"},{"time":82.09,"text":"梦过知音千樽酒  知交共白头  知苦与恨皆休"},{"time":87.62,"text":"一生快哉风里舟  最顽心不改少年游"},{"time":93.65,"text":"倏尔惊醒窗前霜雪凛夜  浊世淹过喉"},{"time":100.2,"text":"梦在心上心便温柔"},{"time":129.13,"text":"【星尘infinity】"},{"time":130.43,"text":"一笺未曾干枯的魂魄"},{"time":135.94,"text":"生动着悲欢离合"},{"time":141.99,"text":"鬓边紫玉钗  榻上槐安国"},{"time":153.79,"text":"凄惘、迷惘、怅惘的哪种困顿能困我"},{"time":159.56,"text":"灵气、浩气、锐气向世间扬手一泼"},{"time":165.36,"text":"且以这一字字碎玉词歌"},{"time":171.13,"text":"为苍生抔起一簇火"},{"time":175.85,"text":"【赤羽】"},{"time":176.89,"text":"梦过无际闲云岫  无拘春至秋  无愧逝水悠悠"},{"time":182.67,"text":"一生清白月如钩  最一往而深著风流"},{"time":188.71,"text":"倏尔惊醒窗前霜雪凛夜  浊世淹过喉"},{"time":195.03,"text":"梦在心上心便温柔"},{"time":201.87,"text":"“黄粱酒尚温，孰醒孰梦深。拂面是红尘，亦幻亦当真”"}]},{"title":"09 将军行","lyrics":[{"time":0.0,"text":"09 将军行"},{"time":3.21,"text":"作词：冉语优"},{"time":4.52,"text":"作曲：周果亦、酷丘"},{"time":5.79,"text":"编曲/分轨：1AN孙毅然"},{"time":8.79,"text":"演唱：苍穹、星尘infinity、赤羽"},{"time":9.68,"text":"调教&Vocal：瑞安Ryan(苍穹/星尘)、坐标P(赤羽)"},{"time":10.41,"text":"吉他：大牛"},{"time":11.03,"text":"电吉他Solo：Guitar_RK"},{"time":11.47,"text":"唢呐：胡悦祺"},{"time":11.96,"text":"笛箫：囚牛"},{"time":12.53,"text":"和声编写：雾敛"},{"time":13.04,"text":"混音：Mr_曾经"},{"time":13.48,"text":"协力：桃源工作室"},{"time":14.68,"text":"【苍穹】"},{"time":18.33,"text":"但有鸿鹄之心，怎可少游市井"},{"time":21.68,"text":"定携剑出淮阴"},{"time":25.05,"text":"此去无问诸君，岂不见平野尽"},{"time":26.15,"text":"漫地卷起风云"},{"time":28.08,"text":"【星尘infinity】"},{"time":28.65,"text":"一界拆楚河汉境，分山河四方逐鼎"},{"time":31.68,"text":"争霸业各展旗旌谁得将军 便得太平"},{"time":35.01,"text":"壮士死不惜发肤，况忍却一时之辱"},{"time":38.71,"text":"耳听 秋声 点兵，心腑唯万骑千军"},{"time":42.4,"text":"【赤羽】"},{"time":46.54,"text":"暗道陈仓入三秦，横岭十万雪甲明"},{"time":49.54,"text":"慨歌罢复东行"},{"time":50.24,"text":"空天裂 降三军，乱云开 翻金鳞"},{"time":54.63,"text":"遇者皆惊"},{"time":56.15,"text":"拔旗背水据为营，夹塞纵横自在行"},{"time":60.28,"text":"投一子 为一兵"},{"time":63.42,"text":"四海鼓，天地应，山欲倾"},{"time":97.42,"text":"【星尘infinity】"},{"time":97.92,"text":"空塞风动角弓鸣，垓下空留楚歌音"},{"time":101.03,"text":"转目间又宴鸿门谁作主人，谁为上宾"},{"time":104.43,"text":"幽夜下杯声烛影，问天下听谁号令"},{"time":107.99,"text":"曾经 置腹 推心，高坛之上拜将军"},{"time":112.09,"text":"【赤羽】"},{"time":112.51,"text":"擂鼓声东而西进，渡河飞辔似流星"},{"time":116.0,"text":"慨歌罢复长行"},{"time":119.02,"text":"一世英 万世名，一关克 百关平"},{"time":123.98,"text":"闻者皆惊"},{"time":125.39,"text":"征侯一片客子心，当年餐饭尚千金"},{"time":129.71,"text":"既授印 便承命"},{"time":132.72,"text":"念妇人，感知音，况是君"},{"time":139.44,"text":"记得少年峥嵘夜，黑天海上满彤云"},{"time":143.03,"text":"千帐同歌对酒饮"},{"time":145.91,"text":"风扬缨 沙吹鬓，声催战 震耳鸣"},{"time":150.92,"text":"万师共饮"},{"time":152.19,"text":"【苍穹/赤羽】"},{"time":152.74,"text":"而今排棋至天明，方寸窗竹空摇影"},{"time":156.67,"text":"满室钟 似鸣金"},{"time":159.67,"text":"此身已 不惧死 何惧听"},{"time":166.39,"text":"【赤羽】"},{"time":166.67,"text":"成功名 能几人 鬓尚青！"}]},{"title":"10 妄语人间","lyrics":[{"time":0.0,"text":"10 妄语人间"},{"time":1.82,"text":"作词：择荇"},{"time":3.17,"text":"作曲/编曲：周果亦"},{"time":5.6,"text":"演唱：星尘Infinity"},{"time":7.22,"text":"调教：瑞安Ryan"},{"time":8.84,"text":"弦乐实录：starliner strings"},{"time":10.73,"text":"琵琶：吉玉"},{"time":12.08,"text":"洞萧：高琛"},{"time":13.05,"text":"吉他/合成器：周果亦"},{"time":14.45,"text":"二胡：陈政宇/皮特"},{"time":15.71,"text":"音效：酷丘"},{"time":16.41,"text":"和声编写：雾敛"},{"time":17.39,"text":"分轨混音/母带：周果亦"},{"time":18.93,"text":"曲绘：海豚岛、杉里沐、竹篮子"},{"time":20.89,"text":"PV：宇言"},{"time":21.45,"text":"协力：桃源工作室"},{"time":22.59,"text":"若她只是  摇曳一缕烛火"},{"time":32.16,"text":"随手摄去  我遣词时的心魄"},{"time":43.32,"text":"荒山寺  远村落"},{"time":48.42,"text":"夜雨还魂  纸笔兴波"},{"time":55.28,"text":"带我去"},{"time":56.89,"text":"aaa～ aaa～"},{"time":59.1,"text":"去白昼  红尘浪迹"},{"time":62.01,"text":"aaa～ aaa～"},{"time":64.36,"text":"无凭散聚"},{"time":66.96,"text":"对烂漫草木  多情鳞羽"},{"time":69.8,"text":"亦着迷"},{"time":97.68,"text":"若她执意  从我窗棂经过"},{"time":107.34,"text":"灯下耳语  世间诡谲的传说"},{"time":118.23,"text":"像鸳梦  被撞破"},{"time":123.51,"text":"枝柯交错  花月凉薄"},{"time":129.47,"text":"随我去"},{"time":131.83,"text":"aaa～ aaa～"},{"time":134.18,"text":"去黄泉碧落相遇"},{"time":137.02,"text":"aaa～ aaa～"},{"time":139.38,"text":"放肆欢寂"},{"time":141.88,"text":"与魑魅作歌  鬼狐对泣"},{"time":146.12,"text":"亦如你"},{"time":153.33,"text":"为我去"},{"time":153.78,"text":"aaa～ aaa～"},{"time":157.53,"text":"去写下  痴绝一笔"},{"time":160.33,"text":"aaa～ aaa～"},{"time":162.75,"text":"缠绵追叙"},{"time":165.3,"text":"为玲珑白骨  冶艳毛皮"},{"time":169.27,"text":"亦执迷"}]},{"title":"11 燕双归","lyrics":[{"time":0.0,"text":"11 燕双归"},{"time":13.08,"text":"Vocal 星尘Minus/诗岸"},{"time":13.32,"text":"作曲：潮汐- tide"},{"time":13.74,"text":"作词：冥凰"},{"time":14.01,"text":"调教：瑞安Ryan"},{"time":14.43,"text":"编曲：云宏"},{"time":14.7,"text":"和声编写：沈雾敛"},{"time":15.18,"text":"混音： Mr曾经"},{"time":21.96,"text":"【合唱】"},{"time":22.14,"text":"一夜春风赴雨润如酥"},{"time":25.26,"text":"旧枝接新蕊吐"},{"time":28.95,"text":"乌衣巷盼顾莺飞燕舞"},{"time":32.58,"text":"依依呢喃当初"},{"time":36.06,"text":"细柳抽条后千丝拂万树"},{"time":39.81,"text":"这诗句轻轻读"},{"time":43.17,"text":"个中琳琅不可不数"},{"time":46.08,"text":"【诗岸】"},{"time":50.79,"text":"又见飞絮起雀鸟乱入"},{"time":54.36,"text":"三两只檐下宿"},{"time":58.05,"text":"你空手绾束年少气度"},{"time":61.65,"text":"相约切磋几出"},{"time":65.34,"text":"名士多风流才子少工夫"},{"time":68.91,"text":"纸上反复也输"},{"time":72.63,"text":"如何能向我借筋骨"},{"time":79.32,"text":"【合唱】"},{"time":79.86,"text":"纷纷扬扬岁岁三月暮"},{"time":83.37,"text":"十里人间终有燕归处"},{"time":87.06,"text":"千秋牢骚客几个真文武"},{"time":90.69,"text":"何必再觅闲愁尽说苦"},{"time":94.41,"text":"飘飘洒洒漫漫堤上路"},{"time":98.07,"text":"繁花迷眼青春谁留住"},{"time":101.73,"text":"光阴逐水流无非沉与浮"},{"time":105.27,"text":"任他来去潮行舟浦"},{"time":107.46,"text":"【星尘 Minus】"},{"time":127.32,"text":"又见飞絮起匆匆寒暑"},{"time":130.74,"text":"天边寄来尺素"},{"time":134.49,"text":"半盏一饮无心绪展舒"},{"time":138.03,"text":"江南意趣再书"},{"time":141.69,"text":"也道双双燕相辞穿朱户"},{"time":145.23,"text":"许是被春光妒"},{"time":149.04,"text":"待我落笔时却如故"},{"time":155.91,"text":"【合唱】"},{"time":156.24,"text":"纷纷扬扬岁岁三月暮"},{"time":159.72,"text":"十里人间终有燕归处"},{"time":163.5,"text":"朱雀桥头望日夜向东注"},{"time":167.07,"text":"青青垂杨只碍离人目"},{"time":170.79,"text":"飘飘洒洒漫漫堤上路"},{"time":174.45,"text":"繁花迷眼青春谁留住"},{"time":177.99,"text":"长歌晚烟里芳尊休虚付"},{"time":181.65,"text":"也烦东西风催诗赋"},{"time":184.38,"text":"【诗岸】"},{"time":186.39,"text":"细雨斜密复疏"},{"time":189.96,"text":"乌衣燕鸣相呼"},{"time":195.09,"text":"不知何人落阶除"},{"time":198.15,"text":"【合唱】"},{"time":201.72,"text":"纷纷扬扬岁岁三月暮"},{"time":205.17,"text":"十里人间终有燕归处"},{"time":208.86,"text":"千秋牢骚客几个真文武"},{"time":212.52,"text":"何必再觅闲愁尽说苦"},{"time":216.27,"text":"飘飘洒洒漫漫堤上路"},{"time":219.93,"text":"繁花迷眼青春谁留住"},{"time":223.53,"text":"光阴逐水流无非沉与浮"},{"time":227.1,"text":"任他来去潮行舟浦"}]},{"title":"12 此期盈期","lyrics":[{"time":0.0,"text":"12 此期盈期"},{"time":1.0,"text":"作词 : 司隶示皇"},{"time":2.0,"text":"作曲 : 沈雾敛"},{"time":3.0,"text":"编曲 : 1AN孙毅然"},{"time":4.0,"text":"Vocal KBShinya/奇然/九渊/三无Marblue"},{"time":14.84,"text":"【KBShinya】"},{"time":40.13,"text":"又东风拂暖烟柳秾桃"},{"time":45.87,"text":"今年春枕梦春韶"},{"time":51.82,"text":"开芳筵倾杯举箸 / 有环佩轻摇"},{"time":56.28,"text":"抚镜劝君暂忘返 / 且听吾家歌笑——"},{"time":61.95,"text":"【奇然】"},{"time":62.85,"text":"是剑光凝 / 是夜雨静"},{"time":66.12,"text":"前尘已随江潮平"},{"time":69.03,"text":"却有今生 / 英雄未分定"},{"time":74.93,"text":"【九渊】"},{"time":75.14,"text":"露浓香冷 / 月落锦屏"},{"time":77.97,"text":"故都长夜玉笛清"},{"time":81.6,"text":"吹入桃源 / 对坐从头听"},{"time":86.4,"text":"【三无Marblue】"},{"time":86.63,"text":"试看 / 高楼红烛烧 / 有灯谜玄妙 / 击鼓狮子闹"},{"time":92.35,"text":"凭栏 / 远路生芳草/ 青山入望遥 /相邀"},{"time":98.31,"text":"何惧 / 前尘犹萦绕 / 鸿爪雪未销 / 此间烟火好"},{"time":104.35,"text":"来共 / 灯辉何皎皎 / 携手作知交 / 年少"},{"time":122.7,"text":"【奇然】"},{"time":122.91,"text":"试此寒芒 / 愿击霜雪"},{"time":125.96,"text":"玉树临江称清绝"},{"time":128.87,"text":"听罢风声 / 回首东山月"},{"time":133.83,"text":"【KBShinya】"},{"time":134.87,"text":"男儿到死 / 狂歌未歇"},{"time":137.87,"text":"挑灯空怀心如铁"},{"time":141.39,"text":"万字平戎 / 试欲补天裂"},{"time":146.11,"text":"【合唱】"},{"time":146.33,"text":"对饮 / 想儿郎意气 / 吴钩照水明 / 故人弦上听"},{"time":151.92,"text":"记取 / 勋业与声名 /未许东流去 / 相迎"},{"time":158.38,"text":"寒沙/ 难掩此丹心 / 浊浪湿红缨 / 击鼓万世鸣"},{"time":164.17,"text":"合卷/ 一笑掩英名 / 犹自想旧京 / 升平"},{"time":170.4,"text":"【三无Marblue】(戏腔)"},{"time":172.17,"text":"今古兴替 / 霜风携去"},{"time":183.77,"text":"待枝上萌新绿 / 与君此期盈期"},{"time":194.66,"text":"【奇然】"},{"time":194.88,"text":"举杯 / 邀来白月明 / 知己请驻停 / 试看樽中影"},{"time":200.08,"text":"【九渊】"},{"time":200.33,"text":"何必/ 独怜瑶台镜 / 应共叙今夕 / 此期"},{"time":206.42,"text":"【三无Marblue】"},{"time":206.7,"text":"惠风 / 桃夭坐花荫 / 冉冉看晴云 / 且歌且同行"},{"time":212.17,"text":"【KBShinya】"},{"time":212.42,"text":"执笔 / 落花笺风信 / 写万事又新 / 可期"},{"time":228.62,"text":"策划 : 忘川风华录 桃源工作室"},{"time":229.18,"text":"吉他 : 大牛"},{"time":229.73,"text":"低音大笛 : 丁晓逵"},{"time":230.29,"text":"二胡 : 二胡妹"},{"time":230.84,"text":"混音 : Mr_曾经"},{"time":231.4,"text":"和声 : 王韩伊淋"},{"time":231.95,"text":"曲绘 : 桃源工作室美术组"},{"time":232.51,"text":"协力 : 竹竹竹篮子"},{"time":233.06,"text":"PV : 塚本故"}]},{"title":"13 数风流","lyrics":[{"time":0.0,"text":"13 数风流"},{"time":1.5,"text":"作词：择荇"},{"time":3.0,"text":"作曲：陈亦洺"},{"time":4.5,"text":"编曲：崔博源"},{"time":6.0,"text":"演唱：星尘Infinity、海伊、苍穹、诗岸、星尘Minus、赤羽、牧心"},{"time":7.5,"text":"调教：瑞安Ryan"},{"time":9.0,"text":"笛子/箫：囚牛"},{"time":10.5,"text":"吉他：Guitar_RK"},{"time":12.0,"text":"弦乐：亚洲首席爱乐"},{"time":13.5,"text":"vocal采样：小可、陈亦洺、崔博源"},{"time":15.0,"text":"和声编写：沈雾敛"},{"time":16.5,"text":"分轨混音/母带：周天澈@Studio21A"},{"time":20.4,"text":"【星尘】"},{"time":22.09,"text":"(秦始皇)"},{"time":23.09,"text":"这个纪元是我铸造空前的传说，"},{"time":26.59,"text":"千秋列国从未如今日般壮阔，"},{"time":30.84,"text":"岁月曾所向披靡着，"},{"time":35.59,"text":"国境万里始于长城的炬火。"},{"time":38.09,"text":"【海伊】"},{"time":39.34,"text":"(汉武帝)"},{"time":41.1,"text":"掞光兮明耀，山川尽照，"},{"time":46.34,"text":"照长乐未央的王朝。"},{"time":50.85,"text":"马踏塞上草，也踏飞鸟，"},{"time":56.35,"text":"向瀚海直取天骄。"},{"time":59.35,"text":"【苍穹】"},{"time":59.85,"text":"(唐太宗)"},{"time":60.34,"text":"这是凯歌破阵后，天下贞观的气魄，"},{"time":65.6,"text":"山河当巍峨，气象尽渊博。"},{"time":69.6,"text":"这是千年跌宕间，传颂四海的寄托，"},{"time":75.09,"text":"有万国衣冠走过，长安巷陌。"},{"time":79.09,"text":"【诗岸】"},{"time":86.34,"text":"(武则天)"},{"time":99.85,"text":"这次盛世是我亲手验取的乾坤，"},{"time":104.84,"text":"神都风物从未如今日般鼎盛。"},{"time":109.6,"text":"我不肯著字于碑文，"},{"time":113.34,"text":"日月长空依旧，寂照这星辰。"},{"time":116.34,"text":"【星Minus】"},{"time":118.1,"text":"(宋太祖)"},{"time":119.35,"text":"过千山广袤，万户丰饶，"},{"time":124.34,"text":"在汴水川流的灯宵，"},{"time":128.86,"text":"我身披铁甲，身披黄袍，"},{"time":134.22,"text":"定天下风雨飘摇。"},{"time":136.72,"text":"【赤羽】"},{"time":137.72,"text":"(明太祖)"},{"time":138.73,"text":"我是乱世的微尘，只在血火里狂奔，"},{"time":143.73,"text":"曾布衣破虏，为家国雪恨。"},{"time":148.47,"text":"扬帆激荡鄱阳水，拂剑登临应天城，"},{"time":153.47,"text":"谁共我戎马半生，山河永镇。"},{"time":157.74,"text":"【牧心】"},{"time":158.73,"text":"“千山俱墨，万籁皆明，"},{"time":163.22,"text":"照长夜浩浩朗朗，"},{"time":165.97,"text":"微微茫茫无数天星。"},{"time":168.23,"text":"滔滔宏愿，来济生灵，"},{"time":172.48,"text":"唯此志天下问鼎，"},{"time":175.23,"text":"百战成功开太平。”"},{"time":176.48,"text":"——改自宋太祖&明太祖《咏月诗》"},{"time":177.73,"text":"【诗岸】"},{"time":188.23,"text":"我是泛黄的春秋，我是陨落的星斗，"},{"time":192.72,"text":"却一意孤行将万世庇佑。"},{"time":196.98,"text":"【星Minus】"},{"time":197.97,"text":"我在云烟里停留，我在辉煌中枯朽，"},{"time":202.99,"text":"还要听千古悠悠，细数风流。"},{"time":206.98,"text":"【大合唱】"},{"time":207.72,"text":"我是披沥的肝胆，我是鲜活的血肉，"},{"time":212.99,"text":"还一脉相承被万世眷佑。"},{"time":216.98,"text":"我在远行时回头，我在长河中不朽，"},{"time":221.99,"text":"还想看今朝明后，再数风流。"},{"time":228.98,"text":"注:\"掞yan光兮明耀\" 出自汉武帝辞赋《天地》"}]},{"title":"破云来(星尘ver.)","lyrics":[{"time":0.0,"text":"破云来"},{"time":1.02,"text":"调教：瑞安Ryan、陌生来访"},{"time":2.46,"text":"编曲：李大白"},{"time":3.94,"text":"作词 : 司隶示皇"},{"time":5.06,"text":"作曲 : 陈亦洺"},{"time":6.44,"text":"吉他：大牛"},{"time":7.77,"text":"古筝：紫格哈哈"},{"time":8.93,"text":"琵琶：Bring"},{"time":10.12,"text":"笛萧：丁晓奎"},{"time":11.36,"text":"和声编写：沈雾敛"},{"time":12.62,"text":"混音：Mr_曾经"},{"time":13.97,"text":"题字：公孙不举"},{"time":15.29,"text":"Vocal 星尘"},{"time":21.27,"text":"筠雾暝/冷清"},{"time":22.65,"text":"灯火中不知倦的影"},{"time":26.43,"text":"竹叶落/幽寂"},{"time":27.75,"text":"却似乱风流云"},{"time":31.64,"text":"或你我执迷"},{"time":32.97,"text":"枯坐星沉月闭"},{"time":35.58,"text":"求而不得 一暝"},{"time":42.11,"text":"无善无恶心之体"},{"time":44.71,"text":"有善有恶意之动"},{"time":47.33,"text":"知善知恶是良知"},{"time":49.92,"text":"为善去恶是格物"},{"time":56.85,"text":"人说长空浩荡偕来"},{"time":59.4,"text":"云中送此君"},{"time":62.0,"text":"却在万山丛中采蕨"},{"time":64.6,"text":"刹那悟此心"},{"time":67.18,"text":"有花不视同 归寂"},{"time":69.82,"text":"灵台万物一"},{"time":72.47,"text":"拨云破月来"},{"time":74.11,"text":"阴阳始分明"},{"time":77.65,"text":"交迫/荒落（沉默在天际的远壑）"},{"time":80.29,"text":"寥廓/四合（惊醒了先贤的旧说）"},{"time":82.85,"text":"心外无物亦成说（走出那好一个从容的洒落）"},{"time":88.04,"text":"息风/引火（余烬里飞灰的煊赫）"},{"time":90.72,"text":"浮云/止戈（风止后又归安邦护国）"},{"time":93.34,"text":"一朝看破（俯仰自无愧怍）"},{"time":104.67,"text":"筠雾暝/冷清"},{"time":106.03,"text":"灯火中不知倦的影"},{"time":109.95,"text":"霜叶凝/沉寂"},{"time":111.21,"text":"都成浮生往忆"},{"time":115.11,"text":"往者太执迷"},{"time":116.42,"text":"云破月来分明"},{"time":119.08,"text":"了然于心 一息"},{"time":125.64,"text":"无善无恶心之体"},{"time":128.16,"text":"有善有恶意之动"},{"time":130.77,"text":"知善知恶是良知"},{"time":133.4,"text":"为善去恶是格物"},{"time":140.28,"text":"人说长空浩荡偕来"},{"time":142.1,"text":"云中送此君"},{"time":145.47,"text":"却在万山丛中采蕨"},{"time":148.07,"text":"刹那悟此心"},{"time":150.66,"text":"有花不视同 归寂"},{"time":153.31,"text":"灵台万物一"},{"time":155.92,"text":"拨云破月来"},{"time":157.56,"text":"阴阳始分明"},{"time":161.01,"text":"洒脱/磊落（踏歌来人心本为乐）"},{"time":163.73,"text":"云丛/轻拨（又何必妄欲自缚锁）"},{"time":166.34,"text":"心外无物亦成说（走出那好一个从容的洒落）"},{"time":171.49,"text":"返躬/省我（夜来时独守的明德）"},{"time":174.19,"text":"此心/澄澈（云开后仍是皎洁月色）"},{"time":176.82,"text":"又复何说（俯仰自无愧怍）"},{"time":184.58,"text":"雾凝烟轻/此身云中之灵"},{"time":186.53,"text":"霞落尘清/有何不可知意"},{"time":188.91,"text":"一张一翕/万象动静于心"},{"time":191.04,"text":"不破不立/ 合掌知行为一"},{"time":193.09,"text":"无挂无羁/良知岂能自欺"},{"time":195.69,"text":"无偏无倚/乃道此心光明"},{"time":202.94,"text":"人说正心诚意致知"},{"time":205.48,"text":"格物才明理"},{"time":208.11,"text":"却道禀守慎独良知"},{"time":210.68,"text":"方能正我心"},{"time":213.25,"text":"天地本与我为一"},{"time":215.94,"text":"知行此中意"},{"time":218.51,"text":"拨云破月来"},{"time":220.15,"text":"阴阳始分明"},{"time":223.72,"text":"来客/对坐"},{"time":226.35,"text":"垂云/落墨"},{"time":228.93,"text":"立身立德终成说"},{"time":234.15,"text":"此心/求索"},{"time":236.78,"text":"可或/不可"},{"time":239.38,"text":"云天开阔"}]}]}