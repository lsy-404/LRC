    {
      "title": "2 Mandala",
      "file": "2 Mandala.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "Mandala"
        },
        {
          "time": 8.0,
          "text": "feat. 赤羽"
        },
        {
          "time": 12.0,
          "text": "作词作曲编曲：胧"
        },
        {
          "time": 16.0,
          "text": "调教：跨海星尘"
        },
        {
          "time": 32.31,
          "text": "听 孤独的宁静"
        },
        {
          "time": 38.92,
          "text": "辗转难眠的夜里"
        },
        {
          "time": 42.63,
          "text": "是谁在哭泣的声音"
        },
        {
          "time": 47.44,
          "text": "心 颤抖地回应"
        },
        {
          "time": 53.87,
          "text": "无法传达的话语"
        },
        {
          "time": 57.84,
          "text": "抛不开过去与回忆"
        },
        {
          "time": 62.47,
          "text": "图绘未来的画卷"
        },
        {
          "time": 66.13,
          "text": "随风盘旋"
        },
        {
          "time": 67.75,
          "text": "却湮没在灰色阴霾"
        },
        {
          "time": 71.1,
          "text": "不断地消散"
        },
        {
          "time": 73.18,
          "text": "在绝望中"
        },
        {
          "time": 77.23,
          "text": "解开被封存的对白"
        },
        {
          "time": 81.27,
          "text": "也许 放下回忆"
        },
        {
          "time": 84.64,
          "text": "再一遍遍一遍遍剪断思念"
        },
        {
          "time": 88.72,
          "text": "才明白爱越浓烈"
        },
        {
          "time": 92.42,
          "text": "越是让痛更深一些"
        },
        {
          "time": 96.27,
          "text": "炽热的爱太危险"
        },
        {
          "time": 99.7,
          "text": "就一点点一点点冷却凝结"
        },
        {
          "time": 103.72,
          "text": "告别脆弱的昨天"
        },
        {
          "time": 107.21,
          "text": "能让我 遗忘那些誓言"
        },
        {
          "time": 113.32,
          "text": "曾经的蜜语甜言"
        },
        {
          "time": 116.23,
          "text": "当你回首后 是否留念"
        },
        {
          "time": 120.99,
          "text": "如今回不到原点"
        },
        {
          "time": 123.4,
          "text": "只剩下逐渐凋零的Mandala"
        },
        {
          "time": 128.02,
          "text": "Ah..."
        },
        {
          "time": 150.41,
          "text": "静静走过"
        },
        {
          "time": 152.15,
          "text": "花开的季节"
        },
        {
          "time": 153.99,
          "text": "流淌的时间"
        },
        {
          "time": 157.44,
          "text": "深埋在心中"
        },
        {
          "time": 159.52,
          "text": "记忆的碎片"
        },
        {
          "time": 161.48,
          "text": "如果能 填补空缺"
        },
        {
          "time": 165.45,
          "text": "卑微懦弱地生长"
        },
        {
          "time": 169.33,
          "text": "试着改变"
        },
        {
          "time": 170.9,
          "text": "却坠入了寂静黑夜"
        },
        {
          "time": 174.3,
          "text": "在消失之前"
        },
        {
          "time": 176.23,
          "text": "不再沉默"
        },
        {
          "time": 180.3,
          "text": "就算是一人独白"
        },
        {
          "time": 184.23,
          "text": "也许 放下回忆"
        },
        {
          "time": 187.79,
          "text": "再一遍遍一遍遍剪断思念"
        },
        {
          "time": 191.77,
          "text": "才明白爱越浓烈"
        },
        {
          "time": 195.51,
          "text": "越是让痛更深一些"
        },
        {
          "time": 199.31,
          "text": "炽热的爱太危险"
        },
        {
          "time": 202.77,
          "text": "就一点点一点点冷却凝结"
        },
        {
          "time": 206.74,
          "text": "告别脆弱的昨天"
        },
        {
          "time": 210.23,
          "text": "能让我 遗忘那些誓言"
        },
        {
          "time": 217.34,
          "text": "Oh… Ah"
        },
        {
          "time": 224.01,
          "text": "“盛开的季节”"
        },
        {
          "time": 227.35,
          "text": "永不凋谢"
        },
        {
          "time": 238.24,
          "text": "Mandala, Mandala…"
        }
      ]
