    {
      "title": "3 灯火",
      "file": "3 灯火.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "灯火"
        },
        {
          "time": 2.0,
          "text": "feat. 星尘Infinity&星尘V4"
        },
        {
          "time": 3.0,
          "text": "作词作曲编曲：胧&Aya-亚夜-"
        },
        {
          "time": 4.0,
          "text": "调教：跨海星尘"
        },
        {
          "time": 5.79,
          "text": "流星赴约划过天边"
        },
        {
          "time": 8.99,
          "text": "一颗颗不停歇"
        },
        {
          "time": 11.03,
          "text": "经历了几亿光年"
        },
        {
          "time": 13.03,
          "text": "才能在此 相遇见"
        },
        {
          "time": 16.91,
          "text": "寻觅星空"
        },
        {
          "time": 18.2,
          "text": "梦想着能够自由游历世界"
        },
        {
          "time": 21.94,
          "text": "可在浩瀚中"
        },
        {
          "time": 23.48,
          "text": "早已习惯被孤独紧紧相拥"
        },
        {
          "time": 27.28,
          "text": "下个站点的光景"
        },
        {
          "time": 29.37,
          "text": "是否能抚平不安的情绪"
        },
        {
          "time": 32.8,
          "text": "驶离了暗涌的船"
        },
        {
          "time": 35.0,
          "text": "愿能寻回渴求的答案"
        },
        {
          "time": 38.68,
          "text": "教堂的钟仍在等待破晓的黎明"
        },
        {
          "time": 43.41,
          "text": "一路穿越了荆棘"
        },
        {
          "time": 46.26,
          "text": "再次向远方起航远行"
        },
        {
          "time": 49.63,
          "text": "赋予我生命的意义"
        },
        {
          "time": 53.68,
          "text": "如果这个世界只剩灰与黑暗"
        },
        {
          "time": 58.79,
          "text": "你将灯火点燃指引明日未来"
        },
        {
          "time": 64.02,
          "text": "划过夜空的流星"
        },
        {
          "time": 65.89,
          "text": "（仰望着）"
        },
        {
          "time": 66.6,
          "text": "属于我们共同的回忆"
        },
        {
          "time": 69.57,
          "text": "（la la la la la）"
        },
        {
          "time": 72.87,
          "text": "继续闪耀光芒"
        },
        {
          "time": 74.77,
          "text": "（耀眼的光芒）"
        },
        {
          "time": 87.3,
          "text": "再次起航"
        },
        {
          "time": 88.75,
          "text": "远离了纷扰与世俗的视线"
        },
        {
          "time": 92.67,
          "text": "追逐着星光"
        },
        {
          "time": 94.14,
          "text": "是我的信仰 再无人能阻挡"
        },
        {
          "time": 97.83,
          "text": "向前一步的距离"
        },
        {
          "time": 100.01,
          "text": "是绽放绮丽或是场梦境"
        },
        {
          "time": 103.44,
          "text": "紧握着的手心"
        },
        {
          "time": 105.64,
          "text": "给我挣脱黑暗的勇气"
        },
        {
          "time": 109.56,
          "text": "夏夜的风吹散斑驳尘世的光影"
        },
        {
          "time": 114.05,
          "text": "沿途踏过的轨迹"
        },
        {
          "time": 116.87,
          "text": "是我对抗命运的决心"
        },
        {
          "time": 120.09,
          "text": "对未来的无限憧憬"
        },
        {
          "time": 123.91,
          "text": "如果这个世界只剩灰与黑暗"
        },
        {
          "time": 129.38,
          "text": "你将成为我停泊希望的港岸"
        },
        {
          "time": 134.7,
          "text": "划过夜空的流星"
        },
        {
          "time": 136.47,
          "text": "（仰望着）"
        },
        {
          "time": 137.28,
          "text": "属于我们共同的回忆"
        },
        {
          "time": 140.17,
          "text": "（la la la la la）"
        },
        {
          "time": 143.28,
          "text": "继续闪耀光芒"
        },
        {
          "time": 145.47,
          "text": "（耀眼的光芒）"
        },
        {
          "time": 170.26,
          "text": "在跨越了现实的界限"
        },
        {
          "time": 172.95,
          "text": "梦的尘埃将回归最初的起点"
        },
        {
          "time": 176.3,
          "text": "（最初的起点）"
        },
        {
          "time": 177.83,
          "text": "让音符彻夜奏响属于我们的明天"
        },
        {
          "time": 182.91,
          "text": "（这个世界）"
        },
        {
          "time": 184.55,
          "text": "如果这个世界只剩灰与黑暗"
        },
        {
          "time": 189.3,
          "text": "是你描绘出灯火璀璨的伟岸"
        },
        {
          "time": 194.51,
          "text": "日复一日的游历"
        },
        {
          "time": 196.29,
          "text": "（寻觅着）"
        },
        {
          "time": 197.3,
          "text": "约定好彼此依偎前行"
        },
        {
          "time": 200.57,
          "text": "（彼此携手相伴而行）"
        },
        {
          "time": 201.66,
          "text": "像夜空的流星"
        },
        {
          "time": 203.56,
          "text": "最闪耀的光芒"
        },
        {
          "time": 205.67,
          "text": "你的光芒让我不再畏惧黑暗"
        },
        {
          "time": 210.84,
          "text": "你的光芒将点亮我的黑夜与整个世界"
        },
        {
          "time": 215.62,
          "text": "la la la"
        },
        {
          "time": 217.34,
          "text": "新的起点"
        }
      ]
    },
    {
