    {
      "title": "1 日出",
      "file": "1 日出.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "日出"
        },
        {
          "time": 1.37,
          "text": "感受风中延绵的山鸣"
        },
        {
          "time": 3.52,
          "text": "一束光一时间洒向海面"
        },
        {
          "time": 7.8,
          "text": "追寻着梦的执念"
        },
        {
          "time": 10.89,
          "text": "继续 谱写"
        },
        {
          "time": 12.91,
          "text": "我们的寓言"
        },
        {
          "time": 18.0,
          "text": "feat. 牧心&星尘Infinity"
        },
        {
          "time": 21.0,
          "text": "作词作曲编曲：胧"
        },
        {
          "time": 24.0,
          "text": "调教：Creuzer"
        },
        {
          "time": 30.18,
          "text": "跳望遥远的未来"
        },
        {
          "time": 34.23,
          "text": "约定的誓言是否还在"
        },
        {
          "time": 38.43,
          "text": "别让情绪主宰"
        },
        {
          "time": 40.44,
          "text": "凛冽寒风中等待"
        },
        {
          "time": 42.9,
          "text": "炙热的思念化成海"
        },
        {
          "time": 45.29,
          "text": "解开了所有的期待"
        },
        {
          "time": 47.74,
          "text": "独属于我们的声音"
        },
        {
          "time": 51.36,
          "text": "（也许是你）"
        },
        {
          "time": 54.04,
          "text": "指引着我向黑夜独自远行"
        },
        {
          "time": 59.18,
          "text": "Take me out"
        },
        {
          "time": 61.09,
          "text": "此刻请给我回应"
        },
        {
          "time": 63.58,
          "text": "Do you know everthings is disappearing at tonight"
        },
        {
          "time": 68.13,
          "text": "You bring my soul leave out of the sorrow"
        },
        {
          "time": 70.8,
          "text": "When i see your eyes"
        },
        {
          "time": 73.17,
          "text": "昨日未完的遗憾终将化作希冀"
        },
        {
          "time": 78.01,
          "text": "在这孤独的世界里"
        },
        {
          "time": 82.8,
          "text": "All of the mine"
        },
        {
          "time": 83.85,
          "text": "全部实现"
        },
        {
          "time": 98.4,
          "text": "也许故事终要完结"
        },
        {
          "time": 101.1,
          "text": "带上信念破束缚前行"
        },
        {
          "time": 104.85,
          "text": "No nothing stumble you"
        },
        {
          "time": 108.12,
          "text": "沉寂落日后的余晖"
        },
        {
          "time": 110.49,
          "text": "也曾伴我度无数黑夜"
        },
        {
          "time": 114.23,
          "text": "the sun will light you"
        },
        {
          "time": 117.96,
          "text": "只身孤高的山巅"
        },
        {
          "time": 122.63,
          "text": "誓言将命运改写"
        },
        {
          "time": 127.46,
          "text": "重拾降生的心愿"
        },
        {
          "time": 132.24,
          "text": "Dont get away"
        },
        {
          "time": 136.11,
          "text": "Just find the way"
        },
        {
          "time": 138.15,
          "text": "Find the way"
        },
        {
          "time": 140.96,
          "text": "Do you know everthings is disappearing at tonight"
        },
        {
          "time": 145.59,
          "text": "You bring my soul leave out of the sorrow"
        },
        {
          "time": 148.29,
          "text": "When i see your eyes"
        },
        {
          "time": 150.66,
          "text": "就算未来是无法再触及的距离"
        },
        {
          "time": 155.49,
          "text": "带上孤独继续前行"
        },
        {
          "time": 160.39,
          "text": "再次证明"
        },
        {
          "time": 163.3,
          "text": "流星的轨迹"
        },
        {
          "time": 166.55,
          "text": "（已远去）"
        },
        {
          "time": 168.09,
          "text": "黑暗中相互辉映"
        },
        {
          "time": 173.01,
          "text": "当日出再次降临"
        },
        {
          "time": 177.8,
          "text": "Will you by my side"
        },
        {
          "time": 182.18,
          "text": "Just hold me again tonight"
        }
      ]
