      "title": "1 枫声",
      "file": "1 枫声.lrc",
      "lyrics": [
        {
          "time": 11.68,
          "text": "枫声"
        },
        {
          "time": 15.18,
          "text": "策划：寒 Sir 演唱：苍穹 调教：懿辰"
        },
        {
          "time": 18.68,
          "text": "湖面涟漪 结成冰"
        },
        {
          "time": 23.42,
          "text": "天空一片干净"
        },
        {
          "time": 27.17,
          "text": "昏沉沉 像是遗憾的梦"
        },
        {
          "time": 35.42,
          "text": "怎么会 用记忆"
        },
        {
          "time": 39.43,
          "text": "沉默出了曾经"
        },
        {
          "time": 42.92,
          "text": "沉默出 一片安静"
        },
        {
          "time": 50.68,
          "text": "山路崎岖 路不平"
        },
        {
          "time": 55.42,
          "text": "脚步从此寂静"
        },
        {
          "time": 59.17,
          "text": "听不到 空谷传来回音"
        },
        {
          "time": 67.42,
          "text": "怎么会 用流水"
        },
        {
          "time": 71.43,
          "text": "抚平湖中倒影"
        },
        {
          "time": 74.92,
          "text": "抚不平 枫叶飘落的声音"
        },
        {
          "time": 82.92,
          "text": "被眼泪染红的枫"
        },
        {
          "time": 86.92,
          "text": "被思念摇晃的声音"
        },
        {
          "time": 90.92,
          "text": "很轻"
        },
        {
          "time": 93.42,
          "text": "叶不遮零碎的影"
        },
        {
          "time": 98.93,
          "text": "被叹息揉皱的枫"
        },
        {
          "time": 102.93,
          "text": "被回忆模糊的风景"
        },
        {
          "time": 107.42,
          "text": "我看不清"
        },
        {
          "time": 110.18,
          "text": "泪浸湿晕开 的约定"
