    {
      "title": "10 灰烬",
      "file": "10 灰烬.lrc",
      "lyrics": [
        {
          "time": 8.94,
          "text": "策划：寒 Sir 演唱：赤羽 调教：67P"
        },
        {
          "time": 17.19,
          "text": "始发电车 惊醒沉寂黎明"
        },
        {
          "time": 24.31,
          "text": "照明灯光碾过 漫天雪花碎屑"
        },
        {
          "time": 30.01,
          "text": "向邮筒投-递 寄不到的-信"
        },
        {
          "time": 37.26,
          "text": "摇摇欲坠 可笑期许终破灭"
        },
        {
          "time": 44.52,
          "text": "玻璃裂隙 漏出黯然光晕"
        },
        {
          "time": 51.27,
          "text": "放映着从交会 至分岔的一切"
        },
        {
          "time": 57.76,
          "text": "想筑起高-墙 隔绝你声-音"
        },
        {
          "time": 64.76,
          "text": "却仍迟疑 是否剪断这心结"
        },
        {
          "time": 72.02,
          "text": "爱意燃作灰烬"
        },
        {
          "time": 75.02,
          "text": "风吹后所剩无几"
        },
        {
          "time": 79.02,
          "text": "干枯的心 以泪灌溉都多余"
        },
        {
          "time": 85.76,
          "text": "翻遍回忆找寻"
        },
        {
          "time": 89.0,
          "text": "通往昨日的阶梯"
        },
        {
          "time": 92.51,
          "text": "可只看见 几朵积雨的云"
        },
        {
          "time": 127.0,
          "text": "花束书信 玩偶气球简讯"
        },
        {
          "time": 133.26,
          "text": "未完交换日记 礼物标本蝴蝶"
        },
        {
          "time": 140.01,
          "text": "一桩又一桩 推我入深渊"
        },
        {
          "time": 146.76,
          "text": "最后哽咽说不出半句再见"
        },
        {
          "time": 154.35,
          "text": "爱意燃作灰烬 风吹后所剩无几"
        },
        {
          "time": 161.1,
          "text": "干枯的心以泪灌溉都多余"
        },
        {
          "time": 168.09,
          "text": "翻遍回忆找寻 通往昨日的阶梯"
        },
        {
          "time": 174.92,
          "text": "可只看见几朵积雨乌云"
        },
        {
          "time": 182.46,
          "text": "爱意燃作灰烬 花谢后一片狼藉"
        },
        {
          "time": 188.47,
          "text": "反复聆听 拥抱时你的耳语"
        },
        {
          "time": 195.22,
          "text": "手弹奏小步圆舞曲 心上演滑稽独角戏"
        },
        {
          "time": 201.96,
          "text": "在落幕之前 你早已经远去"
        }
      ]
    },
    {
      "title": "2 放逐自我",
      "file": "2 放逐自我.lrc",
      "lyrics": [
        {
          "time": 2.2,
          "text": "划：寒 Sir 演唱：赤羽 调教：鬼面P"
        },
        {
          "time": 7.2,
          "text": "嘴角扬起的弧度 凋谢着花朵"
        },
        {
          "time": 14.21,
          "text": "破碎了世间百态 一点点零落"
        },
        {
          "time": 21.2,
          "text": "他们都笑我软弱 任性而执着"
        },
        {
          "time": 27.95,
          "text": "没看到灵魂之上 被缠绕枷锁"
        },
        {
          "time": 35.21,
          "text": "来来往往的躯壳 庸碌与蹉跎"
        },
        {
          "time": 42.45,
          "text": "阿谀谄媚这世俗 泥泞到浑浊"
        },
        {
          "time": 49.45,
          "text": "愚钝的魂魄何处 迷失中漂泊"
        },
        {
          "time": 56.21,
          "text": "雾霭下无声雷雨 倾盆般滂沱"
        },
        {
          "time": 63.2,
          "text": "何必再拘谨 不如去放逐自我"
        },
        {
          "time": 70.45,
          "text": "放逐了自我 啊~"
        },
        {
          "time": 76.45,
          "text": "你感到奇怪吧"
        },
        {
          "time": 79.21,
          "text": "这样真的好吗"
        },
        {
          "time": 83.71,
          "text": "她还在找寻啊"
        },
        {
          "time": 86.2,
          "text": "找寻着什么呢"
        },
        {
          "time": 90.71,
          "text": "来放肆嘲笑我吧"
        },
        {
          "time": 94.46,
          "text": "解脱前拼命挣扎"
        },
        {
          "time": 98.7,
          "text": "我早已放逐在"
        },
        {
          "time": 100.96,
          "text": "那无穷无尽的 深渊啦"
        },
        {
          "time": 119.95,
          "text": "恢宏圣堂前祈祷 他虚伪龌龊"
        },
        {
          "time": 127.2,
          "text": "恶魔隐匿的树梢 是怎样结果"
        },
        {
          "time": 134.2,
          "text": "眼眸映出了底色 黑白在交错"
        },
        {
          "time": 141.2,
          "text": "编织成阴霾一片 哪里去定夺"
        },
        {
          "time": 148.21,
          "text": "无尽的黑暗突兀 架起了焰火"
        },
        {
          "time": 155.45,
          "text": "飞蛾被注定命宿 倔强的扑朔"
        },
        {
          "time": 162.45,
          "text": "生命灼烧着绽放 枯萎和沉没"
        },
        {
          "time": 169.2,
          "text": "让他们看到真实 荒谬又单薄"
        },
        {
          "time": 176.2,
          "text": "何必再忍受不如 去放逐自我"
        },
        {
