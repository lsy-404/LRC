    {
      "title": "9 一半",
      "file": "9 一半.lrc",
      "lyrics": [
        {
          "time": 1.73,
          "text": "一半"
        },
        {
          "time": 6.47,
          "text": "策划：寒 Sir 演唱：海伊/牧心 调教：久城"
        },
        {
          "time": 11.98,
          "text": "海的一半是星"
        },
        {
          "time": 14.98,
          "text": "生的一半是死"
        },
        {
          "time": 18.48,
          "text": "入夜的一半是"
        },
        {
          "time": 20.48,
          "text": "踟蹰的背影"
        },
        {
          "time": 24.74,
          "text": "你心里的一半"
        },
        {
          "time": 27.72,
          "text": "写满孤单字句"
        },
        {
          "time": 30.73,
          "text": "一停一顿 一阵空虚"
        },
        {
          "time": 37.23,
          "text": "时间 一半是雨"
        },
        {
          "time": 40.48,
          "text": "夏天 一半是云"
        },
        {
          "time": 43.48,
          "text": "微笑的一半是"
        },
        {
          "time": 45.73,
          "text": "掩埋的心事"
        },
        {
          "time": 49.73,
          "text": "你怀里的一半"
        },
        {
          "time": 52.73,
          "text": "填满夜空的孤寂"
        },
        {
          "time": 55.72,
          "text": "无边无声 亦无人听"
        },
        {
          "time": 61.73,
          "text": "盛开的一半是"
        },
        {
          "time": 64.73,
          "text": "梦境的凋零"
        },
        {
          "time": 67.99,
          "text": "相遇的一半是"
        },
        {
          "time": 71.23,
          "text": "两地的书信"
        },
        {
          "time": 74.23,
          "text": "信任的一半是"
        },
        {
          "time": 77.49,
          "text": "委婉的猜疑"
        },
        {
          "time": 80.22,
          "text": "关心的一半是"
        },
        {
          "time": 83.72,
          "text": "转身的风清"
        },
        {
          "time": 86.98,
          "text": "凋零的一半是"
        },
        {
          "time": 89.97,
          "text": "盛开的梦境"
        },
        {
          "time": 93.23,
          "text": "书信的一半是"
        },
        {
          "time": 96.23,
          "text": "两地的相遇"
        },
        {
          "time": 99.72,
          "text": "猜疑的一半是"
        },
        {
          "time": 102.73,
          "text": "委婉的信任"
        },
        {
          "time": 105.48,
          "text": "风清的一半是"
        },
        {
          "time": 108.98,
          "text": "转身的关心"
        },
        {
          "time": 138.24,
          "text": "是非一半成迷"
        },
        {
          "time": 141.48,
          "text": "纷扰一半成影"
        },
        {
          "time": 144.72,
          "text": "梦境的一半是"
        },
        {
          "time": 146.97,
          "text": "清醒的呓语"
        },
        {
          "time": 150.97,
          "text": "你爱恨的一半"
        },
        {
          "time": 153.98,
          "text": "沉浮月空的云里"
        },
        {
          "time": 157.22,
          "text": "忽明忽暗 一世迷离"
        },
        {
          "time": 162.97,
          "text": "和好的一半是"
        },
        {
          "time": 165.72,
          "text": "重圆的破镜"
        },
        {
          "time": 168.98,
          "text": "妥协的一半是"
        },
        {
          "time": 171.99,
          "text": "谎言的外衣"
        },
        {
          "time": 175.73,
          "text": "再见的一半是"
        },
        {
          "time": 178.47,
          "text": "永恒的天地"
        },
        {
          "time": 181.23,
          "text": "回忆的一半是"
        },
        {
          "time": 184.98,
          "text": "不堪的过去"
        },
        {
          "time": 187.98,
          "text": "破镜的一半是"
        },
        {
          "time": 190.98,
          "text": "重圆的和好"
        },
        {
          "time": 194.22,
          "text": "谎言的一半是"
        },
        {
          "time": 197.48,
          "text": "编织的妥协"
        },
        {
          "time": 200.72,
          "text": "天地的一半是"
        },
        {
          "time": 203.72,
          "text": "永恒的再见"
        },
        {
          "time": 206.48,
          "text": "过去的一半是"
        },
        {
          "time": 210.49,
          "text": "不堪的回忆"
        }
      ]
    }
