        },
        {
          "time": 14.93,
          "text": "饱和的爱与澄澈的痛"
        },
        {
          "time": 18.41,
          "text": "坠落在无意识拥抱之中"
        },
        {
          "time": 21.53,
          "text": "柔软的心啊"
        },
        {
          "time": 23.6,
          "text": "这所有的情绪 寻求出口"
        },
        {
          "time": 28.68,
          "text": "如果说为谁停留"
        },
        {
          "time": 32.66,
          "text": "都有值得铭记的理由"
        },
        {
          "time": 35.47,
          "text": "雨水像眼泪"
        },
        {
          "time": 37.93,
          "text": "在告别时最温柔"
        },
        {
          "time": 45.09,
          "text": "是无法抵达的尽头"
        },
        {
          "time": 47.83,
          "text": "若缥缈的虚构"
        },
        {
          "time": 50.41,
          "text": "融化在想触碰又收回的手"
        },
        {
          "time": 54.75,
          "text": "浩瀚的宇宙"
        },
        {
          "time": 56.7,
          "text": "万物静籁"
        },
        {
          "time": 57.98,
          "text": "可你听有风轻吹过"
        },
        {
          "time": 61.06,
          "text": "陈旧情书还守着悸动"
        },
        {
          "time": 64.65,
          "text": "潮汐拥着海岸线"
        },
        {
          "time": 66.6,
          "text": "繁星仍闪烁"
        },
        {
          "time": 69.57,
          "text": "而我只凝视"
        },
        {
          "time": 74.23,
          "text": "你眼眸"
        },
        {
          "time": 76.3,
          "text": "作曲：Kide"
        },
        {
          "time": 77.5,
          "text": "作词：沈病娇"
        },
        {
          "time": 78.5,
          "text": "调教：顾令"
        },
        {
          "time": 79.5,
          "text": "演唱：苍穹"
        },
        {
          "time": 81.62,
          "text": "丢失昼夜更迭的线索"
        },
        {
          "time": 85.28,
          "text": "吹散的遗憾都不知所踪"
        },
        {
          "time": 88.1,
          "text": "惊慌又失措"
        },
        {
          "time": 90.39,
          "text": "剩下悄无声息 对我认同"
        },
        {
          "time": 95.76,
          "text": "幻想结成透明的冰冻"
        },
        {
          "time": 99.34,
          "text": "融化前可不可以去触碰"
        },
        {
          "time": 102.15,
          "text": "在这一秒钟"
        },
        {
          "time": 104.35,
          "text": "藏起来的沉默 总有人懂"
        },
        {
          "time": 109.19,
          "text": "如果说为谁停留"
        },
