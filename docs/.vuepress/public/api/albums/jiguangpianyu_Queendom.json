          "text": "轻盈地降落"
        },
        {
          "time": 250.18,
          "text": "珍珠贝壳保留着美梦"
        },
        {
          "time": 253.71,
          "text": "诗歌与远方相拥"
        },
        {
          "time": 255.79,
          "text": "风眷恋苍穹"
        },
        {
          "time": 258.82,
          "text": "你是我唯一"
        },
        {
          "time": 263.31,
          "text": "的心动"
        },
        {
          "time": 270.79,
          "text": "嗯~哼~嗯~"
        }
