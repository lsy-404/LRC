    {
      "title": "4 沙舟",
      "file": "4 沙舟.lrc",
      "lyrics": [
        {
          "time": 1.0,
          "text": "作曲：Zeno"
        },
        {
          "time": 6.07,
          "text": "作词：Zeno"
        },
        {
          "time": 10.47,
          "text": "调教：瑞安Ryan"
        },
        {
          "time": 15.09,
          "text": "演唱：赤羽"
        },
        {
          "time": 21.66,
          "text": "鲜花包裹着纷乱的世界"
        },
        {
          "time": 27.3,
          "text": "盛开后就被遗忘凋谢"
        },
        {
          "time": 32.9,
          "text": "北风带不走花瓣下的爱恋"
        },
        {
          "time": 38.48,
          "text": "风干后埋葬在梦里边"
        },
        {
          "time": 44.28,
          "text": "然后将梦绘成歌"
        },
        {
          "time": 46.95,
          "text": "将歌绘成河"
        },
        {
          "time": 49.93,
          "text": "河流经过孤城"
        },
        {
          "time": 52.76,
          "text": "城中千盏灯"
        },
        {
          "time": 55.67,
          "text": "灯火照不进我心中的干渴"
        },
        {
          "time": 61.12,
          "text": "渴求着无数曲折填补旅程"
        },
        {
          "time": 70.34,
          "text": "无数的黑夜"
        },
        {
          "time": 75.62,
          "text": "找寻着荒野中遗失的那些记忆碎片"
        },
        {
          "time": 81.34,
          "text": "等待黎明来临之前的分别"
        },
        {
          "time": 86.84,
          "text": "满载着悲伤"
        },
        {
          "time": 88.52,
          "text": "在梦的荒野拾起无数的谎言"
        },
        {
          "time": 114.81,
          "text": "尘埃隔绝了所有的眷恋"
        },
        {
          "time": 120.63,
          "text": "等待的人也消失不见"
        },
        {
          "time": 126.13,
          "text": "搁浅在沙丘上等候的千年"
        },
        {
          "time": 131.82,
          "text": "被遗忘的心却不曾被改变"
        },
        {
          "time": 138.21,
          "text": "无数的黑夜"
        },
        {
          "time": 143.54,
          "text": "渴望着的心像深海中一样不停摇曳"
        },
        {
          "time": 149.06,
          "text": "等待黎明来临之前的分别"
        },
        {
          "time": 154.79,
          "text": "满载着悲伤"
        },
        {
          "time": 156.45,
          "text": "在梦的边沿洒下无数的碎屑"
        },
        {
          "time": 186.25,
          "text": "无数的黑夜"
        },
        {
          "time": 191.49,
          "text": "遥远的呼唤是最初的约定还没实现"
        },
        {
          "time": 197.07,
          "text": "等待黎明来临之前的分别"
        },
        {
          "time": 202.7,
          "text": "满载着悲伤"
        },
        {
          "time": 204.24,
          "text": "在梦的终点沉入无你的世界"
        }
      ]
