        },
        {
          "time": 147.12,
          "text": "繁星仍闪烁"
        },
        {
          "time": 150.19,
          "text": "像谁的执着"
        },
        {
          "time": 154.77,
          "text": "低诉着"
        },
        {
          "time": 156.77,
          "text": "曾路过海市蜃楼的雾霭"
        },
        {
          "time": 161.91,
          "text": "曾看见"
        },
        {
          "time": 163.52,
          "text": "蝴蝶振翅掠过指失光年之外"
        },
        {
          "time": 168.9,
          "text": "晴日"
        },
        {
          "time": 172.77,
          "text": "放空"
        },
        {
          "time": 175.81,
          "text": "呐~哈~啊~啊~"
        },
        {
          "time": 183.62,
          "text": "所以那些花朵才盛开"
        },
        {
          "time": 186.83,
          "text": "心中有了对未知旅途的期待"
        },
        {
          "time": 190.64,
          "text": "无数次"
        },
        {
          "time": 193.64,
          "text": "流连过 不舍过一颗小小尘埃"
        },
        {
          "time": 197.74,
          "text": "终究愿意相信 这一切"
        },
        {
