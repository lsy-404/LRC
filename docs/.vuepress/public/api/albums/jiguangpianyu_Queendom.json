        {
          "time": 135.69,
          "text": "光辉的至美 也不过一尊傀儡"
        },
        {
          "time": 142.75,
          "text": "让恒星自毁 装进我胸腔之内"
        },
        {
          "time": 150.9,
          "text": "一颗眼泪 满怀爱意的诋毁"
        },
        {
          "time": 191.9,
          "text": "她赤裸着双足 缓步而来"
        },
        {
          "time": 196.04,
          "text": "荣膺七位选帝候的青睐"
