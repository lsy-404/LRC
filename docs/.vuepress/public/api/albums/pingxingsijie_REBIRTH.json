{"slug":"pingxingsijie_REBIRTH","folder":"平行四界RE：BIRTH","name":"平行四界 RE: BIRTH","prefix":"平行四界","zh_name":"","en_name":"RE: BIRTH","suffix":"","year":"2025-08-12","produce":["平行四界Quadimension"],"vocal":["星尘","赤羽","海伊","诗岸","苍穹"],"lyricist":["黑金语","林擒","乌梅Pd","Zeno","浓缩排骨","Aya-亚夜-","大久"],"composer":["烂兔子P","乌梅Pd","Zeno","胧","Kide","Aya-亚夜-","Bitman"],"arranger":["Evalia-爱娃","烂兔子P","乌梅Pd","Zeno","胧","Kide","Aya-亚夜-","Bitman"],"tuning":["瑞安Ryan","跨海星尘","苍梧_abilrue","血焰玖蝶"],"illustrator":["机器","碳烤腰关节","立旗","尤米妖妖","匙","Tiko","Inoriac"],"mixer":[],"lyric_maker":["武乙凌薇"],"release":"[Bilibili](https://www.bilibili.com/video/BV1uKtSz6EgF/)","purchase":"[淘宝 萌宅幻想](https://item.taobao.com/item.htm?id=991410246698) ￥108/￥178/￥228","electronic":"随专辑附赠","cover":"/albums/pingxingsijie_REBIRTH.jpg","tags":["平行四界RE：BIRTH","平行四界","RE: BIRTH","平行四界Quadimension"],"songs":[{"title":"1 箱庭剧目","lyrics":[{"time":1.0,"text":"作曲 : Evalia-爱娃"},{"time":2.0,"text":"编曲 : Evalia-爱娃"},{"time":3.0,"text":"作词 : 黑金语"},{"time":4.0,"text":"演唱 : 星尘 & 赤羽 & 海伊 & 诗岸 & 苍穹"},{"time":5.0,"text":"调校 : 瑞安Ryan"},{"time":6.0,"text":"曲绘 : 机器"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":20.9,"text":"〔星尘〕枯裂海礁"},{"time":23.9,"text":"〔星尘〕盐痕标识旧时咸潮"},{"time":30.66,"text":"〔海伊〕齿轮割穿浮雕"},{"time":34.76,"text":"〔海伊〕划破神像微笑唇角"},{"time":38.03,"text":"〔海伊〕终末的记号"},{"time":42.1,"text":"〔赤羽〕沙不飘"},{"time":44.66,"text":"〔赤羽〕只是向眸中追着灼烧"},{"time":49.6,"text":"〔苍穹〕把眼泪燃成灰与乌焦"},{"time":54.56,"text":"〔苍穹〕却还有光芒轻轻闪耀"},{"time":58.4,"text":"〔诗岸〕于是他听到："},{"time":61.0,"text":"〔星尘〕倘若献上 你的明亮瞳孔 像浪尖拂晓"},{"time":70.73,"text":"〔苍穹〕热烈尘风 不再将她袭扰 无需受煎熬"},{"time":80.36,"text":"〔海伊〕珍珠倏然变砂土 堕入霾与污 但执迷又不悟"},{"time":89.73,"text":"〔赤羽〕不必有反顾 成为追随同伴双手的盲目信徒"},{"time":100.53,"text":"〔诗岸〕在神已无意眷顾的迷途"},{"time":124.8,"text":"〔海伊〕湖中城邦"},{"time":128.86,"text":"〔海伊〕水草代替人群熙攘"},{"time":134.4,"text":"〔诗岸〕残破的玫瑰窗"},{"time":138.7,"text":"〔诗岸〕已把黄昏白鸽遗忘"},{"time":142.5,"text":"〔诗岸〕晨钟不再响"},{"time":145.2,"text":"〔苍穹〕酸的烟"},{"time":148.2,"text":"〔苍穹〕濒临溶解沉墟中逸散"},{"time":153.6,"text":"〔赤羽〕勉强承载着酣眠的船"},{"time":158.53,"text":"〔赤羽〕仿佛已无法抵达彼岸"},{"time":162.26,"text":"〔星尘〕有谁在呢喃说："},{"time":165.46,"text":"〔赤羽〕“箱庭 玩具盒 陈旧的魔方”"},{"time":167.7,"text":"〔苍穹〕“有趣的坚强 不如说只是狂妄”"},{"time":170.36,"text":"〔海伊〕“固执的羔羊 能忍耐多少次伤”"},{"time":172.56,"text":"〔星尘〕“揉搓在掌中 轻薄的生命纸张”"},{"time":175.3,"text":"〔星尘/诗岸〕“太早 还太早 给多些希望”"},{"time":177.36,"text":"〔海伊〕“足够幸福才致命一枪”"},{"time":179.93,"text":"〔全员〕“值得神明偶尔欣赏”"},{"time":189.46,"text":"〔星尘〕“如若献上 你的动听声嗓 像云雀翅膀"},{"time":199.46,"text":"〔诗岸〕深渊边缘 不再茫然渺远 即刻会浮现”"},{"time":209.13,"text":"〔苍穹/赤羽〕像人鱼失去歌喉 夜莺失去血肉 快要倾尽所有"},{"time":218.26,"text":"〔海伊〕但不求绿洲永久 只有一束温柔照拂在胸口"},{"time":229.13,"text":"〔全员〕“我愿献上最后仅存心脏 实现它幻想"},{"time":239.0,"text":"〔全员〕好似从前 哄睡她的那本 童话中梦想”"},{"time":248.96,"text":"〔全员〕她苏醒在伊甸园 天使在身边 颂赞神的表演"},{"time":257.3,"text":"〔全员〕她回味一遍 吩咐 豢养的剧作者 把故事重写"},{"time":268.3,"text":"〔星尘〕这类型它已厌倦"}]},{"title":"2 发条鸟即兴曲","lyrics":[{"time":1.0,"text":"作曲 : 烂兔子P"},{"time":2.0,"text":"编曲 : 烂兔子P"},{"time":3.0,"text":"作词 : 林擒"},{"time":4.0,"text":"演唱 : 诗岸"},{"time":6.0,"text":"曲绘 : 碳烤腰关节"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":32.75,"text":"太阳贪玩下雨开关 躲在云端后不敢看"},{"time":37.9,"text":"城市打完水仗一般 雨停了我还举着伞"},{"time":42.9,"text":"路旁木制燕子横躺 便给牠换个机械心脏"},{"time":47.9,"text":"上链 再飞翔 已远过楼房"},{"time":52.6,"text":"树荫 电杆 不期闪闪发亮"},{"time":57.7,"text":"青蛙 车辆 随兴一起哼唱"},{"time":63.0,"text":"-Dilibaba Diladilababa-"},{"time":103.35,"text":"大风无聊踢着纸团 被小狗叼去聚成山"},{"time":108.45,"text":"锡兵正忙列队抓犯 而我照水洼抚发端"},{"time":113.5,"text":"镜中群鸟停驻栏杆 有更多发条需要旋转"},{"time":118.5,"text":"上链 再飞翔 相约去流浪"},{"time":123.15,"text":"潮汐 灯塔 全都闪闪发亮"},{"time":128.3,"text":"海鸥 轮船 随兴再唱一段"},{"time":133.6,"text":"-Dilibaba Diladilababa-"},{"time":163.4,"text":"身影 目光 永远闪闪发亮"},{"time":168.3,"text":"歌词 声嗓 随兴收尾一唱"},{"time":174.0,"text":"-Dilibaba Diladilababa-"}]},{"title":"3 错误的","lyrics":[{"time":1.0,"text":"作曲 : 乌梅Pd"},{"time":2.0,"text":"编曲 : 乌梅Pd"},{"time":3.0,"text":"作词 : 乌梅Pd"},{"time":4.0,"text":"演唱 : 星尘"},{"time":5.0,"text":"调校 : 瑞安Ryan"},{"time":6.0,"text":"曲绘 : 立旗"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":15.8,"text":"伪善的脸"},{"time":18.75,"text":"戴上面具之前"},{"time":22.45,"text":"有没有人看见"},{"time":25.4,"text":"混沌 危险"},{"time":29.1,"text":"可笑的指点"},{"time":32.4,"text":"荒唐的字眼"},{"time":35.75,"text":"打扮成是爱你的场面"},{"time":41.5,"text":"写在氧气里的偏见"},{"time":48.2,"text":"要忘记呼吸才能幸免"},{"time":54.9,"text":"窒息梦境叫人沉湎"},{"time":61.15,"text":"推我坠入深渊"},{"time":95.55,"text":"镜子里的脸"},{"time":98.95,"text":"被切割的画面"},{"time":102.2,"text":"一片美梦上演"},{"time":105.15,"text":"一片眼泪赏脸"},{"time":109.95,"text":"沉默是亏欠"},{"time":112.3,"text":"诞生是冒险"},{"time":115.6,"text":"被选择的被视而不见"},{"time":121.45,"text":"写在氧气里的偏见"},{"time":128.1,"text":"要忘记呼吸才能幸免"},{"time":134.7,"text":"室息梦境叫人沉湎"},{"time":140.95,"text":"推我坠入深渊"},{"time":149.0,"text":"（都是欺骗）"},{"time":151.8,"text":"我在谎言的边缘"},{"time":155.5,"text":"等祂出现"},{"time":158.4,"text":"把”爱我“兑现"},{"time":162.1,"text":"告诉我不必自辨"},{"time":167.6,"text":"我所有想、念"},{"time":170.9,"text":"灌溉我直到成熟那天"}]},{"title":"4 假花没有枯萎的权利","lyrics":[{"time":1.0,"text":"作曲 : Zeno"},{"time":2.0,"text":"编曲 : Zeno"},{"time":3.0,"text":"作词 : Zeno"},{"time":4.0,"text":"演唱 : 海伊"},{"time":5.0,"text":"调校 : 瑞安Ryan"},{"time":6.0,"text":"曲绘 : 尤米妖妖"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":23.9,"text":"灰色 身体 装填 记忆"},{"time":28.12,"text":"红色爱意 绿色有些疏离"},{"time":32.2,"text":"晦涩 诗句 难以 理喻"},{"time":36.2,"text":"橙色甜蜜 蓝色忧郁"},{"time":39.25,"text":"紫色沉溺"},{"time":47.7,"text":"模仿着 排练着 却触碰不到呢"},{"time":52.3,"text":"(那属于 脸红着 闪躲的微热)"},{"time":55.8,"text":"就算用再多的诗篇也填补不了的"},{"time":60.9,"text":"(轻轻一吻的颜色)"},{"time":63.9,"text":"欢笑着 哭泣着 我已经学会了"},{"time":68.6,"text":"(想靠近 怕靠近 假装成过客)"},{"time":72.1,"text":"最后连属于我的颜色都消失了"},{"time":77.1,"text":"也依然等待着"},{"time":97.2,"text":"白色 感情 逐渐 剥离"},{"time":101.15,"text":"黄色妒嫉 靛色过分冷静"},{"time":105.2,"text":"退后 距离 难以 摸清"},{"time":109.2,"text":"在心里涂抹成了黑色"},{"time":112.75,"text":"模仿着 排练着 却触碰不到呢"},{"time":117.3,"text":"(但诺言 再拖延 便无可奈何)"},{"time":120.8,"text":"就算用再多的时间也填补不了的"},{"time":125.9,"text":"(轻轻一吻的颜色)"},{"time":128.9,"text":"欢笑着 哭泣着 是否也是假的"},{"time":133.5,"text":"(想忘记 怕忘记 呼吸都违和)"},{"time":136.9,"text":"最后连属于我的颜色都消失了"},{"time":142.0,"text":"也依然等待着"},{"time":146.5,"text":"失去了温热"},{"time":148.5,"text":"失去了选择"},{"time":150.5,"text":"就连枯萎也是种贪奢"},{"time":154.6,"text":"感情愚昧的模仿者"},{"time":156.6,"text":"成为假想的代替者"},{"time":158.6,"text":"连唱着的歌都"},{"time":159.7,"text":"变成你所爱的"},{"time":161.2,"text":"模仿着 排练着 却触碰不到呢"},{"time":165.9,"text":"(连感觉 也渐渐 传达不到了)"},{"time":169.5,"text":"就算用再多的语言也填补不了的"},{"time":174.5,"text":"(轻轻一吻的颜色)"},{"time":177.7,"text":"欢笑着 哭泣着 我已不在乎了"},{"time":182.2,"text":"(越用力 越深刻 也不过摆设)"},{"time":185.7,"text":"最后连我的颜色全都消逝了"},{"time":190.77,"text":"还依然等待着"}]},{"title":"5 念","lyrics":[{"time":0.8,"text":"山遥路远"},{"time":1.0,"text":"作曲 : 胧"},{"time":2.0,"text":"编曲 : 胧"},{"time":3.0,"text":"作词 : 浓缩排骨"},{"time":4.0,"text":"演唱 : 星尘"},{"time":4.55,"text":"十年之后确认 签收 信笺"},{"time":5.0,"text":"调校 : 瑞安Ryan"},{"time":6.0,"text":"曲绘 : 匙"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":11.4,"text":"写给自己的 太多傻话"},{"time":16.35,"text":"边笑边哭吧"},{"time":21.55,"text":"见字如面"},{"time":25.4,"text":"写给未来的我 几句 留言"},{"time":31.7,"text":"日子过得怎么样 还快乐吗"},{"time":37.2,"text":"是否 身边有他"},{"time":42.05,"text":"我期待 天理 注定 时间或是命运"},{"time":47.25,"text":"我还有构思许久却尚未开始的剧情 等待着开机"},{"time":53.5,"text":"今日的我"},{"time":55.7,"text":"正一步一步走向 成为你"},{"time":62.2,"text":"不知道未来的你是否还握着笔"},{"time":68.05,"text":"像我今天一样地组合着字句"},{"time":72.6,"text":"寄托一份心绪"},{"time":74.9,"text":"音乐与梦境 拯救了我的唯一"},{"time":83.7,"text":"希望我不像今天一样小心翼翼"},{"time":88.9,"text":"能够按照自己真实的心意"},{"time":93.4,"text":"自由的活下去"},{"time":95.7,"text":"装载着勇气"},{"time":98.3,"text":"能写出 藏在心底的梦"},{"time":104.6,"text":"我期盼着你"},{"time":125.7,"text":"山遥路远"},{"time":129.5,"text":"十年之后 确认 签收 信笺"},{"time":136.4,"text":"我每天望着 日暮落下"},{"time":140.95,"text":"究竟是 什么感想"},{"time":146.15,"text":"我害怕 你在我的梦境之中登场"},{"time":151.35,"text":"害怕你 眼中永恒独属少年人的光芒"},{"time":155.9,"text":"浪漫不消亡"},{"time":157.65,"text":"梦想还是梦乡"},{"time":159.85,"text":"船舶也没能到港"},{"time":162.1,"text":"我像活在斗兽场"},{"time":167.0,"text":"依存着你留下的余晖 仍在回味"},{"time":172.2,"text":"装作我能将你的勇气寻回"},{"time":176.7,"text":"决然奋不顾身"},{"time":179.02,"text":"带着一颗心"},{"time":183.25,"text":"飞奔向下个天明"},{"time":187.77,"text":"我或许 再也不能写出那种词句"},{"time":193.0,"text":"少年却 永远闪光照进记忆"},{"time":197.45,"text":"还有太多情绪 和跳动的心"},{"time":202.55,"text":"没能够 从我胸膛中吐尽"},{"time":208.6,"text":"继续走下去"},{"time":212.8,"text":"lalalalala...."}]},{"title":"6 夏日激奏","lyrics":[{"time":0.01,"text":"作曲 : Kide"},{"time":0.02,"text":"编曲 : Kide"},{"time":0.03,"text":"作词 : 浓缩排骨"},{"time":0.04,"text":"演唱 : 赤羽"},{"time":0.05,"text":"调校 : 瑞安Ryan"},{"time":0.06,"text":"曲绘 : 碳烤腰关节"},{"time":0.07,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":11.7,"text":"白日梦 还不能 停下"},{"time":14.4,"text":"沉没的 就继续 增加"},{"time":17.1,"text":"别害怕 世界的 落差"},{"time":19.8,"text":"希望在 灰暗中 发芽"},{"time":22.3,"text":"故事从头"},{"time":23.3,"text":"人生是场无目的漂流"},{"time":25.0,"text":"叙写前奏"},{"time":26.0,"text":"在脑海里关押着高歌 的怪兽"},{"time":28.8,"text":"在与平淡 做搏斗"},{"time":33.0,"text":"夏日疾走"},{"time":34.0,"text":"雨水流淌堆积的街头"},{"time":35.65,"text":"初次见面"},{"time":36.6,"text":"茫茫人海回应我电波 的旧友"},{"time":39.5,"text":"擦身认错 偷笑我出糗"},{"time":43.5,"text":"在荒芜的白地 涂写颜色"},{"time":46.3,"text":"为那些有趣的梦 做点什么"},{"time":48.9,"text":"反正人的一生 都在试错"},{"time":51.6,"text":"白日梦 就由我 来先做"},{"time":54.6,"text":"人为梦想而活"},{"time":57.2,"text":"写下我的歌"},{"time":59.6,"text":"抱起吉他想象着 星光闪烁"},{"time":62.35,"text":"舞台焦点聚集在 我的掌握"},{"time":65.3,"text":"说些轻狂蠢话"},{"time":68.0,"text":"会被偷笑吗"},{"time":70.2,"text":"我仍不知道明天 如何到达"},{"time":73.0,"text":"那就"},{"time":74.2,"text":"沿道路狂奔 做全垒打"},{"time":86.7,"text":"白日梦 还不能 停下"},{"time":89.3,"text":"沉没的 就继续 增加"},{"time":92.1,"text":"别害怕 世界的 落差"},{"time":94.7,"text":"希望在 灰暗中 发芽"},{"time":97.2,"text":"热血冲头"},{"time":98.2,"text":"仅有的才能将我拯教"},{"time":99.9,"text":"殉爆之后"},{"time":100.9,"text":"串联你我的炸药当量 还不够"},{"time":103.8,"text":"对于灵感 在渴求"},{"time":108.0,"text":"夏日激奏"},{"time":108.95,"text":"不甘于乏味将我污浊"},{"time":110.6,"text":"碾过蹉跎"},{"time":111.7,"text":"平原沃土建造我们的 理想国"},{"time":114.4,"text":"摩天大厦 在此处座落"},{"time":118.4,"text":"搭建好舞台 唱心里的歌"},{"time":121.1,"text":"挥舞着闪亮 荧光璀璨颜色"},{"time":123.8,"text":"没学会变成熟 莽撞的我"},{"time":126.5,"text":"白日梦 也有人 与我去做"},{"time":150.75,"text":"(过曝的眩光 定格了风 视界摇晃"},{"time":153.3,"text":"永恒的某个瞬间 不再是想象"},{"time":156.1,"text":"停泊的梦乡"},{"time":157.1,"text":"迎来滔天 的巨浪)"},{"time":161.7,"text":"洪水冲刷而过"},{"time":164.3,"text":"我陷入沼泽"},{"time":166.6,"text":"凛冬冻结了脆弱 谁能解脱"},{"time":169.2,"text":"梦想的世界破碎 下沉坠落"},{"time":172.2,"text":"一切结束了吗"},{"time":174.9,"text":"混乱的踢踏"},{"time":177.3,"text":"可是我还相信着 那些蠢话"},{"time":179.9,"text":"说好一起要成为 头号玩家"},{"time":183.0,"text":"即使无药可救"},{"time":185.7,"text":"也无需呼救"},{"time":188.0,"text":"反正大家都一样 像是傻瓜"},{"time":190.7,"text":"做点傻事又如何 笑就笑吧"},{"time":193.7,"text":"再次弹起吉他"},{"time":196.4,"text":"演奏出魔法"},{"time":198.8,"text":"哪怕只是在夏日 限定登场"},{"time":201.4,"text":"也要"},{"time":202.6,"text":"舞台上聚焦所有的光"},{"time":209.2,"text":"在记忆中 被升华"}]},{"title":"7 星星的孩子","lyrics":[{"time":0.01,"text":"作曲 : Aya-亚夜-"},{"time":0.02,"text":"编曲 : Aya-亚夜-"},{"time":0.03,"text":"作词 : Aya-亚夜-"},{"time":0.04,"text":"演唱 : 星尘"},{"time":0.05,"text":"调校 : 跨海星尘"},{"time":0.06,"text":"曲绘 : 原画-Tiko 修改-匙"},{"time":0.07,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":0.86,"text":"在这废墟之中 一个黑暗的世界"},{"time":6.4,"text":"寻找一束光 像是金色的风吹脸庞"},{"time":12.06,"text":"每一次的闪耀，是我在跳动的心脏"},{"time":22.9,"text":"和你的相遇"},{"time":24.9,"text":"带我逃出深渊，抓住云上的黎明"},{"time":28.93,"text":"我是一名勇者"},{"time":30.93,"text":"化茧成蝶的魔法"},{"time":34.36,"text":"星河的凛冽，流淌在我血液"},{"time":40.06,"text":"闪耀的世界，照亮新的夜"},{"time":45.73,"text":"宇宙浩瀚无边无界"},{"time":48.53,"text":"我们就像是渺小的落叶"},{"time":54.06,"text":"也会是卷起风暴的蝴蝶"},{"time":57.26,"text":"向着未知祈祷，一个温柔的世界"},{"time":62.93,"text":"只要闭上眼，流星也会在身旁倾泻"},{"time":68.7,"text":"合上你的手掌，心中的愿望再默默念几遍"},{"time":73.53,"text":"或许很遥远"},{"time":75.53,"text":"也要相信我们不会再被爱疏远"},{"time":80.26,"text":"轻轻说出心愿"},{"time":82.6,"text":"有你陪伴的韶华"},{"time":85.2,"text":"星河的凛冽，流淌在我血液"},{"time":90.86,"text":"闪耀的世界，照亮新的夜"},{"time":96.56,"text":"宇宙浩瀚无边无界"},{"time":99.33,"text":"我们就像是渺小的落叶"},{"time":104.26,"text":"也会是蝴蝶"},{"time":106.63,"text":"飞向你的身边"},{"time":108.53,"text":"星星的孩子"},{"time":111.33,"text":"我是否在寻找答案"},{"time":113.2,"text":"我曾经孤单"},{"time":114.6,"text":"害怕别人的友善"},{"time":116.96,"text":"不敢拥有璀璨"},{"time":119.65,"text":"你照亮黑暗"},{"time":121.76,"text":"还好现在有你的陪伴"},{"time":124.66,"text":"我知道身体终会消散"},{"time":127.53,"text":"但有你，给我了答案"},{"time":134.73,"text":"As my shell fades away."},{"time":134.73,"text":"随着我的躯壳逐渐消散"},{"time":140.4,"text":"Syncretize into light."},{"time":140.4,"text":"我们会融合成光芒"},{"time":143.76,"text":"We are kids of stars."},{"time":143.76,"text":"我们都是星星的孩子"},{"time":181.36,"text":"星河的凛冽，流淌在我血液"},{"time":186.8,"text":"闪耀的世界，照亮新的夜"},{"time":192.53,"text":"宇宙浩瀚无边无界"},{"time":195.33,"text":"我们会是卷起风暴的蝴蝶"},{"time":201.0,"text":"带着奇迹飞向你的身边"}]},{"title":"8 Whispering Snowflakes","lyrics":[{"time":1.0,"text":"作曲 : Bitman"},{"time":2.0,"text":"编曲 : Bitman"},{"time":3.0,"text":"作词 : 大久"},{"time":4.0,"text":"演唱 : 星尘 & 海伊"},{"time":5.0,"text":"调校 : 苍梧 玖蝶"},{"time":6.0,"text":"曲绘 : Inoriac"},{"time":7.0,"text":"收录 : 五维介质・ 官方专辑『五维介质 Re: Birth』"},{"time":12.6,"text":"〔星尘〕我听见窗外落雪纷纷"},{"time":16.77,"text":"〔星尘〕隐秘地述说着多情深"},{"time":23.73,"text":"〔星尘〕远道而来的一回殉身"},{"time":27.8,"text":"〔星尘〕向大地献上它真诚的亲吻"},{"time":34.7,"text":"〔海伊〕我望见屋内火光炙热"},{"time":38.87,"text":"〔海伊〕倒映着角落相依的恋人"},{"time":45.77,"text":"〔海伊〕毯下十指相扣的天真"},{"time":49.93,"text":"〔海伊〕还是为命运转过头噤声"},{"time":53.77,"text":"〔星尘&海伊〕甜蜜的话像晶莹雪花"},{"time":58.07,"text":"〔星尘&海伊〕沾染在我唇边转眼融化"},{"time":61.67,"text":"〔星尘&海伊〕滴落水珠是谁的泪啊"},{"time":63.57,"text":"〔星尘&海伊〕此刻空气一言不发"},{"time":67.2,"text":"〔星尘〕你同我未来道路的温差"},{"time":69.97,"text":"〔海伊〕沉默竟是你抉择的回答"},{"time":72.77,"text":"〔星尘〕名为爱〔海伊〕的游戏〔星尘&海伊〕是如此复杂"},{"time":78.97,"text":"〔海伊〕紧握咫尺距离的温暖"},{"time":83.0,"text":"〔海伊〕短暂地满杯之后被打翻"},{"time":89.9,"text":"〔星尘〕枕边低笑着将我偏袒"},{"time":93.97,"text":"〔星尘〕要我如何不想念这诱人上瘾的陪伴"},{"time":100.9,"text":"〔海伊〕我们之间的相遇"},{"time":103.67,"text":"〔星尘〕并非一场恶作剧"},{"time":106.5,"text":"〔海伊〕语冰的烈日"},{"time":107.9,"text":"〔星尘&海伊〕之梦怎能够不是首恋曲"},{"time":112.2,"text":"〔星尘〕把亏欠钩织成线"},{"time":114.67,"text":"〔海伊〕打成毛巾互相赠与"},{"time":117.13,"text":"〔星尘〕可我〔星尘&海伊〕不愿它是一时安抚的道具"},{"time":122.37,"text":"〔星尘&海伊〕甜蜜的话像晶莹雪花"},{"time":124.27,"text":"〔星尘&海伊〕沾染在我唇边转眼融化"},{"time":128.3,"text":"〔星尘&海伊〕滴落水珠是谁的泪啊"},{"time":129.77,"text":"〔星尘&海伊〕此刻空气一言不发"},{"time":133.4,"text":"〔海伊〕你同我未来道路的温差"},{"time":136.13,"text":"〔星尘〕沉默竟是你抉择的回答"},{"time":138.93,"text":"〔星尘〕名为爱〔海伊〕的游戏〔星尘&海伊〕是如此复杂"},{"time":169.27,"text":"〔海伊〕仰望天空时不知它远近"},{"time":170.9,"text":"〔星尘〕繁星见证那日相守的约定"},{"time":174.8,"text":"〔海伊〕我身旁〔星尘〕的座位〔海伊〕为你〔星尘&海伊〕预留却自此缺席"},{"time":179.6,"text":"〔星尘〕任回忆〔海伊〕摇动着〔星尘&海伊〕不平息我的真心"},{"time":181.57,"text":"〔星尘&海伊〕反复〔星尘〕梦回午夜终〔海伊〕归于寂静"},{"time":185.73,"text":"〔海伊〕化开〔星尘〕涟漪〔星尘&海伊〕像是明镜"},{"time":189.93,"text":"〔星尘&海伊〕早看透爱意之中绽放的雪花"},{"time":193.2,"text":"〔星尘&海伊〕尽管它只能暂驻一刹那"},{"time":196.87,"text":"〔星尘&海伊〕冬去春来仍难舍牵挂"},{"time":198.73,"text":"〔星尘&海伊〕怎么学会遗忘的方法"},{"time":202.57,"text":"〔星尘〕你同我过往故事如同童话〔海伊〕广厦崩塌"},{"time":205.33,"text":"〔星尘〕对世的眼神中无谓赢家"},{"time":207.93,"text":"〔海伊〕名为爱（海伊）的游戏〔星尘&海伊〕是我跨越时空的痴傻"},{"time":213.37,"text":"〔星尘〕没了你〔海伊〕的未来〔星尘&海伊〕不值得我张开手接纳"},{"time":221.67,"text":"〔海伊〕啊〔星尘〕啊〔星尘&海伊〕啊"}]}]}