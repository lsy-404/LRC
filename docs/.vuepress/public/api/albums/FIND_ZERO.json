    {
      "title": "11 暗与辉缠绕的囚笼",
      "file": "11 暗与辉缠绕的囚笼.lrc",
      "lyrics": [
        {
          "time": 0.7,
          "text": "诗岸 饰 猎魔人诗岸 饰 魅魔"
        },
        {
          "time": 11.88,
          "text": "【猎魔人】"
        },
        {
          "time": 12.46,
          "text": "喧嚣歌谣共命运流沙"
        },
        {
          "time": 17.32,
          "text": "追逐群鸟飞越高塔"
        },
        {
          "time": 22.75,
          "text": "待斑斓曙色亲吻橡树枝桠"
        },
        {
          "time": 28.55,
          "text": "神灵正静待旅人步伐"
        },
        {
          "time": 34.95,
          "text": "祷铃萦绕指尖晨风"
        },
        {
          "time": 37.71,
          "text": "伴唱游者的歌声"
        },
        {
          "time": 39.76,
          "text": "如群山慷慨赠予一吻"
        },
        {
          "time": 42.66,
          "text": "将庇佑遥远无尽旅程"
        },
        {
          "time": 46.12,
          "text": "行至昼夜轮转时分"
        },
        {
          "time": 48.99,
          "text": "云翳裹挟发梢与裙角泥尘"
        },
        {
          "time": 51.9,
          "text": "庭院燃起辉煌烛灯"
        },
        {
          "time": 54.22,
          "text": "她叩开那扇门"
        },
        {
          "time": 56.82,
          "text": "【魅魔】"
        },
        {
          "time": 56.89,
          "text": "拂去夜风凄冷 斟满美酒甘醇"
        },
        {
          "time": 62.54,
          "text": "行客啊于此栖身"
        },
        {
          "time": 68.29,
          "text": "是迷途的歌者 吟诵诗篇缤纷"
        },
        {
          "time": 74.0,
          "text": "可曾跨越四季晨昏 触摸浩远星辰"
        },
        {
          "time": 79.39,
          "text": "酒香熏染齿唇 炉火残存余温"
        },
        {
          "time": 85.23,
          "text": "催生 不安 心神"
        },
        {
          "time": 88.0,
          "text": "【猎魔人】"
        },
        {
          "time": 88.41,
          "text": "与幻梦"
        },
        {
          "time": 91.28,
          "text": "【合】"
        },
        {
          "time": 91.44,
          "text": "视线是否与虚妄交锋"
        },
        {
          "time": 96.3,
          "text": "心火跃动麻木双瞳"
        },
        {
          "time": 101.92,
          "text": "馥郁安息香纵情弥散翻涌"
        },
        {
          "time": 107.64,
          "text": "沉沦芬芳至呼吸刺痛"
        },
        {
          "time": 114.03,
          "text": "月光令幻想消退影踪"
        },
        {
          "time": 118.96,
          "text": "恍惚遗忘神明尊荣"
        },
        {
          "time": 124.62,
          "text": "若漂泊宿命无意策划相逢"
        },
        {
          "time": 130.22,
          "text": "此刻请暂歇在我眼中"
        },
        {
          "time": 167.32,
          "text": "【猎魔人】是否我 踏入 这虚浮桎梏 放任高傲猎物 信仰亵渎【魅魔】与我 深陷在 这华美乐土 永荒芜"
        },
        {
          "time": 180.07,
          "text": "【魅魔】苍白乐章散落 烛光蚕食静默"
        },
        {
          "time": 185.56,
          "text": "不过一瞬爱欲似火 皆自灰烬挣脱"
        },
        {
          "time": 191.1,
          "text": "是狡黠的猎手 神圣刀锋闪烁"
        },
        {
          "time": 196.79,
          "text": "指向 消亡 罪恶"
        },
        {
          "time": 200.95,
          "text": "【猎魔人】与我"
        },
        {
          "time": 202.93,
          "text": "【合】"
        },
        {
          "time": 203.16,
          "text": "将残破幻象凝铸囚锁"
        },
        {
          "time": 207.84,
          "text": "心潮永于梦境鲜活"
        },
        {
          "time": 213.51,
          "text": "“若爱是深渊 可否共我陷落”"
        },
        {
          "time": 219.12,
          "text": "下一瞬风霜埋葬炉火"
        },
        {
          "time": 225.64,
          "text": "光辉与暗影交缠跃动"
        },
        {
          "time": 230.43,
          "text": "闪耀锋芒烧作绯红"
        },
        {
          "time": 236.06,
          "text": "“若爱恋赤诚 躯壳不惜奉送”"
        },
        {
          "time": 241.68,
          "text": "此刻将尘封于我眼中"
        },
        {
          "time": 248.12,
          "text": "崇高神明请与我见证"
        },
        {
          "time": 253.04,
          "text": "明日谁与晨曦相拥"
        },
        {
          "time": 258.7,
          "text": "倘若负罪者甘愿束于网中"
        },
        {
          "time": 264.41,
          "text": "猎人（夜魔）啊可否将双手紧握"
        },
        {
          "time": 269.68,
          "text": "就于此 请俯身优雅抉择"
        },
        {
          "time": 275.48,
          "text": "就于此 将交错轮盘轻拨"
        },
        {
          "time": 280.97,
          "text": "啊"
        }
      ]
