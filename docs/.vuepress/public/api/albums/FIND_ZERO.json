    {
      "title": "05 伤者",
      "file": "05 伤者.lrc",
      "lyrics": [
        {
          "time": 10.75,
          "text": "曲/编/混：SakuyaH"
        },
        {
          "time": 19.6,
          "text": "词：大九_LN"
        },
        {
          "time": 29.7,
          "text": "曲绘：revol"
        },
        {
          "time": 37.38,
          "text": "一页一页一页拾起的碎记忆"
        },
        {
          "time": 39.76,
          "text": "一页一页一页于心里累积"
        },
        {
          "time": 42.26,
          "text": "一页一页一页聚集后的诗意"
        },
        {
          "time": 44.76,
          "text": "一页一页一页拉开的距离"
        },
        {
          "time": 47.39,
          "text": "渴望忘记昔日联系"
        },
        {
          "time": 52.36,
          "text": "一页一页一页哭泣着都撕去"
        },
        {
          "time": 54.85,
          "text": "一页一页一页我存多少心意都将悉数死去"
        },
        {
          "time": 62.19,
          "text": "你翻开了我 会读到什么"
        },
        {
          "time": 67.51,
          "text": "战栗的字句和灵魂"
        },
        {
          "time": 72.26,
          "text": "你合上了我 又是因何"
        },
        {
          "time": 77.65,
          "text": "撕咬的痛 不会再愈合"
        },
        {
          "time": 82.41,
          "text": "请让我每个子夜都受创"
        },
        {
          "time": 87.44,
          "text": "直到被赐下死亡"
        },
        {
          "time": 92.51,
          "text": "等待 解脱的那刻来到"
        },
        {
          "time": 102.89,
          "text": "我存多少心意都将悉数死去"
        },
        {
          "time": 107.62,
          "text": "你翻开了我 要问些什么"
        },
        {
          "time": 113.0,
          "text": "以此来说理掩饰你罪行"
        },
        {
          "time": 117.69,
          "text": "你合上了我 从此相隔"
        },
        {
          "time": 123.14,
          "text": "维系的爱 恨意来叠合"
        },
        {
          "time": 127.83,
          "text": "宁愿瞒骗自己只是病了"
        },
        {
          "time": 132.91,
          "text": "秩序碎裂的伤者"
        },
        {
          "time": 138.0,
          "text": "捧着 几缕真实的纠葛"
        },
        {
          "time": 147.88,
          "text": "恩怨 再拉扯"
        },
        {
          "time": 152.88,
          "text": "也无法变成美好 的歌"
        },
        {
          "time": 160.45,
          "text": "算了"
        },
        {
          "time": 166.25,
          "text": "奋力把你的章节撕去"
        }
      ]
    },
    {
