          "text": "传承千百年的不变命运"
        },
        {
          "time": 115.51,
          "text": "何时能应声斩断逃离"
        },
        {
          "time": 117.87,
          "text": "【海伊】"
        },
        {
          "time": 118.88,
          "text": "早已无需分清"
        },
        {
          "time": 121.56,
          "text": "思念或是恨意都已失去原因"
        },
        {
          "time": 126.2,
          "text": "剑刃相接燃烧殆尽"
        },
        {
          "time": 128.88,
          "text": "【海伊】不愿去探寻你"
        },
        {
          "time": 130.87,
          "text": "眼中那抹为之不得已"
        },
        {
          "time": 134.23,
          "text": "【赤羽】不愿去看清你"
        },
        {
          "time": 136.04,
          "text": "侧身挥剑时出手犹疑"
        },
        {
          "time": 139.53,
          "text": "【海伊】当下应是电闪雷鸣"
        },
        {
          "time": 142.2,
          "text": "【赤羽】当下应是神怒鬼泣"
        },
        {
          "time": 144.88,
          "text": "【合】为何鲜血沾染樱花飘落得如此美丽"
        }
      ]
