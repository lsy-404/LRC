    {
      "title": "加特林",
      "file": "加特林.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "作曲 : 绛舞乱丸"
        },
        {
          "time": 3.93,
          "text": "作词 : 绛舞乱丸"
        },
        {
          "time": 7.52,
          "text": "加特林"
        },
        {
          "time": 13.98,
          "text": "就让我火力全开"
        },
        {
          "time": 16.79,
          "text": "三秒轻松过百"
        },
        {
          "time": 18.31,
          "text": "全身心超载"
        },
        {
          "time": 19.82,
          "text": "永动不灭的人生停不下来"
        },
        {
          "time": 23.16,
          "text": "根本停不下来"
        },
        {
          "time": 24.99,
          "text": "Ready aim FIRE!!FIRE!!FIRE!!"
        },
        {
          "time": 28.41,
          "text": "就是个快"
        },
        {
          "time": 42.86,
          "text": "这世界将我围攻"
        },
        {
          "time": 44.78,
          "text": "我难忍其痛 怎么解"
        },
        {
          "time": 49.98,
          "text": "这诱惑味道太冲"
        },
        {
          "time": 51.9,
          "text": "若深陷其中 怎么戒"
        },
        {
          "time": 57.0,
          "text": "这潮流实在看不太懂"
