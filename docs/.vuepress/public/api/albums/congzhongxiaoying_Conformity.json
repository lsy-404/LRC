        },
        {
          "time": 74.04,
          "text": "算算算 坐怀不乱"
        },
        {
          "time": 75.66,
          "text": "看似当然的对错是反的 别太纠结"
        },
        {
          "time": 79.71,
          "text": "拿出十分虔诚去迎接"
        },
        {
          "time": 82.38,
          "text": "啊~~~~！"
        },
        {
          "time": 85.87,
          "text": "万事如意何须机关都算尽，yeah"
        },
        {
          "time": 90.83,
          "text": "啊~~~~！"
        },
        {
          "time": 93.92,
          "text": "盘盘算清不如把自己看清一点"
        },
        {
          "time": 99.07,
          "text": "才不会 才不会"
        },
        {
          "time": 100.79,
          "text": "是数字的傀儡"
        },
        {
          "time": 107.01,
          "text": "才不会 才不会"
        },
        {
          "time": 108.98,
          "text": "就此妥协"
        },
        {
          "time": 117.84,
          "text": "如果 算算算 手到擒来"
        },
        {
          "time": 120.06,
          "text": "谁翻了盘了谁陪了赚了 总会有变"
        },
        {
          "time": 123.75,
          "text": "不变应万变"
        },
        {
          "time": 126.03,
          "text": "算算算 坐怀不乱"
        },
        {
          "time": 127.6,
          "text": "看似简单的收获是难的 别太松懈"
        },
        {
          "time": 131.75,
          "text": "拿出十分认真去迎接"
        },
        {
          "time": 134.64,
          "text": "啊~~~~！"
        },
        {
          "time": 137.73,
          "text": "万事如意何须千金都散尽，yeah"
        },
        {
          "time": 142.73,
          "text": "啊~~~~！"
        },
        {
          "time": 145.66,
          "text": "盘盘算清不如把自己看清一点"
        },
        {
          "time": 150.83,
          "text": "啊~~~~！"
        },
        {
          "time": 153.71,
          "text": "万事如意何须机关都算尽，yeah"
        },
        {
          "time": 158.77,
          "text": "啊~~~~！"
        },
        {
          "time": 161.85,
          "text": "盘盘算清不如把自己看清一点"
        },
        {
          "time": 166.96,
          "text": "猜不对 猜不对"
        },
        {
          "time": 168.72,
          "text": "这红绿的双线"
        },
        {
          "time": 174.84,
          "text": "我才不会 才不会"
        },
        {
          "time": 176.92,
          "text": "就此终结"
        }
