        {
          "time": 2.0,
          "text": "曲：磨蹭_platix_zhang"
        },
        {
          "time": 3.0,
          "text": "词：大九_LN"
        },
        {
          "time": 4.0,
          "text": "调：瑞安Ryan不跑调"
        },
        {
          "time": 5.0,
          "text": "绘：天马九茶"
        },
        {
          "time": 6.0,
          "text": "演唱：牧心"
        },
        {
          "time": 8.54,
          "text": "笔尖跑出白马"
        },
        {
          "time": 12.13,
          "text": "远方的传说如风送达"
        },
        {
          "time": 16.41,
          "text": "讲述孩子爱听的童话再散落鲜花"
        },
        {
          "time": 24.21,
          "text": "挤占农耕闲暇"
        },
        {
          "time": 28.18,
          "text": "驻扎村落河边的船筏"
        },
        {
          "time": 32.32,
          "text": "引来为生计懊恼的人短暂忘却空乏"
        },
        {
          "time": 40.73,
          "text": "演绎王子的优雅"
        },
        {
          "time": 44.32,
          "text": "笨拙地模仿陌生句法"
        },
        {
          "time": 48.28,
          "text": "观众鼓起掌 喝倒彩"
        },
        {
          "time": 52.74,
          "text": "沉浸此刻快活融洽"
        },
        {
          "time": 56.96,
          "text": "果树干瘪的枝桠"
        },
        {
          "time": 60.25,
          "text": "让孩童当魔杖来施法"
        },
        {
          "time": 64.46,
          "text": "剧情高潮迭起谢幕瞬间天空盛放烟花"
        },
        {
          "time": 104.33,
          "text": "撒种美丽的梦"
        },
        {
          "time": 108.19,
          "text": "点亮原已暗淡的双眸"
        },
        {
          "time": 112.28,
          "text": "写下崭新童谣 把希望藏在歌声中"
        },
        {
          "time": 120.47,
          "text": "笔尖跑出白马"
        },
        {
          "time": 124.17,
          "text": "此处的传说拼接成画"
        },
        {
          "time": 128.44,
          "text": "攒下厚厚一叠的快乐朝着没有故事的老地点出发"
        }
      ]
