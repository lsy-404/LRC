    {
      "title": "3 蛇蛊",
      "file": "3 蛇蛊.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "蛇蛊"
        },
        {
          "time": 4.0,
          "text": "曲：雪人Snowman_"
        },
        {
          "time": 6.0,
          "text": "词：大九_LN"
        },
        {
          "time": 8.0,
          "text": "调：某只泽"
        },
        {
          "time": 10.0,
          "text": "曲绘：Fanghx_D"
        },
        {
          "time": 12.0,
          "text": "吉他：阿毛XD"
        },
        {
          "time": 14.0,
          "text": "演唱：海伊"
        },
        {
          "time": 27.54,
          "text": "啊 唯命是从要多少借口"
        },
        {
          "time": 33.08,
          "text": "连体温都拱手献于他人拨动"
        },
        {
          "time": 39.47,
          "text": "如若未见星光也许能安受"
        },
        {
          "time": 46.49,
          "text": "长夜漫漫信念的腐朽"
        },
        {
          "time": 52.49,
          "text": "断壁残垣记叙断句残章的面容"
        },
        {
          "time": 59.97,
          "text": "已剥落的颜料之中多少爱憎已流走"
        },
        {
          "time": 64.84,
          "text": "我非残存的鬼魂"
        },
        {
          "time": 67.94,
          "text": "我非复仇的猎人"
        },
        {
          "time": 71.02,
          "text": "绞落星辰才能复生"
        },
        {
          "time": 100.95,
          "text": "啊 是药是蛊无人能区分"
        },
        {
          "time": 106.67,
          "text": "斑驳的蛇鳞满布风沙刻的样纹"
        },
        {
          "time": 113.46,
          "text": "咬合头尾化身镜廊的大门"
        },
        {
          "time": 120.29,
          "text": "沉溺好似岩浆的伤痕"
        },
        {
          "time": 126.14,
          "text": "复眼观测历史敷衍了事地捉弄"
        },
        {
          "time": 133.79,
          "text": "浪潮翻涌此刻进和退都是错的骁勇"
        },
        {
          "time": 138.45,
          "text": "我非虔诚地报恩"
        },
        {
          "time": 141.7,
          "text": "我非高傲地盘问"
        },
        {
          "time": 144.74,
          "text": "恋慕星辰等同自刎"
        },
        {
          "time": 175.0,
          "text": "寄居的梦先行霸据虚无的瞳孔"
        },
        {
          "time": 182.29,
          "text": "所以它生根扎进脉搏"
        },
        {
          "time": 187.47,
          "text": "跳动的心是我可也并非全是我"
        },
        {
          "time": 194.91,
          "text": "反光之中我已背弃了谁而谁拯救我"
        },
        {
          "time": 199.53,
          "text": "我非残存的鬼魂"
        },
        {
          "time": 202.76,
          "text": "我非复仇的猎人"
        },
        {
          "time": 205.92,
          "text": "绞落星辰才能复生"
        }
      ]
    },
    {
      "title": "4 世界终了物语",
      "file": "4 世界终了物语.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "世界终了物语"
        },
        {
          "time": 4.0,
          "text": "曲：果子Hugo"
        },
        {
          "time": 6.0,
          "text": "词：大九_LN"
        },
        {
          "time": 8.0,
          "text": "调：陌生来访"
        },
        {
          "time": 10.0,
          "text": "绘：宿崎临也"
        },
        {
          "time": 12.0,
          "text": "演唱：Minus"
        },
        {
          "time": 39.86,
          "text": "坠落的 偏是最爱的玻璃杯"
        },
        {
          "time": 48.0,
          "text": "喜爱并非 永恒的恩惠"
        },
        {
          "time": 56.26,
          "text": "繁花多美 却难逃殒身枯萎"
        },
        {
          "time": 65.52,
          "text": "等冬日 满目狼狈"
        },
        {
          "time": 74.46,
          "text": "风暴已至 如何权当作无事"
        },
        {
          "time": 83.0,
          "text": "闪电破空 刺痛谁的凝视"
        },
        {
          "time": 91.6,
          "text": "欢愉恼怒 皆是王的瑕疵"
        },
