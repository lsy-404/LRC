    {
      "title": "1 风沙下的遗物",
      "file": "1 风沙下的遗物.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "风沙下的遗物"
        },
        {
          "time": 4.0,
          "text": "曲：雪人Snowman_"
        },
        {
          "time": 6.0,
          "text": "词：大九_LN"
        },
        {
          "time": 8.0,
          "text": "调：瑞安Ryan不跑调"
        },
        {
          "time": 10.0,
          "text": "绘：-白以慧-"
        },
        {
          "time": 12.0,
          "text": "演唱：苍穹.feat 星尘/海伊/诗岸"
        },
        {
          "time": 19.0,
          "text": "等待谜题成熟"
        },
        {
          "time": 22.97,
          "text": "听荒漠正孵化晨露"
        },
        {
          "time": 27.04,
          "text": "吐出蛇信的孩子"
        },
        {
          "time": 28.73,
          "text": "未免是预演中必吞的毒"
        },
        {
          "time": 35.32,
          "text": "隐藏密语暗渡"
        },
        {
          "time": 38.29,
          "text": "谁先抽选女神加护"
        },
        {
          "time": 42.43,
          "text": "熬过了万难千阻"
        },
        {
          "time": 43.9,
          "text": "是否能改写这"
        },
        {
          "time": 47.91,
          "text": "暗影之中她们的命数"
        },
        {
          "time": 51.75,
          "text": "星群闪烁低诉着启示"
        },
        {
          "time": 54.97,
          "text": "只为落单的孤羊献诗"
        },
        {
          "time": 59.48,
          "text": "沙粒间侵蚀爱憎"
        },
        {
          "time": 61.62,
          "text": "翻涌误传的正史"
        },
        {
          "time": 64.98,
          "text": "Asta Dyna（星星之力）"
        },
        {
          "time": 82.55,
          "text": "啊 四方汇至的风"
        },
        {
          "time": 88.39,
          "text": "几封谜团和欺瞒被掩盖被解开"
        },
        {
          "time": 93.88,
          "text": "旋转交织在鳞片叠合的伤感"
        },
        {
          "time": 113.21,
          "text": "啊 千年未停滞的评判"
        },
        {
          "time": 119.19,
          "text": "残垣遗骸静候谁曾璀璨曾腐坏都无憾"
        },
        {
          "time": 128.59,
          "text": "啊 宿命已缠结的未来"
        },
        {
          "time": 134.61,
          "text": "看月光散落祝福被仰慕被反叛都无奈"
        },
        {
          "time": 143.82,
          "text": "星群闪烁低诉着启示"
        },
        {
          "time": 147.64,
          "text": "只为落单的孤羊献诗"
        },
        {
          "time": 151.65,
          "text": "血脉相承独延的自私"
        },
        {
          "time": 155.11,
          "text": "誊写而成图纸"
        },
        {
          "time": 159.24,
          "text": "咬破无辜之人的意志"
        },
        {
          "time": 162.97,
          "text": "想念和回忆随泪遗失"
        },
        {
          "time": 166.92,
          "text": "水晶球倒映谁的窥视"
        },
        {
          "time": 170.57,
          "text": "粉身碎骨换来真知"
        },
        {
          "time": 174.65,
          "text": "Dia Psamma la Minauto（乘坐小船穿越荒漠）"
        },
        {
          "time": 178.15,
          "text": "Stenspecta Sominia（窥见梦境）"
        },
        {
          "time": 182.34,
          "text": "Galactasamma Horomega （奶色的海滨之沙）"
        },
        {
          "time": 186.0,
          "text": "Haiper Polisia（城市之上）"
        },
        {
          "time": 190.0,
          "text": "Locusa bio abonoma（无名之所）"
        },
        {
          "time": 193.43,
          "text": "Lumina Lapidasomana（流淌的月光如宝石未改）"
        },
        {
          "time": 197.65,
          "text": "Odoranecros Trocorota（车轮转动染上死亡香氛）"
        },
        {
          "time": 201.25,
          "text": "Seena Aheeca（和挚友一起）"
        }
      ]
    },
    {
      "title": "10 贤者之书",
      "file": "10 贤者之书.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "贤者之书"
        },
        {
          "time": 4.0,
          "text": "曲：雪人Snowman_"
        },
        {
          "time": 6.0,
          "text": "词：大九_LN"
        },
        {
          "time": 8.0,
          "text": "调：某只泽"
        },
        {
          "time": 10.0,
          "text": "绘：年糕"
        },
        {
          "time": 12.0,
          "text": "演唱：希罗多德（青溯）"
        },
        {
          "time": 27.36,
          "text": "把地图上所有新地方变老地方"
        },
        {
          "time": 34.54,
          "text": "每个人都会的魔法比秘术奇妙"
        },
        {
          "time": 41.27,
          "text": "勤加练习之后就能朋友遍布全宇宙"
        },
        {
          "time": 48.28,
          "text": "到星星的尽头都不够"
        },
        {
          "time": 54.79,
          "text": "有太多经历要和你慢慢说"
        },
        {
          "time": 71.87,
          "text": "我曾和巨龙闲话 矮人坏脾气"
        },
        {
          "time": 78.65,
          "text": "也曾悄偷拿精灵藏的美术品"
        },
        {
          "time": 85.55,
          "text": "有时刻意招些麻烦给自己"
        },
        {
          "time": 89.57,
          "text": "惹人生气让心和心的距离更贴近"
        },
        {
          "time": 123.58,
          "text": "你口中有什么离奇故事可分享"
        },
        {
          "time": 130.46,
          "text": "满上店家私酿的美酒别想逃跑"
        },
        {
          "time": 137.22,
          "text": "几十年的人生多少有几处缤纷闪耀"
        },
        {
          "time": 144.23,
          "text": "让我将它带去那远方"
        },
        {
          "time": 150.81,
          "text": "供他乡人在炉边津津乐道"
        },
        {
          "time": 205.5,
          "text": "写进游记的话无需面面俱到"
        },
        {
          "time": 212.39,
          "text": "脑袋聪明的人只记美好时光"
        },
        {
          "time": 219.15,
          "text": "把每段故事转述给新朋友"
        },
        {
          "time": 223.17,
          "text": "续上之前未饮完的酒"
        },
        {
          "time": 227.74,
          "text": "再畅聊到天亮"
        }
      ]
    },
