    {
      "title": "2 月神之呓",
      "file": "2 月神之呓.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "✤"
        },
        {
          "time": 7.22,
          "text": "月神之呓"
        },
        {
          "time": 29.66,
          "text": "-- --- --- -. --. --- -.. -.. . ... ... .-- .... .. ... .--. . .-."
        },
        {
          "time": 29.66,
          "text": "MOON GODDESS WHISPER"
        },
        {
          "time": 46.06,
          "text": "✤"
        },
        {
          "time": 48.68,
          "text": "喧闹的心是未来和过去的约定"
        },
        {
          "time": 53.03,
          "text": "不属于任何人任何地的记忆"
        },
        {
          "time": 57.07,
          "text": "因为风翻开了龟裂的旧诗集"
        },
        {
          "time": 60.59,
          "text": "尘土落笔呼喊和沉默交替"
        },
        {
          "time": 64.1,
          "text": "不停止跳动的心因爱而有交集"
        },
        {
          "time": 68.02,
          "text": "我用纸笔遮住眼睛"
        },
        {
          "time": 69.87,
          "text": "倾听你的声音"
        },
        {
          "time": 71.58,
          "text": "感受到温柔的呼吸"
        },
        {
          "time": 73.87,
          "text": "还有风尘交织的足迹"
        },
        {
          "time": 76.87,
          "text": "摇不醒的梦里"
        },
        {
          "time": 79.73,
          "text": "不停止的羁旅"
        },
        {
          "time": 81.34,
          "text": "陪我找寻人间最绚烂的风景"
        },
        {
          "time": 85.02,
          "text": "与遥远星河所编织成的谜语"
        },
        {
          "time": 88.79,
          "text": "坠落前拥抱穿梭时间的轨迹"
        },
        {
          "time": 92.45,
          "text": "摇晃酒杯染浸永不变的香气"
        },
        {
          "time": 96.45,
          "text": "太阳从你眼中升起 泪水融化冰"
        },
        {
          "time": 102.1,
          "text": "孕育生而凋零"
        },
        {
          "time": 104.03,
          "text": "留在太阳坠落之地"
        },
        {
          "time": 106.82,
          "text": "将属于你的印记"
        },
        {
          "time": 109.61,
          "text": "铺满整个记忆"
        },
        {
          "time": 116.98,
          "text": "✤"
        },
        {
          "time": 141.79,
          "text": "灵魂不管塞进怎样的容器"
        },
        {
          "time": 148.03,
          "text": "我还是我自己"
        },
        {
          "time": 149.63,
          "text": "多少偶然都没将我变成你"
        },
        {
          "time": 154.62,
          "text": "但是没关系"
        },
        {
          "time": 157.85,
          "text": "白昼会来临"
        },
        {
          "time": 160.18,
          "text": "你是晨曦陪伴黑夜的结局"
        },
        {
          "time": 164.5,
          "text": "我是我生命中最后的离去"
        },
        {
          "time": 170.05,
          "text": "无法互相代替"
        },
        {
          "time": 171.96,
          "text": "当我看遍人间最绚烂的疯狂"
        },
        {
          "time": 175.77,
          "text": "与遥远星河所不知道的彼岸"
        },
        {
          "time": 179.41,
          "text": "轮廓模糊的面庞微光里仰望"
        },
        {
          "time": 183.08,
          "text": "颤抖翅膀沾染抖不完的尘沙"
        },
        {
          "time": 187.2,
          "text": "点燃沉于海的太阳 重生的倔强"
        },
        {
          "time": 192.63,
          "text": "孵化生的渴望"
        },
        {
          "time": 194.68,
          "text": "来不及去实现来时的约定"
        },
        {
          "time": 198.75,
          "text": "目光可及"
        },
        {
          "time": 200.37,
          "text": "泪水化作星光"
        },
        {
          "time": 207.56,
          "text": "诉说尘世过往"
        },
        {
          "time": 215.64,
          "text": "直到灵魂蒸发"
        },
        {
          "time": 219.45,
          "text": "✤"
        }
      ]
    },
