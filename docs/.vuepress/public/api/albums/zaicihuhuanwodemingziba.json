"},{"time":188.76,"text":"一"},{"time":188.92,"text":"个愿望"}]},{"time":189.17,"text":"将那乱动的拥抱都抛却","words":[{"time":189.98,"text":"的拥抱都抛却"}]},{"time":190.7,"text":"将所有虚饰都撕毁"},{"time":191.92,"text":"将所有悲哀都熄灭"},{"time":193.15,"text":"再向天空放飞一只白鸽","words":[{"time":193.15,"text":"再"},{"time":193.28,"text":"向天"},{"time":193.66,"text":"空放"},{"time":194.03,"text":"飞"},{"time":194.19,"text":"一"},{"time":194.53,"text":"只"},{"time":194.73,"text":"白鸽"}]},{"time":196.09,"text":"再向天空放飞一只白鸽","words":[{"time":196.09,"text":"再"},{"time":196.11,"text":"向天"},{"time":196.47,"text":"空放"},{"time":196.83,"text":"飞"},{"time":197.19,"text":"一"},{"time":197.33,"text":"只"},{"time":197.55,"text":"白鸽"}]},{"time":198.75,"text":"再向天空放飞一只白鸽","words":[{"time":198.75,"text":"再"},{"time":198.91,"text":"向天"},{"time":199.27,"text":"空放"},{"time":199.65,"text":"飞"},{"time":199.81,"text":"一"},{"time":200.13,"text":"只"},{"time":200.33,"text":"白鸽"}]},{"time":201.21,"text":"[CREDITS]"},{"time":202.94,"text":"作词/作曲：奥莉安多"},{"time":204.91,"text":"调校/混音：卡莱米诺"}]},{"title":"9 不可言说","lyrics":[]}]}