":"已膨胀"}]},{"time":90.61,"text":"且无法再确证"},{"time":91.83,"text":"将我放逐于缄默的牢笼","words":[{"time":92.82,"text":"于缄"},{"time":93.16,"text":"默"},{"time":93.52,"text":"的牢笼"}]},{"time":94.68,"text":"我会安于这黏腻的平庸……？","words":[{"time":95.42,"text":"于"},{"time":95.6,"text":"这黏腻"},{"time":96.32,"text":"的"},{"time":96.48,"text":"平"},{"time":96.76,"text":"庸……？"}]},{"time":98.94,"text":"绝 无 可 能","words":[{"time":98.94,"text":"绝 "},{"time":99.28,"text":"无 "},{"time":99.46,"text":"可 "},{"time":99.68,"text":"能"}]},{"time":124.96,"text":"自诩冷漠的旁观者","words":[{"time":125.21,"text":"诩"},{"time":125.43,"text":"冷"},{"time":125.77,"text":"漠"},{"time":125.95,"text":"的"},{"time":126.11,"text":"旁"},{"time":126.47,"text":"观"},{"time":126.79,"text":"者"}]},{"time":127.15,"text":"维系着沉默（不作为）却逐渐","words":[{"time":127.15,"text":"维系"},{"time":127.49,"text":"着"},{"time":127.83,"text":"沉"},{"time":128.23,"text":"默（不作为）"},{"time":128.89,"text":"却逐渐"}]},{"time":129.83,"text":"孤注一掷的追随者","words":[{"time":129.83,"text":"孤"},{"time":130.85,"text":"注"},{"time":131.11,"text":"一"},{"time":131.35,"text":"掷"},{"time":131.57,"text":"的追"},{"time":132.07,"text":"随"},{"time":132.41,"text":"者"}]},{"time":132.9,"text":"却用胆怯向我奉上他底色","words":[{"time":134.13,"text":"我"},{"time":134.5,"text":"奉上他"},{"time":135.26,"text":"底"},{"time":135.42,"text":"色"}]},{"time":136.21,"text":"齿轮构铸的伪造物","words":[{"time":137.2,"text":"的"},{"time":137.34,"text":"伪"},{"time":137.72,"text":"造物"}]},{"time":138.42,"text":"不经意流出（没藏住）虚假泪珠","words":[{"time":138.42,"text":"不"},{"time":138.58,"text":"经"},{"time":138.78,"text":"意"},{"time":139.08,"text":"流"},{"time":139.44,"text":"出（没藏住）虚假"},{"time":140.86,"text":"泪"},{"time":141.02,"text":"珠"}]},{"time":141.83,"text":"锈蚀已将生机包裹","words":[{"time":142.32,"text":"已"},{"time":142.6,"text":"将"},{"time":142.78,"text":"生"},{"time":142.96,"text":"机包"},{"time":143.68,"text":"裹"}]},{"time":143.94,"text":"我只得否决这首不愿被曲解的歌","words":[{"time":144.19,"text":"只"},{"time":144.41,"text":"得"},{"time":144.56,"text":"否"},{"time":