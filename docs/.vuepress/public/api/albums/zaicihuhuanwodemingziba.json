t":"许"},{"time":66.62,"text":"愿"}]},{"time":67.08,"text":"放任绝望在头顶盘旋","words":[{"time":67.08,"text":"放任"},{"time":67.52,"text":"绝"},{"time":67.76,"text":"望"},{"time":67.98,"text":"在"},{"time":68.42,"text":"头"},{"time":68.88,"text":"顶"},{"time":69.08,"text":"盘"},{"time":69.3,"text":"旋"}]},{"time":69.76,"text":"我们困在暗红的栅间","words":[{"time":69.76,"text":"我"},{"time":70.0,"text":"们"},{"time":70.22,"text":"困"},{"time":70.42,"text":"在"},{"time":70.78,"text":"暗"},{"time":71.38,"text":"红"},{"time":71.54,"text":"的栅"},{"time":71.98,"text":"间"}]},{"time":72.12,"text":"重复呢喃深蓝的谎言","words":[{"time":72.12,"text":"重"},{"time":72.38,"text":"复呢喃"},{"time":73.28,"text":"深蓝"},{"time":74.22,"text":"的"},{"time":74.44,"text":"谎"},{"time":74.64,"text":"言"}]},{"time":154.8,"text":"（2：我们困在暗红的栅间","words":[{"time":155.09,"text":"我"},{"time":155.33,"text":"们困"},{"time":157.99,"text":"在暗红的栅间"}]},{"time":158.66,"text":"默念着誓言）"},{"time":160.59,"text":"是我甘愿陨坠","words":[{"time":160.88,"text":"我甘"},{"time":161.08,"text":"愿陨坠"}]},{"time":163.49,"text":"是你命途多舛","words":[{"time":163.78,"text":"你命途"},{"time":173.33,"text":"多"},{"time":179.26,"text":"舛"}]},{"time":180.08,"text":"2："},{"time":182.84,"text":"于是你将幕布点燃","words":[{"time":183.42,"text":"你将幕布点燃"}]},{"time":185.16,"text":"（1：幕布点燃）"},{"time":186.61,"text":"1："},{"time":186.91,"text":"静待悲悯骤鸣完"},{"time":188.94,"text":"（2：静待悲鸣落完）"}]},{"title":"3 我？爱？你？","lyrics":[{"time":18.31,"text":"爱情乐园 点缀着 玫瑰色鲜艳","words":[{"time":18.31,"text":"爱"},{"time":43.6,"text":"情"},{"time":71.25,"text":"乐"},{"time":71.43,"text":"园 "},{"time":71.85,"text":"点"},{"time":156.43,"text":"缀"},{"time":156.59,"text":"着 "},{"time":157.03,"text":"玫"},{"time":157.35,"text":"瑰"},{"time":157.45,"text":"色"},{"time":157.75,"text":"鲜"},{"time":158.21,"text":"艳"}]},{"time":158.5,"text":"旋转木马 不停歇 逃不出的怪圈","words":[{"time":158.77,"text":"转"},{"time":159.09,"text":"木"},{"time":159.24,"text":"马 "},{"time":159.68,"text":"不"},{"time":159.94,"text":"停"},{"time":160.08,"text":"歇 "},{"time":160.5,"text":"逃"},{"time":160.8,"text":"不"},{"time":160.94,"text":"出"},{"time":161.26,"text":"的"},{"time":161.42,"text":"怪"},{"time":161.66,"text":"圈"}]},{"time":162.22,"text":"眼神交叠 胡博弈 看穿对方心愿","words":[{"time":162.22,"text":"眼"},{"time":162.24,"text":"神交"},{"time":162.72,"text":"叠 胡博"},{"time":163.82,"text":"弈 "},{"time":164.0,"text":"看"},{"time":164.3,"text":"穿"},{"time":164.5,"text":"对"},{"time":164.92,"text":"方心愿"}]},{"time":165.62,"text":"先沉迷 再盛恋 后生厌","words":[{"time":165.62,"text":"先"},{"time":166.04,"text":"沉"},{"time":166.24,"text":"迷 "},{"time":166.64,"text":"再"},{"time":167.76,"text":"盛"},{"time":168.46,"text":"恋 后生厌"}]},{"time":166.3,"text":"（将完美角色扮演）"},{"time":166.83,"text":"我的笑容 太灿烂 找不到破绽"},{"time":167.74,"text":"你的指尖 紫贝箍 锁结石的誓言"},{"time":168.73,"text":"往后余生 仍不知 会与何物相伴","words":[{"time":168.86,"text":"余生 仍不知 会与何物相伴"}]},{"time":168.76,"text":"住进了 蜜糖色的狭间"},{"time":168.78,"text":"（蒙住双眼）"},{"time":168.79,"text":"你总是认为我们的故事"},{"time":168.82,"text":"像无数没有后续的童话"},{"time":168.84,"text":"我却已知晓现实写下的注"},{"time":168.87,"text":"延续爱意的魔法"},{"time":168.89,"text":"便只能静静聆听你呼吸作答"},{"time":168.91,"text":"默默揣摸下雨行进步伐"},{"time":168.94,"text":"反复试探着 再失去自我"},{"time":168.96,"text":"在灵魂栖处雕刻 于鬼首崖"},{"time":168.99,"text":"幸福的梦 不如所愿"},{"time":169.01,"text":"爱情乐园 点缀着 玫瑰色鲜艳"},{"time":169.04,"text":"旋转木马 不停歇 逃不出的怪圈"},{"time":169.07,"text":"眼神交叠 胡博弈 看穿对方杂念"},{"time":169.1,"text":"先沉迷 再盛恋 后生厌"},{"time":169.12,"text":"（将完美角色扮演）"},{"time":169.14,"text":"我的身体 和灵魂 都残缺不堪","words":[{"time":169.14,"text":"我"},{"time":169.32,"text":"的"},{"time":169.56,"text":"身"},{"time":169.72,"text":"体 "},{"time":169.88,"text":"和"},{"time":170.16,"text":"灵"},{"time":170.62,"text":"魂 "},{"time":171.06,"text":"都"},{"time":171.46,"text":"残缺"},{"time":171.82,"text":"不堪"}]},{"time":172.55,"text":"怎来资格 染你的 颜色填充完满","words":[{"time":172.82,"text":"来"},{"time":173.1,"text":"资"},{"time":173.12,"text":"格 染你的 "},{"time":174.58,"text":"颜"},{"time":174.86,"text":"色填充"},{"time":175.46,"text":"完满"}]},{"time":176.18,"text":"你在悬来 我呼救 直到信任倾塌","words":[{"time":176.18,"text":"你"},{"time":176.32,"text":"在悬来 "},{"time":177.22,"text":"我呼"},{"time":177.62,"text":"救 直"},{"time":178.38,"text":"到信"},{"time":178.72,"text":"任倾塌"}]},{"time":179.66,"text":"悲剧的情节再度泛滥","words":[{"time":179.66,"text":"悲"},{"time":180.12,"text":"剧"},{"time":180.3,"text":"的"},{"time":180.66,"text":"情节"},{"time":181.18,"text":"再度泛滥"}]},{"time":183.18,"text":"有人贪心 在嘴边 总挂着爱情","words":[{"time":183.18,"text":"有"},{"time":183.38,"text":"人"},{"time":183.64,"text":"贪"},{"time":183.8,"text":"心 "},{"time":184.24,"text":"在嘴"},{"time":184.68,"text":"边 总挂"},{"time":185.54,"text":"着"},{"time":185.98,"text":"爱情"}]},{"time":186.7,"text":"有人哭泣 镜面前 刻烙印着自己","words":[{"time":186.7,"text":"有"},{"time":186.88,"text":"人哭泣 镜面前 刻烙"},{"time":189.5,"text":"印着"},{"time":189.76,"text":"自"},{"time":189.93,"text":"己"}]},{"time":190.22,"text":"本该付出的关系 终绕自私自利","words":[{"time":190.22,"text":"本该"},{"time":190.66,"text":"付"},{"time":190.79,"text":"出"},{"time":191.25,"text":"的关系 终绕自私"},{"time":193.01,"text":"自"},{"time":193.51,"text":"利"}]},{"time":193.69,"text":"失去“我” 没有“爱” 不需“你”","words":[{"time":193.69,"text":"失去“我” "},{"time":194.79,"text":"没"},{"time":195.03,"text":"有“"},{"time":195.65,"text":"爱” 不需“你”"}]},{"time":195.63,"text":"（将虚假爱语抛弃）"},{"time":197.14,"text":"告别乌云 擦干泪 披一身轻盈","words":[{"time":197.41,"text":"别"},{"time":197.73,"text":"乌云 "},{"time":198.45,"text":"擦干"},{"time":198.73,"text":"泪 披一身轻"},{"time":200.53,"text":"盈"}]},{"time":200.79,"text":"你的闪耀 不需要 谁的爱来证明","words":[{"time":200.79,"text":"你"},{"time":200.93,"text":"的闪耀 "},{"time":201.79,"text":"不"},{"time":202.07,"text":"需"},{"time":202.23,"text":"要 谁"},{"time":203.41,"text":"的爱来"},{"time":203.53,"text":"证"},{"time":203.88,"text":"明"}]},{"time":204.28,"text":"踏上旅程 去寻 属于你的安宁","words":[{"time":204.28,"text":"踏"},{"time":204.4,"text":"上旅程 去寻 属于"},{"time":206.68,"text":"你"},{"time":206.92,"text":"的"},{"time":207.1,"text":"安宁"}]},{"time":207.84,"text":"爱便会 站在那里等你","words":[{"time":207.84,"text":"爱便"},{"time":208.38,"text":"会 "},{"time":208.8,"text":"站"},{"time":209.28,"text":"在"},{"time":209.3,"text":"那"},{"time":209.56,"text":"里"},{"time":209.72,"text":"等"},{"time":210.02,"text":"你"}]},{"time":211.28,"text":"终解出“我爱你的”意义","words":[{"time":211.28,"text":"终解"},{"time":211.86,"text":"出“"},{"time":212.36,"text":"我"},{"time":212.66,"text":"爱"},{"time":212.8,"text":"你的”意义"}]}]},{"title":"4 我生于死去之日","lyrics":[{"time":86.58,"text":"若自甘割舍长眠权利","words":[{"time":86.58,"text":"若自"},{"time":87.1,"text":"甘割舍长"},{"time":88.16,"text":"眠"},{"time":88.36,"text":"权"},{"time":88.74,"text":"利"}]},{"time":89.77,"text":"意料中的幸福是否也会如期降临","words":[{"time":89.77,"text":"意"},{"time":90.01,"text":"料"},{"time":90.25,"text":"中"},{"time":90.53,"text":"的"},{"time":90.73,"text":"幸"},{"time":91.05,"text":"福"},{"time":91.45,"text":"是"},{"time":91.61,"text":"否"},{"time":91.83,"text":"也"},{"time":92.09,"text":"会如期"},{"time":92.87,"text":"降"},{"time":93.19,"text":"临"}]},{"time":93.93,"text":"可爱人都离去 承载超负荷的记忆","words":[{"time":93.93,"text":"可"},{"time":94.51,"text":"爱"},{"time":94.73,"text":"人"},{"time":95.29,"text":"都"},{"time":95.79,"text":"离"},{"time":96.03,"text":"去 "},{"time":96.55,"text":"承载"},{"time":96.83,"text":"超负"},{"time":97.11,"text":"荷"},{"time":97.39,"text":"的"},{"time":97.61,"text":"记"},{"time":97.79,"text":"忆"}]},{"time":98.41,"text":"独留下被变革排除在外的孤寂","words":[{"time":98.41,"text":"独"},{"time":98.71,"text":"留"},{"time":98.91,"text":"下"},{"time":99.23,"text":"被"},{"time":99.5,"text":"变"},{"time":99.73,"text":"革"},{"time":99.95,"text":"排除"},{"time":100.56,"text":"在"},{"time":100.68,"text":"外"},{"time":100.76,"text":"的"},{"time":100.84,"text":"孤"},{"time":102.08,"text":"寂"}]},{"time":102.59,"text":"人们总在劳碌中争夺片刻的安宁","words":[{"time":103.16,"text":"总在劳碌中争"},{"time":105.0,"text":"夺"},{"time":105.24,"text":"片刻"},{"time":105.8,"text":"的安宁"}]},{"time":106.77,"text":"盛放后世寻求独享散场的寂静（循环更替）","words":[{"time":107.34,"text":"后世寻求"},{"time":108.42,"text":"独享"},{"time":109.2,"text":"散"},{"time":109.44,"text":"场的寂静（循环更替）"}]},{"time":111.44,"text":"死亡正在颂唱万物的真名","words":[{"time":113.15,"text":"万"},{"time":113.45,"text":"物"},{"time":113.69,"text":"的"},{"time":114.19,"text":"真"},{"time":114.75,"text":"名"}]},{"time":115.03,"text":"侧耳倾听（倾听生命）礼赞的回音","words":[{"time":115.51,"text":"倾"},{"time":115.77,"text":"听（倾听生命）礼赞"},{"time":117.63,"text":"的"},{"time":117.91,"text":"回音"}]},{"time":123.73,"text":"新月升空艳阳沉湎 昼夜轮转化成四季","words":[{"time":124.01,"text":"月"},{"time":124.17,"text":"升空艳阳"},{"time":124.95,"text":"沉湎 昼"},{"time":126.07,"text":"夜轮转化成"},{"time":127.07,"text":"四"},{"time":127.35,"text":"季"}]},{"time":127.57,"text":"百草尽数枯萎后觅得一线生机","words":[{"time":127.57,"text":"百"},{"time":127.85,"text":"草尽"},{"time":128.37,"text":"数枯萎后觅得"},{"time":130.28,"text":"一"},{"time":130.5,"text":"线"},{"time":131.02,"text":"生机"}]},{"time":131.95,"text":"若痛还在 戏谑地留下了 历史的毛皮","words":[{"time":133.38,"text":"谑地留"},{"time":134.06,"text":"下"},{"time":134.48,"text":"了 "},{"time":134.74,"text":"历"},{"time":134.92,"text":"史的"},{"time":135.24,"text":"毛"},{"time":135.52,"text":"皮"}]},{"time":136.06,"text":"我刺穿血肉只为将罪书页写到底","words":[{"time":136.06,"text":"我"},{"time":136.32,"text":"刺穿"},{"time":136.8,"text":"血肉"},{"time":137.36,"text":"只为"},{"time":137.74,"text":"将罪"},{"time":138.38,"text":"书"},{"time":138.7,"text":"页"},{"time":138.92,"text":"写"},{"time":139.48,"text":"到"},{"time":139.76,"text":"底"}]},{"time":140.3,"text":"我的生命倾在死去之日攥紧遗言","words":[{"time":140.3,"text":"我"},{"time":140.54,"text":"的"},{"time":140.76,"text":"生"},{"time":141.06,"text":"命倾"},{"time":141.59,"text":"在"},{"time":141.81,"text":"死"},{"time":141.97,"text":"去"},{"time":142.37,"text":"之"},{"time":142.63,"text":"日攥紧遗言"}]}]}]}