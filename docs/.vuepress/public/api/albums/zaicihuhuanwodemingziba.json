]},{"time":190.22,"text":"本该停止的关系 终结自私自利","words":[{"time":190.22,"text":"本该停止"},{"time":191.25,"text":"的关系 终结自私"},{"time":192.87,"text":"自"},{"time":193.51,"text":"利"}]},{"time":193.69,"text":"失去“我” 没有“爱” 不需“你”","words":[{"time":193.69,"text":"失去“我” "},{"time":194.79,"text":"没"},{"time":195.03,"text":"有“"},{"time":195.65,"text":"爱” "},{"time":201.79,"text":"不"},{"time":202.07,"text":"需“你”"}]},{"time":202.35,"text":"（将虚假爱语抽弃）","words":[{"time":203.12,"text":"爱语抽弃）"}]},{"time":202.73,"text":"告别乌云 擦干泪 抛一身轻盈"},{"time":203.39,"text":"你的闪耀 不需畏 谁的爱来证明","words":[{"time":203.41,"text":"的闪耀 不需畏 谁的爱来"},{"time":203.53,"text":"证"},{"time":203.88,"text":"明"}]},{"time":204.28,"text":"踏上旅程 去追寻 属于你的安宁","words":[{"time":204.28,"text":"踏"},{"time":204.4,"text":"上旅程 去追寻 属于"},{"time":206.68,"text":"你"},{"time":206.92,"text":"的"},{"time":207.1,"text":"安宁"}]},{"time":207.84,"text":"爱便会 站在那里等你","words":[{"time":207.84,"text":"爱便"},{"time":208.38,"text":"会 "},{"time":208.8,"text":"站"},{"time":209.28,"text":"在"},{"time":209.3,"text":"那"},{"time":209.56,"text":"里"},{"time":209.72,"text":"等"},{"time":210.02,"text":"你"}]},{"time":211.28,"text":"终解出“我爱你”的意义","words":[{"time":211.28,"text":"终解"},{"time":211.86,"text":"出“"},{"time":212.36,"text":"我"},{"time":212.66,"text":"爱"},{"time":212.8,"text":"你”的意义"}]}]},{"title":"5 若自甘剥夺长眠权利","lyrics":[{"time":86.58,"text":"若自甘剥夺长眠权利","words":[{"time":86.58,"text":"若自"},{"time":87.1,"text":"甘剥夺长"},{"time":88.16,"text":"眠"},{"time":88.36,"text":"权"},{"time":88.74,"text":"利"}]},{"time":89.77,"text":"意料中的幸福是否也会如期降临","words":[{"time":89.77,"text":"意"},{"time":90.01,"text":"料"},{"time":90.25,"text":"中"},{"time":90.53,"text":"的"},{"time":90.73,"text":"幸"},{"time":91.05,"text":"福"},{"time":91.45,"text":"是"},{"time":91.61,"text":"否"},{"time":91.83,"text":"也"},{"time":92.09,"text":"会如期"},{"time":92.87,"text":"降"},{"time":93.19,"text":"临"}]},{"time":93.93,"text":"可是爱人都离去 承载超负荷的记忆","words":[{"time":93.93,"text":"可"},{"time":94.19,"text":"是"},{"time":94.51,"text":"爱"}