"},{"time":56.43,"text":"宁"},{"time":56.63,"text":"静"}]},{"time":57.67,"text":"却执着于保持清醒","words":[{"time":57.67,"text":"却"},{"time":57.88,"text":"执着"},{"time":58.31,"text":"于"},{"time":58.73,"text":"保"},{"time":59.12,"text":"持"},{"time":59.52,"text":"清"},{"time":59.94,"text":"醒"}]},{"time":60.98,"text":"是种命 是种颓疾","words":[{"time":60.98,"text":"是"},{"time":61.2,"text":"种"},{"time":61.66,"text":"命 "},{"time":62.66,"text":"是"},{"time":62.86,"text":"种颓"},{"time":63.32,"text":"疾"}]},{"time":64.18,"text":"是药可医","words":[{"time":64.56,"text":"药"},{"time":64.96,"text":"可"},{"time":66.62,"text":"医"}]},{"time":67.7,"text":"或许不幸 或许恐惧","words":[{"time":67.7,"text":"或"},{"time":67.86,"text":"许"},{"time":68.1,"text":"不"},{"time":68.28,"text":"幸 "},{"time":69.24,"text":"或"},{"time":69.52,"text":"许恐"},{"time":69.96,"text":"惧"}]},{"time":70.54,"text":"或许那次该是结局","words":[{"time":72.45,"text":"是"},{"time":72.73,"text":"结局"}]},{"time":74.19,"text":"用封存的话语 痛苦的疑问句","words":[{"time":74.57,"text":"封"},{"time":74.77,"text":"存的"},{"time":75.21,"text":"话"},{"time":75.43,"text":"语 "},{"time":76.03,"text":"痛"},{"time":76.25,"text":"苦"},{"time":76.47,"text":"的"},{"time":76.67,"text":"疑"},{"time":76.87,"text":"问"},{"time":77.05,"text":"句"}]},{"time":78.64,"text":"可就此告别旅程"},{"time":81.23,"text":"当被重新厌弃时","words":[{"time":81.23,"text":"当"},{"time":81.43,"text":"被"},{"time":81.61,"text":"重"},{"time":82.45,"text":"新"},{"time":83.29,"text":"厌弃"},{"time":83.91,"text":"时"}]},{"time":84.55,"text":"我却知解释不了许多","words":[{"time":84.55,"text":"我"},{"time":84.75,"text":"却知解"},{"time":84.95,"text":"释不"},{"time":85.61,"text":"了许"},{"time":86.66,"text":"多"}]},{"time":87.72,"text":"从自庸俗中解脱","words":[{"time":88.1,"text":"自庸"},{"time":89.12,"text":"俗"},{"time":89.96,"text":"中"},{"time":90.4,"text":"解"},{"time":90.6,"text":"脱"}]},{"time":90.98,"text":"但仍有人议论我的罪过","words":[{"time":91.24,"text":"有人议"},{"time":92.28,"text":"论"},{"time":92.5,"text":"我"},{"time":92.92,"text":"的"},{"time":93.22,"text":"罪"},{"time":93.58,"t