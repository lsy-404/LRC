,{"time":98.91,"text":"下"},{"time":99.23,"text":"被"},{"time":99.5,"text":"变"},{"time":99.73,"text":"革"},{"time":99.95,"text":"排除"},{"time":100.56,"text":"在"},{"time":100.68,"text":"外"},{"time":100.76,"text":"的"},{"time":100.84,"text":"孤"},{"time":102.08,"text":"寂"}]},{"time":102.61,"text":"人们总在劳碌中争夺片刻的安宁","words":[{"time":103.16,"text":"总在劳碌中争"},{"time":105.0,"text":"夺"},{"time":105.24,"text":"片刻"},{"time":105.8,"text":"的安宁"}]},{"time":106.79,"text":"盛放后世寻求独享散场的寂静（循环更替）","words":[{"time":107.34,"text":"后世寻求"},{"time":108.42,"text":"独享"},{"time":109.2,"text":"散"},{"time":109.44,"text":"场的寂静（循环更替）"}]},{"time":111.49,"text":"死亡正在颂唱万物的真名","words":[{"time":113.15,"text":"万"},{"time":113.45,"text":"物"},{"time":113.69,"text":"的"},{"time":114.19,"text":"真"},{"time":114.75,"text":"名"}]},{"time":115.02,"text":"侧耳倾听（倾听生命）礼赞的回音","words":[{"time":115.51,"text":"倾"},{"time":115.77,"text":"听（倾听生命）礼赞"},{"time":117.63,"text":"的"},{"time":117.91,"text":"回音"}]},{"time":123.73,"text":"新月升空而阳沉溺 昼夜轮转扩成四季","words":[{"time":124.01,"text":"月"},{"time":124.17,"text":"升空而阳"},{"time":124.95,"text":"沉"},{"time":125.29,"text":"溺 昼"},{"time":126.07,"text":"夜轮转扩成"},{"time":127.07,"text":"四"},{"time":127.35,"text":"季"}]},{"time":127.57,"text":"百草尽数枯萎后觅得一线生机","words":[{"time":127.57,"text":"百"},{"time":127.85,"text":"草尽"},{"time":128.37,"text":"数枯萎后觅得"},{"time":130.28,"text":"一"},{"time":130.5,"text":"线"},{"time":131.02,"text":"生机"}]},{"time":131.98,"text":"若命运 戏谑地留下了 历史的毛皮","words":[{"time":132.26,"text":"命"},{"time":132.64,"text":"运 戏"},{"time":133.38,"text":"谑地留"},{"time":134.06,"text":"下"},{"time":134.48,"text":"了 "},{"time":134.74,"text":"历"},{"time":134.92,"text":"史的"},{"time":135.24,"text":"毛"},{"time":135.52,"text":"皮"}]},{"time":136.06,"text":"我刺穿血肉只为将那书页写到底","words":[{"time":136.06,"text":"我"},{"time":136.32,"text":"刺穿"},{"time":136.8,"text":"血肉"},{"time":137.36,"text":"只为"},{"time":137.74,"text":"将"},{"time":138.18,"text":"那"},{"time":138.38,"text":"书"},{"time":138.7,"text":"页"},{"time":1