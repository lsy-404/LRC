          "text": "兴师于子矛戈"
        },
        {
          "time": 61.15,
          "text": "六国毕一便终将过往 的铭刻"
        },
        {
          "time": 66.63,
          "text": "田垄上便又能听那"
        },
        {
          "time": 69.21,
          "text": "蒹葭及忘我良多"
        },
        {
          "time": 73.17,
          "text": "初时 年少登王座"
        },
        {
          "time": 75.42,
          "text": "平几端乱祸"
        },
        {
          "time": 77.01,
          "text": "自此天地便开阔"
        },
        {
          "time": 80.09,
          "text": "赢六国门客"
        },
        {
          "time": 81.95,
          "text": "征旗猎猎 残阳如火"
        },
        {
          "time": 86.38,
          "text": "到东南北把所向皆破"
        },
        {
          "time": 89.48,
          "text": "笑松柏歌"
        },
        {
          "time": 92.68,
          "text": "自三皇五帝的辉煌山河"
        },
        {
          "time": 95.95,
          "text": "天下一国"
        },
        {
          "time": 125.47,
          "text": "望见影绰绰胡马在"
        },
        {
          "time": 127.75,
          "text": "北风中婆娑"
        },
        {
          "time": 131.11,
          "text": "征夫在边野摇戈岁月 多蹉跎"
        },
        {
          "time": 136.55,
          "text": "夷平多少艰难与险恶"
        },
        {
          "time": 139.71,
          "text": "风急云寒铸成巨龙卧"
        },
        {
          "time": 143.27,
          "text": "一砖一石苦厄"
        },
        {
          "time": 145.56,
          "text": "惟愿各得其所"
        },
        {
          "time": 150.23,
          "text": "便把过去不曾可得的"
        },
        {
          "time": 152.65,
          "text": "一一渐次撷获"
        },
        {
          "time": 156.73,
          "text": "法度量衡笔下风云何须太多"
        },
        {
          "time": 162.21,
          "text": "文伦一统与子同仇的方称泱泱大国"
        },
        {
          "time": 168.79,
          "text": "易水风曾吹悲歌"
        },
        {
          "time": 171.22,
          "text": "击筑也听得"
        },
        {
          "time": 172.75,
          "text": "迷离博浪卷风波"
        },
        {
          "time": 175.8,
          "text": "对月举杯踱"
        },
        {
          "time": 177.54,
          "text": "苦心 或许亦有偏颇"
        },
        {
          "time": 182.32,
          "text": "说什么天河"
        },
        {
          "time": 183.92,
          "text": "守心荧惑 得谁知我"
        },
        {
          "time": 188.67,
          "text": "巡游罢天下 知各得阡陌 勒功铭刻"
        },
        {
          "time": 195.13,
          "text": "风轻雨歇时 烛光正落寞"
        },
        {
          "time": 198.26,
          "text": "似岁月苍凉一抹"
        },
        {
          "time": 201.47,
          "text": "转眼的闪烁"
        },
        {
          "time": 203.1,
          "text": "作一生浮沉苦跋涉"
        },
        {
          "time": 207.85,
          "text": "比缥缈传说 却又不得"
        },
        {
          "time": 211.0,
          "text": "万世山河"
        },
        {
          "time": 214.28,
          "text": "长夜中回望 心中又何憾"
        },
        {
          "time": 217.42,
          "text": "任后人说"
        }
      ]
    },
    {
      "title": "09 如见青山",
      "file": "09 如见青山.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "09 如见青山"
        },
        {
          "time": 1.0,
          "text": "作词 : 冉语优"
        },
        {
          "time": 3.96,
          "text": "作曲 : 潮汐-tide"
        },
        {
          "time": 5.93,
          "text": "编曲：悠悠酱"
        },
        {
          "time": 7.93,
          "text": "笛子：囚牛"
        },
        {
          "time": 9.68,
          "text": "演唱：心华"
        },
        {
          "time": 11.18,
          "text": "调教：花儿不哭"
        },
        {
          "time": 13.93,
          "text": "曲绘：白邬東"
        },
        {
          "time": 15.93,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 17.93,
          "text": "万里无云天将晚，夜航行船"
        },
        {
          "time": 21.93,
          "text": "把酒共与新相识，三杯两盏"
        },
        {
          "time": 25.68,
          "text": "耳畔风雪声，放下帘毡"
        },
        {
          "time": 30.18,
          "text": "此间便与人间无关"
        },
        {
          "time": 33.93,
          "text": "少年大才赴京华，方及弱冠"
        },
        {
          "time": 37.93,
          "text": "一袭僧袍返庐山，经年修禅"
        },
        {
          "time": 41.68,
          "text": "意得尽心满，好不恬然"
        },
        {
          "time": 46.18,
          "text": "万物山川皆可做清谈"
        },
        {
          "time": 51.43,
          "text": "谁将清茶一杯都饮完"
        },
        {
          "time": 55.43,
          "text": "几声长笑轻摇手中扇"
        },
        {
          "time": 59.43,
          "text": "“何许人，妄说禅"
        },
        {
          "time": 61.43,
          "text": "物与我，是两般"
        },
        {
          "time": 63.43,
          "text": "竟说见你好似见青山！”"
        },
        {
          "time": 67.18,
          "text": "谁在案前炉中点沉檀"
        },
        {
          "time": 71.43,
          "text": "会心而笑一语多坦然"
        },
        {
          "time": 75.43,
          "text": "“真痴儿，不懂禅"
        },
        {
          "time": 77.68,
          "text": "物与我，皆为幻"
        },
        {
          "time": 79.68,
          "text": "见我岂不犹如见青山？”"
        },
        {
          "time": 99.93,
          "text": "少年早闻有大才，方及弱冠"
        },
        {
          "time": 103.93,
          "text": "一袭僧袍出尘外，经年修禅"
        },
        {
          "time": 107.93,
          "text": "是意得心满，清风两岸"
        },
        {
          "time": 112.18,
          "text": "嬉笑怒骂皆可清谈"
        },
        {
          "time": 115.93,
          "text": "诗书满怀兴正酣，高下难断"
        },
        {
          "time": 119.68,
          "text": "嘴上文章余一半，尚未说完"
        },
        {
          "time": 123.68,
          "text": "转眼见小舟，却已放缆"
        },
        {
          "time": 127.93,
          "text": "千里快风送我过津关"
        },
        {
          "time": 133.18,
          "text": "谁怕人生到处相逢难"
        },
        {
          "time": 137.18,
          "text": "知己一程何必多善感"
        },
        {
          "time": 141.43,
          "text": "我上京，试诗才"
        },
        {
          "time": 143.43,
          "text": "你归去，返庐山"
        },
        {
          "time": 145.43,
          "text": "心中无虑方是真超然"
        },
        {
          "time": 149.43,
          "text": "来日放榜簪花在春衫"
        },
        {
          "time": 153.18,
          "text": "一朝等闲驰马到江南"
        },
        {
          "time": 157.43,
          "text": "访名寺，涉长川"
        },
        {
          "time": 159.43,
          "text": "人间味，做清欢"
        },
        {
          "time": 161.43,
          "text": "不妨再来寻你说说禅"
        },
        {
          "time": 165.43,
          "text": "明朝京华多少人攘攘"
        },
        {
          "time": 169.43,
          "text": "浮沉如海只是无波澜"
        },
        {
          "time": 173.43,
          "text": "役于物，得失患"
        },
        {
          "time": 175.43,
          "text": "役于形，不超然"
        },
        {
          "time": 177.68,
          "text": "所遇即安到处无牵绊"
        },
        {
          "time": 181.18,
          "text": "来日放榜簪花在春衫"
        },
        {
          "time": 185.18,
          "text": "一朝等闲驰马到江南"
        },
        {
          "time": 189.18,
          "text": "访名寺，涉长川"
        },
        {
          "time": 191.43,
          "text": "人间味，做清欢"
        },
        {
          "time": 193.43,
          "text": "不妨再来寻你说说禅"
        }
      ]
