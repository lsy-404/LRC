  "songs": [
    {
      "title": "01 多情岸",
      "file": "01 多情岸.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "01 多情岸"
        },
        {
          "time": 3.0,
          "text": "编曲：Mzf小慕"
        },
        {
          "time": 9.28,
          "text": "演唱：洛天依"
        },
        {
          "time": 12.0,
          "text": "调教：花儿不哭"
        },
        {
          "time": 15.0,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 18.0,
          "text": "二胡：辰小弦"
        },
        {
          "time": 21.0,
          "text": "笛箫：囚牛"
        },
        {
          "time": 46.49,
          "text": "某年某月某日天欲晚，我自饮马长川，"
        },
        {
          "time": 51.53,
          "text": "暮色恰如诗中的阑珊。"
        },
        {
          "time": 56.65,
          "text": "忽我身着哪个千年前，落魄王侯的衣冠，"
        },
        {
          "time": 61.76,
          "text": "放逐到，这片蘅皋之岸。"
        },
        {
          "time": 66.91,
          "text": "那些去国怀乡的伤感，早已与我无关，"
        },
        {
          "time": 72.01,
          "text": "日月只为有情人流转。"
        },
        {
          "time": 77.17,
          "text": "天地冥冥之中静待谁，如约而至得悄然，"
        },
        {
          "time": 82.45,
          "text": "只与我，相逢洛水之岸。"
        },
        {
          "time": 87.41,
          "text": "此刻有月色与飞雪在侧，"
        },
        {
          "time": 92.63,
          "text": "彼岸正神光离合，"
        },
        {
          "time": 97.69,
          "text": "此刻谁若微步凌波，"
        },
        {
          "time": 102.39,
          "text": "这翩如惊鸿的过客，求而不得。"
        },
        {
          "time": 109.7,
          "text": "于是潜渊而唱，又若还若往，"
        },
        {
          "time": 115.18,
          "text": "有意解佩以长寄沧浪。"
        },
        {
          "time": 120.1,
          "text": "我却轻舟启航，才敢落笔痴狂，"
        },
        {
          "time": 125.58,
          "text": "留下这传奇，在孤枕上流芳。"
        },
        {
          "time": 164.62,
          "text": "那时众生弃我于尘寰，早已宠辱无关，"
        },
        {
          "time": 169.69,
          "text": "只剩相思在余生辗转。"
        },
        {
          "time": 174.91,
          "text": "明明似曾相识的顾盼，却如初见般璀璨，"
        },
        {
          "time": 180.13,
          "text": "定与我，重逢洛水之畔。"
        },
        {
          "time": 185.16,
          "text": "此刻有月色与飞雪在侧，"
        },
        {
          "time": 190.31,
          "text": "彼岸正神光离合，"
        },
        {
          "time": 195.42,
          "text": "此刻谁若微步凌波，"
        },
        {
          "time": 200.09,
          "text": "这翩如惊鸿的过客，求而不得。"
        },
        {
          "time": 207.58,
          "text": "于是潜渊而唱，又若还若往，"
        },
        {
          "time": 212.89,
          "text": "有意解佩以长寄沧浪。"
        },
        {
          "time": 217.7,
          "text": "我却轻舟启航，才敢落笔痴狂，"
        },
        {
          "time": 223.24,
          "text": "留下这传奇，在孤枕上流芳。"
        },
        {
          "time": 228.85,
          "text": "黄初三年秋，天欲晚，我似曾打马过长川，"
        },
        {
          "time": 233.97,
          "text": "邂逅如诗中波光聚散。"
        },
        {
          "time": 239.1,
          "text": "忽我梦醒间皆了然，那个落魄王侯的悲欢，"
        },
        {
          "time": 244.24,
          "text": "渡不过，多情之岸。"
        },
        {
          "time": 248.5,
          "text": "于是踟蹰彷徨，又溯游而上，"
        },
        {
          "time": 254.14,
          "text": "只怕无佳期永慕相望。"
        },
        {
          "time": 258.82,
          "text": "我待曙色沾霜，才知南柯一场，"
        },
        {
          "time": 264.31,
          "text": "留下这传奇，在水一方流浪。"
        }
      ]
    },
    {
      "title": "02 洛阳怀",
      "file": "02 洛阳怀.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "02 洛阳怀"
        },
        {
          "time": 3.75,
          "text": "作曲：tide-潮汐"
        },
        {
          "time": 6.1,
          "text": "编曲/和声编写：PoKeR"
        },
        {
          "time": 7.83,
          "text": "作词：玄天"
        },
        {
          "time": 9.6,
          "text": "演唱：洛天依"
        },
        {
          "time": 11.3,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 13.05,
          "text": "曲绘：白川柏川"
        },
        {
          "time": 14.79,
          "text": "调教：花儿不哭"
        },
        {
          "time": 16.51,
          "text": "二胡：辰小弦"
        },
        {
          "time": 18.25,
          "text": "笛子：囚牛"
        },
        {
          "time": 45.05,
          "text": "风吹起思绪向远方 倾城烟霞芬芳"
        },
        {
          "time": 51.97,
          "text": "牡丹放香风都烂漫 晕开诗酒华章"
        },
        {
          "time": 58.84,
          "text": "倚清风白云作衣裳 玉剑骏马轻狂"
        },
        {
          "time": 64.36,
          "text": "意气共相欢 便把酒诉衷肠"
        },
        {
          "time": 72.9,
          "text": "立壮志凌云泰山上 会绝顶瞰八荒"
        },
        {
          "time": 79.73,
          "text": "看遍了人间事茫茫 笔下热泪两行"
        },
        {
          "time": 86.61,
          "text": "一见倾心醉酒佯狂 管他世人毁谤"
        },
        {
          "time": 92.19,
          "text": "一城繁花浪漫 知交对饮欢畅"
        },
        {
          "time": 98.72,
          "text": "少年意气激扬 山河饱览快意引吭"
        },
        {
          "time": 102.78,
          "text": "便策马绚烂好风光"
        },
        {
          "time": 105.8,
          "text": "历遍人世俯仰 冠盖满京华 报守土开疆"
        },
        {
          "time": 112.76,
          "text": "还把杯酒斟满 笔下龙蛇万千气象"
        },
        {
          "time": 116.57,
          "text": "豪言一吐锦绣盛唐"
        },
        {
          "time": 120.21,
          "text": "自酌酒在草堂 曾举杯会洛阳"
        },
        {
          "time": 142.39,
          "text": "玉墀（chi）前不改性轻狂 散了千金何妨"
        },
        {
          "time": 148.94,
          "text": "长携手暖风游人唱 再乘舟随流荡"
        },
        {
          "time": 155.99,
          "text": "万里悲秋共拥烛光 愿致君尧舜上"
        },
        {
          "time": 161.44,
          "text": "安得广厦千万 天下寒士相欢"
        },
        {
          "time": 168.08,
          "text": "少年意气激扬 山河饱览快意引吭"
        },
        {
          "time": 171.93,
          "text": "便策马绚烂好风光"
        },
        {
          "time": 175.13,
          "text": "阶前明月如霜 自举杯兴起 便对影成双"
        },
        {
          "time": 181.99,
          "text": "还把杯酒斟满 笔下龙蛇万千气象"
        },
        {
          "time": 185.86,
          "text": "豪言一吐锦绣盛唐"
        },
        {
          "time": 189.5,
          "text": "折一支作遥想 记当年牡丹香"
        }
      ]
    },
