        },
        {
          "time": 44.71,
          "text": "阵云昏 逝水黯 怕触目霜雪衣冠"
        },
        {
          "time": 51.22,
          "text": "清肃容颜 炽烈肝胆 心决然"
        },
        {
          "time": 59.37,
          "text": "风萧萧兮易水寒"
        },
        {
          "time": 66.36,
          "text": "壮士一去不复还"
        },
        {
          "time": 72.05,
          "text": "陈年酒 尚余半 添入往事尝浓淡"
        },
        {
          "time": 78.78,
          "text": "敬你我俱能从容踏狂澜"
        },
        {
          "time": 86.2,
          "text": "最怕是独活 最狠是回忆"
        },
        {
          "time": 89.29,
          "text": "当年燕市击筑扬歌在耳际"
        },
        {
          "time": 92.86,
          "text": "倾十分孤勇 步无归命局"
        },
        {
          "time": 96.16,
          "text": "明朝少年邀同醉 白头人间何处你"
        },
        {
          "time": 102.9,
          "text": "浮生旧事多不值一提 除却曾得知音你"
        },
        {
          "time": 109.52,
          "text": "浩然江海与苍茫天地 都将替我铭记"
        },
        {
          "time": 116.6,
          "text": "光阴坦荡若飞鸿雪泥 采撷传说里的相遇别离"
        },
        {
          "time": 123.5,
          "text": "珍藏在西风古道清明雨"
        },
        {
          "time": 131.34,
          "text": "风萧兮 易水寒 壮士去 不复还"
        },
        {
          "time": 134.89,
          "text": "风萧萧兮易水寒"
        },
        {
          "time": 138.3,
          "text": "风萧兮 易水寒 壮士去 不复还"
        },
        {
          "time": 141.79,
