        },
        {
          "time": 54.23,
          "text": "霓裳羽衣盛世风月"
        },
        {
          "time": 57.81,
          "text": "长生殿上结发誓约"
        },
        {
          "time": 61.96,
          "text": "生生世世不离别"
        },
        {
          "time": 65.31,
          "text": "或许情不知所起才称绝妙"
        },
        {
          "time": 69.19,
          "text": "免去忖度掂量生烦恼"
        },
        {
          "time": 73.47,
          "text": "能一往而深倾尽全力去拥抱"
        },
        {
          "time": 80.74,
          "text": "时光几曾仓促将红颜催老"
        },
        {
          "time": 85.22,
          "text": "它只是吻过簪花鬓角"
        },
        {
          "time": 88.9,
          "text": "婉转成一段又一段传世歌谣"
        },
        {
          "time": 95.75,
          "text": "我想和你相恋最凡俗人间"
        },
        {
          "time": 99.35,
          "text": "邀来春花与秋月烹成炊烟"
        },
        {
          "time": 103.18,
          "text": "荔枝青瓷盘 微雨紫竹伞"
        },
        {
          "time": 107.03,
          "text": "每一程山水都能与你相伴"
        },
        {
          "time": 111.32,
          "text": "可偏偏我们置身万众眉眼"
        },
        {
          "time": 114.89,
          "text": "喜怒哀乐都惹得他人褒贬"
        },
        {
          "time": 118.73,
          "text": "皓月映长川 相思在长安"
        },
        {
          "time": 122.83,
          "text": "纵然是如画江山 有你才圆满"
        },
        {
          "time": 142.37,
          "text": "或许情不知所起才称绝妙"
        },
        {
          "time": 146.7,
          "text": "免去忖度掂量生烦恼"
        },
        {
          "time": 150.7,
          "text": "能一往而深倾尽全力去拥抱"
        },
        {
          "time": 157.98,
          "text": "时光几曾仓促将红颜催老"
        },
        {
          "time": 162.26,
          "text": "它只是吻过簪花鬓角"
        },
        {
          "time": 166.19,
          "text": "婉转成一段又一段传世歌谣"
        },
        {
          "time": 173.09,
          "text": "我想作你最岿然安稳峰峦"
        },
        {
          "time": 176.7,
          "text": "挡得住风霜雨雪明枪暗箭"
        },
        {
          "time": 180.65,
          "text": "有轻云翩跹 有月华如练"
        },
        {
          "time": 184.41,
          "text": "将所有晴天阴天都经历遍"
        },
        {
          "time": 188.64,
          "text": "哪管世人会如何喟叹妒羡"
        },
        {
          "time": 192.16,
          "text": "高处不胜寒幸有你在身边"
        },
        {
          "time": 196.35,
          "text": "若比翼鹣鹣 若连理缠绵"
        },
        {
          "time": 200.2,
          "text": "千载后深情犹存山高水阔 天浩远"
        },
        {
          "time": 205.98,
          "text": "我想和你相恋最凡俗人间"
