    {
      "title": "04 山河令",
      "file": "04 山河令.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "04 山河令"
        },
        {
          "time": 3.0,
          "text": "作词 : 无比"
        },
        {
          "time": 5.0,
          "text": "作曲 : tide-潮汐"
        },
        {
          "time": 8.26,
          "text": "编曲/伴奏混音：宏宇"
        },
        {
          "time": 9.71,
          "text": "演唱：星尘"
        },
        {
          "time": 11.54,
          "text": "调教：花儿不哭"
        },
        {
          "time": 13.09,
          "text": "人声混音：Mr.曾经"
        },
        {
          "time": 14.82,
          "text": "笛子/萧：囚牛"
        },
        {
          "time": 16.09,
          "text": "吉他：小E"
        },
        {
          "time": 17.25,
          "text": "曲绘：白鄔東"
        },
        {
          "time": 31.67,
          "text": "骤雨后斜阳正浓 欲挑灯 旌旗动"
        },
        {
          "time": 35.0,
          "text": "去成就一段骁勇"
        },
        {
          "time": 38.3,
          "text": "不若此身化千里 快哉风 弦上弓"
        },
        {
          "time": 41.6,
          "text": "策马追一道彩虹"
        },
        {
          "time": 44.93,
          "text": "楼烦城几场决胜 定襄破 长平封"
        },
        {
          "time": 48.08,
          "text": "汉关路笑尽英雄"
        },
        {
          "time": 50.77,
          "text": "辟长空 挽弓 啸入苍穹"
        },
        {
          "time": 57.5,
          "text": "沐黄沙 敌阵谁敢与我争高下"
        },
        {
          "time": 60.78,
          "text": "风云几度 惊半生戎马"
        },
        {
          "time": 64.16,
          "text": "拭铁甲 挥兵破阵 再望断天涯"
        },
        {
          "time": 67.4,
          "text": "血雨腥风吻过了伤疤"
        },
        {
          "time": 84.49,
          "text": "一世气概与君同 御长风 数峥嵘"
        },
        {
          "time": 87.88,
          "text": "再成就一段骁勇"
        },
        {
          "time": 91.23,
          "text": "但此去剑指漠北 定河朔 酩酊中"
        },
        {
          "time": 94.43,
          "text": "频传着谁的征程"
        },
        {
          "time": 97.92,
          "text": "楼烦城几场决胜 定襄破 长平封"
        },
        {
          "time": 101.09,
          "text": "汉关路笑尽英雄"
        },
        {
          "time": 103.62,
          "text": "辟长空 挽弓 啸入苍穹"
        },
        {
          "time": 110.46,
          "text": "谁留下 烽火连天照夜的勾划"
        },
        {
          "time": 113.69,
          "text": "又是谁在传说中寻他"
        },
        {
          "time": 117.0,
          "text": "千年后 挥兵破阵 不过一刹那"
        },
        {
          "time": 120.28,
          "text": "血雨腥风吻过了伤疤"
        },
        {
          "time": 150.76,
          "text": "楼烦城几场决胜 定襄破 长平封"
        },
        {
          "time": 154.02,
          "text": "汉关路笑尽英雄"
        },
        {
          "time": 156.72,
          "text": "梦归处 挽弓 啸入苍穹"
        },
        {
          "time": 163.44,
          "text": "万里沙 敌阵谁敢与我争高下"
        },
        {
          "time": 166.7,
          "text": "风云几度 惊半生戎马"
        },
        {
          "time": 169.95,
          "text": "拭铁甲 挥兵破阵 再望断天涯"
        },
        {
          "time": 173.29,
          "text": "血雨腥风吻过了伤疤"
        },
        {
          "time": 176.65,
          "text": "谁留下 烽火连天照夜 的勾划"
        },
        {
          "time": 179.99,
          "text": "又是谁在 传说中寻他"
        },
        {
          "time": 183.3,
          "text": "史册间 挥兵破阵 不过一刹那"
        },
        {
          "time": 186.45,
          "text": "血雨腥风吻过了伤疤"
        },
        {
          "time": 189.87,
          "text": "山河在 回首泪如雨下"
        }
      ]
