        {
          "time": 3.02,
          "text": "演唱：星尘"
        },
        {
          "time": 3.8,
          "text": "曲绘：白鄔東"
        },
        {
          "time": 4.55,
          "text": "笛子：囚牛"
        },
        {
          "time": 5.29,
          "text": "调教：花儿不哭"
        },
        {
          "time": 6.0,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 25.06,
          "text": "清辉映着深堂"
        },
        {
          "time": 26.62,
          "text": "风月入酒一觞"
        },
        {
          "time": 28.12,
          "text": "有人已经与我饮畅"
        },
        {
          "time": 31.11,
          "text": "却还要我当"
        },
        {
          "time": 32.64,
          "text": "纵马白衣少年郎"
        },
        {
          "time": 37.11,
          "text": "残棋停在掌上"
        },
        {
          "time": 38.56,
          "text": "死局欲盖弥彰"
        },
        {
          "time": 40.05,
          "text": "有人故作眉眼疏狂"
        },
        {
          "time": 43.09,
          "text": "与我交过手"
        },
        {
          "time": 44.57,
          "text": "与我留过伤"
        },
        {
          "time": 46.01,
          "text": "却想求个美满收场"
        },
        {
          "time": 48.86,
          "text": "谯鼓响"
        },
        {
          "time": 49.83,
          "text": "烽烟茫茫"
        },
        {
          "time": 50.9,
          "text": "剑影刀光"
        },
        {
          "time": 52.01,
          "text": "阴谋阳谋"
        },
        {
          "time": 52.77,
          "text": "影影幢幢"
        },
        {
          "time": 55.06,
          "text": "这生死场上"
        },
        {
          "time": 56.5,
          "text": "有谁真愿谁"
        },
        {
          "time": 58.09,
          "text": "无恙"
        },
        {
          "time": 60.79,
          "text": "兴许"
        },
        {
          "time": 61.48,
          "text": "青竹早凋"
        },
        {
          "time": 62.97,
          "text": "碧梧已僵"
        },
        {
          "time": 64.46,
          "text": "人事本难防"
        },
        {
          "time": 66.71,
          "text": "只在"
        },
        {
          "time": 67.52,
          "text": "旧时旧日"
        },
        {
          "time": 69.03,
          "text": "大梦了一场"
        },
        {
          "time": 72.74,
          "text": "从此"
        },
        {
          "time": 73.51,
          "text": "天各一方"
        },
        {
          "time": 74.98,
          "text": "各自怀想"
        },
        {
          "time": 76.54,
          "text": "不如两相忘"
        },
        {
          "time": 79.07,
          "text": "非黄泉路上"
        },
        {
          "time": 80.57,
          "text": "此生王不见王"
        },
        {
          "time": 88.12,
          "text": "一夜长安冷雨"
        },
        {
          "time": 89.59,
          "text": "几声马蹄彷徨"
        },
        {
          "time": 91.17,
          "text": "烽火长燃撞破天光"
        },
        {
          "time": 94.1,
          "text": "只拂一拂袖"
        },
        {
          "time": 95.59,
          "text": "挥别了当年模样"
        },
        {
          "time": 100.13,
          "text": "千里江山入眼"
        },
        {
          "time": 101.59,
          "text": "谁不志在四方"
        },
        {
          "time": 103.16,
          "text": "行到水穷不曾回望"
        },
        {
          "time": 106.09,
          "text": "吟鞭断流水"
        },
        {
          "time": 107.57,
          "text": "也能断情长"
        },
        {
          "time": 109.0,
          "text": "前尘往事何必思量"
        },
        {
          "time": 112.07,
          "text": "纵然是"
        },
        {
          "time": 112.88,
          "text": "斯人已去"
        },
        {
          "time": 113.97,
          "text": "天地纵广"
        },
        {
          "time": 114.9,
          "text": "转眼又成几家沙场"
        },
        {
          "time": 118.1,
          "text": "夜半听楼角"
        },
        {
          "time": 119.56,
          "text": "纵马迎天光"
        },
        {
          "time": 121.0,
          "text": "凄怆"
        },
        {
          "time": 123.75,
          "text": "兴许"
        },
        {
          "time": 124.49,
          "text": "青竹早凋"
        },
        {
          "time": 125.96,
          "text": "碧梧已僵"
        },
        {
          "time": 127.42,
          "text": "人事本难防"
        },
        {
          "time": 129.66,
          "text": "只在"
        },
        {
          "time": 130.46,
          "text": "旧时旧日"
        },
        {
          "time": 131.97,
          "text": "大梦了一场"
        },
        {
          "time": 135.81,
          "text": "从此"
        },
        {
          "time": 136.56,
          "text": "天各一方"
        },
        {
          "time": 138.02,
          "text": "各自怀想"
        },
        {
          "time": 139.48,
          "text": "不如两相忘"
        },
        {
          "time": 142.05,
          "text": "非黄泉路上"
        },
        {
          "time": 143.54,
          "text": "此生王不见王"
        },
        {
          "time": 148.06,
          "text": "贪痴疏狂"
        },
        {
          "time": 149.61,
          "text": "暗自滋长"
        },
        {
          "time": 151.04,
          "text": "变了当年模样"
        },
        {
          "time": 154.1,
          "text": "相视一望"
        },
        {
          "time": 155.52,
          "text": "近乎咫尺"
        },
        {
          "time": 157.12,
          "text": "远在山岗"
        },
        {
          "time": 160.06,
          "text": "语息温凉"
        },
        {
          "time": 161.58,
          "text": "吞吐如霜"
        },
        {
          "time": 163.07,
          "text": "化在你眉睫上"
        },
        {
          "time": 165.71,
          "text": "生死一念算过场"
        },
        {
          "time": 169.14,
          "text": "冷不防"
        },
        {
          "time": 171.75,
          "text": "三千"
        },
        {
          "time": 172.55,
          "text": "铁衣披霜"
        },
        {
          "time": 173.98,
          "text": "万籁绝响"
        },
        {
          "time": 175.56,
          "text": "举目是残阳"
        },
        {
          "time": 177.72,
          "text": "回首"
        },
        {
          "time": 178.52,
          "text": "剑拔弩张"
