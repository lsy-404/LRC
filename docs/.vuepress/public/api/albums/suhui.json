          "text": "演唱：星尘"
        },
        {
          "time": 10.41,
          "text": "大提琴：冰果"
        },
        {
          "time": 11.68,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 35.3,
          "text": "初遇是草长莺飞时节"
        },
        {
          "time": 39.03,
          "text": "婆娑之处杨柳新叶"
