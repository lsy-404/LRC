        },
        {
          "time": 144.95,
          "text": "风萧兮 易水寒 壮士去 不复还"
        },
        {
          "time": 148.59,
          "text": "壮士一去不复还"
        },
        {
          "time": 151.98,
          "text": "风萧兮 易水寒 壮士去 不复还"
        },
        {
          "time": 155.44,
          "text": "心决然"
        },
        {
          "time": 158.88,
          "text": "风萧萧兮易水寒"
        },
        {
          "time": 165.74,
          "text": "壮士一去不复还"
        },
        {
          "time": 171.3,
          "text": "仓促梦 狼藉盏 梦里朗笑归远帆"
        },
        {
          "time": 178.21,
          "text": "共睹你舍身相护的河山"
        },
        {
          "time": 185.57,
          "text": "故友长别离 故国成追忆"
        },
        {
          "time": 188.51,
          "text": "当年燕市击筑扬歌在耳际"
        },
        {
          "time": 192.33,
          "text": "倾十分孤勇 步无归命局"
        },
        {
          "time": 195.39,
          "text": "明朝少年邀同醉 白头人间何处你"
        },
        {
          "time": 202.25,
          "text": "浮生旧事多不值一提 除却曾得知音你"
        },
        {
          "time": 208.76,
          "text": "浩然江海与苍茫天地 都将替我铭记"
        },
        {
          "time": 215.83,
          "text": "光阴坦荡若飞鸿雪泥 采撷传说里的相遇别离"
        },
        {
          "time": 222.45,
          "text": "珍藏在西风古道清明雨"
        },
        {
          "time": 229.61,
          "text": "烽烟乱世中怀抱勇气 慨然孤注手中棋"
        },
        {
          "time": 236.45,
          "text": "放浪形骸的江湖岁月 滚烫一点一滴"
        },
        {
          "time": 243.28,
          "text": "原来生死之交这命题 是毋庸许什么豪言誓语"
        },
        {
          "time": 250.05,
          "text": "就并辔奔赴下一世风雨"
