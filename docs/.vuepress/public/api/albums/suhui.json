        {
          "time": 4.0,
          "text": "作曲 : 陈亦洺"
        },
        {
          "time": 16.68,
          "text": "举杯坐饮放歌竹林间"
        },
        {
          "time": 20.44,
          "text": "清风拂面悄然拨动初弦"
        },
        {
          "time": 23.94,
          "text": "便推开烦恼与尘喧"
        },
        {
          "time": 27.19,
          "text": "便还是当时的少年"
        },
        {
          "time": 30.18,
          "text": "放了萦思且濯缨清泉"
        },
        {
          "time": 34.19,
          "text": "披襟送来春风轻扫了喧阗"
        },
        {
          "time": 37.69,
          "text": "拨捻起复苏的时节"
        },
        {
          "time": 40.94,
          "text": "翩翩淡忘了是何年"
        },
        {
          "time": 44.44,
          "text": "重重叠叠的醉眼"
        },
