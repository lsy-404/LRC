        {
          "time": 179.99,
          "text": "箭已在弦上"
        },
        {
          "time": 183.74,
          "text": "耳畔"
        },
        {
          "time": 184.51,
          "text": "江海有声"
        },
        {
          "time": 186.01,
          "text": "山河无量"
        },
        {
          "time": 187.49,
          "text": "呼万寿无疆"
        },
        {
          "time": 190.12,
          "text": "却无人共看"
        },
        {
          "time": 191.62,
          "text": "这人间多荒唐"
        },
        {
          "time": 195.91,
          "text": "却无人共看"
        },
        {
          "time": 198.11,
          "text": "这人间多荒唐"
        }
      ]
    },
    {
      "title": "07 心上秋",
      "file": "07 心上秋.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "07 心上秋"
        },
        {
          "time": 3.0,
          "text": "作词 : 冉语优"
        },
        {
          "time": 5.0,
          "text": "作曲 : litterzy"
        },
        {
          "time": 7.44,
          "text": "编曲：Mzf小慕"
        },
        {
          "time": 8.69,
          "text": "混音：Mr.曾经"
        },
        {
          "time": 27.43,
          "text": "记不起究竟哪一次"
        },
        {
          "time": 31.93,
          "text": "当秋光漫上了窗外花枝"
        },
        {
          "time": 37.43,
          "text": "你顿笔回眸一顾"
        },
        {
          "time": 41.93,
          "text": "熟稔得仿佛似旧日相识"
        },
        {
          "time": 47.43,
          "text": "并肩长谈过多少往事"
        },
        {
          "time": 52.18,
          "text": "恍然间黄昏已至"
        },
        {
          "time": 57.18,
          "text": "以为一双知己做了一世"
        },
        {
          "time": 62.18,
          "text": "从来不过如此"
        },
        {
          "time": 67.18,
          "text": "纸上描眉目，不辨妍或媸（chi）"
        },
        {
          "time": 72.18,
          "text": "刹那美人成东施"
        },
        {
          "time": 76.92,
          "text": "就中的故事，岂止一人痴"
        },
        {
          "time": 82.17,
          "text": "落款谁提了名氏"
        },
        {
          "time": 109.67,
          "text": "辗转经由他人唇齿"
        },
        {
          "time": 114.42,
          "text": "多少日夜听闻你的故事"
        },
        {
          "time": 119.91,
          "text": "难道这情之一字"
        },
        {
          "time": 124.41,
          "text": "竟连抛生死亦不可探知"
        },
        {
          "time": 129.91,
          "text": "听说北国的那座城池"
        },
        {
          "time": 134.92,
          "text": "被冬雪覆了终日"
        },
        {
          "time": 139.66,
          "text": "等到故人长诀渐行渐远"
        },
        {
          "time": 144.91,
          "text": "转眼已隔两世"
        },
        {
          "time": 149.41,
          "text": "谁向生而死，谁患得患失"
        },
        {
          "time": 154.91,
          "text": "相顾也再无多时"
        },
        {
          "time": 159.41,
          "text": "画中人暗自，竟心荡神痴"
        },
        {
          "time": 164.66,
          "text": "一滴泪氤氲满纸"
        },
        {
          "time": 169.41,
          "text": "挥墨描眉目，提笔勾鬓丝"
        },
        {
          "time": 174.91,
          "text": "寥寥几笔竟如此"
        },
        {
          "time": 179.65,
          "text": "夜半无人处，对月展卷时"
        },
        {
          "time": 184.9,
          "text": "忽然看懂这相思"
        },
        {
          "time": 189.9,
          "text": "落款谁提了名字"
        }
      ]
    },
    {
      "title": "08 祖龙吟",
      "file": "08 祖龙吟.lrc",
      "lyrics": [
