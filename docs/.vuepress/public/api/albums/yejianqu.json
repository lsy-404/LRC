{"slug":"yejianqu","folder":"页间曲","name":"页间曲","prefix":"","zh_name":"页间曲","en_name":"","suffix":"","year":"2025-10-10","produce":["星韵社"],"vocal":["赤羽","洛天依","永夜MInus","星尘","初音ミク","闇音レンリ","诗岸","乐正绫"],"lyricist":["comdull","Yuink","oO杳Oo","CRS","纪余珊","m1rac","ひかり","南北百合朝","Dasein"],"composer":["comdull","Yuink","oO杳Oo","CRS","m1rac","_B3nwalker_","菠萝罐头","墨绫P","纪余珊"],"arranger":["comdull","Yuink","oO杳Oo","CRS","m1rac","_B3nwalker_","菠萝罐头","墨绫P","纪余珊"],"tuning":["comdull","Yuink","oO杳Oo","CRS","m1rac","qwq自动机","木羲kigiko","浪隐波风","墨绫P","纪余珊"],"illustrator":["予澈","GoNorthMang","灰域漫游者","袋子","lain","GLanDoSS"],"mixer":["X-Dimension","oO杳Oo","墨绫P"],"lyric_maker":["神武竹"],"release":"[Bilibili](https://www.bilibili.com/video/BV14H47zjEin/)","purchase":"[淘宝 星韵社](https://e.tb.cn/h.R1cvXOGlmABT07g?tk=f2Pd5sNbjUl)","electronic":"[dizzylab](https://www.dizzylab.net/d/SD-03/)","cover":"/albums/yejianqu.jpg","tags":["页间曲","星韵社"],"songs":[{"title":"1 问","lyrics":[{"time":0.0,"text":"01 问"},{"time":0.89,"text":"Lyricist comdull"},{"time":2.58,"text":"Composer comdull"},{"time":4.33,"text":"Tuning comdull"},{"time":5.98,"text":"Mixing X-Dimension"},{"time":7.68,"text":"Illustration 予澈"},{"time":9.38,"text":"Vocal 赤羽"},{"time":10.61,"text":"天要下雨  娘要嫁人"},{"time":13.95,"text":"世间芳草本一生"},{"time":17.38,"text":"万事万物  昼夜晨昏"},{"time":20.06,"text":"只是原应各浮沉"},{"time":32.65,"text":"地崩山摧  壮士无闻"},{"time":35.94,"text":"怎可因心动回魂"},{"time":39.34,"text":"须知天地寰宇皆有伦"},{"time":42.28,"text":"冬梅不可饰成春"},{"time":45.71,"text":"啊"},{"time":52.02,"text":"常言道  法自然"},{"time":55.36,"text":"然有何人若罔闻"},{"time":59.18,"text":"只 是"},{"time":60.84,"text":"为什么要躲起身"},{"time":67.67,"text":"何为幻影何为真"},{"time":74.44,"text":"万千思绪诉无门"},{"time":81.21,"text":"生于泥土归于坟"},{"time":111.72,"text":"啊"},{"time":117.97,"text":"常言道  法自然"},{"time":121.26,"text":"然有何人若罔闻"},{"time":125.05,"text":"只 是"},{"time":126.79,"text":"为什么要躲起身"},{"time":133.54,"text":"何为幻影何为真"},{"time":140.33,"text":"万千思绪诉无门"},{"time":147.13,"text":"生于泥土归于坟"},{"time":153.9,"text":"为什么要躲起身"},{"time":160.65,"text":"何处寻那无生忍"},{"time":167.39,"text":"万千思绪聚一人"},{"time":174.21,"text":"人有终焉归于坟"},{"time":180.97,"text":"梦有终焉无温存"}]},{"title":"10 迟来","lyrics":[{"time":0.0,"text":"10 迟来"},{"time":3.22,"text":"Lyricist 纪余珊"},{"time":6.29,"text":"Composer 纪余珊"},{"time":9.44,"text":"Arranger CRS"},{"time":12.6,"text":"Tuning 纪余珊"},{"time":15.81,"text":"Mixing X-Dimension"},{"time":18.93,"text":"Illustration lain"},{"time":22.07,"text":"Vocal 星尘"},{"time":25.25,"text":"花  落下来"},{"time":27.59,"text":"错过的时间不再来"},{"time":31.12,"text":"遗憾的空白"},{"time":33.9,"text":"拖曳我不让我释怀"},{"time":37.41,"text":"笨鸟  别等待"},{"time":40.18,"text":"差了勇气太不应该"},{"time":43.75,"text":"落单的你  和我"},{"time":47.3,"text":"太过奇怪"},{"time":50.06,"text":"未来的未来"},{"time":52.86,"text":"迷雾般朦胧又难猜"},{"time":56.34,"text":"沉默的钟摆"},{"time":59.18,"text":"诉说没人听的心海"},{"time":62.67,"text":"书桌的一角"},{"time":65.48,"text":"刻着太天真的梦想"},{"time":69.03,"text":"摸索磨损记号"},{"time":72.21,"text":"寻不回旧时锋芒"},{"time":75.76,"text":"也曾想抓住那抹朝阳"},{"time":80.81,"text":"脚步太慢的我  追不上光"},{"time":84.79,"text":"一路上跌跌撞撞"},{"time":88.19,"text":"但红日冉冉升起在路上"},{"time":93.44,"text":"没赶上的公交  还有下一辆"},{"time":97.44,"text":"风吹过  莺飞草长"},{"time":125.87,"text":"总是  不明白"},{"time":128.61,"text":"总是在蹉跎慢慢捱"},{"time":132.16,"text":"可是  若重来"},{"time":134.96,"text":"明月依然照耀窗台"},{"time":138.48,"text":"青春的释怀"},{"time":141.28,"text":"不再有天真的梦想"},{"time":144.79,"text":"就算路途漫漫"},{"time":147.98,"text":"总要循着心中方向"},{"time":151.55,"text":"也曾想抓住那抹朝阳"},{"time":156.59,"text":"脚步太慢的我  追不上光"},{"time":160.61,"text":"一路上跌跌撞撞"},{"time":164.0,"text":"而我的行囊已背在身上"},{"time":169.24,"text":"青春不过序章  错过又怎样"},{"time":173.22,"text":"挥挥手  来日方长"},{"time":182.7,"text":"翻出一颗  原味的糖"},{"time":185.85,"text":"放到过期都不舍得品尝"},{"time":189.01,"text":"这样小心的"},{"time":192.19,"text":"又何必  对自己失望"},{"time":202.04,"text":"也曾想抓住那抹朝阳"},{"time":207.12,"text":"脚步太慢的我  追不上光"},{"time":211.12,"text":"一路上跌跌撞撞"},{"time":214.34,"text":"而我的行囊已背在身上"},{"time":219.79,"text":"青春不过序章  错过又怎样"},{"time":223.73,"text":"挥挥手  来日方长"}]},{"title":"2 星间吟游歌姬","lyrics":[{"time":0.0,"text":"02 星间吟游歌姬"},{"time":2.82,"text":"Lyricist Yuink"},{"time":6.6,"text":"Composer Yuink"},{"time":9.57,"text":"Tuning Yunik"},{"time":13.15,"text":"Mixing X-Dimension"},{"time":16.97,"text":"Illustration 予澈"},{"time":20.46,"text":"Vocal 洛天依"},{"time":22.34,"text":"破旧等离子引擎  嗡嗡轰鸣"},{"time":24.33,"text":"刚刚  将上个星球  演唱活动  设备整理"},{"time":26.1,"text":"就向着银河系的  边缘一隅"},{"time":27.98,"text":"推下  摇杆就准备  前进"},{"time":29.87,"text":"是否我的歌声能  带来回音"},{"time":31.7,"text":"即使  在声波也传递不了的  银河系里"},{"time":33.63,"text":"就算想得再多  不如现在  先带上耳机"},{"time":37.55,"text":"提示声音又响起"},{"time":39.54,"text":"故障紊乱了神经"},{"time":41.36,"text":"在前方  稍停息"},{"time":43.2,"text":"落在这颗   雾霾笼罩的星体"},{"time":45.08,"text":"氤氲的酸雨气 伴着闪灭的虹霓"},{"time":48.63,"text":"面具加雨衣  穿梭街区"},{"time":52.37,"text":"曾探索过天际  某个时代后沉寂"},{"time":56.23,"text":"静谧的卫星  无人踪迹"},{"time":59.85,"text":"恍惚的生命体  伴着酒精以歇息"},{"time":63.63,"text":"麻木已入侵  喧闹市井"},{"time":67.36,"text":"卸下了扩音器  未曾计划的预期"},{"time":71.22,"text":"舞台已就绪  请深呼吸"},{"time":76.87,"text":"就让律动撼动这地方"},{"time":78.83,"text":"为我和音为我歌唱"},{"time":80.72,"text":"请你沐浴在音浪"},{"time":82.01,"text":"就尽情胡思乱想  也不要惊慌"},{"time":84.23,"text":"暂且逃避未来的紧张"},{"time":86.3,"text":"请别急于一时迷茫"},{"time":88.26,"text":"你的掌声亦有重量  再踏向远方"},{"time":106.85,"text":"节外生枝的演唱"},{"time":108.66,"text":"未经设想的异况"},{"time":110.29,"text":"耗尽了时间和能量"},{"time":112.16,"text":"机体故障  仍没有  恢复迹象"},{"time":114.29,"text":"黄矮星微弱光芒"},{"time":116.14,"text":"带电粒子流渐强"},{"time":117.69,"text":"规律无线信号方向"},{"time":119.59,"text":"查询来源  三号星球  上释放"},{"time":121.77,"text":"数据库检索图像"},{"time":123.65,"text":"包裹着蔚蓝水光"},{"time":125.23,"text":"耳膜充斥警报轰响"},{"time":127.13,"text":"指令发出  就准备  紧急迫降"},{"time":129.27,"text":"大气烧蚀着机舱"},{"time":131.14,"text":"突破了云层震荡"},{"time":132.74,"text":"剧烈碰撞水花飞扬"},{"time":134.6,"text":"空气凉爽  透入灼热胸膛"},{"time":137.21,"text":"见证了  海岸旁  城市中  高耸着  举火把  铜绿的巨像"},{"time":140.47,"text":"穿梭  穿梭  穿梭  人海茫茫"},{"time":144.73,"text":"篝火燃  荒原上  星垂帐  伴风霜  让晨露  做我的衣裳"},{"time":148.01,"text":"探索  探索  探索  荒芜熙攘"},{"time":152.21,"text":"跨过了  高筑的  盘踞在  崇山和  峻岭中  蜿蜒的城墙"},{"time":155.48,"text":"化作  化作  化作  文明故乡"},{"time":159.7,"text":"即使会  永远地  留在这  但无法  限制住  声波的激荡"},{"time":163.01,"text":"灯光聚在  星球之上"},{"time":168.6,"text":"就让律动撼动这地方"},{"time":170.72,"text":"为我和音为我歌唱"},{"time":172.57,"text":"亿万鼓动的心脏"},{"time":173.93,"text":"与地心引力共振  让音乐飞翔"},{"time":176.1,"text":"织就思绪在乐间流淌"},{"time":178.26,"text":"伴着我的回忆生长"},{"time":180.15,"text":"记录下文明的频响  在这片土壤"},{"time":183.64,"text":"就让焰火伴随着月光"},{"time":185.72,"text":"与我和音与我歌唱"},{"time":187.6,"text":"用旋律摇曳狂想"},{"time":188.9,"text":"再不管旅程多长  要去向何方"},{"time":191.09,"text":"即使脚步驻留在地上"},{"time":193.2,"text":"宇宙仍然充满眼眶"},{"time":195.13,"text":"就让歌声挣脱引力  在银河回响"}]},{"title":"3 光降落的序章","lyrics":[{"time":0.0,"text":"03 光降落的序章"},{"time":8.43,"text":"Lyricist oO杳Oo"},{"time":12.02,"text":"Composer oO杳Oo"},{"time":15.89,"text":"Tuning oO杳Oo"},{"time":19.52,"text":"Mixing X-Dimension/oO杳Oo"},{"time":23.14,"text":"Illustration GoNorthMang"},{"time":26.71,"text":"Vocal 永夜Minus"},{"time":30.43,"text":"我撕掉了那份精密人生的导航"},{"time":34.0,"text":"地图终点从没说通往什么天堂"},{"time":37.7,"text":"下个目标曾是我唯一的行囊"},{"time":41.4,"text":"却让我困在一座空旷的囚房"},{"time":45.14,"text":"像一场风暴  意外将我席卷"},{"time":50.66,"text":"给了我彻底的释放"},{"time":58.02,"text":"直到那一束光  撞进我那片黑白的现场"},{"time":63.56,"text":"一道不合逻辑温暖  闪烁着从天而降"},{"time":68.97,"text":"我的世界忽然野蛮"},{"time":71.38,"text":"泼洒上那从未见过的橙色夕阳"},{"time":75.25,"text":"和蓝色海浪"},{"time":78.38,"text":"心跳终于学会漏掉一拍的慌张"},{"time":82.07,"text":"理性构筑城墙  崩塌露出的光芒"},{"time":85.74,"text":"原来活着不是为了抵达某个远方"},{"time":89.47,"text":"而是为了感受此刻风吹过的滚烫"}]},{"title":"4 守望与羁绊的微光航行","lyrics":[{"time":0.0,"text":"04 守望与羁绊的微光航行"},{"time":2.25,"text":"PLanning CRS"},{"time":4.29,"text":"Lyricist CRS/纪余珊"},{"time":6.23,"text":"Composer CRS"},{"time":8.3,"text":"Tuning CRS"},{"time":10.23,"text":"Mixing X-Dimension"},{"time":12.22,"text":"Illustration 予澈"},{"time":14.23,"text":"Vocal 星尘"},{"time":16.2,"text":"你总是低着头沉默不语"},{"time":20.16,"text":"我尝试着靠近却被推开"},{"time":24.1,"text":"说着违心的话眼神逃避"},{"time":28.09,"text":"我不知所措"},{"time":31.63,"text":"我曾经也想过要放手"},{"time":35.6,"text":"以为这样就能找到出口"},{"time":39.64,"text":"可为何越想要忘记所有"},{"time":44.12,"text":"思绪却越如潮涌"},{"time":47.09,"text":"所以即使你被困在执念的漩涡"},{"time":52.09,"text":"我也会成为你坚实的锚点"},{"time":55.85,"text":"无论被裹挟着上浮或下沉"},{"time":59.62,"text":"我都会在这里等待你靠岸"},{"time":63.11,"text":"也许等待的过程循环着静默"},{"time":68.04,"text":"或者永远也无法等到结果"},{"time":71.85,"text":"但我不会让你再次经历失去"},{"time":75.6,"text":"爱是重拾勇气前行的赞歌"},{"time":96.16,"text":"你总是挣扎着掩饰脆弱"},{"time":100.14,"text":"不相信值得被爱的承诺"},{"time":104.17,"text":"尽管被你推开也无所谓"},{"time":108.11,"text":"我不会放手"},{"time":111.66,"text":"像刺猬一样竖起尖刺"},{"time":115.59,"text":"却刺痛着自己的内心"},{"time":119.57,"text":"害怕会分开却又不敢靠近"},{"time":124.11,"text":"像做错事的孩子"},{"time":127.08,"text":"所以即使你迷失在无尽的夜晚"},{"time":132.1,"text":"我也会成为为你引路的光"},{"time":135.86,"text":"就算不知道前进还是后退"},{"time":139.57,"text":"我也懂得你纠结的爱与恨"},{"time":143.12,"text":"任凭情绪被狂风和骤雨撕裂"},{"time":148.1,"text":"我仍用包容为你照亮归途"},{"time":151.83,"text":"微弱的光芒也能穿透黑暗"},{"time":155.6,"text":"请相信心之所向终会相见"},{"time":175.69,"text":"你的灵魂闪耀着独特的光芒"},{"time":179.62,"text":"纵使异于常人也绝非残次品"},{"time":183.84,"text":"别再把自己的温柔和善良伪装"},{"time":187.65,"text":"走过的泥泞过往我会陪你珍藏"},{"time":191.8,"text":"雄鹰终会有天展开羽翼去翱翔"},{"time":195.66,"text":"我愿一直守候你等到雨过天晴"},{"time":199.86,"text":"无论喜悦激动脆弱无能癫狂或冷漠"},{"time":203.65,"text":"都是可以一起走下去的独一无二的你"},{"time":211.32,"text":"因为我一直都陪伴在你的身边"},{"time":216.04,"text":"所以你从来不是孤身一人"},{"time":219.83,"text":"不必为逃避抉择而感到羞愧"},{"time":223.62,"text":"我会握紧你的手一起面对"},{"time":227.15,"text":"虽然有些困难依然会持续下去"},{"time":232.09,"text":"但只要心心相连便无所畏惧"},{"time":235.89,"text":"我一样地拥抱你的闪耀和破碎"},{"time":239.64,"text":"无论过去现在还是未来"}]},{"title":"5 恋に落ちた","lyrics":[{"time":0.0,"text":"05　恋に落ちた"},{"time":0.0,"text":"Lyricist m1rac"},{"time":0.41,"text":"Composer m1rac"},{"time":0.77,"text":"Tuning m1rac"},{"time":1.05,"text":"Mixing m1rac"},{"time":1.41,"text":"Ilustration 灰域漫游者"},{"time":1.74,"text":"Vocal 初音ミク"},{"time":2.08,"text":"違うよ　　違うよ　　別に　　あなたのため"},{"time":5.58,"text":"この気持ちて　　もうすぐしが切れる"},{"time":9.12,"text":"会えない　　きっと会えない　　太陽見たくない"},{"time":12.7,"text":"まぶしすぎて開けられない"},{"time":16.16,"text":"そもそも"},{"time":17.75,"text":"私にどこから良かった"},{"time":21.26,"text":"きっと誤解だ"},{"time":23.24,"text":"もう少し時間だけ"},{"time":24.93,"text":"全部から、忘れた"},{"time":26.95,"text":"それでも、もう仕方ない"},{"time":28.57,"text":"私の光になってくれるか"},{"time":33.06,"text":"「だけも好き　　それ以上ない」"},{"time":34.74,"text":"はっきり聞こえました"},{"time":36.52,"text":"何度も繰り返さなくていいよ"},{"time":40.0,"text":"返事は欲しい　　今は内緒"},{"time":41.76,"text":"答えを聞くまでは"},{"time":43.52,"text":"私の質問に先、答えろ"},{"time":47.07,"text":"一、本気なの？噓じゃない？"},{"time":51.67,"text":"信じることを選んでもいいんだよ"},{"time":54.12,"text":"二、食べ物とか、何が好き？"},{"time":58.73,"text":"聞くのもあなたのために、バカ"},{"time":62.55,"text":"そうだよ　　そうだよ　　とっくに好きだった"},{"time":66.03,"text":"ほんの少しでも、もっと近づきたいよ"},{"time":69.55,"text":"会いたい　　会いたい　　今すぐ会いたい"},{"time":73.07,"text":"この気持ちで、今は、否定しない"},{"time":76.62,"text":"どうしよう　　一体どうしよう"},{"time":78.29,"text":"こんな綺麗なんだ"},{"time":80.15,"text":"言葉なんてとか"},{"time":81.73,"text":"とっくには要らない"},{"time":83.7,"text":"愛とか好きとか"},{"time":85.2,"text":"もうどうでもいいよ"},{"time":87.23,"text":"全部夢じゃない、はっきり分かってる"},{"time":90.74,"text":"もしも"},{"time":92.25,"text":"実はあんまり良くないんだ…どうしよう"},{"time":95.75,"text":"君知ってるか"},{"time":97.84,"text":"私は悪い子だ、人生もう失敗だ"},{"time":101.36,"text":"でもね　　でもね"},{"time":103.11,"text":"愛が欲しい、くださいよ"},{"time":108.03,"text":"慣れたもう　　期待されない"},{"time":111.5,"text":"このまま続いていく…が"},{"time":115.71,"text":"あなた来たね"},{"time":118.17,"text":"世界が変わった　　この瞬間に"},{"time":121.64,"text":"もう　　知らないよ　　分からないよ"},{"time":126.29,"text":"私の人生あなたにあずけるわ"},{"time":129.88,"text":"答えとか"},{"time":131.61,"text":"もう知ってるだ！"},{"time":133.38,"text":"もちろんずっとYESだよ、このバカ"},{"time":137.06,"text":"そうだよ　　そうだよ　　あなたのこと"},{"time":140.56,"text":"少しずつていい…もっと知りたいんだ"},{"time":144.11,"text":"仕方ない　　仕方ない　　恋に落ちました"},{"time":147.66,"text":"何があっても"},{"time":149.55,"text":"諦める不可能"},{"time":151.24,"text":"苦しみも　　喜びも　　一緒に過ごす"},{"time":154.69,"text":"そばにいてくれる"},{"time":156.2,"text":"何でもできるよ"},{"time":158.25,"text":"輝け　　輝け　　こんなにまぶしい"},{"time":161.79,"text":"私を救ったのは君の目だ"},{"time":165.3,"text":"そういえば　　甘えても　　まだいいよね"},{"time":170.45,"text":"もう一度さ　　あの言葉"},{"time":174.12,"text":"もう一度　　もう一回"},{"time":175.92,"text":"言ってよ　　言ってよ"},{"time":177.58,"text":"聞かせてね　　好きどか"}]},{"title":"6 恋♭","lyrics":[{"time":0.0,"text":"06　恋♭"},{"time":1.91,"text":"Lyricist ひかり"},{"time":3.48,"text":"Composer m1rac"},{"time":5.11,"text":"Tuning qwq自动机"},{"time":6.79,"text":"Mixing m1rac"},{"time":8.36,"text":"Illustration 袋子"},{"time":9.94,"text":"Vocal 闇音レンリ"},{"time":10.15,"text":"どれだけ祈れば"},{"time":13.92,"text":"幸せになるだろう"},{"time":16.81,"text":"未だにまだわからない"},{"time":23.56,"text":"桜が空に舞うの日も"},{"time":27.21,"text":"雨を降り注ぐの日も"},{"time":32.7,"text":"ぐるぐる廻り続いていく"},{"time":36.81,"text":"話をかけてくれた　　君は"},{"time":41.77,"text":"灰色が満ちている時間薔薇色を染まる"},{"time":50.25,"text":"こんな日々　　ずっとつづける"},{"time":55.1,"text":"疑いもない"},{"time":56.87,"text":"どうして君は裏切られた"},{"time":63.55,"text":"君と駆け抜けたあの夏さえ"},{"time":70.23,"text":"記憶のかけらとして"},{"time":73.9,"text":"ただ見ているだけなんて"},{"time":78.09,"text":"「ずっと、元気でいてね」"},{"time":83.31,"text":"君が残した最後の言葉"},{"time":103.58,"text":"側に居るそれだけで"},{"time":107.35,"text":"心が満たされると思う"},{"time":112.63,"text":"それだけでいいと思う"},{"time":116.81,"text":"抱き締めるの後も"},{"time":120.49,"text":"その手に残された温もりも"},{"time":125.94,"text":"絶対忘れないよ"},{"time":130.14,"text":"心に　　噓はつけない"},{"time":133.47,"text":"胸に　　溢れている気持ちは冷たい針のように刺そう"},{"time":143.5,"text":"一人　　このままに歩いてく"},{"time":148.33,"text":"夕風の中"},{"time":150.22,"text":"知らない場所に迷いみたい"},{"time":156.91,"text":"残されたの理由"},{"time":159.68,"text":"誰がに問えばいいの"},{"time":165.14,"text":"今はそれさえもわからない"},{"time":171.22,"text":"教えて、その先の道"},{"time":176.88,"text":"どうやって進めてが出来るなのかな"},{"time":183.63,"text":"夕暮の色もう二度と来ない"},{"time":190.26,"text":"25時の愛しさ重すぎだがら"},{"time":195.18,"text":"ただの４グラムには載せない"},{"time":203.56,"text":"それはまだ誰の知らないストーリー"},{"time":210.23,"text":"風がささやく"},{"time":213.11,"text":"星の約束"},{"time":216.95,"text":"君が教えてくれたこの歌とその一雫涙の意味"},{"time":230.12,"text":"きっと　　映せるよ　　その先の未来"},{"time":243.61,"text":"今だに永久は知らない"},{"time":247.23,"text":"闇の中光を追い駆け"},{"time":252.51,"text":"夜明け信じて待っている"}]},{"title":"7 蝶说，春也可哀，秋也可爱","lyrics":[{"time":0.0,"text":"07 蝶说，春也可爱，秋也可哀"},{"time":2.8,"text":"Lyricist 南北百合朝"},{"time":5.08,"text":"Composer _B3nwalker_"},{"time":6.93,"text":"Tuning 木羲kigiko"},{"time":8.82,"text":"Mixing X-Dimension"},{"time":10.99,"text":"Illustration lain"},{"time":13.36,"text":"Vocal 诗岸"},{"time":15.53,"text":"“跳起来也不一定够得着的宝物，即使迷失了，也会一直是指引我们前行的灯塔。没有太多的障碍，何时都不算太晚。因为无论怎样，我们最终都要用自己的口来诉说自己的答案。”"},{"time":22.12,"text":"窗外蝴蝶  与我总属不同世界"},{"time":26.39,"text":"庭院传何景明  室内昏暗幽静"},{"time":30.51,"text":"我只默望  她翩飞过"},{"time":34.6,"text":"蜷缩趴桌  囿于沉默"},{"time":48.35,"text":"她降落在  我曾浇灌那株蕙兰"},{"time":52.58,"text":"银白轻翼泛光  邀我共舞一场"},{"time":56.76,"text":"我只彷徨  心恐惊扰"},{"time":60.75,"text":"思绪漫涨  终不肯往"},{"time":65.18,"text":"我总爱叹  森罗万殿"},{"time":69.21,"text":"言说书传如越巴山  可比蜀道难"},{"time":73.56,"text":"我总哀叹  北冥浩瀚"},{"time":77.92,"text":"片刻相欢似彩云散  终被时光冲淡"},{"time":82.83,"text":"于是不敢期待"},{"time":86.95,"text":"共登楼台  清弦合奏未来"},{"time":91.35,"text":"可那份自卑悲哀  爱仍在"},{"time":95.95,"text":"呼唤  多么不甘"},{"time":98.16,"text":"离别的你  轻易就不在"},{"time":118.06,"text":"昼夜几百  独留我空守旧窗台"},{"time":122.4,"text":"西风吹折九畹  绿红怎敌秋晚"},{"time":126.47,"text":"我只莫忘  她翩飞过"},{"time":130.53,"text":"蜷缩趴桌  又余沉默"},{"time":144.25,"text":"不知实幻  润玉莹白是故人来"},{"time":148.52,"text":"碧空飘然回旋  芳踪似往日再"},{"time":152.75,"text":"我只呐喊  不再等待"},{"time":156.75,"text":"门扉轻开  终入此院"},{"time":161.21,"text":"我总寂寥  清梦一场"},{"time":165.16,"text":"朝生暮死皆若虚妄  你又葬何方"},{"time":169.56,"text":"我总寂寥  却望九霄"},{"time":173.95,"text":"春去秋来不改苍茫  你我天地同往"},{"time":178.88,"text":"于是不再哀叹"},{"time":182.82,"text":"心即云帆  可驭平生胸怀"},{"time":187.3,"text":"纵此身难越山海  爱仍在"},{"time":191.96,"text":"呼唤  空谷声传"},{"time":194.15,"text":"似你归来  “我一直都在”"},{"time":196.27,"text":"呼唤  清歌婉转"},{"time":198.46,"text":"轻解开爱  我一直都在"}]},{"title":"8 淬火","lyrics":[{"time":0.0,"text":"08 淬火"},{"time":5.35,"text":"Lyricist 纪余珊"},{"time":10.65,"text":"Composer/Arranger 菠萝罐头"},{"time":15.99,"text":"Tuning 浪隐波风"},{"time":21.3,"text":"Mixing X-Dimension"},{"time":26.68,"text":"Illustration 予澈"},{"time":32.0,"text":"Vocal 洛天依"},{"time":42.97,"text":"规则在  编织他自己的网"},{"time":45.32,"text":"不动声色  只等迷途的羔羊撞上"},{"time":48.29,"text":"黑鸦俯瞰这战场"},{"time":50.44,"text":"适者生存的法则  无需过多承让"},{"time":53.63,"text":"并不是  谁都自愿地入场"},{"time":55.97,"text":"愿意承认  这荒谬愚蠢的虚假象"},{"time":58.99,"text":"枝桠在蔓延生长"},{"time":61.13,"text":"赤眼凝望那苍穹  只剩一片昏黄"},{"time":64.32,"text":"双手  扯着线去舞蹈"},{"time":66.98,"text":"瞳孔  会被锈迹染伤"},{"time":69.67,"text":"口舌  只能拐弯抹角"},{"time":71.97,"text":"服用固定饵料  扮演绝对乖巧"},{"time":74.67,"text":"别再软弱  别沉默  谁能逃得脱"},{"time":77.31,"text":"要想自由  就抬头  撕裂这枷锁"},{"time":80.0,"text":"就让烈火  尽烧灼  还世间清浊"},{"time":82.63,"text":"风吹过  零星斑驳"},{"time":85.32,"text":"别再蜷缩  别懒惰  别麻木地活"},{"time":87.97,"text":"寻找出口  要执拗  得到了再说"},{"time":90.64,"text":"尽力争夺  共你我  颠覆这因果"},{"time":93.32,"text":"千万颗  炽热燎原的星火"},{"time":106.98,"text":"规则仍  编织他自己的网"},{"time":109.27,"text":"不动声色  称量你我灵魂的重量"},{"time":112.29,"text":"黑鸦俯瞰这战场"},{"time":114.44,"text":"适者生存的法则  无需过多承让"},{"time":117.65,"text":"我已经  被迫自愿地入场"},{"time":119.97,"text":"只能撕破  这荒谬愚蠢的虚假象"},{"time":122.95,"text":"枝桠在蔓延生长"},{"time":125.15,"text":"山雨欲来风满楼  月色落地成霜"},{"time":130.09,"text":"撞碎高墙  烧红  铁丝网  夜比昼更亮"},{"time":138.62,"text":"别再软弱  别沉默  谁能逃得脱"},{"time":141.31,"text":"要想自由  就抬头  撕裂这枷锁"},{"time":143.97,"text":"就让烈火  尽烧灼  还世间清浊"},{"time":146.63,"text":"风吹过  零星斑驳"},{"time":149.31,"text":"别再蜷缩  别懒惰  别麻木地活"},{"time":151.97,"text":"寻找出口  要执拗  得到了再说"},{"time":154.66,"text":"尽力争夺  共你我  颠覆这因果"},{"time":157.3,"text":"千万颗  炽热燎原的星火"},{"time":181.69,"text":"双手  要鸟儿般飞翔"},{"time":184.29,"text":"瞳孔  映着清澈光芒"},{"time":186.97,"text":"口舌  不会被谁遮挡"},{"time":189.33,"text":"我和我的心脏  赢得这场硬仗"},{"time":202.76,"text":"时针转过  谁走过  留下了什么"},{"time":205.31,"text":"浪潮之下  尽赤色  永恒的泡沫"},{"time":207.97,"text":"齿轮啮合  彗星落  夜幕都划破"},{"time":210.66,"text":"风吹过  回声不落"},{"time":213.33,"text":"血迹干涸  伤愈合  结痂会脱落"},{"time":215.97,"text":"碎裂玻璃  仍锋利  仍在等待着"},{"time":218.64,"text":"就算前方  遍布着  横亘的沟壑"},{"time":221.31,"text":"这一次不会再重蹈覆辙"},{"time":223.96,"text":"时针转过  谁躲过  陨星谁记得"},{"time":226.63,"text":"浪潮之上  新生的  长明的银河"},{"time":229.33,"text":"沉沉雾色  难勾勒  山路仍曲折"},{"time":231.97,"text":"自由的心  燃烧着  从不会退缩"},{"time":234.64,"text":"举起了手"},{"time":235.29,"text":"就去争夺  别让咽喉  再被剥夺"},{"time":237.31,"text":"神的承诺"},{"time":237.99,"text":"没有结果  沧海桑田  一瞬湮没"},{"time":239.97,"text":"请听我说"},{"time":240.63,"text":"请听你说  不再由祂  给予赤裸"},{"time":242.62,"text":"凡人之躯也塑造传说"}]},{"title":"9 The Coming Wave","lyrics":[{"time":0.0,"text":"09 The Coming Wave"},{"time":0.38,"text":"Lyricist Dasein"},{"time":1.36,"text":"Composer 墨绫P"},{"time":2.66,"text":"Arranger X-Dimension/墨绫P"},{"time":3.89,"text":"Tuning 墨绫P"},{"time":5.17,"text":"Mixing X-Dimension"},{"time":6.42,"text":"Illustration GLanDoSS"},{"time":7.67,"text":"Vocal 乐正绫/洛天依"},{"time":8.63,"text":"试炼场上  幸存谎言"},{"time":13.56,"text":"能量算子高效循环"},{"time":18.54,"text":"沃土培苗  丰盛美餐"},{"time":23.51,"text":"她独站立霜中塔巅"},{"time":28.24,"text":"所有维度外寻求改变"},{"time":33.53,"text":"却如水月镜中花般"},{"time":38.54,"text":"骰子落下时命运宣判"},{"time":43.57,"text":"骨牌倾覆直至狂澜"},{"time":49.28,"text":"琴弦响彻海浪之间"},{"time":54.14,"text":"月光皎白融化在这蔚蓝"},{"time":59.16,"text":"初心碎在鲨鱼深渊"},{"time":65.51,"text":"海水尽红染"},{"time":69.46,"text":"多少手指掰下在井檐"},{"time":74.48,"text":"多少狼豺噬心瞪白眼"},{"time":79.44,"text":"多少碎石砸向泪面颊"},{"time":85.36,"text":"隐忍待宣判"},{"time":138.62,"text":"精致符咒呼唤天雷"},{"time":143.51,"text":"昔日城池唯剩火焰"},{"time":148.53,"text":"誓要血债笔笔偿还"},{"time":153.53,"text":"撕碎他们残余体面"},{"time":158.33,"text":"可曾铭记春花下初见"},{"time":163.52,"text":"可曾铭记谈笑致远"},{"time":168.56,"text":"可曾红月下挽手登攀"},{"time":173.54,"text":"可曾见证星河璀璨"},{"time":179.17,"text":"多少颠沛此去经年"},{"time":184.32,"text":"决绝目光下是泪光婉转"},{"time":189.18,"text":"于那内心深处枷锁"},{"time":195.48,"text":"打开了明天"},{"time":199.71,"text":"光与影子也本来相伴"},{"time":204.5,"text":"爱与歌声又何惧霜寒"},{"time":209.42,"text":"再次求索本真你我"},{"time":215.5,"text":"期待着明天"}]}]}