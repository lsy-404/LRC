{"slug":"ganzeyao","folder":"甘泽谣","name":"甘泽谣","prefix":"","zh_name":"甘泽谣","en_name":"","suffix":"","year":"2020-04-24","produce":[],"vocal":["小白龙"],"lyricist":["邪叫教主"],"composer":["海鲜面"],"arranger":["海鲜面"],"tuning":["我才木有","Creuzer","纳兰寻风"],"illustrator":["骸鸦","野坂言火","逢时"],"mixer":["海鲜面","马尾嗷嗷子","西门振"],"lyric_maker":[],"release":"[Bilibili](https://www.bilibili.com/video/BV19Z4y1W7nr)","purchase":"","electronic":"","cover":null,"tags":["甘泽谣"],"songs":[{"title":"为人君者","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":8.52,"text":"编曲 : 海鲜面"},{"time":11.29,"text":"混音 : 海鲜面"},{"time":14.15,"text":"调教 : 纳兰寻风"},{"time":16.96,"text":"曲绘 : 骸鸦"},{"time":19.79,"text":"PV : Ci茜"},{"time":22.58,"text":"Vocal : 乐正龙牙、星尘、言和"},{"time":25.39,"text":"灵感来源于《甘泽谣·魏先生》"},{"time":45.46,"text":"南北嶂千叠欲访仙居却无径"},{"time":51.19,"text":"未遇风雨潜龙莫不藏其鳞"},{"time":56.79,"text":"林深闻虫鸣不闻猛虎伏身行"},{"time":62.39,"text":"削飞岩生雷处默然立苍鹰"},{"time":68.09,"text":"梧桐顶凤有尖爪利吻而不施"},{"time":73.7,"text":"冲碧霄一鸣则群禽皆飞至"},{"time":79.43,"text":"望神麟上青云何须多费足趾"},{"time":85.06,"text":"得天道应集于时且顺其势"},{"time":93.12,"text":"为人父者 言传须先效行 以身作则"},{"time":98.77,"text":"为人师者 克勉常新方能解人惑"},{"time":104.42,"text":"为人将者 不战而屈人兵 战无不克"},{"time":110.07,"text":"为人君者 千古兴亡鉴成此说"},{"time":117.82,"text":"心志如山岳巍峨"},{"time":120.66,"text":"高峻而不动 树威德"},{"time":124.21,"text":"抚民以仁待臣以礼"},{"time":126.99,"text":"身范仪六合"},{"time":129.42,"text":"胸怀有容似江河"},{"time":131.94,"text":"腾云生春雨 万物泽"},{"time":135.47,"text":"殷殷寰内土木兴作"},{"time":138.3,"text":"潮浪百汇聚成鲸波"},{"time":152.74,"text":"行舟欲绝重洋必假桡楫之功"},{"time":158.42,"text":"鸿鹄凌高空必因羽翮之用"},{"time":164.05,"text":"是故君之为国必知任贤为重"},{"time":169.71,"text":"访俊才尊良士慧眼识英雄"},{"time":174.99,"text":"为人父者 言传须先效行 以身作则"},{"time":180.65,"text":"为人师者 克勉常新方能解人惑"},{"time":186.3,"text":"为人将者 不战而屈人兵 战无不克"},{"time":191.95,"text":"为人君者 千里山河鉴成此说"},{"time":199.72,"text":"世象皆揽为我镜"},{"time":202.54,"text":"可以明得失 知废兴"},{"time":206.06,"text":"察民之艰纳臣之谏"},{"time":208.89,"text":"忠言正视听"},{"time":211.39,"text":"教化定邦制礼乐"},{"time":213.84,"text":"广庇八方客 结友邻"},{"time":217.36,"text":"大国泱泱威而不犯"},{"time":220.19,"text":"四海万邦来朝盛名"},{"time":256.17,"text":"千载兴衰由谁评"},{"time":259.02,"text":"雁山白日照 皓月明"},{"time":262.52,"text":"圣主之道一心为民"},{"time":265.39,"text":"为君者应常记"},{"time":270.28,"text":"心志如山岳巍峨"},{"time":273.12,"text":"高峻而不动 树威德"},{"time":276.68,"text":"抚民以仁待臣以礼"},{"time":279.46,"text":"身范仪六合"},{"time":281.92,"text":"教化定邦制礼乐"},{"time":284.42,"text":"广庇八方客 结友邻"},{"time":287.96,"text":"大国泱泱威而不犯"},{"time":290.75,"text":"四海万邦来朝盛名"}]},{"title":"十二年后秋月夜","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":6.0,"text":"编曲 : 海鲜面"},{"time":9.0,"text":"混音 : 马尾嗷嗷子"},{"time":12.0,"text":"调教 : 纳兰寻风"},{"time":15.0,"text":"曲绘 : 野坂言火"},{"time":18.0,"text":"PV : 酱油红"},{"time":35.23,"text":"时少年 徘徊楼台之间"},{"time":42.29,"text":"翚檐高低"},{"time":44.93,"text":"跌宕如层山 起伏成海面"},{"time":49.35,"text":"作行舟 飘荡至于佛前"},{"time":56.43,"text":"闻君高歌"},{"time":59.05,"text":"松寒抖落雪 山长而水远"},{"time":66.32,"text":"三十年与君 共偕行"},{"time":70.31,"text":"迎五方游云 作四邻"},{"time":74.05,"text":"菩提一叶 亦自飘零 不辨浊清"},{"time":80.44,"text":"三十年无酒 共河饮"},{"time":84.41,"text":"笑远风来处 好开襟"},{"time":88.17,"text":"娑婆世界 天星乍明 点染江心"},{"time":109.56,"text":"是踽踽俗身"},{"time":111.32,"text":"自烟尘中来"},{"time":113.13,"text":"闻和尚吟唱"},{"time":114.87,"text":"白鹭白雪白骨如来"},{"time":116.66,"text":"一灯长明未灭"},{"time":118.39,"text":"万千呼啸过的须臾"},{"time":120.15,"text":"浮生似露影了无痕迹"},{"time":121.92,"text":"留一些风月诗句"},{"time":123.69,"text":"四十春秋就像"},{"time":125.45,"text":"残本的经卷翻开"},{"time":127.23,"text":"你是六道中的行客"},{"time":129.22,"text":"背影慷慨"},{"time":130.78,"text":"余下半句佛偈"},{"time":132.09,"text":"坐枯了谁仙去的莲台"},{"time":134.28,"text":"说故人或再相见"},{"time":136.06,"text":"在大山大海"},{"time":140.44,"text":"看明月照在 天竺山"},{"time":144.42,"text":"吹萤光满谷 映满川"},{"time":148.17,"text":"无处寻访 忽闻歌声 在秋水岸"},{"time":154.55,"text":"看明月照在 葛洪川"},{"time":158.53,"text":"叩角唱竹枝 入青山"},{"time":162.36,"text":"无由叙话 只见故人 来去姗姗"},{"time":177.5,"text":"三生石不论 风月赏"},{"time":181.47,"text":"身前身后事 皆茫茫"},{"time":185.22,"text":"因缘如是 烟棹南上 却回瞿塘"},{"time":191.6,"text":"看明月照在 天竺山"},{"time":195.58,"text":"吹萤光满谷 映满川"},{"time":199.35,"text":"无处寻访 忽闻歌声 在秋水岸"}]},{"title":"大唐玄怪来谒","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":8.0,"text":"调校 : 我才木有"},{"time":27.67,"text":"文翰初议周隋"},{"time":30.16,"text":"再话旧唐"},{"time":31.56,"text":"以尺墨安定狐媚"},{"time":36.41,"text":"平生偏好奇诡"},{"time":38.66,"text":"又易食髓知味"},{"time":40.66,"text":"秉夜烛 诗邀神鬼"},{"time":45.73,"text":"听说落魄书生"},{"time":48.28,"text":"杜氏子春"},{"time":49.74,"text":"虎皮上两世长梦"},{"time":54.75,"text":"成仙或为人"},{"time":56.82,"text":"他已识门道九分"},{"time":58.77,"text":"偏情字入骨深"},{"time":63.32,"text":"清夜慎持明烛台"},{"time":65.55,"text":"它亦吟得词句入怀"},{"time":69.52,"text":"大唐遍出诗才"},{"time":72.35,"text":"待我坐镇云峰台"},{"time":74.61,"text":"千里紫霞参拜"},{"time":78.59,"text":"引鹤来"},{"time":81.42,"text":"剑指乌妖一当百"},{"time":83.68,"text":"身性刚正怎怕污邪"},{"time":88.16,"text":"侵害"},{"time":90.46,"text":"只把酒此生付慷慨"},{"time":94.45,"text":"喝完"},{"time":96.45,"text":"披朱衣再去游炎海"},{"time":118.19,"text":"笔触刺骨几分"},{"time":120.75,"text":"毫若青锋"},{"time":122.19,"text":"如凡俗入骨几寸"},{"time":126.96,"text":"最难罢品红尘"},{"time":129.24,"text":"异事易勾瘾症"},{"time":131.19,"text":"上酒卮 劳君多论"},{"time":136.28,"text":"时人文章评批"},{"time":138.86,"text":"非不靡丽"},{"time":140.18,"text":"却可惜殊少骨气"},{"time":145.37,"text":"不如拂袖去"},{"time":147.35,"text":"练绝这一手棋技"},{"time":149.34,"text":"普世人桔中戏"},{"time":153.84,"text":"当心红鬼鸣鼓钟"},{"time":156.12,"text":"提柄长剑叩你颈痛"},{"time":160.09,"text":"方知善恶有终"},{"time":162.93,"text":"上元广陵景最浓"},{"time":165.2,"text":"由我乘驾天虹"},{"time":169.15,"text":"彩云中"},{"time":171.98,"text":"敢凭纸符救白龙"},{"time":174.24,"text":"并非是我醉得太过"},{"time":178.77,"text":"放纵"},{"time":181.01,"text":"只爱煞一生逞英雄"},{"time":184.98,"text":"不叹匆匆"},{"time":211.02,"text":"真君子不言怪"},{"time":213.59,"text":"自诩假小人尽可谈的开怀"},{"time":219.55,"text":"因我解下绣龙裳"},{"time":221.76,"text":"世间无人敢自称王"},{"time":225.76,"text":"犯我半分张狂"},{"time":228.58,"text":"挑亮烛光点鬼将"},{"time":230.86,"text":"推杯豪饮琼浆"},{"time":234.82,"text":"祭参商"},{"time":237.65,"text":"扬手呼童请明皇"},{"time":239.92,"text":"突觉喉中酒烈吐出"},{"time":244.43,"text":"金蟒"},{"time":246.72,"text":"吞山河胸胆正开张"},{"time":250.61,"text":"容我"},{"time":252.66,"text":"怒书这一卷说盛唐"}]},{"title":"如懒残言","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":2.96,"text":"编曲：海鲜面"},{"time":8.75,"text":"调校：Creuzer"},{"time":46.66,"text":"我不乐生天 亦不爱福田"},{"time":52.49,"text":"饥来食碗米 困来倒头眠"},{"time":58.32,"text":"衡山常巍巍 湘水长绵绵"},{"time":64.14,"text":"山径随我行 水清洗我面"},{"time":70.17,"text":"无事无端 自无忧无虑无散乱"},{"time":73.18,"text":"且啖冷残 也可求得腹中安"},{"time":76.02,"text":"无缘无故 无须无谓论一段"},{"time":78.97,"text":"过去已过 未来莫由人算"},{"time":81.97,"text":"举手招云入怀袖 南岳既立我则来游"},{"time":87.74,"text":"牛粪取火煨芋头 仰向群星吟啸半宿"},{"time":93.57,"text":"莫怨脚下道难通 不过拦路几块小石头"},{"time":99.45,"text":"如我所言不妨踩着走"},{"time":102.33,"text":"碧涧长流 与我同下山丘"},{"time":128.55,"text":"大不居方所 小可住蓬屋"},{"time":134.33,"text":"深宵对松炉 野蛾扑窗入"},{"time":140.15,"text":"鹑衣尘中走 燕舟浪里渡"},{"time":145.98,"text":"折柳约青鲈 清风忽如注"},{"time":151.86,"text":"多事多患 总多言多语多相误"},{"time":154.7,"text":"欲度众生 过犹不及且自度"},{"time":157.62,"text":"多嘴多舌 多有闲人多摆谱"},{"time":160.52,"text":"聪明难为 不如一梦糊涂"},{"time":163.56,"text":"珠宫怎比此间阔 山云当幕夜月成钩"},{"time":169.29,"text":"懒为俗人拭粥涕 不朝天子岂羡王侯"},{"time":175.12,"text":"锁向金笼婉转吟 不及林间自在鸣啾啾"},{"time":180.95,"text":"如我所言就地睡个够"},{"time":183.84,"text":"藤萝下卧 苔石便作枕头"},{"time":213.03,"text":"自有洞天三十六 何向金殿寻一处留"},{"time":218.8,"text":"时从池影看云还 谪来人间千个昏昼"},{"time":224.69,"text":"尝得熟芋好风味 这趟俗世算是没白走"},{"time":230.52,"text":"如我所言春来草自稠"},{"time":233.43,"text":"任虎叼去 不过就一狂叟"}]},{"title":"洞庭","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":0.08,"text":"作曲 : 海鲜面"},{"time":0.17,"text":"洞庭"},{"time":4.92,"text":"作编曲：海鲜面"},{"time":8.42,"text":"作词：邪叫教主"},{"time":11.42,"text":"演唱：小白龙"},{"time":14.42,"text":"和声/监棚：马鸿儒"},{"time":16.92,"text":"混音：马尾嗷嗷子"},{"time":20.17,"text":"灵感来源于《甘泽谣·韦驺》"},{"time":32.17,"text":"望太清 凤鸟帅云霓"},{"time":35.67,"text":"两翼一振去昆仑西"},{"time":39.67,"text":"引劲风 吹落山巅石"},{"time":43.17,"text":"惊涌重湖水八百里"},{"time":47.36,"text":"“风扯雷 雨来川"},{"time":54.86,"text":"龙摆尾 龟镇潭”"},{"time":62.61,"text":"倒乾坤 吞云吐大江"},{"time":65.8,"text":"波下月宫生万顷光"},{"time":69.8,"text":"王母镜 横开十余丈"},{"time":73.3,"text":"照君山千年几经霜"},{"time":77.3,"text":"是司羿一箭 直取巨蛇 堆骨而成巴陵"},{"time":85.48,"text":"峰回无穷雁 百代迁飞不尽 腾转入青冥"},{"time":92.73,"text":"是二妃泪洒 潇湘万竹 九嶷长辞帝君"},{"time":100.48,"text":"人间须臾变 秋风久吹不老 千古惟洞庭"},{"time":123.73,"text":"倒乾坤 吞云吐大江"},{"time":126.98,"text":"波下月宫生万顷光"},{"time":130.98,"text":"王母镜 横开十余丈"},{"time":134.48,"text":"照君山千年几经霜"},{"time":138.48,"text":"是柳毅传书 龙君震怒 断金锁掣玉柱"},{"time":146.48,"text":"钧天咸池乐 昔奏贵主还宫 而今为君鼓"},{"time":153.42,"text":"是章华倾倒 郢都无迹 楚臣临江问渡"},{"time":161.67,"text":"忽闻朗吟声 遥在烟楼高台 吕仙换酒处"},{"time":176.92,"text":"“齐天水 渡人船"},{"time":184.42,"text":"下洞庭 上江汉"},{"time":192.17,"text":"风扯雷 雨来川"},{"time":199.92,"text":"龙摆尾 龟镇潭”"},{"time":210.86,"text":"虽天行有常 大道无情 因缘生灭万物"},{"time":218.61,"text":"众生自轮转 沧海化于一粟 蚍蜉亦撼树"},{"time":225.86,"text":"作云中一梦 旷然忘忧 浮世聚散不定"},{"time":234.36,"text":"归舟谢神明 若问至音何名 此曲曰洞庭"},{"time":257.22,"text":"“齐天水 渡人船"},{"time":272.97,"text":"下洞庭 上江汉”"}]},{"title":"笛裂","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":0.1,"text":"作曲 : 海鲜面"},{"time":0.21,"text":"笛裂"},{"time":1.96,"text":"作编曲：海鲜面"},{"time":3.71,"text":"作词：邪叫教主"},{"time":5.21,"text":"人声本家：狮三百（乐队）"},{"time":7.21,"text":"混音：西门振"},{"time":13.46,"text":"灵感来源于《甘泽谣·许云封》"},{"time":21.21,"text":"忽而听尽梨园二十八段曲"},{"time":24.71,"text":"夜泊江上又闻一支横笛"},{"time":28.21,"text":"你若问我舟楫将荡向哪里"},{"time":31.46,"text":"瀛洲仙山不妨也一同去"},{"time":35.21,"text":"惜《折杨柳》 咏《梅花落》"},{"time":38.71,"text":"陇头《望行人》 又上《长安道》"},{"time":42.21,"text":"玄宗鼓乐 贵妃击磐"},{"time":45.71,"text":"我向咸阳主 借吹昭华管"},{"time":49.71,"text":"引笛一啸为我呼得凉月"},{"time":52.96,"text":"出关山 出关山"},{"time":54.96,"text":"将云雾拨散"},{"time":56.39,"text":"照彻瑶台照我大敞襟怀"},{"time":59.89,"text":"引凤来 引凤来"},{"time":62.14,"text":"举翼奔南海"},{"time":63.64,"text":"天地无穷长歌寄往何处"},{"time":66.89,"text":"风休住 风休住"},{"time":69.14,"text":"鸣动钟与鼓"},{"time":70.64,"text":"随赋清平调 酒痕题画壁"},{"time":74.14,"text":"当纵意 当纵意"},{"time":76.08,"text":"写下几首绝句"},{"time":91.83,"text":"十三叠里凉州哪见独孤翁"},{"time":95.33,"text":"离岸客船邀来一条蛟龙"},{"time":98.83,"text":"你若问我舟楫为何去匆匆"},{"time":102.33,"text":"过路春秋本就像一场梦"},{"time":105.83,"text":"惜《折杨柳》 咏《梅花落》"},{"time":109.33,"text":"陇头《望行人》 又上《长安道》"},{"time":112.83,"text":"玄宗鼓乐 贵妃击磐"},{"time":116.33,"text":"我向咸阳主 借吹昭华管"},{"time":120.08,"text":"引笛一啸为我呼得白马"},{"time":123.58,"text":"出关山 出关山"},{"time":125.52,"text":"将花影踏乱"},{"time":127.02,"text":"唱罢人间唱我好不快哉"},{"time":130.52,"text":"引凤来 引凤来"},{"time":132.52,"text":"举翼向蓬莱"},{"time":134.27,"text":"我主风月要请万象为宾"},{"time":137.77,"text":"杯莫停 杯莫停"},{"time":139.52,"text":"相逢为君饮"},{"time":141.27,"text":"嘹唳上青天 化鹤自由飞"},{"time":144.52,"text":"不胜醉 不胜醉"},{"time":147.02,"text":"兴未尽人不归"},{"time":169.52,"text":"二十八曲解忧愁"},{"time":173.02,"text":"十三叠里唱凉州"},{"time":176.52,"text":"未至入破 且就由我"},{"time":179.77,"text":"自在歌 自在歌"},{"time":184.96,"text":"天地无情自是一本曲谱"},{"time":188.71,"text":"风休住 风休住"},{"time":190.71,"text":"吹有情万物"},{"time":192.46,"text":"日月不留留我放诞词笔"},{"time":195.71,"text":"当纵意 当纵意"},{"time":197.71,"text":"唱几首绝句"},{"time":199.46,"text":"我主风月要等一位知音"},{"time":202.96,"text":"杯莫停 杯莫停"},{"time":204.96,"text":"相约在旗亭"},{"time":206.41,"text":"妙音上青天 穿云不复回"},{"time":209.91,"text":"不胜醉 不胜醉"},{"time":211.91,"text":"竹笛应声而碎"}]},{"title":"红线盗盒","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":2.0,"text":"编曲 : 海鲜面"},{"time":3.0,"text":"混音 : 海鲜面"},{"time":4.0,"text":"调校 : 纳兰寻风"},{"time":5.0,"text":"曲绘 : 逢时"},{"time":6.0,"text":"PV : saiqomo、乐藏"},{"time":7.0,"text":"题字 : 顾辞夏"},{"time":8.0,"text":"logo : 笙寒【歆悦呈符】"},{"time":9.0,"text":"灵感来源于《甘泽谣·红线》"},{"time":15.98,"text":"青烟浮剑影入凉风"},{"time":19.29,"text":"谯楼正打三更"},{"time":21.29,"text":"飞身渡长河未敢惊鱼龙"},{"time":25.98,"text":"夜露坠是闻佩环微动"},{"time":29.33,"text":"一霎而隐于云中"},{"time":31.96,"text":"只余得四野俱寂寂"},{"time":35.3,"text":"孤月悬于苍空"},{"time":37.28,"text":"听羯鼓悲歌骨中痛"},{"time":40.62,"text":"在世不得从容"},{"time":42.62,"text":"生乱世其身更是不由衷"},{"time":47.28,"text":"时人把前朝豪杰称颂"},{"time":50.63,"text":"而眼下却无英雄"},{"time":53.29,"text":"长嗟复再叹亦无用"},{"time":56.62,"text":"红线自去领功"},{"time":58.96,"text":"看当世王府官曹"},{"time":61.63,"text":"坐中皆窃世大盗"},{"time":64.32,"text":"我今探虎口取宝"},{"time":66.66,"text":"不过效其一点皮毛"},{"time":69.61,"text":"西来山风送鼓角"},{"time":72.28,"text":"绡纱弄舞上玉霄"},{"time":74.96,"text":"直入天阙偷星皎皎"},{"time":79.28,"text":"四弦十二柱上叩浩歌剑前置酒"},{"time":84.61,"text":"草泽间自古不尽英杰风流"},{"time":89.94,"text":"此去一行独向江湖棹兰舟"},{"time":95.29,"text":"碧天无际刹那间飞星已别百尺楼"},{"time":114.65,"text":"灯一颤即过数重门"},{"time":117.95,"text":"倏忽不见其人"},{"time":119.95,"text":"轻履点廊下军士皆不闻"},{"time":124.62,"text":"三千兵甲兰堂上同梦"},{"time":127.96,"text":"不觉我已入寝门"},{"time":130.62,"text":"其时烛光熄而不明"},{"time":133.94,"text":"炉中香已尽焚"},{"time":135.95,"text":"帐后人酣睡亦沉沉"},{"time":139.3,"text":"人头犀上高枕"},{"time":141.3,"text":"但无意教刃下多一亡魂"},{"time":145.96,"text":"项上留其首只取其簪"},{"time":149.28,"text":"持金盒而出魏城"},{"time":151.99,"text":"转眼间将行二百里"},{"time":155.29,"text":"鸡鸣始报晓晨"},{"time":157.65,"text":"忽然见斜月在林"},{"time":160.3,"text":"铜雀台高揭入云"},{"time":162.96,"text":"青史湮没封侯名"},{"time":165.3,"text":"似两河水奔流不停"},{"time":168.28,"text":"十九年命犯妖星"},{"time":170.95,"text":"更难除冥顽秉性"},{"time":173.63,"text":"拜谢知遇三生有幸"},{"time":177.97,"text":"四弦十二柱上叩浩歌剑前置酒"},{"time":183.28,"text":"草泽间自古不尽英杰风流"},{"time":188.63,"text":"此去一行独向江湖棹兰舟"},{"time":193.97,"text":"碧天无际刹那间飞星已别百尺楼"},{"time":222.03,"text":"（京白：来此已是漳河，待俺飞渡过去！）"},{"time":231.28,"text":"四弦十二柱上叩浩歌剑前置酒"},{"time":236.63,"text":"草泽间自古不尽英杰风流"},{"time":241.96,"text":"此去一行独向江湖棹兰舟"},{"time":247.29,"text":"碧天无际刹那间飞星已别百尺楼"}]},{"title":"聂隐娘","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":0.23,"text":"作曲 : 海鲜面"},{"time":0.46,"text":"作编曲：海鲜面"},{"time":1.97,"text":"作词：邪叫教主"},{"time":3.71,"text":"灵感来源于《甘泽谣·聂隐娘》"},{"time":5.22,"text":"调校：纳兰寻风"},{"time":6.46,"text":"混音：马尾嗷嗷子"},{"time":7.22,"text":"琵琶：远坂麦芽"},{"time":7.72,"text":"京胡：柠檬CC露"},{"time":8.22,"text":"笛箫：O天气晴朗O"},{"time":8.71,"text":"实录监制：司鼓君"},{"time":9.47,"text":"【Rap】"},{"time":10.0,"text":"青衫白面长执宝剑"},{"time":13.0,"text":"刺猿斩虎身轻如燕"},{"time":15.5,"text":"白日杀人人莫能见"},{"time":18.25,"text":"锋光出似镜悬"},{"time":20.75,"text":"使击鹰隼无不能中"},{"time":23.25,"text":"精精空空未得始终"},{"time":25.75,"text":"人入长安我入长梦"},{"time":28.75,"text":"自向山水如风"},{"time":31.12,"text":"登走峭壁飞涧"},{"time":33.9,"text":"一年练成刺猿"},{"time":36.48,"text":"二年功力能当虎豹 决首于前"},{"time":41.75,"text":"鹰掠如矢离弦"},{"time":44.0,"text":"出鞘断其羽翦"},{"time":46.85,"text":"如此三年再视其剑 刃有五寸减"},{"time":51.86,"text":"四年携我入市"},{"time":54.85,"text":"万恶皆有所指"},{"time":57.25,"text":"黑白人间无惧无恃 持匕而刺"},{"time":62.2,"text":"常令命悬一线"},{"time":65.0,"text":"动身不可动念"},{"time":67.75,"text":"五年习术直至物我 皆不见"},{"time":72.9,"text":"万里来风红幡阵前 白幡动"},{"time":77.5,"text":"是那夜 夜云奔涌我将没入其中"},{"time":83.1,"text":"沉浮世人似仙似魔 似种种"},{"time":87.75,"text":"池泽荒野中惟我似飞鸿"},{"time":94.0,"text":"羊角短匕借照寒月 上眉弓"},{"time":98.0,"text":"追白鸟 鸟踏千峰我踏檐上灯笼"},{"time":104.15,"text":"百代日月将送风尘 赴枯荣"},{"time":108.6,"text":"今我大隐隐于人间躁动"},{"time":135.5,"text":"中宵制敌在先"},{"time":138.0,"text":"虚冥空空浮现"},{"time":140.75,"text":"骑跨白卫天地来去 风里扬鞭"},{"time":145.9,"text":"含影藏形九变"},{"time":148.5,"text":"阴阳断于掌边"},{"time":151.0,"text":"生死起灭众生与我 皆不见"},{"time":156.5,"text":"颠沛世情饮冰而我 饮川洪"},{"time":160.5,"text":"悬天河 万流奔冲我将没入其中"},{"time":166.75,"text":"镜里迷蒙似花似月 似种种"},{"time":170.9,"text":"千般皮相中见诸相皆空"},{"time":177.25,"text":"非是侠义但取颈上 落头风"},{"time":181.5,"text":"颅后刀 刀出无影我亦来去无踪"},{"time":187.75,"text":"轮回大义将送白骨 赴枯荣"},{"time":191.9,"text":"今我闻道全在一斩之中"},{"time":221.5,"text":"万里来风红幡阵前 白幡动"},{"time":226.0,"text":"是那夜 夜云奔涌我将没入其中"},{"time":232.0,"text":"百代日月将送风尘 赴枯荣"},{"time":236.2,"text":"今我大隐隐于人间躁动"},{"time":242.5,"text":"颠沛世情饮冰而我 饮川洪"},{"time":246.7,"text":"悬天河 万流奔冲我将没入其中"},{"time":253.0,"text":"轮回大义将送白骨 赴枯荣"},{"time":257.0,"text":"今我闻道全在一斩之中"}]},{"title":"至宝","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":0.09,"text":"作曲 : 海鲜面"},{"time":0.18,"text":"至宝"},{"time":11.18,"text":"编曲：海鲜面"},{"time":15.18,"text":"人声本家：陈说"},{"time":18.18,"text":"混音：西门振"},{"time":22.18,"text":"灵感来源于《甘泽谣·陶岘》"},{"time":29.68,"text":"龙泉宝剑气冲七星"},{"time":32.62,"text":"如断虹飞电在握 一出鞘则斩不平"},{"time":36.87,"text":"蓝田美玉性通灵"},{"time":39.37,"text":"浑然天所就 巧琢具匠心"},{"time":59.12,"text":"美玉四寸环 宝剑二尺冰"},{"time":65.87,"text":"执此双至宝 陶公烦请听"},{"time":73.12,"text":"宝剑藏匣中"},{"time":76.37,"text":"长夜哀泣作雷鸣"},{"time":80.37,"text":"玉环置椟中"},{"time":83.62,"text":"日久蒙尘晦不明"},{"time":87.87,"text":"不劈风斩浊浪 怎舒侠情"},{"time":91.12,"text":"不经日渐月染 怎显清莹"},{"time":95.12,"text":"嗟乎至宝 无以致用"},{"time":98.62,"text":"徒叹世事 何能试昆吾锋"},{"time":124.62,"text":"摩诃勇士天生忠勇"},{"time":127.12,"text":"如沧海力士再世 一挥椎则惊豪雄"},{"time":131.62,"text":"冯夷水宫居蛟龙"},{"time":133.87,"text":"奋髯喷白浪 啸吼怒波丛"},{"time":138.99,"text":"百代出勇士 千年生蛟龙"},{"time":145.99,"text":"有此双至宝 进劝向天公"},{"time":153.24,"text":"勇士无良用"},{"time":156.49,"text":"深泉未尽气竟穷"},{"time":160.49,"text":"蛟龙沉水宫"},{"time":163.69,"text":"昏睡不醒绝其踪"},{"time":167.94,"text":"不逢千载一时 怎立奇功"},{"time":171.44,"text":"不出海腾天去 怎掀云涌"},{"time":174.94,"text":"嗟乎至宝 无以致用"},{"time":178.69,"text":"徒恨造化 何处敢露峥嵘"},{"time":198.69,"text":"我流落风中"},{"time":201.94,"text":"诗才抛如剑与琼"},{"time":205.94,"text":"我埋没尘中"},{"time":209.19,"text":"心志蛰如士与龙"},{"time":213.44,"text":"不遇举翼之风 怎效大鹏"},{"time":216.94,"text":"寄湖海清商曲 今亦歌咏"},{"time":220.44,"text":"嗟乎至宝 无以致用"},{"time":224.19,"text":"徒望青山 留我在醉饮中"}]},{"title":"花月妖","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":0.38,"text":"作曲 : 海鲜面"},{"time":0.76,"text":"编曲/混音：海鲜面"},{"time":4.39,"text":"调校：Creuzer"},{"time":6.27,"text":"唱：墨清弦"},{"time":8.18,"text":"和声：祖娅纳惜"},{"time":10.04,"text":"灵感来源于《甘泽谣·素娥》"},{"time":46.14,"text":"化形朝云暮雨 自以烟火傍身"},{"time":49.77,"text":"且顾盼 眼波不必识分寸"},{"time":53.56,"text":"指拨风月令牌 点数裙下之臣"},{"time":57.19,"text":"列群贤 争来赋韶华青春"},{"time":60.9,"text":"海棠色醺朱颜 又含红杏未吞"},{"time":64.58,"text":"君解语 何必令我先启唇"},{"time":68.29,"text":"祸国立名史册 倾城不劳尺刃"},{"time":71.95,"text":"这盛誉 最当属绝代佳人"},{"time":76.54,"text":"我乃百花中王侯"},{"time":79.13,"text":"戏荒唐春秋"},{"time":80.98,"text":"传靡靡之音四百州"},{"time":84.22,"text":"胭脂将里称魁首"},{"time":86.52,"text":"策酒令花筹"},{"time":88.32,"text":"艳杀乐府词三千首"},{"time":91.51,"text":"瑶台月下逢 春风拂槛 云想衣裳花想容"},{"time":98.93,"text":"从来盛世最难久"},{"time":101.31,"text":"迷梦摧迷楼"},{"time":103.16,"text":"不教那良夜歌舞休 纵情游"},{"time":123.72,"text":"曳裾香汗弥散 衫底冰肌稍透"},{"time":127.32,"text":"白莲颤 软玉足轻轻来勾"},{"time":131.11,"text":"洒落半斛明珠 分赐一襟温柔"},{"time":134.69,"text":"燃芳骨 引情热恰到火候"},{"time":138.4,"text":"礼乐不崩自坏 九五何尊之有"},{"time":142.11,"text":"欲拜我 先奉上绫罗锦绣"},{"time":145.85,"text":"连七星成垂竿 娥眉月作金钩"},{"time":149.5,"text":"有雅兴 沽名而钓世人愁"},{"time":153.94,"text":"我乃乱世之祸由"},{"time":156.74,"text":"无千金在手"},{"time":158.54,"text":"也挥霍江山万里秀"},{"time":161.81,"text":"敢坐欢场中龙头"},{"time":164.05,"text":"写传世风流"},{"time":165.93,"text":"笑圣名不似艳名留"},{"time":169.12,"text":"瑶台月下逢 春风拂槛 云想衣裳花想容"},{"time":176.46,"text":"从来盛世好下酒"},{"time":178.94,"text":"醉倒万丈楼"},{"time":180.67,"text":"不见那良夜有尽头 从未够"},{"time":198.33,"text":"我乃乱世之祸由"},{"time":201.02,"text":"无千金在手"},{"time":202.9,"text":"也挥霍江山万里秀"},{"time":206.08,"text":"敢坐欢场中龙头"},{"time":208.44,"text":"写传世风流"},{"time":210.24,"text":"笑圣名不似艳名留"},{"time":216.82,"text":"我乃百花中王侯"},{"time":219.46,"text":"戏荒唐春秋"},{"time":221.34,"text":"传靡靡之音四百州"},{"time":224.53,"text":"胭脂将里称魁首"},{"time":226.88,"text":"策酒令花筹"},{"time":228.73,"text":"艳杀乐府词三千首"},{"time":231.87,"text":"瑶台月下逢 春风拂槛 云想衣裳花想容"},{"time":239.31,"text":"从来盛世最难久"},{"time":241.61,"text":"迷梦摧迷楼"},{"time":243.49,"text":"不教那良夜歌舞休 纵情游"}]}]}