        },
        {
          "time": 14.18,
          "text": "沾睫的雨 戏耍着灰"
        },
        {
          "time": 27.59,
          "text": "无瑕之约 诡异的美"
        },
        {
          "time": 66.61,
          "text": "指引的月 遗失方位"
        },
        {
          "time": 80.49,
          "text": "心中空缺 等待着谁"
        },
        {
          "time": 92.81,
          "text": "在毁灭之中"
        },
        {
          "time": 95.1,
          "text": "找寻希望 找寻遗忘 埋葬泪水"
        },
        {
          "time": 104.1,
          "text": "终于"
        },
        {
          "time": 106.47,
          "text": "黑 撕裂了所有誓言只剩懊悔"
        },
        {
          "time": 112.32,
          "text": "夜 褪去了伪装嘲弄我的愚昧"
        },
        {
          "time": 118.51,
          "text": "当泪水已不再属于我"
        },
        {
          "time": 123.26,
          "text": "等待的结果"
        },
        {
          "time": 126.14,
          "text": "哪怕是最后一点感觉"
        },
        {
          "time": 129.18,
          "text": "也是对于你的眷恋"
        },
        {
          "time": 183.87,
          "text": "找寻希望 找寻遗忘"
        },
        {
          "time": 190.24,
          "text": "来到 夜的终点"
        },
        {
          "time": 195.33,
          "text": "那既不是痛 也不是梦"
        },
        {
          "time": 201.42,
          "text": "那是只属于我的牢笼"
        },
        {
          "time": 207.83,
          "text": "黑 撕裂了所有关于你的后悔"
        },
        {
          "time": 213.51,
          "text": "夜 褪去了伪装拥抱我的愚昧"
        },
        {
          "time": 219.74,
          "text": "当黑夜已不再属于我"
        },
        {
          "time": 224.04,
          "text": "等待的结果"
        },
        {
          "time": 227.05,
          "text": "回忆只剩遇远的幻觉"
        },
        {
          "time": 230.37,
          "text": "已是对于我的恩惠"
        },
        {
          "time": 243.56,
          "text": "当回忆已不再属于我"
        },
        {
          "time": 248.14,
          "text": "也就再没有什么让我刺痛"
        },
        {
          "time": 255.24,
          "text": "已没有"
        }
      ]
