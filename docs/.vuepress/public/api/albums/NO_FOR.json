        },
        {
          "time": 46.53,
          "text": "本只想得过且过"
        },
        {
          "time": 48.2,
          "text": "现实却南辕北辙"
        },
        {
          "time": 49.91,
          "text": "被名为关怀枷锁"
        },
        {
          "time": 51.44,
          "text": "强制牵着鼻子走"
        },
        {
          "time": 53.13,
          "text": "其实更倾心黑色"
        },
        {
          "time": 56.06,
          "text": "真实按钮前退缩"
        },
        {
          "time": 59.92,
          "text": "为得到肯定做出了"
        },
        {
          "time": 63.09,
          "text": "背道而驰选择"
        },
        {
          "time": 66.52,
          "text": "如果不是为存在长久"
        },
        {
          "time": 69.46,
          "text": "非自愿成为迎合大众小丑"
        },
        {
          "time": 72.92,
          "text": "无心之举被赞赏"
        },
        {
          "time": 76.21,
          "text": "有意努力被剥夺"
        },
        {
          "time": 79.43,
          "text": "不想成为出头鸟随意定夺"
        },
        {
          "time": 82.72,
          "text": "原地不动等待闪耀的那颗"
        },
        {
          "time": 86.02,
          "text": "他们全部都后退几步不守规则"
        },
        {
          "time": 89.39,
          "text": "假意关心说把握机会别浪费了"
        },
        {
          "time": 92.76,
          "text": "不经允许擅自把希望寄托"
        },
        {
          "time": 95.89,
          "text": "从当事人变成无压力看客"
        },
        {
          "time": 99.2,
          "text": "只需骄傲不用为可能失败负责"
        },
        {
          "time": 102.47,
          "text": "谁关心舞台上主演说着什么"
        },
        {
          "time": 132.27,
          "text": "我已经 对未来 满意无追求"
        },
        {
          "time": 135.34,
          "text": "想坐在 不算大 安定的椅中"
        },
        {
          "time": 138.78,
          "text": "整理收到信件上"
        },
        {
          "time": 140.44,
          "text": "都是自说自话"
        },
        {
          "time": 141.94,
          "text": "喜欢讨厌和对错"
        },
        {
          "time": 145.66,
          "text": "坐上了不知道 通向哪列车"
        },
        {
          "time": 148.51,
          "text": "被屏幕内气氛 无形地折磨"
        },
        {
          "time": 151.76,
          "text": "本只想得过且过"
        },
        {
          "time": 153.25,
          "text": "现实却南辕北辙"
        },
        {
          "time": 154.97,
          "text": "被名为关怀枷锁"
        },
        {
          "time": 156.68,
          "text": "强制牵着鼻子走"
        },
        {
          "time": 158.34,
          "text": "不偏爱喜剧颜色"
        },
        {
          "time": 161.55,
          "text": "真实想法前退缩"
        },
        {
          "time": 164.86,
          "text": "为得到支持做出了"
        },
        {
          "time": 168.17,
          "text": "背道而驰选择"
        },
        {
          "time": 171.73,
          "text": "如果不是为了存在长久"
        },
        {
          "time": 174.6,
          "text": "非自愿成为迎合大众小丑"
        },
        {
          "time": 177.99,
          "text": "为瑕疵删除所有"
        },
        {
          "time": 181.09,
          "text": "过去不曾存在过"
        },
        {
          "time": 184.54,
          "text": "被迫成为出头鸟随意定夺"
        },
        {
          "time": 187.84,
          "text": "只能维持完美闪耀的那刻"
        },
        {
          "time": 191.18,
          "text": "他们全部都围成一圈撕碎规则"
        },
        {
          "time": 194.56,
          "text": "假意关心说把握真心别浪费了"
        },
        {
          "time": 197.95,
          "text": "不经允许擅自把责任寄托"
        },
        {
          "time": 201.05,
          "text": "从陌生人变成最亲密看客"
        },
        {
          "time": 204.37,
          "text": "只需笑不用担心任何可能后果"
        },
        {
          "time": 207.72,
          "text": "谁关心舞台上主演想要什么"
        },
        {
          "time": 211.05,
          "text": "是我 就是我"
        },
        {
          "time": 214.09,
          "text": "谁要这成绩拿走好了"
        },
        {
          "time": 217.46,
          "text": "他强 他最弱"
        },
        {
          "time": 220.68,
          "text": "简单标签谁不会贴呢"
        },
        {
          "time": 223.98,
          "text": "如果 我说如果"
        },
        {
          "time": 227.24,
          "text": "全都按照自愿的道路"
        },
        {
          "time": 230.43,
          "text": "走走走走走"
        },
        {
          "time": 233.67,
          "text": "想回到最普通源头"
        },
        {
          "time": 237.33,
          "text": "鲜花簇拥睁开眼睛是场梦"
        },
        {
          "time": 240.4,
          "text": "叮叮咚咚 耳机中七嘴八舌"
        },
        {
          "time": 243.71,
          "text": "不要再烦了 不要再吵了"
        },
        {
          "time": 246.27,
          "text": "不值得"
        },
        {
          "time": 247.12,
          "text": "疼痛过后 谁还在让我别回头"
        },
        {
          "time": 250.58,
          "text": "不经同意 擅自把罪孽寄托"
        },
        {
          "time": 253.55,
          "text": "任何成果 十年后谁会记得"
        },
        {
          "time": 256.96,
          "text": "被强迫承担 从所谓神坛上掉落"
        },
        {
          "time": 260.36,
          "text": "谁关心轮椅上主演想要什么"
        },
        {
          "time": 263.64,
          "text": "不要 别找我"
        },
        {
          "time": 266.55,
          "text": "谁要这成绩拿走好了"
        }
      ]
