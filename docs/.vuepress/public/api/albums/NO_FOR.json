    {
      "title": "非善类",
      "file": "非善类.lrc",
      "lyrics": [
        {
          "time": 14.41,
          "text": "真实想法习惯了不隐藏"
        },
        {
          "time": 17.85,
          "text": "无意识锋芒戳穿纸负伤"
        },
        {
          "time": 21.38,
          "text": "善意谎言 大都能被原谅"
        },
        {
          "time": 24.92,
          "text": "悲剧现实 捂住耳朵听不到声响"
        },
        {
          "time": 28.8,
          "text": "被欺骗衷心感谢上苍"
        },
        {
          "time": 30.57,
          "text": "误解诚实者贬低信仰"
        },
        {
          "time": 32.28,
          "text": "那天花乱坠吹嘘理想"
        },
        {
          "time": 34.03,
          "text": "俯视着信者高高在上"
        },
        {
          "time": 35.97,
          "text": "利用不知所措的迷茫"
        },
        {
          "time": 37.66,
          "text": "蚕食纷争中最后纯良"
        },
        {
          "time": 39.42,
          "text": "猜疑的种子生根发芽"
        },
        {
          "time": 40.76,
          "text": "退出到 怪圈外 装作欣赏"
        },
        {
          "time": 42.51,
          "text": "将怀疑猜忌之风饲养"
        },
        {
          "time": 45.65,
          "text": "收集互相撕咬野兽掉落的皮毛"
        },
        {
          "time": 49.64,
          "text": "自认为光明正大执行正确选项"
        },
        {
          "time": 53.12,
          "text": "握住棋子碾碎对面的女皇"
        },
        {
          "time": 56.68,
          "text": "善与恶定义模糊混淆"
        },
        {
          "time": 59.74,
          "text": "置身之外得利者是最清醒一方"
        },
        {
          "time": 63.78,
          "text": "“神” 脱去伪装在中央"
        },
        {
          "time": 67.28,
          "text": "扫除残渣 正义陷阱又布下"
        },
        {
          "time": 84.92,
          "text": "破坏法则习惯了不张扬"
        },
        {
          "time": 88.48,
          "text": "转移视线瞄准新的战场"
        },
        {
          "time": 91.97,
          "text": "善意提醒 大都能被原谅"
        },
        {
          "time": 95.45,
          "text": "逆耳忠言 清空大脑逐渐被遗忘"
        },
        {
          "time": 99.45,
          "text": "被蛊惑调查所谓旧账"
        },
        {
          "time": 101.13,
          "text": "自我感动后换个方向"
        },
        {
          "time": 102.98,
          "text": "那添油加醋包装真相"
        },
        {
          "time": 104.56,
          "text": "半真半假视线被吸纳"
        },
        {
          "time": 106.56,
          "text": "利用无处宣泄的渴望"
        },
        {
          "time": 108.26,
          "text": "腐化金钱构筑的围墙"
        },
        {
          "time": 110.01,
          "text": "站在愤怒猜忌斗兽场"
        },
        {
          "time": 111.45,
          "text": "非善类 观众席 欣赏对抗"
        },
        {
          "time": 113.25,
          "text": "火燃烧腥风血雨落下"
        },
        {
          "time": 116.29,
          "text": "售卖互相撕咬野兽掉落的齿牙"
        },
        {
          "time": 120.22,
          "text": "自认为光明正大执行正确选项"
        },
        {
          "time": 123.68,
          "text": "无人有错却依然两败俱伤"
        },
        {
          "time": 127.2,
          "text": "悄悄改变心中的度量"
        },
        {
          "time": 130.49,
          "text": "置身之外得利者是最理智一方"
        },
        {
          "time": 134.24,
          "text": "“神” 握住红酒杯品尝"
        },
        {
          "time": 137.84,
          "text": "收割成果 扭曲下一个梦想"
        }
      ]
    },
    {
      "title": "非完美",
      "file": "非完美.lrc",
      "lyrics": [
        {
          "time": 0.46,
          "text": "非完美 - 洛天依"
        },
        {
          "time": 14.79,
          "text": "尘土石砾填平划上斑马线"
        },
        {
          "time": 18.53,
          "text": "整齐沥青后的涂鸦消失不见"
        },
        {
          "time": 22.18,
          "text": "因为向信任那侧暴露了一切"
        },
        {
          "time": 25.66,
          "text": "代价失去 隐私空间"
        },
        {
          "time": 28.79,
          "text": "喜爱悲伤的眉眼"
        },
        {
          "time": 30.92,
          "text": "得到白月光理解"
        },
        {
          "time": 32.59,
          "text": "你唐突露出笑颜"
        },
        {
          "time": 34.34,
          "text": "把我赶回到了边界"
        },
        {
          "time": 36.13,
          "text": "收集残缺碎片"
        },
        {
          "time": 37.77,
          "text": "独一无二的拼接"
        },
        {
          "time": 39.7,
          "text": "被当成了垃圾"
        },
        {
          "time": 41.36,
          "text": "只放过翠绿的枝叶"
        },
        {
          "time": 43.38,
          "text": "孤独地与影子说你好和再见"
        },
        {
          "time": 46.82,
          "text": "唯一伙伴在灯管下忽隐忽现"
        },
        {
          "time": 50.38,
          "text": "谁打开四周开关照亮黑夜"
        },
        {
          "time": 53.86,
          "text": "幻想消失光明之间"
        },
        {
          "time": 57.5,
          "text": "用即兴的歌词和走调旋律"
        },
        {
          "time": 61.59,
          "text": "在废墟声嘶力竭"
        },
        {
          "time": 64.64,
          "text": "为什么修复音节去除破音后"
        },
        {
          "time": 67.92,
          "text": "完美表演不再拥有力量过于和谐"
        },
        {
          "time": 71.97,
          "text": "不能再如我所愿"
        },
        {
          "time": 73.94,
          "text": "重蹈复撤不向前"
        },
        {
          "time": 75.63,
          "text": "贴上非完美象征单一基准标签"
        },
        {
          "time": 79.26,
          "text": "因为过于温暖"
        },
        {
          "time": 80.9,
          "text": "泪水还未流下眼"
        },
        {
          "time": 84.79,
          "text": "蒸发后离别"
        },
        {
          "time": 100.9,
          "text": "朝阳醒来缓慢跃上地平线"
        },
        {
          "time": 104.23,
          "text": "静谧空气后萤火虫消失不见"
        },
        {
          "time": 108.07,
          "text": "因为向憧憬那侧透露了一切"
        },
        {
          "time": 111.59,
          "text": "代价失去 新鲜感觉"
        },
        {
          "time": 115.07,
          "text": "享受过程没终点"
        },
        {
          "time": 116.84,
          "text": "希望旅行能永远"
        },
        {
          "time": 118.63,
          "text": "美好结局却出现"
        },
        {
          "time": 120.43,
          "text": "让我停滞最后边缘"
        },
        {
          "time": 122.26,
          "text": "打碎完整镜片"
        },
        {
          "time": 123.77,
          "text": "独一无二地拼接"
        },
        {
          "time": 125.57,
          "text": "被当成了隐患"
        },
        {
          "time": 127.38,
          "text": "只放过融化的残雪"
        },
        {
          "time": 129.39,
          "text": "孤独的与倒影说谢谢和抱歉"
        },
        {
          "time": 132.74,
          "text": "唯一伙伴在涟漪中忽隐忽现"
        },
        {
          "time": 136.36,
          "text": "谁打开闸门找寻失踪宝剑"
        },
        {
          "time": 139.93,
          "text": "幻想消失财富之间"
        },
        {
          "time": 143.32,
          "text": "用即兴的笔触和廉价颜料"
        },
        {
          "time": 147.53,
          "text": "涂抹开裂的墙面"
        },
        {
          "time": 150.68,
          "text": "为什么修复溅墨去除线条后"
