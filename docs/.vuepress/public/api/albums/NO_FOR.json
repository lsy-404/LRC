    {
      "title": "非同心",
      "file": "非同心.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "作词 : sya"
        },
        {
          "time": 1.0,
          "text": "作曲 : sya"
        },
        {
          "time": 9.19,
          "text": "天真相信着所有的志同道合"
        },
        {
          "time": 13.44,
          "text": "把信任放在盘中 一股脑诉说"
        },
        {
          "time": 17.95,
          "text": "左边在鼓掌祝贺 右边踮起脚靠拢"
        },
        {
          "time": 22.19,
          "text": "谁笑容是真的 谁又无奈附和"
        },
        {
          "time": 26.44,
          "text": "因为换了一个装扮 态度急转变冷漠"
        },
        {
          "time": 30.95,
          "text": "连口中棒棒糖 都被当成烟了"
        },
        {
          "time": 35.44,
          "text": "每一个羔羊寻求安全自我保护"
        },
        {
          "time": 37.7,
          "text": "对染上黑色皮毛同伴退避三舍"
        },
        {
          "time": 39.69,
          "text": "否认围栏外逃离者存在过"
        },
        {
          "time": 44.19,
          "text": "转盘 指针朝向谁能预测"
        },
        {
          "time": 47.45,
          "text": "“随机”抽选的 幸运儿"
        },
        {
          "time": 49.69,
          "text": "承担一切对所有失误负责"
        },
        {
          "time": 52.94,
          "text": "手中 玩具喷出的不是火"
        },
        {
          "time": 56.19,
          "text": "被没收 询问 哦 是么？"
        },
        {
          "time": 58.44,
          "text": "盖棺定论的事不接受反驳"
        },
        {
          "time": 65.94,
          "text": "~"
        },
        {
          "time": 79.69,
          "text": "天真珍藏着所有的意气相投"
        },
        {
          "time": 83.94,
          "text": "把喜爱暴露无遗 和盘托出了"
        },
        {
          "time": 88.44,
          "text": "左边在不断点头 右边在舞动笔墨"
        },
        {
          "time": 92.69,
          "text": "谁在当做笑柄 谁又在散播中"
        },
        {
          "time": 96.94,
          "text": "因为多了一种颜色 态度急转变冷漠"
        },
        {
          "time": 101.19,
          "text": "连手中的枝杈 都被当武器了"
        },
        {
