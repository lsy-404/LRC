    {
      "title": "4 苍白梦书",
      "file": "4 苍白梦书.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "《苍白梦书》"
        },
        {
          "time": 13.93,
          "text": "曲/小野道"
        },
        {
          "time": 27.69,
          "text": "词/赭莓奶"
        },
        {
          "time": 58.04,
          "text": "像是"
        },
        {
          "time": 61.27,
          "text": "一个梦"
        },
        {
          "time": 64.87,
          "text": "相同时空"
        },
        {
          "time": 66.81,
          "text": "陌生的面容"
        },
        {
          "time": 70.22,
          "text": "信号灯"
        },
        {
          "time": 73.7,
          "text": "大雨之中"
        },
        {
          "time": 78.38,
          "text": "破碎的躯体"
        },
        {
          "time": 80.51,
          "text": "乌云在翻涌"
        },
        {
          "time": 85.66,
          "text": "旋转着"
        },
        {
          "time": 89.1,
          "text": "老摆钟"
        },
        {
          "time": 92.29,
          "text": "划过指缝"
        },
        {
          "time": 94.6,
          "text": "是夏夜的风"
        },
        {
          "time": 99.31,
          "text": "是懦弱"
        },
        {
          "time": 102.77,
          "text": "或凡庸"
        },
        {
          "time": 106.27,
          "text": "我从来不甘沦为观众"
        },
        {
          "time": 111.38,
          "text": "零星树叶"
        },
        {
          "time": 114.66,
          "text": "无声地落下"
        },
        {
          "time": 118.16,
          "text": "点缀了"
        },
        {
          "time": 121.41,
          "text": "某朵无名的花"
        },
        {
          "time": 125.02,
          "text": "漂泊的船"
        },
        {
          "time": 128.22,
          "text": "能驶到大海吗"
        },
        {
          "time": 133.53,
          "text": "怀揣着那句你未讲的话"
        },
        {
          "time": 138.39,
          "text": "名为爱吧"
        },
        {
          "time": 143.1,
          "text": "伸出这双臂"
        },
        {
          "time": 154.34,
          "text": "这心意"
        },
        {
          "time": 160.25,
          "text": "你会懂吧"
        },
        {
          "time": 167.45,
          "text": "儿时"
        },
        {
          "time": 170.9,
          "text": "薄荷糖"
        },
        {
          "time": 174.56,
          "text": "统统蒸发"
        },
        {
          "time": 176.53,
          "text": "在时间汪洋"
        },
        {
          "time": 179.91,
          "text": "把勇气"
        },
        {
          "time": 183.37,
          "text": "装进行囊"
        },
        {
          "time": 188.07,
          "text": "祈求一束光"
        },
        {
          "time": 189.8,
          "text": "照进你心房"
        },
        {
          "time": 195.37,
          "text": "被拥抱"
        },
        {
          "time": 198.78,
          "text": "被原谅"
        },
        {
          "time": 201.91,
          "text": "人生剧场"
        },
        {
          "time": 204.37,
          "text": "为自己拍掌"
        },
        {
          "time": 209.15,
          "text": "这岁月"
        },
        {
          "time": 212.5,
          "text": "还很长"
        },
        {
          "time": 215.93,
          "text": "让星辰"
        },
        {
          "time": 217.18,
          "text": "点亮每个胸膛"
        },
        {
          "time": 221.06,
          "text": "零星树叶"
        },
        {
          "time": 224.27,
          "text": "无声地落下"
        },
        {
          "time": 227.92,
          "text": "点缀了"
        },
        {
          "time": 231.11,
          "text": "某朵无名的花"
        },
        {
          "time": 234.77,
          "text": "漂泊的船"
        },
        {
          "time": 237.92,
          "text": "能驶向大海吗"
        },
        {
