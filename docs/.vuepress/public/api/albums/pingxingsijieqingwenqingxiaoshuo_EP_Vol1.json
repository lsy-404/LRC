    {
      "title": "2 神圣之名",
      "file": "2 神圣之名.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "《神圣之名》"
        },
        {
          "time": 6.53,
          "text": "BV1vW411h7Qf"
        },
        {
          "time": 13.2,
          "text": "Vocal：星尘"
        },
        {
          "time": 18.05,
          "text": "曲：希望索任合资"
        },
        {
          "time": 23.04,
          "text": "词：雨狸"
        },
        {
          "time": 29.59,
          "text": "调：纳兰寻风"
        },
        {
          "time": 40.4,
          "text": "传说是否已然离去"
        },
        {
          "time": 47.26,
          "text": "滞留在沙钟的瓶颈"
        },
        {
          "time": 53.18,
          "text": "史诗归于静寂"
        },
        {
          "time": 56.6,
          "text": "箴言沉沦锈迹"
        },
        {
          "time": 60.03,
          "text": "约定  葬身繁星"
        },
        {
          "time": 67.77,
          "text": "季节追随候鸟迁徙"
        },
        {
          "time": 74.47,
          "text": "谜底们被带往哪里"
        },
        {
          "time": 80.28,
          "text": "看不见的精灵"
        },
        {
          "time": 83.66,
          "text": "耳畔轻声絮语"
        },
        {
          "time": 86.99,
          "text": "轨迹  悄然分离"
        },
        {
          "time": 94.56,
          "text": "以这残存希望颂吟"
        },
        {
          "time": 100.31,
          "text": "神圣之名  谁人作温柔回应"
        },
        {
          "time": 107.81,
          "text": "空白书页慷慨赐予"
        },
        {
          "time": 113.55,
          "text": "叩问命运  奇迹何时苏醒"
        },
        {
          "time": 131.37,
          "text": "我行走过一片虚无"
        },
        {
          "time": 138.18,
          "text": "诸神赠它名为最初"
        },
        {
          "time": 144.25,
          "text": "无人仍会停驻　无人仍会追逐"
        },
        {
          "time": 151.11,
          "text": "我却愿意讲述"
        },
        {
          "time": 158.78,
          "text": "颠沛的梦循环往复"
        },
        {
          "time": 165.48,
          "text": "散落旧日笑语稀疏"
        },
        {
          "time": 171.3,
          "text": "像孩子般企盼　最微弱的幸福"
        },
        {
          "time": 178.03,
          "text": "此刻紧紧抓住"
        },
        {
          "time": 185.59,
          "text": "诅咒萧瑟终被冲破"
        },
        {
          "time": 191.34,
          "text": "祈愿之歌　随时光流动响彻"
        },
        {
          "time": 198.82,
          "text": "揭开千万误解尘封"
        },
        {
          "time": 204.61,
          "text": "目指永恒　茁壮地复生"
        },
        {
          "time": 244.4,
          "text": "天际飘荡祝祷余音"
        },
        {
          "time": 250.2,
          "text": "虔诚之心　如今仍将爱深信"
        },
        {
          "time": 257.7,
          "text": "以我生命高声颂吟"
        },
        {
          "time": 263.44,
          "text": "神圣之名　呼唤着光辉再临"
        },
        {
          "time": 277.02,
          "text": "在混沌中失散　卑微过的我们"
        },
        {
          "time": 283.92,
          "text": "能否也因此相遇"
        }
      ]
    },
