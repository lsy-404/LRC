          "text": "“就大概 沦为缺乏独立性的废柴”"
        },
        {
          "time": 181.2,
          "text": "胃袋洒落几吨感慨"
        },
        {
          "time": 183.23,
          "text": "怎么还是那样 不明不白"
        },
        {
          "time": 185.97,
          "text": "还在烦恼烦恼"
        },
        {
          "time": 187.43,
          "text": "体温有点高"
        },
        {
          "time": 189.71,
          "text": "奇怪吞没着细胞"
        },
        {
          "time": 192.54,
          "text": "更新过方向"
        },
        {
          "time": 194.0,
          "text": "说不定心墻就变成 海的广场"
        },
        {
          "time": 197.28,
          "text": "没什么大不了"
        },
        {
          "time": 198.73,
          "text": "相逢开口笑"
        },
        {
          "time": 201.15,
          "text": "原谅过后就 不思量"
        },
        {
          "time": 203.72,
          "text": "循环的地方"
        },
        {
          "time": 205.32,
          "text": "让刺痛朝思暮想 填满时光"
        },
        {
          "time": 231.15,
          "text": "还在发炎发炎"
        },
        {
          "time": 232.58,
          "text": "习惯要几天"
        },
        {
          "time": 235.04,
          "text": "血液还留在指尖"
        },
        {
          "time": 237.6,
          "text": "再勇敢一点"
        },
        {
          "time": 239.14,
          "text": "说不定伤痕就变成 海的碎片"
        },
        {
          "time": 242.43,
          "text": "不算明天明天"
        },
        {
          "time": 244.0,
          "text": "就赢过时间"
        },
        {
          "time": 246.3,
          "text": "苦涩着笑 就别见面"
        },
        {
          "time": 249.0,
          "text": "再明媚一遍"
        },
        {
          "time": 250.31,
          "text": "就解散我皱在眉间 刮风这天"
        },
        {
          "time": 254.14,
          "text": "过劳短命 过慧有天收"
        },
        {
          "time": 257.73,
          "text": "努力差多少就够"
        },
        {
          "time": 260.4,
          "text": "无聊的预表法"
        },
        {
          "time": 261.75,
          "text": "还像从前那样 惹人忧愁"
        },
        {
          "time": 265.0,
          "text": "从来她甚爱的 抵不过空旷"
        },
        {
          "time": 268.98,
          "text": "以后我藏的 会消亡"
        },
        {
          "time": 271.48,
          "text": "白操心一场"
        },
        {
          "time": 273.15,
          "text": "让刺痛朝思暮想 填满时光"
        }
      ]
