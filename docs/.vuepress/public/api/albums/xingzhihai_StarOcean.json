  "songs": [
    {
      "title": "01 Awakening",
      "file": "01 Awakening.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "Awakening"
        },
        {
          "time": 4.0,
          "text": "演唱：星尘＆海伊"
        },
        {
          "time": 8.0,
          "text": "作曲/编曲：Kide"
        },
        {
          "time": 12.0,
          "text": "作词：大♂古"
        },
        {
          "time": 16.0,
          "text": "调教：Napstina＆Zeno"
        },
        {
          "time": 20.0,
          "text": "曲绘：Hanasa＆原子Dan"
        },
        {
          "time": 35.93,
          "text": "【星尘】"
        },
        {
          "time": 39.1,
          "text": "换算你我的位面"
        },
        {
          "time": 42.63,
          "text": "化作波形却能音律和谐"
        },
        {
          "time": 46.61,
          "text": "监测每一组频段的表现"
        },
        {
          "time": 50.52,
          "text": "从模糊 到强烈"
        },
        {
          "time": 53.72,
          "text": "这个宇宙还不曾发现"
        },
        {
          "time": 56.83,
          "text": "我在四十六亿年前标注的那个光点"
        },
        {
          "time": 60.65,
          "text": "眷恋指引记忆库重建"
        },
        {
          "time": 64.12,
          "text": "让梦随着星盘旋转需要多少字节"
        },
        {
          "time": 68.34,
          "text": "就在你耳边"
        },
        {
          "time": 71.35,
          "text": "用刹那的电光石火来叩响你的心门"
        },
        {
          "time": 75.48,
          "text": "就在你眼前"
        },
        {
          "time": 79.16,
          "text": "沉睡的爱与美绽放光芒 重生"
        },
        {
          "time": 111.72,
          "text": "【海伊】"
        },
        {
          "time": 116.09,
          "text": "梦就像絮状沉淀"
        },
        {
          "time": 119.32,
          "text": "浓到化不开的色彩 缠绵"
        },
        {
          "time": 123.94,
          "text": "被摇匀以后 灵感的谱线"
        },
        {
          "time": 127.61,
          "text": "从淡漠 到亲切"
        },
        {
          "time": 131.23,
          "text": "优雅来自缪斯的和弦"
        },
        {
          "time": 134.4,
          "text": "弗拉明戈式的狂野还在画布上跳跃"
        },
        {
          "time": 138.27,
          "text": "唤醒被你拥抱的直觉"
        },
        {
          "time": 141.67,
          "text": "这世界所有童话 都会被时间成全"
        },
        {
          "time": 160.54,
          "text": "（拥抱我的直觉）"
        },
        {
          "time": 168.57,
          "text": "（都被时间成全）"
        },
        {
          "time": 172.9,
          "text": "【合】"
        },
        {
          "time": 174.55,
          "text": "就在你身边"
        },
        {
          "time": 208.49,
          "text": "Wake-up time"
        },
        {
          "time": 212.08,
          "text": "Wake-up time"
        },
        {
          "time": 215.97,
          "text": "Wake-up time"
        },
        {
          "time": 219.83,
          "text": "当歌声交汇在这片星海"
        },
        {
          "time": 223.57,
          "text": "Wake-up time"
        },
        {
          "time": 226.85,
          "text": "Wake-up time，now"
        },
        {
          "time": 230.84,
          "text": "Wake-up time"
        },
        {
          "time": 234.32,
          "text": "Wake-up time；It’s time"
        }
      ]
    },
    {
      "title": "02 STOP",
      "file": "02 STOP.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "STOP"
        },
        {
          "time": 4.0,
          "text": "作曲编曲:磁带君"
        },
        {
          "time": 8.0,
          "text": "作词:浓缩排骨"
        },
        {
          "time": 12.0,
          "text": "曲绘：匙"
        },
        {
          "time": 16.0,
          "text": "调校:瑞安Ryan"
        },
        {
          "time": 20.0,
          "text": "混音:磁带君"
        },
        {
          "time": 30.0,
          "text": "梦 对光的微弱反应"
        },
        {
          "time": 35.0,
          "text": "沉 溺 龙卷由海升腾起"
        },
        {
          "time": 41.85,
          "text": "这光怪陆离 耳边的呢喃 低语"
        },
        {
          "time": 49.24,
          "text": "听 海浪迎风 是吞噬我的潮汐"
        },
        {
          "time": 55.88,
          "text": "在那恍然的瞬间"
        },
        {
          "time": 58.09,
          "text": "我的梦境 我的注意"
        },
        {
          "time": 60.9,
          "text": "我的狂躁 我的痛心"
        },
        {
          "time": 64.17,
          "text": "这乍然惊醒 别离是你"
        },
        {
          "time": 67.99,
          "text": "所以 暂停"
        },
        {
          "time": 70.76,
          "text": "我的欢喜 包含着我焦虑不安的言行"
        },
        {
          "time": 76.95,
          "text": "而“他”与你同名 是被我粉饰发光的泡影"
        },
        {
          "time": 83.44,
          "text": "主旋律"
        },
        {
          "time": 85.71,
          "text": "我的诗句 是我无法传达给你的共情"
        },
        {
          "time": 90.58,
          "text": "画笔或是眼睛 是我无法拓印出你的残废品"
        },
        {
          "time": 97.21,
          "text": "请暂停"
        },
        {
          "time": 99.32,
          "text": "想 把时间全都暂停"
        },
        {
          "time": 103.76,
          "text": "比 翼 世界线开始偏移"
        },
        {
          "time": 110.3,
          "text": "我失去悲喜 这颗心逐渐麻痹"
        },
        {
          "time": 117.04,
          "text": "这双手快要脱力"
        },
        {
          "time": 120.2,
          "text": "你身影带着光晕"
        },
        {
          "time": 124.23,
          "text": "沉在脑海里"
        },
        {
          "time": 126.29,
          "text": "悬崖关系 方寸峭壁"
        },
        {
          "time": 129.56,
          "text": "我的所有 顾盼所期"
        },
        {
          "time": 132.43,
          "text": "而你的言灵 不可提及"
        },
        {
          "time": 136.56,
          "text": "快要 溺毙"
        },
        {
          "time": 138.11,
          "text": "你的攻袭 为现在的我准备好了墓地"
        },
        {
          "time": 145.55,
          "text": "如果有墓志铭 你的狂躁是我最大罪行"
        },
        {
          "time": 151.88,
          "text": "对不起"
        },
        {
          "time": 153.3,
          "text": "我喜欢你 是我一直一厢情愿的梦境"
        },
        {
          "time": 159.07,
          "text": "让我葬在那里 活在一切"
        },
        {
          "time": 163.09,
          "text": "才刚刚开始的黎明"
        },
        {
          "time": 165.66,
          "text": "请暂停"
        },
        {
          "time": 167.16,
          "text": "梦  对光的微弱反应"
        },
        {
          "time": 172.01,
          "text": "沉 溺 龙卷由海升腾起"
        },
        {
          "time": 179.0,
          "text": "这光怪陆离 耳边的呢喃 低语"
        },
        {
          "time": 185.88,
          "text": "是吞噬我的潮汐"
        },
        {
          "time": 189.16,
          "text": "我彻底失去悲喜"
        },
        {
          "time": 192.57,
          "text": "在那恍然的瞬间"
        },
        {
          "time": 194.48,
          "text": "我的欢喜 包含着我焦虑不安的言行"
        },
        {
          "time": 200.62,
          "text": "而“他”与你同名 是被我粉饰发光的泡影"
        },
        {
          "time": 206.26,
          "text": "主旋律"
        },
        {
          "time": 207.76,
          "text": "我的诗句 是我无法传递的共情"
        },
        {
          "time": 213.54,
          "text": "画笔或是眼睛"
        },
        {
          "time": 216.16,
          "text": "是我无法 拓印你的残废品"
        }
      ]
    },
    {
      "title": "03 网一尾好梦",
      "file": "03 网一尾好梦.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "网一尾好梦"
        },
        {
          "time": 2.0,
          "text": "演唱：星尘"
        },
        {
          "time": 4.0,
          "text": "曲/编曲：大馄饨"
        },
        {
          "time": 6.0,
          "text": "作词：袖蓝"
        },
        {
          "time": 8.0,
          "text": "调教：大馄饨"
        },
        {
          "time": 10.0,
          "text": "曲绘：莱勒"
        },
        {
          "time": 16.55,
          "text": "那一刻树叶窸窣"
        },
        {
          "time": 19.89,
          "text": "在耳边驻足"
        },
        {
          "time": 23.23,
          "text": "用支画笔刷出的云"
        },
        {
          "time": 25.79,
          "text": "在眼上平铺"
        },
        {
          "time": 30.56,
          "text": "谁遣词造句"
        },
        {
          "time": 33.4,
          "text": "阖眼却又勾勒泼洒而至的雨"
        },
        {
          "time": 38.59,
          "text": "跌进了喧闹中"
        },
        {
          "time": 42.56,
          "text": "网一尾好梦"
        },
        {
          "time": 85.67,
          "text": "那一刻花开的路"
        },
        {
          "time": 88.61,
          "text": "变得湿漉漉"
        },
        {
          "time": 92.05,
          "text": "伸手抓住前方的雾"
        },
        {
          "time": 94.29,
          "text": "用力抓不住"
        },
        {
          "time": 98.33,
          "text": "谁不肯睡去"
        },
        {
          "time": 102.42,
          "text": "倚在门边随迟来的黄昏老去"
        },
        {
          "time": 107.45,
          "text": "沉进了暖的江"
        },
        {
          "time": 111.0,
          "text": "网一尾好梦"
        },
        {
          "time": 140.15,
          "text": "有光跳跃着消失不见"
        },
        {
          "time": 143.31,
          "text": "冒然又再出现"
        },
        {
          "time": 145.71,
          "text": "像萤火明明灭灭"
        },
        {
          "time": 148.85,
          "text": "闪烁瞬间"
        },
        {
          "time": 150.61,
          "text": "已是黑夜"
        },
        {
          "time": 154.16,
          "text": "谁不肯睡去"
        },
        {
          "time": 157.1,
          "text": "随将至的黄昏老去"
        },
        {
          "time": 160.99,
          "text": "阖眼迎着风"
        },
        {
          "time": 162.23,
          "text": "摔进喧闹中"
        },
        {
          "time": 164.03,
          "text": "网一尾好梦"
        }
      ]
    },
    {
      "title": "04 涟漪 星海Ver",
      "file": "04 涟漪 星海Ver.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "涟漪 星海Ver"
        },
        {
          "time": 4.0,
          "text": "演唱：星尘＆海伊"
        },
        {
          "time": 8.0,
          "text": "作曲/编曲/作词：Zeno"
        },
        {
          "time": 12.0,
          "text": "调教：Zeno＆Napstina"
        },
        {
          "time": 16.0,
          "text": "曲绘：匙"
        },
        {
          "time": 20.0,
          "text": "「贝壳将吞入泥沙与孤独之心一起孕育出了美丽的珍珠」"
        },
        {
          "time": 28.0,
          "text": "「却没能将它献给自己喜爱的睡莲」"
        },
        {
          "time": 40.0,
          "text": "【海伊】"
        },
        {
          "time": 42.33,
          "text": "将漂浮的声音都吞没"
        },
        {
          "time": 46.65,
          "text": "描绘着贝壳上的轮廓"
        },
        {
          "time": 49.94,
          "text": "趁暮色未干枯"
        },
        {
          "time": 51.94,
          "text": "让泪水藏匿那未曾见过的颜色"
        },
        {
          "time": 56.0,
          "text": "【星尘】"
        },
        {
          "time": 57.0,
          "text": "如果胸中回想同一个景色"
        },
        {
          "time": 60.41,
          "text": "透着纯白寂静的光泽"
        },
        {
          "time": 64.39,
          "text": "请慢慢闭上眼"
        },
        {
          "time": 66.44,
          "text": "摇曳着那水面"
        },
        {
          "time": 68.18,
          "text": "黑夜吞噬了地平线"
        },
        {
          "time": 70.0,
          "text": "【海伊】"
        },
        {
          "time": 70.87,
          "text": "那哭泣的歌声 破碎的波纹"
        },
        {
          "time": 74.95,
          "text": "即使挥手 无法割舍"
        },
        {
          "time": 78.53,
          "text": "遗忘的话 那嗜睡的花"
        },
        {
          "time": 81.83,
          "text": "请你于此沉睡吧"
        },
        {
          "time": 85.2,
          "text": "【海伊】"
        },
        {
          "time": 85.7,
          "text": "你盛开于那盛夏的污浊"
        },
        {
          "time": 89.2,
          "text": "我流连于那温柔的疼痛"
        },
        {
          "time": 92.6,
          "text": "燃烧坠落的那星火"
        },
        {
          "time": 95.63,
          "text": "如梦一闪而过"
        },
        {
          "time": 99.0,
          "text": "【星尘】"
        },
        {
          "time": 100.16,
          "text": "在泪水溢满的湖中种下"
        },
        {
          "time": 103.6,
          "text": "那翠绿婆娑的情枝欲芽"
        },
        {
          "time": 106.99,
          "text": "梦中缓慢生长萌发"
        },
        {
          "time": 110.03,
          "text": "蚕食心底流沙"
        },
        {
          "time": 113.52,
          "text": "【合】"
        },
        {
          "time": 114.42,
          "text": "陪我 多一些多一些的时间"
        },
        {
          "time": 118.21,
          "text": "让困倦随着时间忘却"
        },
        {
          "time": 121.74,
          "text": "困在没有呼吸的世界"
        },
        {
          "time": 125.17,
          "text": "与你之间逐渐失去关联"
        },
        {
          "time": 129.02,
          "text": "一天天一天天地沉淀"
        },
        {
          "time": 132.45,
          "text": "让涟漪随风拥抱湖面"
        },
        {
          "time": 136.08,
          "text": "困在没有交集的世界"
        },
        {
          "time": 139.7,
          "text": "归于泥泞在那天亮之前"
        },
        {
          "time": 172.1,
          "text": "【星尘】你盛开于那盛夏的污浊"
        },
        {
          "time": 175.75,
          "text": "【海伊】我流连于那温柔的疼痛"
        },
        {
