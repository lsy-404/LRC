        {
          "time": 107.15,
          "text": "陪伴着我更像是梦靥"
        },
        {
          "time": 110.38,
          "text": "而你唱出的歌与我的梦"
        },
        {
          "time": 112.25,
          "text": "一直在身边"
        },
        {
          "time": 115.08,
          "text": "愿 梦的相见"
        },
        {
          "time": 120.01,
          "text": "带着星愿"
        },
        {
          "time": 122.49,
          "text": "在下一刻能实现"
        },
        {
          "time": 125.43,
          "text": "我 跨越星海云边"
        },
        {
          "time": 130.36,
          "text": "与你相逢"
        },
        {
          "time": 132.89,
          "text": "降临此间"
        },
        {
          "time": 134.78,
          "text": "这里便是终点"
        },
        {
          "time": 137.86,
          "text": "只要有你在"
        },
        {
          "time": 140.32,
          "text": "身边"
        },
        {
          "time": 162.37,
          "text": "我观测到梦中的星图"
        },
        {
          "time": 167.62,
          "text": "为可能与你邂逅毫不停步"
        },
        {
          "time": 170.64,
          "text": "潮汐在推进我加速"
        },
        {
          "time": 172.66,
          "text": "身处在无重力之中"
        },
        {
          "time": 175.34,
          "text": "就连欢乐的眼泪都变沉重"
        },
        {
          "time": 179.3,
          "text": "终能触碰你的温度"
        },
        {
          "time": 183.33,
          "text": "星的微茫"
        },
        {
          "time": 185.21,
          "text": "洞穿所有光的忧伤"
        },
        {
          "time": 188.51,
          "text": "跨越过苍茫"
        },
        {
          "time": 190.3,
          "text": "寰宇间是谁的歌声在回响"
