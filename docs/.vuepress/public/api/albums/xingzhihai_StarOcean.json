          "text": "当耀斑扰乱整个航线"
        },
        {
          "time": 58.11,
          "text": "电波在传导"
        },
        {
          "time": 59.86,
          "text": "所有绚烂光华无声闪耀"
        },
        {
          "time": 63.24,
          "text": "碰撞毁灭天体"
        },
        {
          "time": 65.07,
          "text": "燃烧坍塌星云"
        },
        {
          "time": 68.51,
          "text": "下一个坐标"
        },
        {
          "time": 70.24,
          "text": "划出轨迹"
        },
        {
          "time": 73.62,
          "text": "跨过星间"
        },
        {
          "time": 75.49,
          "text": "时沙与光在此被迫停歇"
        },
        {
          "time": 78.91,
          "text": "逃出引力圈"
