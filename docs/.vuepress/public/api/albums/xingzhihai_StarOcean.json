      "lyrics": [
        {
          "time": 0.0,
          "text": "绮云泽"
        },
        {
          "time": 2.0,
          "text": "相传苍就山西出七百里有一名泽"
        },
        {
          "time": 4.0,
          "text": "曰绮云"
        },
        {
          "time": 7.0,
          "text": "虽谓泽 不聚水"
