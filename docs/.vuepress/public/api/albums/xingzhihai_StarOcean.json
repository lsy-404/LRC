    {
      "title": "05 浅滩",
      "file": "05 浅滩.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "浅滩"
        },
        {
          "time": 1.54,
          "text": "如果全部星光"
        },
        {
          "time": 6.98,
          "text": "能够照亮这片海洋"
        },
        {
          "time": 13.51,
          "text": "踏过所有波浪"
        },
        {
          "time": 18.95,
          "text": "能否带我到更远的地方"
        },
        {
          "time": 27.0,
          "text": "词曲编曲：Zeno"
        },
        {
          "time": 31.0,
          "text": "调教：Napstina"
        },
        {
          "time": 35.0,
          "text": "曲绘：Hanasa&原子Dan"
        },
        {
          "time": 39.0,
          "text": "PV：宇言DX"
        },
        {
          "time": 49.17,
          "text": "穿过黄昏角落"
        },
        {
          "time": 51.48,
          "text": "随着歌声脉搏"
        },
        {
          "time": 55.14,
          "text": "灯火也闪烁着"
        },
        {
          "time": 57.21,
          "text": "玻璃橱窗隔断的景色"
        },
        {
          "time": 61.11,
          "text": "如果灯熄灭了"
        },
        {
          "time": 63.47,
          "text": "露水也将会在日落之后"
        },
        {
          "time": 67.08,
          "text": "洗去那霓虹的颜色"
        },
        {
          "time": 71.51,
          "text": "变沉默"
        },
        {
          "time": 72.53,
          "text": "迷路的我们被梦境捕捉"
        },
        {
          "time": 76.72,
          "text": "在街角转身"
        },
        {
          "time": 78.8,
          "text": "不停错过"
        },
        {
          "time": 81.39,
          "text": "渐行渐远"
        },
        {
          "time": 83.47,
          "text": "不再有交错"
        },
        {
          "time": 85.81,
          "text": "什么时候 才能懂得"
        },
        {
          "time": 89.99,
          "text": "当天空阴霾的时候"
        },
        {
          "time": 93.11,
          "text": "心澎湃的哀求"
        },
        {
          "time": 95.73,
          "text": "盛开在天空的花火"
        },
        {
          "time": 99.11,
          "text": "倒映进心底的琥珀"
        },
        {
          "time": 102.5,
          "text": "告诉我 如果在记忆中漂泊"
        },
        {
          "time": 107.15,
          "text": "时间最后会改变些什么"
        },
        {
          "time": 112.06,
          "text": "全部零落"
        },
        {
          "time": 150.01,
          "text": "你是自由的风"
        },
        {
          "time": 152.1,
          "text": "来去无影无踪"
        },
        {
          "time": 155.76,
          "text": "而我却找寻着"
        },
        {
          "time": 158.14,
          "text": "那支昨日遗落的花朵"
        },
        {
          "time": 161.77,
          "text": "如果无法挣脱"
        },
        {
          "time": 164.37,
          "text": "冰霜也将会在日出之后"
        },
        {
          "time": 167.75,
          "text": "消失的同时留下泪痕"
        },
        {
          "time": 172.97,
          "text": "当天空哭泣的时候"
        },
        {
          "time": 175.83,
          "text": "倾听我的哀求"
        },
        {
          "time": 178.93,
          "text": "洗去洒满整个天空"
        },
        {
          "time": 181.8,
          "text": "那烟花落尽的粉末"
        },
        {
          "time": 185.44,
          "text": "告诉我 如果在记忆中沉没"
        },
        {
          "time": 189.9,
          "text": "时间最后会留下些什么"
        },
        {
          "time": 195.11,
          "text": "再一次向星光闪烁的天空"
        },
        {
          "time": 199.79,
          "text": "倔强伸出双手"
        },
        {
          "time": 202.62,
          "text": "无法触及的那温柔"
        },
        {
          "time": 205.49,
          "text": "却将整个心都包裹"
        },
        {
          "time": 209.12,
          "text": "对我说 追寻那盛开的花朵"
        },
        {
          "time": 213.53,
          "text": "为你祝福不要停下脚步"
        },
        {
          "time": 219.56,
          "text": "直到永久带着所有星光"
        },
        {
          "time": 227.89,
          "text": "流浪远方"
        },
        {
          "time": 236.74,
          "text": "踏遍所有波浪"
        },
        {
          "time": 239.34,
          "text": "只为你而歌唱"
        }
      ]
    },
