{"slug":"weiai_Lamou","folder":"维·爱L'amouЯ","name":"维·爱 L'amouЯ","prefix":"","zh_name":"维·爱","en_name":"L'amouЯ","suffix":"","year":"2026-05-29","produce":[],"vocal":["海伊","赤羽","诗岸","星尘","苍穹","BruceMercer2016"],"lyricist":[],"composer":[],"arranger":[],"tuning":[],"illustrator":[],"mixer":[],"lyric_maker":["jiangchenyu0","神武竹"],"release":"[Bilibili](https://www.bilibili.com/video/BV1VTVb6MEDC)","purchase":"","electronic":"","cover":"/albums/weiai_Lamou.jpg","tags":["维·爱L'amouЯ","维·爱","L'amouЯ"],"songs":[{"title":"01 樱落斩","lyrics":[{"time":23.88,"text":"【海伊】"},{"time":24.84,"text":"小时候的约定"},{"time":27.54,"text":"总是在时光中渐无影迹"},{"time":32.16,"text":"即使承诺时一腔真心"},{"time":35.47,"text":"究竟谁先背弃"},{"time":38.15,"text":"此刻回头追究也已失去意义"},{"time":42.82,"text":"剑刃相接燃烧殆尽"},{"time":45.48,"text":"【海伊】不愿去探寻你"},{"time":47.45,"text":"眼中那抹为之不得已"},{"time":50.82,"text":"【赤羽】不愿去看清你"},{"time":52.68,"text":"侧身挥剑时出手犹疑"},{"time":56.16,"text":"【海伊】当下应是大雨倾泻"},{"time":58.74,"text":"【赤羽】当下应是神怒鬼泣"},{"time":61.42,"text":"【合】为何天朗气清樱花飘落得如此柔情"},{"time":87.3,"text":"【赤羽】"},{"time":88.9,"text":"解不开的咒语"},{"time":91.51,"text":"传承千百年的不变命运"},{"time":96.11,"text":"何时能应声斩断逃离"},{"time":98.47,"text":"【海伊】"},{"time":99.48,"text":"早已无需分清"},{"time":102.16,"text":"思念或是恨意都已失去原因"},{"time":106.8,"text":"剑刃相接燃烧殆尽"},{"time":109.48,"text":"【海伊】不愿去探寻你"},{"time":111.47,"text":"眼中那抹为之不得已"},{"time":114.83,"text":"【赤羽】不愿去看清你"},{"time":116.64,"text":"侧身挥剑时出手犹疑"},{"time":120.13,"text":"【海伊】当下应是电闪雷鸣"},{"time":122.8,"text":"【赤羽】当下应是神怒鬼泣"},{"time":125.48,"text":"【合】为何鲜血沾染樱花飘落得如此美丽"}]},{"title":"02 异世千寻","lyrics":[{"time":0.0,"text":"旁白/Solo Feat . BruceMercer2016"},{"time":45.39,"text":"浮光洒淤涟 风瑟响"},{"time":54.45,"text":"麻目交错落空方向 耳边轻声虚无游荡"},{"time":62.88,"text":"藤蔓刺手掌 雨滂茫"},{"time":71.91,"text":"凝视黑夜思绪怅怏 身旁微火伴入梦乡"},{"time":80.25,"text":"千万条道路 却难寻圣树 心中执念亦存放"},{"time":89.07,"text":"盼破晓时刻 携羽翼染色 绘异世将孤独盛装"},{"time":117.39,"text":"阳光不再躲藏 与我狂妄"},{"time":126.39,"text":"炽热烧穿黑夜胸膛 余火仍在为我吟唱"},{"time":134.76,"text":"鲜血洒落襟上 焱铸铜墙"},{"time":143.94,"text":"迎着风向眺望 星河啊 无惧独往"},{"time":192.45,"text":"‘In a world surrounded closed and backward, a maiden dreamed of calling from another world."},{"time":201.74,"text":"However, Instead of believing in her, people regarded her as a heresy."},{"time":210.15,"text":"Finally, she decided to leave."},{"time":214.23,"text":"Broke through thousands of barriers and difficulties."},{"time":218.42,"text":"Following the voice of that dream，she moved on to search a way to that world alone.’"},{"time":261.78,"text":"历尽风霜 苍空万丈 千回百转 梦指引我远航"},{"time":279.14,"text":"万物停唱 永无彷徨 心随神往 终将抵达远乡那光芒"}]},{"title":"03 暗与辉缠绕的囚笼","lyrics":[{"time":0.2,"text":"诗岸 饰 猎魔人 苍穹 饰 魅魔"},{"time":11.38,"text":"【猎魔人】"},{"time":11.96,"text":"喧嚣歌谣共命运流沙"},{"time":16.82,"text":"追逐群鸟飞越高塔"},{"time":22.25,"text":"待斑斓曙色亲吻橡树枝桠"},{"time":28.05,"text":"神灵正静待旅人步伐"},{"time":34.45,"text":"祷铃萦绕指尖晨风"},{"time":37.21,"text":"伴唱游者的歌声"},{"time":39.26,"text":"如群山慷慨赠予一吻"},{"time":42.16,"text":"将庇佑遥远无尽旅程"},{"time":45.62,"text":"行至昼夜轮转时分"},{"time":48.49,"text":"云翳裹挟发梢与裙角泥尘"},{"time":51.4,"text":"庭院燃起辉煌烛灯"},{"time":53.72,"text":"她叩开那扇门"},{"time":56.32,"text":"【魅魔】"},{"time":56.39,"text":"拂去夜风凄冷 斟满美酒甘醇"},{"time":62.04,"text":"行客啊于此栖身"},{"time":67.79,"text":"是迷途的歌者 吟诵诗篇缤纷"},{"time":73.5,"text":"可曾跨越四季晨昏 触摸浩远星辰"},{"time":78.89,"text":"酒香熏染齿唇 炉火残存余温"},{"time":84.73,"text":"催生 不安 心神"},{"time":87.5,"text":"【猎魔人】"},{"time":87.91,"text":"与幻梦"},{"time":90.78,"text":"【合】"},{"time":90.94,"text":"视线是否与虚妄交锋"},{"time":95.8,"text":"心火跃动麻木双瞳"},{"time":101.42,"text":"馥郁安息香纵情弥散翻涌"},{"time":107.14,"text":"沉沦芬芳至呼吸刺痛"},{"time":113.53,"text":"月光令幻想消退影踪"},{"time":118.46,"text":"恍惚遗忘神明尊荣"},{"time":124.12,"text":"若漂泊宿命无意策划相逢"},{"time":129.72,"text":"此刻请暂歇在我眼中"},{"time":166.82,"text":"【猎魔人】是否我 踏入 这虚浮桎梏 放任高傲猎物 信仰亵渎【魅魔】与我 深陷在 这华美乐土 永荒芜"},{"time":179.57,"text":"【魅魔】苍白乐章散落 烛光蚕食静默"},{"time":185.06,"text":"不过一瞬爱欲似火 皆自灰烬挣脱"},{"time":190.6,"text":"是狡黠的猎手 神圣刀锋闪烁"},{"time":196.29,"text":"指向 消亡 罪恶"},{"time":200.45,"text":"【猎魔人】与我"},{"time":202.43,"text":"【合】"},{"time":202.66,"text":"将残破幻象凝铸囚锁"},{"time":207.34,"text":"心潮永于梦境鲜活"},{"time":213.01,"text":"“若爱是深渊 可否共我陷落”"},{"time":218.62,"text":"下一瞬风霜埋葬炉火"},{"time":225.14,"text":"光辉与暗影交缠跃动"},{"time":229.93,"text":"闪耀锋芒烧作绯红"},{"time":235.56,"text":"“若爱恋赤诚 躯壳不惜奉送”"},{"time":241.18,"text":"此刻将尘封于我眼中"},{"time":247.62,"text":"崇高神明请与我见证"},{"time":252.54,"text":"明日谁与晨曦相拥"},{"time":258.2,"text":"倘若负罪者甘愿束于网中"},{"time":263.91,"text":"猎人（夜魔）啊可否将双手紧握"},{"time":269.18,"text":"就于此 请俯身优雅抉择"},{"time":274.98,"text":"就于此 将交错轮盘轻拨"},{"time":280.47,"text":"啊"}]},{"title":"04 无法变得可爱","lyrics":[{"time":0.84,"text":"转转圈 嘟嘟脸"},{"time":3.34,"text":"想变得可爱些"},{"time":5.59,"text":"许愿甜蜜魔法 能够应验"},{"time":9.09,"text":"辛德瑞拉闪耀过零点"},{"time":37.14,"text":"小小肩膀 承担着 枯燥繁重学业"},{"time":43.12,"text":"快要忘记 落灰舞鞋"},{"time":48.86,"text":"衣柜挤满 校服 没有一点空间"},{"time":53.59,"text":"多希望 公主裙多几件"},{"time":60.57,"text":"关上窗 换上鞋"},{"time":63.0,"text":"打扮得可爱些"},{"time":65.31,"text":"镜中闪耀光芒 童话世界"},{"time":68.75,"text":"时间停留今夜"},{"time":72.0,"text":"转转圈 嘟嘟脸"},{"time":74.73,"text":"魔法已实现 喔喔"},{"time":78.01,"text":"就算只有我能看见"},{"time":80.51,"text":"此时此刻 享受这一切"},{"time":108.17,"text":"未来何去何从 快要毕业了"},{"time":113.25,"text":"还有 不要忘了 爸妈说的"},{"time":116.92,"text":"人生苦着呢"},{"time":118.31,"text":"“哼，我知道！”"},{"time":119.49,"text":"“你又知道！？”"},{"time":119.75,"text":"转转圈 嘟嘟脸"},{"time":122.78,"text":"魔法已实现"},{"time":124.75,"text":"就算只有我能看见啊"},{"time":128.0,"text":"此时此刻 享受这一切"},{"time":133.21,"text":"走上街 翩翩起舞"},{"time":136.19,"text":"让大家看见"},{"time":138.0,"text":"是我 踏着舞鞋 闪耀表演"},{"time":141.25,"text":"拉满可爱百分点"},{"time":143.88,"text":"啊"},{"time":144.92,"text":"转转圈 嘟嘟脸"},{"time":147.48,"text":"魔法已实现"},{"time":150.5,"text":"我要让世界看见"},{"time":153.25,"text":"倔强的我想变可爱点"}]},{"title":"05 霓虹灯の温度","lyrics":[{"time":25.37,"text":"【羽】夜幕降临之时"},{"time":28.08,"text":"时间将会重置"},{"time":30.83,"text":"等待彻夜月蚀"},{"time":33.65,"text":"所爱扣紧十指"},{"time":47.91,"text":"夜幕降临之时"},{"time":50.67,"text":"时间将会重置"},{"time":53.45,"text":"等待彻夜月蚀"},{"time":56.31,"text":"错过的缺失"},{"time":58.91,"text":"拨开你的未知"},{"time":61.99,"text":"视线对视"},{"time":64.71,"text":"多猜让我泪湿"},{"time":67.59,"text":"【合】说不开你 自知"},{"time":72.55,"text":"【尘】悲哀 却是 这夜蚀"},{"time":81.45,"text":"痴为爱 猎食"},{"time":89.46,"text":"你的解释"},{"time":95.21,"text":"【赤羽】穿梭城市"},{"time":97.94,"text":"霓虹灯展示"},{"time":100.93,"text":"错失午时"},{"time":103.59,"text":"我的位置"},{"time":106.75,"text":"【合】若是 你回忆中那落日"},{"time":110.83,"text":"诱惑作誓 遗失"},{"time":114.33,"text":"回不来过往之事"},{"time":140.85,"text":"【羽】夜幕降临之时"},{"time":143.62,"text":"时间将会重置"},{"time":146.4,"text":"等待彻夜月蚀"},{"time":149.25,"text":"错过的缺失"},{"time":151.85,"text":"拨开你的未知"},{"time":154.94,"text":"视线对视"},{"time":157.66,"text":"多猜让我泪湿"},{"time":160.53,"text":"【合】说不开你 自知"},{"time":165.5,"text":"【尘】悲哀 却是 这夜蚀"},{"time":174.4,"text":"痴为爱 猎食"},{"time":182.41,"text":"你的解释"},{"time":188.16,"text":"【羽】穿梭城市"},{"time":190.88,"text":"霓虹灯展示"},{"time":193.88,"text":"错失午时"},{"time":196.53,"text":"我的位置"},{"time":199.69,"text":"【合】若是 你回忆中那落日"},{"time":203.78,"text":"诱惑作誓 遗失"},{"time":207.28,"text":"回不来过往之事"}]},{"title":"06 维爱六等分","lyrics":[{"time":0.12,"text":"【合】"},{"time":0.64,"text":"向歌声 向海洋 描绘无尽诗章"},{"time":5.43,"text":"而远方 最清澈的幻想 将与七色虹霓一路起航"},{"time":34.61,"text":"【星尘】"},{"time":34.77,"text":"以星芒 连结梦境渺茫"},{"time":36.95,"text":"视线将 命运重叠相交"},{"time":39.61,"text":"【海伊】"},{"time":39.76,"text":"该如何登场 该为谁轻声歌唱"},{"time":44.7,"text":"【赤羽】"},{"time":45.02,"text":"以烈焰 烙印爱恋灼烫"},{"time":47.56,"text":"怀拥着 明朝新生初阳"},{"time":50.22,"text":"【诗岸】"},{"time":50.38,"text":"这澎湃声浪 该因谁肆意盛放"},{"time":55.03,"text":"【星尘】"},{"time":55.49,"text":"指尖 捕捉星光 音符凝结在手掌"},{"time":60.32,"text":"请共它无顾忌回旋飘荡 心之所向"},{"time":65.3,"text":"【苍穹】"},{"time":65.56,"text":"那 云海 与翅膀 是否能承载哀伤"},{"time":71.2,"text":"静候微风叩门造访 与我轻盈舞蹈 淋漓酣畅"},{"time":77.34,"text":"【星尘&海伊&诗岸】"},{"time":77.9,"text":"向歌声 向穹苍 向无垠的辉光"},{"time":82.64,"text":"就把幻想深埋珍藏 孕育诗篇绵长"},{"time":88.46,"text":"【星尘&赤羽&苍穹】"},{"time":88.5,"text":"而远方 仍闪耀 等待乐章奏响"},{"time":93.21,"text":"请抛下 一切迟疑恐慌 在彼此怀抱 向未来昂首眺望"},{"time":121.7,"text":"【星尘】"},{"time":122.05,"text":"若星芒 照破深夜冗长"},{"time":124.81,"text":"视线亦 引燃缤纷灯光"},{"time":127.45,"text":"【海伊】"},{"time":127.65,"text":"将为你登场 期待称赞鼓掌"},{"time":132.4,"text":"【赤羽】"},{"time":132.76,"text":"若烈焰 描摹思念轨道"},{"time":135.59,"text":"也许会 寻见共鸣心跳"},{"time":138.25,"text":"【诗岸】"},{"time":138.46,"text":"这绚烂声浪 就此刻肆意盛放"},{"time":143.35,"text":"【星尘】"},{"time":143.58,"text":"指尖 那缕星光 又将温暖谁面庞"},{"time":148.68,"text":"自银河故乡朝舞台下降 心之所向"},{"time":153.76,"text":"【苍穹】"},{"time":154.1,"text":"那 云海 与翅膀 裹挟沉重疼痛哀伤"},{"time":159.19,"text":"静候微风叩门造访 于下一刻遗忘 振翼高翔"},{"time":166.14,"text":"【星尘】"},{"time":166.3,"text":"向歌声 与梦乡 向无穷故事琳琅"},{"time":170.71,"text":"【星尘&海伊】"},{"time":170.92,"text":"音符跨过惊雷风霜 勾勒金色希望"},{"time":176.65,"text":"【星尘&赤羽&苍穹】"},{"time":176.83,"text":"那远方 那梦想 依旧骄傲生长"},{"time":181.37,"text":"飘扬乐章连缀孤岛 喝彩将飞跃层叠云霄"},{"time":188.88,"text":"【星尘】"},{"time":189.16,"text":"从相遇第一秒 请共我 天幕中徜徉"},{"time":196.6,"text":"余晖至霞光 栖身于星河 无人阻挡"},{"time":200.65,"text":"【诗岸&海伊】"},{"time":200.8,"text":"向歌声 向穹苍 向无垠的辉光"},{"time":204.92,"text":"【星尘&海伊&诗岸】"},{"time":205.21,"text":"清澈幻想深埋珍藏 孕育诗篇绵长"},{"time":211.16,"text":"【星尘&赤羽&苍穹】"},{"time":211.33,"text":"而远方 仍闪耀 乐章早已奏响"},{"time":215.85,"text":"请带上 所有无畏力量 于彼此怀抱 向未来眺望"},{"time":222.81,"text":"【合】"},{"time":223.1,"text":"啦 啦 啦 啦"},{"time":227.14,"text":"啦啦啦啦啦啦 啦啦啦啦啦啦"},{"time":232.56,"text":"向歌声 与梦乡 寻觅故事琳琅"},{"time":237.33,"text":"而梦想 依旧骄傲生长"},{"time":240.64,"text":"喝彩飞跃云霄 与我一路起航"}]},{"title":"07 ~Our Story Begin~","lyrics":[{"time":18.85,"text":"啊啊"},{"time":22.71,"text":"啊啊啊"},{"time":26.68,"text":"啊啊啊啊"},{"time":30.74,"text":"啊啊啊啊啊"},{"time":71.8,"text":"啊啊啊"},{"time":73.21,"text":"啊啊啊啊啊啊啊啊"},{"time":76.75,"text":"啊啊"}]}]}