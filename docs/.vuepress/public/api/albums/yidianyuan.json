        {
          "time": 170.27,
          "text": "<02:50.27>教<02:50.58>我<02:50.93>没<02:51.27>资<02:51.57>格<02:51.83>期<02:52.16>待<02:52.69>"
        },
        {
          "time": 173.1,
          "text": "<02:53.10>没<02:53.53>勇<02:53.88>气<02:54.21>不<02:54.51>凡<02:54.86>"
        },
        {
          "time": 174.96,
          "text": "<02:54.96>月<02:55.26>光<02:55.58>是<02:55.89>安<02:56.20>全<02:56.46>感<02:56.89>"
        },
        {
          "time": 176.89,
          "text": "<02:56.89>擅<02:57.22>自<02:57.54>叛<02:57.84>离<02:58.17>了<02:58.56>夜<02:58.94>晚<02:59.69>"
        },
        {
          "time": 180.27,
          "text": "<03:00.27>回<03:00.57>避<03:00.90>是<03:01.21>安<03:01.55>慰<03:01.80>剂<03:02.21>"
        },
        {
          "time": 182.21,
          "text": "<03:02.21>擅<03:02.56>自<03:02.90>镇<03:03.21>压<03:03.53>了<03:03.90>不<03:04.25>安<03:04.99>"
        },
        {
          "time": 185.89,
          "text": "<03:05.89>我<03:06.24>不<03:06.59>做<03:06.94>备<03:07.25>案<03:07.62>不<03:07.94>做<03:08.24>辩<03:08.53>白<03:08.89>"
        },
        {
          "time": 188.89,
          "text": "<03:08.89>不<03:09.26>做<03:09.58>永<03:09.88>远<03:10.22>第<03:10.59>二<03:11.37>"
        },
        {
          "time": 191.63,
          "text": "<03:11.63>我<03:11.81>要<03:12.17>只<03:12.50>一<03:12.83>人<03:13.21>的<03:13.51>爱<03:13.91>"
        },
        {
          "time": 194.3,
          "text": "<03:14.30>乔<03:14.58>戈<03:14.92>里<03:15.24>永<03:15.56>不<03:15.86>做<03:16.53>"
        },
        {
          "time": 196.53,
          "text": "<03:16.53>替<03:17.23>代<03:18.95>"
        },
        {
          "time": 200.04,
          "text": "<03:20.04>不<03:20.31>够<03:20.63>勇<03:20.92>敢<03:21.30>"
        },
        {
          "time": 202.63,
          "text": "<03:22.63>不<03:22.93>够<03:23.29>坦<03:23.59>然<03:23.95>"
        },
        {
          "time": 204.63,
          "text": "<03:24.63>只<03:24.91>成<03:25.24>为<03:25.58>我<03:25.93>是<03:26.25>否<03:26.60>也<03:26.93>能<03:27.27>拥<03:27.59>有<03:27.92>唯<03:28.26>一<03:28.60>的<03:28.94>爱<03:29.67>"
        },
        {
          "time": 210.0,
          "text": "<03:30.00>若<03:30.28>我<03:30.61>不<03:30.93>想<03:31.23>心<03:31.57>甘<03:31.96>"
