        },
        {
          "time": 47.3,
          "text": "<00:47.30>要<00:47.64>勇<00:47.98>敢<00:48.59>承<00:49.28>受<00:49.60>批<00:49.94>判<00:50.36>"
        },
        {
          "time": 50.67,
          "text": "<00:50.67>要<00:50.96>坦<00:51.28>然<00:51.62>喝<00:51.96>彩<00:52.47>"
        },
        {
