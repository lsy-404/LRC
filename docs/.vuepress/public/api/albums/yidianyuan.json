  "songs": [
    {
      "title": "不正确女孩",
      "file": "不正确女孩.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "作词 : licis"
        },
        {
          "time": 0.2,
          "text": "作曲 : licis"
        },
        {
          "time": 0.4,
          "text": "编曲 : licis"
        },
        {
          "time": 0.5,
          "text": "限时电文听到请回答"
        },
        {
          "time": 17.66,
          "text": "束起长发 努力去扮演一株流行色的花 一场过家家"
        },
        {
          "time": 24.51,
          "text": "再套上长袜 裙摆扫过的弧度被精心规划 负距离的差"
        },
        {
          "time": 32.01,
          "text": "逆向进化 挤不进标准模具招来的惩罚 一场大逃杀"
        },
        {
          "time": 38.79,
          "text": "气泡太嘈杂 全世界在汽水的海洋中融化 你也一样吗"
        },
        {
          "time": 46.21,
          "text": "丢掉那些过了赏味期限的梦吧"
        },
        {
          "time": 49.28,
          "text": "成为她 成为她 做一颗砝码"
        },
        {
          "time": 53.22,
          "text": "限时电文请在五月到来前回答"
        },
        {
          "time": 56.66,
          "text": "开心吗 甘心吗 你还听得到吗"
        },
        {
          "time": 60.37,
          "text": "嘿 你还在听吗 还记得自己吗"
        },
        {
          "time": 67.62,
          "text": "还想要继续吗 一起逃吧"
        },
        {
          "time": 78.2,
          "text": "剪去长发 裙摆在膝上投落下一道时差 填一道伤疤"
        },
        {
          "time": 85.0,
          "text": "焦茶色发夹 十元店批量生产的鲜艳廉价 盛开过的花"
        },
        {
          "time": 92.43,
          "text": "塑料刀叉 卡路里层层堆积建筑起的塔 美丽的代价"
        },
        {
          "time": 99.11,
          "text": "锂电池爆炸 液晶屏在有害垃圾桶里安家 再不用喧哗"
        },
        {
          "time": 106.56,
          "text": "寄出那颗困在梦中蒙尘的心吧"
        },
        {
          "time": 109.81,
          "text": "要浮夸 要宏大 要歌颂梦话"
        },
        {
          "time": 113.74,
          "text": "时间颠倒地点崩塌都不回头地逃吧"
        },
        {
          "time": 117.03,
          "text": "向明天 向未来 背向人群出发"
        },
        {
          "time": 120.83,
          "text": "你依然还期望一个正确答案吗"
        },
        {
          "time": 127.96,
          "text": "偌大世界空荡如不曾有人回答"
        },
        {
          "time": 133.12,
          "text": "做个坏孩子吧"
        },
        {
          "time": 135.15,
          "text": "乘着一场火山喷发砸碎天空吧"
        },
        {
          "time": 138.39,
          "text": "快逃吧 快逃吧 快做个梦吧"
        },
        {
          "time": 142.16,
          "text": "留给那场破碎的梦一封电文吧"
        },
        {
          "time": 145.39,
          "text": "开心吗 甘心吗 你听得到的吧"
        },
        {
          "time": 149.3,
          "text": "限时电文这位女孩听到请回答"
        },
        {
          "time": 152.55,
          "text": "五月的你过得好吗"
        }
      ]
    },
    {
      "title": "乔戈里的自白信",
      "file": "乔戈里的自白信.lrc",
      "lyrics": [
        {
          "time": 0.4,
          "text": "<00:00.40>乔<00:00.62>戈<00:00.82>里<00:01.05>的<00:01.27>自<00:01.48>白<00:01.69>信<00:01.79> - <00:01.90>言<00:02.12>和<00:02.36>"
        },
        {
          "time": 2.36,
          "text": "<00:02.36>词<00:02.59>：<00:02.59>licis<00:02.81>"
        },
        {
          "time": 2.81,
          "text": "<00:02.81>曲<00:03.06>：<00:03.06>licis<00:03.36>"
        },
        {
          "time": 21.28,
          "text": "<00:21.28>第<00:21.95>一<00:22.64>高<00:22.97>峰<00:23.29>在<00:23.92>记<00:24.26>录<00:24.62>中<00:24.94>岿<00:25.31>然<00:25.82>"
        },
        {
          "time": 26.08,
          "text": "<00:26.08>一<00:26.30>如<00:26.60>命<00:27.27>运<00:27.92>的<00:28.28>宠<00:28.63>儿<00:29.19>有<00:29.55>天<00:29.93>资<00:30.28>不<00:30.66>凡<00:31.26>"
        },
        {
          "time": 31.26,
          "text": "<00:31.26>站<00:31.58>矮<00:31.95>一<00:32.64>截<00:33.28>领<00:33.60>奖<00:33.96>台<00:34.56>"
        },
        {
          "time": 34.56,
          "text": "<00:34.56>听<00:34.90>他<00:35.26>们<00:35.61>讲<00:35.89>"
        },
