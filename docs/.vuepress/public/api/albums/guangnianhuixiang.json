    {
      "title": "向春归",
      "file": "向春归.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "向春归 Primavera"
        },
        {
          "time": 5.55,
          "text": "作编曲：CrClr"
        },
        {
          "time": 7.4,
          "text": "作词：CrClr"
        },
        {
          "time": 9.24,
          "text": "调教：磷元素P"
        },
        {
          "time": 11.08,
          "text": "混音：CrClr"
        },
        {
          "time": 13.01,
          "text": "插图：薛钦"
        },
        {
          "time": 16.72,
          "text": "醒来 窗外阳光浮现"
        },
        {
          "time": 20.36,
          "text": "街边 梨花倒映双眼"
        },
        {
          "time": 24.16,
          "text": "蓝天 洒在树叶的缝隙间 好久不见"
        },
        {
          "time": 31.7,
          "text": "公园 风筝划过云边"
        },
        {
          "time": 35.44,
          "text": "笑脸 融化漫长冬天"
        },
        {
          "time": 39.16,
          "text": "晴天 撒在每个人的心田 甚是想念"
        },
        {
          "time": 46.7,
          "text": "春暖花开 世界清晰"
        },
        {
          "time": 50.46,
          "text": "温柔阳光微风也和煦"
        },
        {
          "time": 54.28,
          "text": "过期门票统统丢弃 忘掉那些没回应问题"
        },
        {
          "time": 61.76,
          "text": "向春去 不必去苦寻意义 平淡生活也有惊喜"
        },
        {
          "time": 69.21,
          "text": "向春去 梦想由自己命题 真谛融在每个点滴"
        },
        {
          "time": 91.73,
          "text": "四季流转 喜悦与哀愁"
        },
        {
          "time": 99.34,
          "text": "好似一江 春水向东流"
        },
        {
          "time": 106.81,
          "text": "光阴往前走 更替了新旧"
        },
        {
          "time": 114.33,
          "text": "大雪过后 看湖边杨柳"
        },
        {
          "time": 121.77,
          "text": "静听 枝头换了鸟鸣"
        },
        {
          "time": 125.48,
          "text": "桥亭 溪水响破坚冰"
        },
        {
          "time": 129.24,
          "text": "绿汀 小楼一夜听遍春雨 淅淅沥沥"
        },
        {
          "time": 136.62,
          "text": "微风 吹起风铃叮叮"
        },
        {
          "time": 140.51,
          "text": "黎明 渐闻琴音冷冷"
        },
        {
          "time": 144.22,
          "text": "人群 嬉戏奔跑热闹不停 笑语盈盈"
        },
        {
          "time": 151.74,
          "text": "风和日丽 未来清晰"
        },
        {
          "time": 155.43,
          "text": "梦想崭新乐曲要奏起"
        },
        {
          "time": 159.28,
          "text": "过期幻想统统丢弃 忘掉那些困扰老问题"
        },
        {
          "time": 166.72,
          "text": "向春去 我已经找到意义 编排心底梦的潮汐"
        },
        {
          "time": 174.16,
          "text": "向春去 春天从不会远去 胸中自是盎然春意"
        },
        {
          "time": 181.65,
          "text": "春天不再是上个春天"
        },
        {
          "time": 185.51,
          "text": "我奔向每一个不同的明天"
        }
      ]
    },
    {
      "title": "向融雪处",
      "file": "向融雪处.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "向融雪处"
        },
        {
          "time": 4.02,
          "text": "作编曲：闹闹"
        },
        {
          "time": 5.5,
          "text": "作词：果汁凉菜"
        },
        {
          "time": 6.91,
          "text": "调教：潜水荷叶"
        },
        {
          "time": 8.21,
          "text": "混音：欧Ωhm"
        },
        {
          "time": 9.55,
          "text": "插图：薛钦"
        },
        {
          "time": 16.73,
          "text": "比肃杀冬日还要老气横秋"
        },
        {
          "time": 19.41,
          "text": "灵魂出走在突至寒流"
        },
        {
          "time": 22.04,
          "text": "还来不及缅怀打薄的薪酬"
        },
        {
          "time": 24.74,
          "text": "又得加到什么时候"
        },
        {
          "time": 27.59,
          "text": "期待的幸运未片刻驻留"
        },
        {
          "time": 30.39,
          "text": "却无数次放任随波逐流"
        },
        {
          "time": 33.19,
          "text": "太精彩的世界对我来说"
        },
        {
          "time": 35.45,
          "text": "这点耐久已然不够"
        },
        {
          "time": 39.98,
          "text": "止不住怀念 街灯影幢幢"
        },
        {
          "time": 42.77,
          "text": "退勤后总在 跌跌又撞撞"
        },
        {
          "time": 45.56,
          "text": "可惜滴酒不沾 清醒得不得了"
        },
        {
          "time": 48.51,
          "text": "连个借口想找都找不到"
        },
        {
          "time": 51.11,
          "text": "忍不住庆幸 我神经大条"
        },
        {
          "time": 53.82,
          "text": "还不至于被句歌词蹭红了眼眶"
        },
        {
          "time": 57.16,
          "text": "莫名的孤寂感硬往外套口袋里钻"
        },
        {
          "time": 60.28,
          "text": "可恨这虚标的充绒量"
        },
        {
          "time": 74.3,
          "text": "天空遗落的灰白雪花"
        },
        {
          "time": 76.64,
          "text": "到底是不是该我负担的重量"
        },
        {
          "time": 79.32,
          "text": "想慢慢地 泛泛地 看一看"
        },
        {
          "time": 81.99,
          "text": "曾以为黯淡的 散乱的 记忆片段"
        },
        {
          "time": 85.67,
          "text": "为什么没人来保管"
        },
        {
          "time": 87.76,
          "text": "被没收的痴心妄想长大后却没返还"
        },
        {
          "time": 91.14,
          "text": "都怪偶然发现锁进抽屉里的future plans"
        },
        {
          "time": 98.06,
          "text": "止不住怀念 秋千椅晃晃"
        },
        {
          "time": 100.73,
          "text": "夕阳下的街 熙熙又攘攘"
        },
        {
          "time": 103.46,
          "text": "可惜人生在世 设施太不配套"
        },
        {
          "time": 106.42,
          "text": "连个过去想回都回不到"
        },
        {
          "time": 109.01,
          "text": "最讨厌人劝 其实大不了"
        },
        {
          "time": 111.77,
          "text": "只不过是无法按想象描绘形状"
        },
        {
          "time": 115.13,
          "text": "每个人满载着参差缺口和开放伤"
        },
        {
          "time": 118.2,
          "text": "安慰都像在找茬一样"
        },
        {
          "time": 121.4,
          "text": "有机会就让委屈充斥行囊"
        },
        {
          "time": 123.73,
          "text": "用段熟睡填车厢"
        },
        {
          "time": 126.31,
          "text": "志愿的终点站 未必不是天亮"
        },
        {
          "time": 128.98,
          "text": "为冻僵梦境化霜"
        },
        {
          "time": 131.16,
          "text": "止不住怀念 街灯影幢幢"
        },
        {
          "time": 133.8,
          "text": "儿时才不怕 跌跌又撞撞"
        },
        {
          "time": 136.49,
          "text": "天黑也不知觉 雪花攀进袖口"
        },
        {
          "time": 139.56,
          "text": "还和未来的模样捉迷藏"
        },
        {
          "time": 142.11,
          "text": "在温和月光 铺陈的路上"
        },
        {
          "time": 144.79,
          "text": "毫无防备被句歌词蹭红了眼眶"
        },
        {
          "time": 148.19,
          "text": "我为自己备好毛毯与一瓮暖汤"
        },
        {
          "time": 151.13,
          "text": "再向融雪之处借块家乡"
        }
      ]
    },
    {
      "title": "夏日寻踪",
      "file": "夏日寻踪.lrc",
      "lyrics": [
        {
          "time": 1.57,
          "text": "夏天在窗边 摇晃风铃"
        },
        {
          "time": 3.41,
          "text": "阳光 轻抚矮墙上 乖巧猫咪"
        },
        {
          "time": 5.44,
          "text": "天空晴得出奇 我要散步在微风里"
        },
        {
          "time": 9.29,
          "text": "沿河流溯溯溪 顺路捉一只红蜻蜓"
        },
        {
          "time": 12.72,
          "text": "一阵倦意 躺在草地 思绪飞到远处去"
        },
        {
          "time": 17.01,
          "text": "舀一勺西瓜消夏 正甘甜"
        },
        {
          "time": 20.7,
          "text": "桌边飞扬的树影 年复一年变幻"
        },
        {
          "time": 24.44,
          "text": "无忧无虑 游曳在此间 盛夏仍自在绵延"
        },
        {
          "time": 27.65,
          "text": "白日漫长 挥霍着时间 像永无终点"
        },
        {
          "time": 32.06,
          "text": "到明天再见 还有 无穷个明天"
        },
        {
          "time": 35.68,
          "text": "从细小的波纹 直到最盛大的庆典"
        },
        {
          "time": 39.59,
          "text": "还有些挂念 明天 再实现也不晚"
        },
        {
          "time": 43.22,
          "text": "近在眼前的 熟悉笑颜 也不会走远"
        },
        {
          "time": 50.88,
          "text": "夏日寻踪 Arcade"
        },
        {
          "time": 52.75,
          "text": "作编曲：1-Zero"
        },
        {
          "time": 54.63,
          "text": "作词：Kevinz"
        },
        {
          "time": 56.55,
          "text": "调教：鬼面P"
        },
        {
          "time": 58.37,
          "text": "混音：棕色环"
        },
        {
          "time": 60.31,
          "text": "插图：潼玖"
        },
        {
          "time": 64.45,
          "text": "许多绮夜 如烟的流萤 吹过了透明的山野"
        },
        {
          "time": 71.8,
          "text": "我们在 明亮星光下 消遣"
        },
        {
          "time": 73.65,
          "text": "无数个故事 下笔成篇"
        },
        {
          "time": 75.58,
          "text": "乘着轻快的歌谣 小城里兜转几圈"
        },
        {
          "time": 79.4,
          "text": "蝉鸣出新月一弯 天地宽"
        },
        {
          "time": 83.15,
          "text": "铺展开凉席一卷 到梦乡里探险"
        },
        {
          "time": 86.7,
          "text": "风轻云淡 期待着精彩 又期待就这样安然"
        },
        {
          "time": 90.02,
          "text": "自由烂漫 归家的路也 从未被遮拦"
        },
        {
          "time": 94.48,
          "text": "到明天再见 还有 无穷个明天"
        },
        {
          "time": 98.06,
          "text": "有热烈的烟火 也有甜丝丝的雨点"
        },
        {
          "time": 101.92,
          "text": "还有些挂念 明天 再实现也不晚"
        },
        {
          "time": 105.51,
          "text": "近在眼前的 熟悉笑颜 也不会走远"
        },
        {
          "time": 124.85,
          "text": "突然有一天 夏日将终结"
        },
        {
          "time": 128.86,
          "text": "如江入海 后会无期"
        },
        {
          "time": 132.97,
          "text": "梦里 仍清晰见你"
        }
      ]
    },
    {
      "title": "当你如光漂泊",
      "file": "当你如光漂泊.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "当你如光漂泊"
        },
        {
          "time": 2.4,
          "text": "作编曲：阿耗"
        },
        {
          "time": 4.8,
          "text": "作词：薛钦"
        },
        {
          "time": 7.18,
          "text": "调教：阿耗"
        },
        {
          "time": 9.59,
          "text": "混音：阿耗"
        },
        {
          "time": 11.95,
          "text": "插图：薛钦"
        },
        {
          "time": 21.21,
          "text": "飘泼大雨掩盖住的书声朗朗"
        },
        {
          "time": 23.67,
          "text": "哗啦轻轻盘旋在耳蜗旁"
        },
        {
          "time": 25.87,
          "text": "谁心不在焉望着天边的白月光"
        },
        {
          "time": 28.28,
          "text": "埋藏已久 将心愿都寄存在了远方"
        },
        {
          "time": 31.08,
          "text": "嘀嘀嗒嘀嗒 震碎了大地 腐蚀了心脏"
        },
        {
          "time": 35.21,
          "text": "(我想要吗)"
        },
        {
          "time": 35.9,
          "text": "忙碌的人呐 徘徊在生死的边缘又惧怕死亡"
        },
        {
          "time": 40.87,
          "text": "有时候我读着诗"
        },
        {
          "time": 42.72,
          "text": "未来有一万种方式"
        },
        {
          "time": 45.1,
          "text": "可是 跌跌撞撞的坚持"
        },
        {
          "time": 47.5,
          "text": "是否真的值得我如此偏执"
        },
        {
          "time": 49.83,
          "text": "若只是考试 只为了名次"
        },
        {
          "time": 52.23,
          "text": "到最后却变成一把腐朽的尺"
        },
        {
          "time": 54.68,
          "text": "这人生倘若由我来执匙"
        },
        {
          "time": 57.09,
          "text": "在终点 会否有不同的结局"
        },
        {
          "time": 60.06,
          "text": "时间啊 请告诉我该活出怎样的人生吧"
        },
        {
          "time": 85.6,
          "text": "暮色四合 天际线把窗外晚云煅烧成金箔"
        },
        {
          "time": 90.55,
          "text": "而银杏散落沉入斑驳的旧课桌"
        },
        {
          "time": 95.3,
          "text": "落笔停顿 再思索"
        },
        {
          "time": 97.37,
          "text": "写下被浪潮磨损褪色的抉择"
        },
        {
          "time": 100.14,
          "text": "来不及去揣度命运的颠簸"
        },
        {
          "time": 103.41,
          "text": "让我去描摹"
        },
        {
          "time": 104.21,
          "text": "我不想再忐忑"
        },
        {
          "time": 105.72,
          "text": "手中 迷途的纸鹤"
        },
        {
          "time": 107.53,
          "text": "听人说 成熟标志是学会随波"
        },
        {
          "time": 109.86,
          "text": "若必须选择 就暂且错过"
        },
        {
          "time": 112.27,
          "text": "时光会 把每道遗憾酿成琥珀"
        },
        {
          "time": 114.73,
          "text": "这人生并不必谁来认可"
        },
        {
          "time": 117.21,
          "text": "如萤火 孤独振翅着却执着"
        },
        {
          "time": 120.0,
          "text": "时间会告诉我该活出怎样的"
        },
        {
          "time": 124.01,
          "text": "想要听风说 听雨落"
        },
        {
          "time": 126.55,
          "text": "想要看花开 看云朵"
        },
        {
          "time": 128.94,
          "text": "但好像 无论是 星辰还是清辉 全都隔着如果"
        },
        {
          "time": 133.66,
          "text": "终于我学会不闪躲"
        },
        {
          "time": 136.15,
          "text": "终于我拾起月色"
        },
        {
          "time": 138.52,
          "text": "看着那浪花载着 所有如果"
        },
        {
          "time": 141.71,
          "text": "去往更远的星河"
        },
        {
          "time": 144.14,
          "text": "掌心 起舞的纸鹤"
        },
        {
          "time": 145.9,
          "text": "我说 成长不过是 与光同辙"
        },
        {
          "time": 148.17,
          "text": "若风会阻隔"
        },
        {
          "time": 149.51,
          "text": "就乘风漂泊"
        },
        {
          "time": 150.7,
          "text": "岁月会 把每片羽翼 镀上光泽"
        },
        {
          "time": 153.18,
          "text": "这旅途 终会由你来篆刻"
        },
        {
          "time": 155.55,
          "text": "如星河 亿万年漂泊 仍炽热"
        },
        {
          "time": 158.52,
          "text": "经历过 长夜跋涉 仍璀璨闪烁 就算值得"
        }
      ]
    },
    {
      "title": "纪念",
      "file": "纪念.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "作词 : 空气凝"
        },
        {
          "time": 1.0,
          "text": "作曲 : 空气凝"
        },
        {
          "time": 9.6,
          "text": "在这 繁华的世界看着"
        },
        {
          "time": 13.2,
          "text": "绚丽景色有很多"
        },
        {
          "time": 15.59,
          "text": "笑着 跳着"
        },
        {
          "time": 18.02,
          "text": "时针慢慢走动着"
        },
        {
          "time": 20.39,
          "text": "三百六十度地旋转"
        },
        {
          "time": 23.08,
          "text": "隐藏阵阵的不安"
        },
        {
          "time": 25.47,
          "text": "现在眼前的绚烂"
        },
        {
          "time": 27.86,
          "text": "到最后化蝶飞翻"
        },
        {
          "time": 30.28,
          "text": "记忆中TA很美啊"
        },
        {
          "time": 32.66,
          "text": "但现在TA去哪儿啦"
        },
        {
          "time": 35.08,
          "text": "像指间透过的沙"
        },
        {
          "time": 37.43,
          "text": "飘散在空中消失啦"
        },
        {
          "time": 43.51,
          "text": "不回来啦"
        },
        {
          "time": 47.11,
          "text": "如果时间逃走了"
        },
        {
          "time": 49.48,
          "text": "还有谁会记得我"
        },
        {
          "time": 51.9,
          "text": "如果一切都变了"
        },
        {
          "time": 54.27,
          "text": "还有谁会想起我"
        },
        {
          "time": 56.69,
          "text": "旧的都悄悄走了"
        },
        {
          "time": 59.06,
          "text": "新的也慢慢来了"
        },
        {
          "time": 61.48,
          "text": "只留下我一个人独自 回忆着"
        },
        {
          "time": 66.29,
          "text": "那些璀璨的烟火"
        },
        {
          "time": 68.7,
          "text": "绽放后就消失了"
        },
        {
          "time": 71.05,
          "text": "但那些真挚笑容"
        },
        {
          "time": 73.51,
          "text": "此刻依然定格着"
        },
        {
          "time": 75.92,
          "text": "我们都无法逃脱"
        },
        {
          "time": 78.25,
          "text": "在这时间的漩涡"
        },
        {
          "time": 80.7,
          "text": "那就让我们在这仅存的时间"
        },
        {
          "time": 85.53,
          "text": "用心去感受着"
        },
        {
