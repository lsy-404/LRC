    {
      "title": "夜光灯 Twilights",
      "file": "夜光灯 Twilights.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "05 夜光灯 Twilights"
        },
        {
          "time": 21.06,
          "text": "洛天依：悬于暗幕蔚蓝色的灯"
        },
        {
          "time": 26.55,
          "text": "掌心栖居着眺望的梦"
        },
        {
          "time": 31.87,
          "text": "银河如流沙滑落指缝"
        },
        {
          "time": 37.19,
          "text": "凝结成琥珀寂静的风"
        },
        {
          "time": 42.51,
          "text": "若我 在时终消融"
        },
        {
          "time": 48.2,
          "text": "能否先岁月抵达永恒"
        },
        {
          "time": 53.22,
          "text": "若我 向深空航行"
        },
        {
          "time": 58.83,
          "text": "这抹微光愿为你常夜启明"
        },
        {
          "time": 64.25,
          "text": "苍穹：焚身于烈焰点燃的引擎"
        },
        {
          "time": 69.83,
          "text": "镌刻轨迹碑铭"
        },
        {
          "time": 74.8,
          "text": "那所有未言的守望奏鸣"
        },
        {
          "time": 80.18,
          "text": "震颤将要飞升弦音"
        },
        {
          "time": 85.26,
          "text": "合：若万物沉溺冰封安宁"
        },
        {
          "time": 90.48,
          "text": "这簇心跳仍为你回应"
        },
        {
          "time": 95.74,
          "text": "纵使在深渊无法聆听"
        },
        {
          "time": 101.21,
          "text": "光年外请等我拥抱你"
        },
        {
          "time": 127.89,
          "text": "洛天依：她是夜空中的守灯人"
        },
        {
          "time": 133.15,
          "text": "收集每个迷途的时分"
        },
        {
          "time": 138.46,
          "text": "将流浪星芒编织成绳"
        },
        {
          "time": 143.85,
          "text": "系住所有漂泊者灵魂"
        },
        {
          "time": 149.09,
          "text": "若我 在时终消融"
        },
        {
          "time": 154.82,
          "text": "能否先岁月抵达永恒"
        },
        {
          "time": 159.89,
          "text": "若我 向深空航行"
        },
        {
          "time": 165.43,
          "text": "这抹微光愿为你常夜启明"
        },
        {
          "time": 170.82,
          "text": "苍穹：我是那预言将毁的孤星"
        },
        {
          "time": 176.51,
          "text": "借着灰烬重生"
        },
        {
          "time": 181.52,
          "text": "待你途经此处残存炽诚"
        },
        {
          "time": 186.85,
          "text": "唤我回归故土之声"
        },
        {
          "time": 191.82,
          "text": "合：若万物沉溺冰封安宁"
        },
        {
          "time": 197.23,
          "text": "这簇心跳仍为你回应"
        },
        {
          "time": 202.44,
          "text": "纵使在深渊无法聆听"
        },
        {
          "time": 207.9,
          "text": "光年外请等我拥抱你"
        }
      ]
    },
    {
      "title": "海与光的破晓​​ Tide Dawn",
      "file": "海与光的破晓​​ Tide Dawn.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "03 海与光的破晓 TideDawn"
        },
        {
          "time": 20.46,
          "text": "星尘：白海鸥 盘旋在沙堤"
        },
        {
          "time": 26.41,
          "text": "晨曦涨潮时万籁喧鸣"
        },
        {
          "time": 34.04,
          "text": "海伊：青蓝色 流入你眼睛"
        },
        {
          "time": 40.11,
          "text": "陪沉船搁浅在这片海域"
        },
        {
          "time": 46.93,
          "text": "星尘：漫游中听清海的呼吸"
        },
        {
          "time": 53.86,
          "text": "源自心跳频率的潮汐"
        },
        {
          "time": 60.73,
          "text": "海伊：浮沉间错过多少黎明"
        },
        {
          "time": 67.56,
          "text": "最终探听到你的消息"
        },
        {
          "time": 74.75,
          "text": "星尘：鲸落的遗迹"
        },
        {
          "time": 78.31,
          "text": "指引我坠入海底"
        },
        {
          "time": 81.56,
          "text": "这沉默的钟情"
        },
        {
          "time": 84.74,
          "text": "跋涉过鱼群向你致意"
        },
        {
          "time": 88.63,
          "text": "海伊：执着的意义"
        },
        {
          "time": 91.88,
          "text": "期待孤岛的来信"
        },
        {
          "time": 95.46,
          "text": "这遥远的回音"
        },
        {
          "time": 98.49,
          "text": "足够我听清你的爱语"
        },
        {
          "time": 129.31,
          "text": "星尘：漂泊中锚定光的轨迹"
        },
        {
          "time": 136.1,
          "text": "源自心房悸动的规律"
        },
        {
          "time": 142.93,
          "text": "悬停间捕获这缕晨曦"
        },
        {
          "time": 149.68,
          "text": "才抛却引力向你触近"
        },
        {
          "time": 157.13,
          "text": "海伊：不甘心沉底"
        },
        {
          "time": 160.56,
          "text": "穿梭在日出光影"
        },
        {
          "time": 163.87,
          "text": "这片梦太晶莹"
        },
        {
          "time": 166.99,
          "text": "还未曾抵达怎能放弃"
        },
        {
          "time": 170.78,
          "text": "星尘：只因为是你"
        },
        {
          "time": 174.2,
          "text": "遥不可及的黎明"
        },
        {
          "time": 177.65,
          "text": "都值得去寻觅"
        },
        {
          "time": 180.74,
          "text": "寻找你我存在的意义"
        }
      ]
    },
    {
      "title": "海与光的黄昏 Tide Dusk",
      "file": "海与光的黄昏 Tide Dusk.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "04 海与光的黄昏 Tide Dusk"
        },
        {
          "time": 2.59,
          "text": "作词 : 陌地枯生"
        },
        {
          "time": 3.81,
          "text": "作编：ZClear"
        },
        {
          "time": 7.19,
          "text": "作词：陌地枯生"
        },
        {
          "time": 10.63,
          "text": "调校：John_Em"
        },
        {
          "time": 14.21,
          "text": "曲绘：Eid_Shacklebolt"
        },
        {
          "time": 17.47,
          "text": "混音：ZClear"
        },
        {
          "time": 20.93,
          "text": "演唱：星尘&海伊"
        },
        {
          "time": 26.17,
          "text": "星尘："
        },
        {
          "time": 27.75,
          "text": "还记得"
        },
        {
          "time": 29.89,
          "text": "我见过的潮汐"
        },
        {
          "time": 34.08,
          "text": "水浪漫过湾"
        },
        {
          "time": 36.72,
          "text": "卷回海底"
        },
        {
          "time": 40.35,
          "text": "海伊："
        },
        {
          "time": 41.43,
          "text": "曾几何时"
        },
        {
          "time": 43.54,
          "text": "我想说我爱你"
        },
        {
          "time": 47.99,
          "text": "可惜太安静"
        },
        {
          "time": 50.42,
          "text": "夜色太美丽"
        },
        {
          "time": 54.55,
          "text": "星尘："
        },
        {
          "time": 55.15,
          "text": "听仔细听"
        },
        {
          "time": 60.76,
          "text": "月色坠落进海底 切切微鸣"
        },
        {
          "time": 68.51,
          "text": "海伊："
        },
        {
          "time": 68.96,
          "text": "听认真听"
        },
        {
          "time": 74.45,
          "text": "当海浪碎成荧光"
        },
        {
          "time": 77.93,
          "text": "你的心跳与月色同频"
        },
        {
          "time": 95.54,
          "text": "星尘："
        },
        {
          "time": 96.37,
          "text": "还记得"
        },
        {
          "time": 98.35,
          "text": "我捡起的沙瓶"
        },
        {
          "time": 102.77,
          "text": "封存一封信"
        },
        {
          "time": 105.24,
          "text": "无人问津"
        },
        {
          "time": 109.23,
          "text": "海伊："
        },
        {
          "time": 110.12,
          "text": "曾几何时"
        },
        {
          "time": 112.18,
          "text": "我想说我爱你"
        },
        {
          "time": 116.53,
          "text": "可惜太僵硬"
        },
        {
          "time": 119.03,
          "text": "笑容太用力"
        },
        {
          "time": 123.87,
          "text": "海与月亮"
        },
        {
          "time": 125.55,
          "text": "是否能够在一起"
        },
        {
          "time": 129.79,
          "text": "还是只能回忆"
        },
        {
          "time": 132.35,
          "text": "溶在水中那抹幻影"
        },
        {
          "time": 137.17,
          "text": "合："
        },
        {
          "time": 137.53,
          "text": "听仔细听"
        },
        {
          "time": 143.06,
          "text": "月色坠落进海底 无声无息"
        },
        {
          "time": 151.18,
          "text": "听认真听"
        },
        {
          "time": 156.77,
          "text": "当海面波光粼粼"
        },
        {
          "time": 160.17,
          "text": "你的心声与月光共鸣"
        },
        {
          "time": 192.22,
          "text": "星尘："
        },
        {
          "time": 192.38,
          "text": "我曾问你"
        },
        {
          "time": 194.05,
          "text": "回忆是否有意义"
        },
        {
          "time": 198.31,
          "text": "就像海浪卷起"
        },
        {
          "time": 200.88,
          "text": "包裹月光碎如泡影"
        },
        {
          "time": 205.54,
          "text": "海伊："
        },
        {
          "time": 206.03,
          "text": "海与月亮"
        },
        {
          "time": 207.78,
          "text": "是否能够在一起"
        },
        {
          "time": 212.08,
          "text": "你舀一抔海水"
        },
        {
          "time": 214.61,
          "text": "月亮沉在手心明亮恬静"
        }
      ]
    },
    {
      "title": "赛博音乐家 Cyber Musician",
      "file": "赛博音乐家 Cyber Musician.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "01 赛博音乐家 CyberMusician"
        },
        {
          "time": 22.89,
          "text": "听见心跳 在流变"
        },
        {
          "time": 28.15,
          "text": "听见脉搏 在撕裂"
        },
        {
          "time": 33.58,
          "text": "是破土重燃的硝烟"
        },
        {
          "time": 38.89,
          "text": "轻碰世界唯一热源"
        },
        {
          "time": 42.92,
          "text": "我看见迷雾荒野"
        },
        {
          "time": 45.57,
          "text": "奔涌的沙砾尘埃"
        },
        {
          "time": 48.26,
          "text": "也目睹那些焰火"
        },
        {
          "time": 50.88,
          "text": "化为光点"
        },
        {
          "time": 53.51,
          "text": "我触见脉搏动荡"
        },
        {
          "time": 56.19,
          "text": "在眼前燃起日月"
        },
        {
          "time": 58.84,
          "text": "随破晓天际蔓延"
        },
        {
          "time": 61.52,
          "text": "银河攀缘"
        },
        {
          "time": 64.28,
          "text": "我听见苍穹正撕裂"
        },
        {
          "time": 67.18,
          "text": "群山呼啸和沦陷"
        },
        {
          "time": 69.86,
          "text": "现实与梦的边界"
        },
        {
          "time": 72.46,
          "text": "启程告别暗夜"
        },
        {
          "time": 74.54,
          "text": "迎来明天"
        },
        {
          "time": 76.14,
          "text": "秒针定格一念永远"
        },
        {
          "time": 78.83,
          "text": "当你在脑海浮现"
        },
        {
          "time": 81.22,
          "text": "当旋律再度热烈重演"
        },
        {
          "time": 85.17,
          "text": "回到开篇"
        },
        {
          "time": 106.83,
          "text": "我看见火星四溅"
        },
        {
          "time": 109.55,
          "text": "日与夜不休不眠"
        },
        {
          "time": 112.15,
          "text": "也目送所有执念"
        },
        {
          "time": 114.81,
          "text": "化为鼓点"
        },
        {
          "time": 117.56,
          "text": "我触见音波燎原"
        },
        {
          "time": 120.27,
          "text": "不歇的炽热夙愿"
        },
        {
          "time": 122.8,
          "text": "像焰火彻夜长燃"
        },
        {
          "time": 125.56,
          "text": "还未熄灭"
        },
        {
          "time": 128.2,
          "text": "我听见磅礴的时间"
        },
        {
          "time": 131.22,
          "text": "宇宙坍缩在指尖"
        },
        {
          "time": 133.86,
          "text": "那些不朽的誓言"
        },
        {
          "time": 136.5,
          "text": "还在原地回响"
        },
        {
          "time": 138.61,
