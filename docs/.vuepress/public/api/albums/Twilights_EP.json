    {
      "title": "向无归岸 Towards Lost Shore",
      "file": "向无归岸 Towards Lost Shore.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "02 向无归岸 Towards Lost Shore"
        },
        {
          "time": 2.6,
          "text": "作词 : 绝尘"
        },
        {
          "time": 4.3,
          "text": "作曲 : ZClear"
        },
        {
          "time": 5.96,
          "text": "编曲 : ZClear"
        },
        {
          "time": 7.63,
          "text": "作词：九岁不行"
        },
        {
          "time": 9.32,
          "text": "调校：一盒肥皂泡_"
        },
        {
          "time": 11.1,
          "text": "混音：ZClear"
        },
        {
          "time": 12.79,
          "text": "演唱：牧心"
        },
        {
          "time": 14.52,
          "text": "听晚风 将琴弦拂过"
        },
        {
          "time": 21.35,
          "text": "哼唱着 未命名的歌"
        },
        {
          "time": 27.34,
          "text": "影子摇曳霓虹 轻声附和"
        },
        {
          "time": 34.21,
          "text": "在第四十三次日落 沉入暮色"
        },
        {
          "time": 41.0,
          "text": "初生的星子 为彼岸勾画轮廓"
        },
        {
          "time": 47.88,
          "text": "它静静照亮 在迷途者的漂泊"
        },
        {
          "time": 54.73,
          "text": "当晚钟的呢喃唤不回失巢的孤鸟"
        },
        {
          "time": 61.55,
          "text": "星河会为它指引方向"
        },
        {
          "time": 68.61,
          "text": "若我向深渊远航"
        },
        {
          "time": 71.9,
          "text": "去那梦中的幻乡"
        },
        {
          "time": 75.31,
          "text": "岁月与尘土也会酿成酒浆"
        },
        {
