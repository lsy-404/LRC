{"slug":"fanxingyuyuyunzhishang","folder":"繁星于雨云之上","name":"繁星于雨云之上","prefix":"","zh_name":"繁星于雨云之上","en_name":"","suffix":"","year":"2025-05-01","produce":["会咬人的白海豹"],"vocal":["星尘","永夜","洛天依","乐正绫","诗岸","赤羽"],"lyricist":["又瓷","雷小晏","四一","槃清","muri","幻"],"composer":["怀归","奇怪雷子QGRay","槃清","muri","崽无儿音"],"arranger":["槃清","怀归","奇怪雷子QGRay","muri","崽无儿音"],"tuning":["苍梧_abilrue","雨巷","正十字p","muri"],"illustrator":["诺九隐隐","Yawity","糸镜镜镜子","落叶brs","方白","芳芳"],"mixer":["枯月Kareta","槃清","muri"],"lyric_maker":["武乙凌薇"],"release":"[Bilibili](https://www.bilibili.com/video/BV1uRGizvEtV/)","purchase":"[淘宝 繁花空昼](https://e.tb.cn/h.6O506HSnp05pWOg?tk=zDAyVV6dkut) ￥69","electronic":"[Dizzylab](https://www.dizzylab.net/d/HB-FX1/) ￥15","cover":"/albums/fanxingyuyuyunzhishang.jpg","tags":["繁星于雨云之上","会咬人的白海豹"],"songs":[{"title":"1 序曲","lyrics":[{"time":0.0,"text":"《亵渎》"},{"time":0.01,"text":"作曲 : 槃清"},{"time":0.02,"text":"编曲 : 槃清"},{"time":0.05,"text":"曲绘 : 诺九隐隐"},{"time":1.0,"text":"纯音乐"}]},{"title":"2 繁星于雨云之上-星尘ver","lyrics":[{"time":0.0,"text":"《繁星于雨云之上（星尘ver）》"},{"time":0.01,"text":"作曲 : 怀归"},{"time":0.02,"text":"编曲 : 怀归"},{"time":0.03,"text":"作词 : 又瓷"},{"time":0.04,"text":"调校 : 苍梧"},{"time":0.05,"text":"曲绘 : Yawity"},{"time":0.06,"text":"混音 : 枯月Kareta"},{"time":15.87,"text":"抽枝在黎明前 平凡不过时代"},{"time":24.93,"text":"跋涉于山或海 风和浪波涌没过脚踝"},{"time":35.37,"text":"太多不易承载"},{"time":42.53,"text":"纪念碑说 无数勇者未被故事青睐"},{"time":52.37,"text":"旅程后 火把熄灭回干柴"},{"time":60.4,"text":"纪念碑说 光点别坠入尘霾"},{"time":69.5,"text":"别让诗歌"},{"time":74.37,"text":"深埋"},{"time":97.13,"text":"当旗帜"},{"time":100.9,"text":"自暴雨幕点燃一抹色 当萤辉"},{"time":109.93,"text":"从深黑夜划破万条河"},{"time":115.33,"text":"闪烁着 蔓延出视线之外"},{"time":122.53,"text":"鲜活而又温热 流入文明的血脉"},{"time":131.47,"text":"纪念碑说 无数勇者敢嫌故事狭隘"},{"time":141.27,"text":"旅程后 火把仍然烧澎湃"},{"time":149.3,"text":"纪念碑说 光点常生自尘霾"},{"time":158.57,"text":"平凡却顽固 飘摇地照透云霭"},{"time":168.27,"text":"松柏"},{"time":170.73,"text":"总愿意用躯体铭刻 灵魂与时间 对白"},{"time":185.67,"text":"不谢命运 从未太慷慨"},{"time":190.13,"text":"恰好够拥 蜉蝣入怀"},{"time":195.0,"text":"星河 只需沉默着 撒希望向 未来"}]},{"title":"3 繁星于雨云之上-永夜ver","lyrics":[{"time":0.0,"text":"《繁星于雨云之上（永夜ver）》"},{"time":0.01,"text":"作曲 : 怀归"},{"time":0.02,"text":"编曲 : 怀归"},{"time":0.03,"text":"作词 : 又瓷"},{"time":0.04,"text":"调校 : 苍梧"},{"time":0.05,"text":"曲绘 : 糸镜镜镜子"},{"time":0.06,"text":"混音 : 枯月Kareta"},{"time":27.37,"text":"沿时代之河 辰灰随花种"},{"time":32.77,"text":"掠过云幕"},{"time":38.1,"text":"坠进旅途"},{"time":41.17,"text":"果敢而笨拙"},{"time":44.07,"text":"大方却珍重"},{"time":47.13,"text":"篇章伊始前破土"},{"time":50.97,"text":"自眼角滴落晨露"},{"time":57.0,"text":"至 怀抱以闷黄薄暮"},{"time":63.13,"text":"便 身向汹涌夜 深深处"},{"time":68.93,"text":"与最盛的风同路"},{"time":78.13,"text":"当 清澈许愿如萤辉旋舞"},{"time":84.4,"text":"当 微末花火燃亮暴雨幕"},{"time":90.5,"text":"当 离群晶尘皆往废墟回溯"},{"time":97.73,"text":"闪烁时未尽理想也复苏"},{"time":109.33,"text":"以缤纷颜色 写纪实诗歌"},{"time":117.1,"text":"生于草木 鲜花拥簇"},{"time":123.13,"text":"静默而执着"},{"time":126.1,"text":"细腻又沉勇"},{"time":129.17,"text":"有烛光温度"},{"time":135.2,"text":"留刻痕在时间 故事"},{"time":140.87,"text":"朝历史过渡"},{"time":144.47,"text":"每页皆会叙说 从容傲骨"},{"time":150.47,"text":"毕竟璀璨之人 从未驻足"},{"time":160.4,"text":"当 万腔热忱往星海注入"},{"time":166.47,"text":"当 炽明炬火与洪流对赌"},{"time":172.5,"text":"当 希望共晨曦一同绽放出"},{"time":179.77,"text":"喷洒满英雄 终归处"}]},{"title":"4 平行相遇","lyrics":[{"time":0.0,"text":"《平行相遇》"},{"time":0.01,"text":"作曲 : 奇怪雷子QGRay"},{"time":0.02,"text":"编曲 : 奇怪雷子QGRay"},{"time":0.03,"text":"作词 : 雷小晏"},{"time":0.04,"text":"调校 : 雨巷独酌"},{"time":0.05,"text":"曲绘 : 落叶brs"},{"time":0.06,"text":"混音 : 枯月Kareta"},{"time":0.07,"text":"“高铁的速度是300公里每小时，在这五分钟里，它能飞驰25公里，也能让我们相遇。”"},{"time":22.97,"text":"〔绫〕 深夜梦里时常有个身影"},{"time":28.4,"text":"回神说起她与我相似 又 格外吸引"},{"time":33.67,"text":"看着屏幕的讯息"},{"time":36.73,"text":"留下青春痕迹"},{"time":38.97,"text":"期待 梦中的身影 走出来与我相遇"},{"time":44.4,"text":"一场突 如其来的旅行"},{"time":47.1,"text":"一次未 曾预料的接触"},{"time":49.7,"text":"平行线 也会想要相遇"},{"time":52.4,"text":"我们就这样 去"},{"time":55.0,"text":"我们偶然有了联系 叮咚 叮咚 期待 你消息"},{"time":60.37,"text":"手机的一条讯息"},{"time":62.7,"text":"悄然诉说着 我们之间默契"},{"time":65.73,"text":"我们旅行交汇地 试探 邀请 想要 看见你"},{"time":71.0,"text":"深夜的突然约定"},{"time":73.33,"text":"就这样唤起 对相遇的好奇"},{"time":86.97,"text":"〔绫〕 你也喜欢布丁 也爱赏远方景"},{"time":92.3,"text":"我漫不经心 漫无目的"},{"time":95.73,"text":"旅途里 你跌跌撞撞闯进"},{"time":100.7,"text":"与我谈天说地"},{"time":102.97,"text":"从此 万千的美丽 抵不过身旁的你"},{"time":108.37,"text":"一段心 知肚明的同行"},{"time":111.07,"text":"一次充 满希望的相遇"},{"time":113.7,"text":"平行线 这样相伴下去"},{"time":116.4,"text":"我们就这样 去"},{"time":119.07,"text":"若有似无的言语"},{"time":121.33,"text":"叮咚 叮咚 猜测 你心意"},{"time":124.37,"text":"屏幕外甜美声音"},{"time":126.7,"text":"若就此歌唱 你定致以回应"},{"time":129.7,"text":"数着漫天的星星"},{"time":132.0,"text":"纠结 默念 理解 情愫起 相依"},{"time":135.73,"text":"在他乡夜里 感叹着我们 这样平行相遇"},{"time":161.67,"text":"我们已互通心意 叮咚 叮咚 心灵 已相依"},{"time":167.0,"text":"深夜的每个梦境"},{"time":169.33,"text":"全都于此刻 兑现成为美景"},{"time":172.37,"text":"想与你分享未来 相知 相遇 同行 故事起"},{"time":177.7,"text":"就这样许个约定"},{"time":180.07,"text":"我们一定会 一直并肩前行"}]},{"title":"5 呼唤利维坦的大山","lyrics":[{"time":0.0,"text":"《呼唤利维坦的大山》"},{"time":0.01,"text":"作曲 : 槃清"},{"time":0.02,"text":"编曲 : 槃清"},{"time":0.03,"text":"作词 : 四一、槃清"},{"time":0.04,"text":"调校 : 正十字p"},{"time":0.05,"text":"曲绘 : 方白"},{"time":0.06,"text":"混音 : 槃清"},{"time":0.07,"text":"“为了逃避利维坦躲进大山，却又在大山中呼唤利维坦。火焰吞噬了村庄，群山和海洋沉默不语。”"},{"time":2.17,"text":"足印蜿蜒成细线 自街灯下匿迹"},{"time":8.37,"text":"褪下光滑的圆环 奔走踏上荆棘"},{"time":14.57,"text":"将陈旧声音驱散 以新调子顶替"},{"time":20.8,"text":"我们捧起支新生的歌 旋律仍生涩"},{"time":25.7,"text":"如此哼唱着 如此期许着 重生的时刻"},{"time":32.13,"text":"阴雨连绵着对视界 倾斜"},{"time":36.07,"text":"倾斜向未雕琢过的 一切"},{"time":39.13,"text":"一切草木丛生中 词句正随曲调织成结"},{"time":44.4,"text":"口舌悉数自在开合着 填充进音节"},{"time":50.53,"text":"赋予新生的歌以骨血"},{"time":56.77,"text":"这身躯 面朝光明 却囫囵填充着恐惧"},{"time":62.87,"text":"是谁将我耳膜撕裂"},{"time":66.07,"text":"愈合时 又缝补进 喃喃低语"},{"time":70.73,"text":"于是我决心抛出火炬"},{"time":75.13,"text":"与这片荒原一同燃尽"},{"time":95.2,"text":"寂静边界的枝叶 于冰雪下萌发"},{"time":101.47,"text":"掩盖雾笼罩的天 与天对岸的虚假"},{"time":107.67,"text":"生锈的匕首划破 淤青的旧伤疤"},{"time":113.9,"text":"我们传唱那新生的歌 用信仰雕琢"},{"time":118.8,"text":"如此呢喃着 如此重复着 剜下了腐朽"},{"time":124.97,"text":"拾起 旁观者的金杯"},{"time":128.37,"text":"饮下 最冷漠的滋味 土地 消解了泪水"},{"time":133.8,"text":"却没忘怀叩拜的卑微"},{"time":137.47,"text":"阴影 跪倒在那山脚下 等夜色消褪"},{"time":143.57,"text":"祂是否还为生命倾醉"},{"time":149.93,"text":"这双手 捧起愿景 赐予无常的神灵"},{"time":156.07,"text":"请不要吹熄烛火"},{"time":159.17,"text":"恳求着 再次将我心声聆听"},{"time":163.8,"text":"假若命运在纸上注定"},{"time":168.13,"text":"为何仍残忍将我唤醒"},{"time":174.67,"text":"神明啊 能否为我的无礼祈求宽恕呢"},{"time":180.87,"text":"神明啊 从现在开始请护佑我吧"},{"time":187.07,"text":"神明啊 听见颤抖的歌声了吗"},{"time":193.0,"text":"呼唤着 直到白塔 坍塌"}]},{"title":"6 老人与海，少年与路","lyrics":[{"time":0.0,"text":"《老人与海 少年与路》"},{"time":0.01,"text":"作曲 : muri"},{"time":0.02,"text":"编曲 : muri"},{"time":0.03,"text":"作词 : muri"},{"time":0.04,"text":"调校 : muri"},{"time":0.05,"text":"混音 : muri"},{"time":0.06,"text":"曲绘 : 芳芳"},{"time":0.07,"text":"“在走廊另一头少年的宿舍里，他又睡着了。他依旧脸朝下躺着，身边依旧空无一人。少年正梦见满天繁星。”"},{"time":0.08,"text":"特别鸣谢：Ernest Miller Hemingway"},{"time":17.53,"text":"我再也唱不出率真的歌"},{"time":22.67,"text":"不经意间的修饰是为何"},{"time":27.5,"text":"明明秋天是我最最喜欢的季节"},{"time":32.57,"text":"当黄色落叶铺满大街"},{"time":36.2,"text":"既然有两只脚就迈开步"},{"time":40.6,"text":"不想走别人已走过的路"},{"time":45.77,"text":"像一只蝴蝶自由自在到哪儿都好"},{"time":50.87,"text":"从不需要别人的地图"},{"time":54.3,"text":"我就想要 fly away"},{"time":59.13,"text":"我就想要 runaway"},{"time":63.73,"text":"没人认得我是谁"},{"time":68.5,"text":"无所谓"},{"time":74.13,"text":"啦啦"},{"time":78.7,"text":"啦"},{"time":82.53,"text":"哦我"},{"time":87.07,"text":"是水"},{"time":91.67,"text":"你说到底我是谁"},{"time":113.57,"text":"虽然还唱着曾经写的歌"},{"time":118.33,"text":"但唱的人已不是同一个"},{"time":123.47,"text":"他仍然还爱着秋天落叶的声音"},{"time":128.77,"text":"但眼神不似往日澄清"},{"time":132.0,"text":"他爱听歌颂青春的歌曲"},{"time":136.6,"text":"那是种始终怀念过去的心情"},{"time":141.73,"text":"不小心眼泪一滴一滴落下去"},{"time":146.9,"text":"恍惚间自己不再年轻"},{"time":150.3,"text":"我就想要 fly"},{"time":154.47,"text":"away 我就想要 runaway"},{"time":159.7,"text":"甩开一切无所谓 无所谓 runaway"},{"time":169.17,"text":"喔喔喔 啦啦啦啦啦啦啦 嘿咦耶"},{"time":175.1,"text":"啦啦啦"},{"time":179.2,"text":"啦啦"},{"time":183.0,"text":"啦啦"},{"time":187.6,"text":"我已知道我是谁"}]},{"title":"7 亵渎","lyrics":[{"time":0.0,"text":"《亵渎》"},{"time":0.01,"text":"作曲 : 崽无儿音"},{"time":0.02,"text":"编曲 : 崽无儿音"},{"time":0.03,"text":"作词 : 幻"},{"time":0.04,"text":"调校 : 苍梧"},{"time":0.05,"text":"曲绘 : 诺九隐隐"},{"time":0.06,"text":"混音 : 枯月Kareta"},{"time":0.07,"text":"“那盛满如酒壶般的，必将被倾倒。那残暴如猛兽的，必将被猎杀。那陈旧如朽木的，也必将被焚尽。”"},{"time":1.0,"text":"Those live hollow thirst for brimming"},{"time":1.0,"text":"凡空虚的必求盈满"},{"time":6.93,"text":"“It is finished” He said"},{"time":6.93,"text":"“成了”"},{"time":11.47,"text":"Then we fed embryo of the arrogance with the"},{"time":11.47,"text":"我们饲育那睥睨万物者的胚胎"},{"time":32.4,"text":"Fire"},{"time":32.4,"text":"火焰"},{"time":35.27,"text":"Desire"},{"time":35.27,"text":"欲念"},{"time":38.33,"text":"Terror"},{"time":38.33,"text":"恐惧"},{"time":41.37,"text":"Despair"},{"time":41.37,"text":"绝望"},{"time":48.97,"text":"Apocalypse coming"},{"time":48.97,"text":"天启降临"},{"time":53.37,"text":"coming spreading"},{"time":53.37,"text":"降临 蔓延"},{"time":60.77,"text":"Babel breaking (It’s time to nature be revealing)"},{"time":60.77,"text":"巴别崩毁（此即本性显露之时）"},{"time":66.93,"text":"Symphonic screaming (The good, make up is so fragile)"},{"time":66.93,"text":"惊叫争响（善的伪装如此脆弱）"},{"time":72.97,"text":"Venom releasing (Pay for prices which far forgotten)"},{"time":72.97,"text":"恶流肆溢（偿还远被遗忘的代价）"},{"time":78.97,"text":"Feast of bleeding (Fair day of trial)"},{"time":78.97,"text":"与血欢宴（于此公正审判之日）"},{"time":93.93,"text":"Till all things are served to there due"},{"time":93.93,"text":"直至予一切事物应得的终局"},{"time":98.67,"text":"Solvet sæclum in favilla (Dies irae)"},{"time":98.67,"text":"尘寰将在烈火中熔化（震怒之日）"},{"time":103.77,"text":"Stella in tenebris micat (Dies illa)"},{"time":103.77,"text":"繁星于黑暗闪烁如旧（既定之日）"}]}]}