    {
      "title": "满月",
      "file": "满月.lrc",
      "lyrics": [
        {
          "time": 1.24,
          "text": "群山回声 叩击静默的心胸"
        },
        {
          "time": 9.0,
          "text": "呼与吸 恍若 炽热的一场 飓风"
        },
        {
          "time": 16.24,
          "text": "荒芜 世界一如雪海般空无"
        },
        {
          "time": 23.35,
          "text": "归途 淹没在 白银 枯木 交汇处"
        },
        {
          "time": 29.53,
          "text": "目光所触 帷幕"
        },
        {
          "time": 32.99,
          "text": "卷开一片 褪色的尘土"
        },
        {
          "time": 37.56,
          "text": "浪潮声刺骨 于光晕中沉浮"
        },
        {
          "time": 45.01,
          "text": "那绰约 而轻巧 向本能撩动的狩猎"
        },
        {
          "time": 51.58,
          "text": "困倦 无眠 浓雾触摸双眼"
        },
        {
          "time": 57.38,
          "text": "指向唯一的所见"
        },
        {
          "time": 59.19,
          "text": "追逐之前 痛觉烧灼到目眩"
        },
        {
          "time": 62.88,
          "text": "如坠 迷宫 噩梦抑或一种幻觉"
        },
        {
          "time": 67.11,
          "text": "缠绕进 血液"
        },
        {
          "time": 73.64,
          "text": "不存在 缚网中谁徒劳挣扎"
        },
        {
          "time": 77.35,
          "text": "光芒 包围躯体未成熟的茧"
        },
        {
          "time": 81.73,
          "text": "窥见 诗与毁灭"
        },
        {
          "time": 87.7,
          "text": "欣然剪断 理智的引线"
        },
        {
          "time": 109.81,
          "text": "荒芜 向枯萎的风徒劳地倾诉"
        },
        {
          "time": 117.0,
          "text": "痛苦 如生命一般 悠长 残酷"
        },
        {
          "time": 124.21,
          "text": "帷幕 掩盖一片未冷透的骸骨"
        },
        {
          "time": 131.19,
          "text": "无光的窄路 又该行至何处"
        },
        {
          "time": 134.98,
          "text": "泉源 奔涌而出"
        },
        {
          "time": 138.65,
          "text": "冰冷之前 自我烧灼到炽烈"
        },
        {
          "time": 142.29,
          "text": "坠下 迷宫 胸骨中失控而雀跃"
        },
        {
          "time": 146.52,
          "text": "凛然的 终结"
        },
        {
          "time": 152.94,
          "text": "最远端 视野残余寂静独眼"
        },
        {
          "time": 156.58,
          "text": "冷冽 永恒清澈永恒地无眠"
        },
        {
          "time": 161.19,
          "text": "洞见 一切所愿"
        },
        {
          "time": 167.12,
          "text": "而我所愿 仍高悬山巅"
        }
      ]
