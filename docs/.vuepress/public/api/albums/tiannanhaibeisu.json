59,"text":"慌张的曲调"},{"time":209.97,"text":"是夏风太过灼烫 还是雀跃的心跳"},{"time":214.28,"text":"让脸颊都映上浅红的霞光"},{"time":218.05,"text":"穿过熟悉的街巷 余晖中短暂依靠"},{"time":222.42,"text":"每一刻 永久珍藏"},{"time":228.23,"text":"也许情节太俗套 笑容却从不说谎"},{"time":232.49,"text":"向晚星挥手告别欢快梦乡"},{"time":236.37,"text":"背包中散漫乐谱 跳跃的笔画勾勒"},{"time":240.63,"text":"下一天 新的曲调"},{"time":246.09,"text":"闪闪发光 明天依然不一样"}]},{"title":"夏日的第三次结束","lyrics":[{"time":0.0,"text":"作词 : 举烛"},{"time":1.0,"text":"作曲 : Orange Soda"},{"time":2.0,"text":"编曲 : Orange Soda"},{"time":12.63,"text":"从何时察觉冰棒滴落或蝉鸣渐弱"},{"time":23.28,"text":"从你的瞳孔倒映出踌躇的溪河"},{"time":33.9,"text":"夏日的结束像挚爱变故友悠然着沉默"},{"time":44.73,"text":"不经意想起连一寸遗憾都显过多"},{"time":55.38,"text":"残存的夏天坠入湖泊溺进了云朵"},{"time":65.94,"text":"轻轻一触碰天空都因此破碎零落"},{"time":76.74,"text":"我挥别风景看着挥手的你向身后坍缩"},{"time":87.33,"text":"从此也告别荒诞俗套的煽情戏辙"},{"time":97.71,"text":"再也寻不到幽凉着滚烫的日暮"},{"time":108.33,"text":"再也记不起侧脸上柔软的恍惚"},{"time":119.04,"text":"再读起那时日记却只读出唐突"},{"time":129.66,"text":"字符间全是彼此过了期的情愫"},{"time":162.03,"text":"可我却没有值得惋惜夏日的线索"},{"time":172.65,"text":"你也丢失了为你而耐心拾捡的贝壳"},{"time":183.27,"text":"像你曾说的要经告别三次才算到夏末"},{"time":193.98,"text":"可不辞而别又应该算作哪种失落"},{"time":209.64,"text":"最初你只是遗憾于夏天的结束（结束）"},{"time":220.41,"text":"然后是我也释然了挥别的孤独（仿佛不曾孤独）"},{"time":231.03,"text":"最后彼此的回忆（彼此的回忆）都洇湿成模糊（变得模糊）"},{"time":241.59,"text":"像是脆弱的相片（相片）被吹进了雨幕（雨幕）"},{"time":268.38,"text":"我从未想过你名字竟这样生疏（生疏）"},{"time":279.03,"text":"面目全非后才被我不幸地认出（像是某种孤独）"},{"time":289.74,"text":"在陌生的称呼间（陌生的称呼）彼此匆匆庆祝（形同陌路）"},{"time":300.51,"text":"把夏日倒影埋在（埋在）第三次的结束（结束）"}]},{"title":"夏花挽浪","lyrics":[{"time":0.0,"text":"纯音乐，请欣赏"}]},{"title":"天南海北酥","lyrics":[{"time":0.0,"text":"纯音乐，请欣赏"}]},{"title":"折子戏","lyrics":[{"time":0.0,"text":"折子戏"},{"time":6.77,"text":"曲作 - 信弦"},{"time":10.67,"text":"编曲 - Chase梦音"},{"time":12.64,"text":"作词 - 白棠"},{"time":14.54,"text":"调校 - 焱依_01"},{"time":16.48,"text":"混音 - 饭后AfterDinner"},{"time":18.4,"text":"曲绘 - 彳亍REIM AyanXMemory_001"},{"time":20.3,"text":"PV - AyanXMemory_001"},{"time":22.24,"text":"标题设计 - 白棠"},{"time":25.21,"text":"和声编写 - YAFLY"},{"time":34.07,"text":"残阳落霞映街头"},{"time":38.08,"text":"风满旗 花满楼"},{"time":42.0,"text":"桂香浮空游街走"},{"time":45.92,"text":"茶微涩 恰入喉"},{"time":49.73,"text":"竹影斜疏分碧落"},{"time":53.54,"text":"狂言十载酿陈酒"},{"time":57.35,"text":"戏言雪里埋"},{"time":59.4,"text":"人间灯火旧 难留"},{"time":65.13,"text":"就像年轮般的坟头酒"},{"time":68.89,"text":"浇透了又干涸"},{"time":70.85,"text":"干涸了再浇透"},{"time":72.93,"text":"世上若真的忘川有"},{"time":76.58,"text":"春风也拂绿几度秋"},{"time":80.64,"text":"你埋下惊蛰半宿"},{"time":84.51,"text":"轻巧将长星染锈"},{"time":88.48,"text":"她望向雨夜幽幽"},{"time":91.83,"text":"执意说月色温柔"},{"time":95.7,"text":"多年后寻旧折戏"},{"time":100.03,"text":"谁满纸难言名姓"},{"time":103.88,"text":"少年心绪多别离"},{"time":105.88,"text":"何处长剑指月影"},{"time":108.13,"text":"何必折柳问归期"},{"time":111.6,"text":"你一去未辞 笑歧路至此"},{"time":115.74,"text":"是她太不懂事"},{"time":119.46,"text":"我踏雪寻影 空倚她残忆"},{"time":123.85,"text":"斗胆问声值不值"},{"time":161.96,"text":"台上绸缪犹束薪"},{"time":165.75,"text":"烛绕遍 闲庭院"},{"time":169.69,"text":"爆竹声声点明灭"},{"time":173.57,"text":"谶欲辩 已忘言"},{"time":177.56,"text":"苔痕染迹接断棱"},{"time":181.16,"text":"笑言零零弦丝绝"},{"time":185.2,"text":"碧海望连天"},{"time":187.26,"text":"断戟错横叠 雨斜"},{"time":192.95,"text":"就像轮回般的朔望月"},{"time":196.64,"text":"残缺了又圆满"},{"time":198.6,"text":"圆满了再残缺"},{"time":200.73,"text":"共听它万里长安雪"},{"time":204.32,"text":"难寄这半尺扬州笺"},{"time":208.48,"text":"还未续新柳梨园"},{"time":212.19,"text":"故草才疯长连天"},{"time":216.24,"text":"我拨开风花雪月"},{"time":219.53,"text":"判几轮图穷匕见"},{"time":223.47,"text":"如今已无旧折戏"},{"time":227.76,"text":"谁故作寻寻觅觅"},{"time":231.53,"text":"年少悲欢总多情"},{"time":233.57,"text":"难敌广厦已将倾"},{"time":235.94,"text":"难堪提笔所指意"},{"time":239.38,"text":"走历历四季 数虚实故事"},{"time":243.43,"text":"从来结尾相似"},{"time":247.21,"text":"又一年春始 归燕离人辞"},{"time":251.54,"text":"花红江青也如是"}]},{"title":"潮汐漂流瓶","lyrics":[{"time":0.0,"text":"潮汐漂流瓶"},{"time":17.94,"text":"曲编 - 燈林"},{"time":20.0,"text":"作词 - 梦圆"},{"time":21.97,"text":"调校 - 九雪 纳兰思绫"},{"time":23.96,"text":"混音 - 燈林"},{"time":25.94,"text":"曲绘 - kazma与八百万"},{"time":27.97,"text":"PV - 霞露竹翎"},{"time":29.96,"text":"特别感谢 - 林墨白"},{"time":33.34,"text":"枕涛声睡下之前"},{"time":37.4,"text":"别忘记互道晚安"},{"time":41.31,"text":"季风雨坠向堤岸"},{"time":44.55,"text":"弹奏着窗台"},{"time":49.23,"text":"潮汐吟诵出念想"},{"time":53.46,"text":"念想充盈了波光"},{"time":57.31,"text":"顺月升月落抽芽"},{"time":60.48,"text":"生长"},{"time":65.33,"text":"趁仲夏光景 缓慢打造 漂流瓶"},{"time":73.4,"text":"跟随雪糕滑进 冰棱"},{"time":76.91,"text":"妄图抵消距离"},{"time":81.34,"text":"冷焰火余温 取来烧制漂流瓶"},{"time":89.24,"text":"拾起海螺电话接听"},{"time":92.96,"text":"被模糊的讯息"},{"time":129.28,"text":"想拜托迁徙水鸟"},{"time":133.12,"text":"替浪潮抒写诗行"},{"time":137.36,"text":"衔走潮湿的烦恼"},{"time":140.62,"text":"改换成朝阳"},{"time":145.21,"text":"细砂堆积起希望"},{"time":149.34,"text":"希望再敲击心脏"},{"time":153.39,"text":"漂游里同频收缩"},{"time":156.38,"text":"舒张"},{"time":161.36,"text":"举双手攥紧 满载思念漂流瓶"},{"time":169.35,"text":"黄昏时分向北邮寄"},{"time":172.8,"text":"不惧洋流倒逆"},{"time":177.44,"text":"从心口擎出 晶亮坚硬漂流瓶"},{"time":185.35,"text":"梦醒片刻向南送递"},{"time":188.83,"text":"送予你"},{"time":193.3,"text":"让欢笑与泪尽数揽进 漂流瓶"},{"time":201.26,"text":"目送它踊跃向海 向你"},{"time":204.91,"text":"指尖浪花相系"},{"time":209.3,"text":"你我心意是 最珍重的 漂流瓶"},{"time":217.2,"text":"怀揣它就不惧 沉寂"},{"time":220.92,"text":"再向海 前行"}]},{"title":"红尘寄雪","lyrics":[{"time":0.0,"text":"作词 : 北山薇 作曲 : 被遗忘者的哀伤 编曲 : 被遗忘者的哀伤 《红尘寄雪》"},{"time":1.12,"text":"“君埋泉下泥销骨，我寄人间雪满头。”"},{"time":2.38,"text":"旧时景 香尘去"},{"time":5.85,"text":"剑扫春风絮 遥指关山雁啼"},{"time":10.92,"text":"朝暮换 日月移"},{"time":14.79,"text":"聊借浮云笔 此间叙"},{"time":40.14,"text":"今宵剪烛 芙蓉帐下一顾"},{"time":43.65,"text":"红绡垂上蝴蝶骨 青丝乱枕沉香炉"},{"time":48.99,"text":"长安三鼓 不待胭脂熟"},{"time":52.38,"text":"便远赴 望云外 风起平芜"},{"time":57.93,"text":"此去沉浮 迢迢至天北 无归路"},{"time":62.13,"text":"托信玉门去 知君饮马江头宿 渐无书"},{"time":66.75,"text":"还忆当初 对清秋如故 曾许江湖"},{"time":71.49,"text":"抬眸处 相思怎渡"},{"time":74.46,"text":"谁握住指间红线 拜明月乞天怜"},{"time":79.08,"text":"枕上约吹灯不见 故人此别叩窗风雪"},{"time":83.49,"text":"潮起时孤鸿飞掠 只影去赴黄泉"},{"time":87.9,"text":"道是天涯明灭 意难平在人间"},{"time":92.46,"text":"夜来梦关山 心事诉与阑珊"},{"time":96.15,"text":"醒罢眼底江岸 谁握金钗伫门外"},{"time":101.25,"text":"经年春秋改 江湖聚散难猜"},{"time":105.24,"text":"欲将别酒杯盏 尽倾烟波外"},{"time":111.27,"text":"平生遗恨 琐窗风雨曾诉"},{"time":114.78,"text":"昔日红衣埋黄土 桃花剑上烟尘覆"},{"time":120.06,"text":"长安三鼓 飞沙没马足"},{"time":123.42,"text":"天将暮 流光过 银鞍白骨"},{"time":129.12,"text":"玉扇浓暑 对饮琳琅时 蛾眉蹙"},{"time":133.2,"text":"烽火催蹄声 辗转忽觉惊梦处 往来哭"},{"time":137.88,"text":"回望山河 往事皆如雾 春风相顾"},{"time":142.56,"text":"难眠处 怀君眉目"},{"time":145.56,"text":"谁握住指间红线 拜明月乞天怜"},{"time":150.15,"text":"枕上约吹灯不见 故人此别叩窗风雪"},{"time":154.53,"text":"潮起时孤鸿飞掠 只影去赴黄泉"},{"time":159.03,"text":"道是天涯明灭 意难平在人间"},{"time":163.56,"text":"夜来梦关山 心事诉与阑珊"},{"time":167.28,"text":"醒罢眼底江岸 谁握金钗伫门外"},{"time":172.32,"text":"经年春秋改 江湖聚散难猜"},{"time":176.31,"text":"欲将别酒杯盏 尽倾烟波外"},{"time":182.2,"text":"红尘寄雪"},{"time":184.4,"text":"作编曲：被遗忘者的哀伤"},{"time":186.69,"text":"作词：北山薇"},{"time":188.83,"text":"演唱：洛天依乐正绫"},{"time":190.0,"text":"调校：玖蝶鬼面 P"},{"time":191.11,"text":"混音：橘子"},{"time":192.75,"text":"曲绘：绫汜鹣芝"},{"time":193.42,"text":"PV：苏卿白"},{"time":194.42,"text":"吉他： Sepia"},{"time":195.57,"text":"二胡：被遗忘者的哀伤"},{"time":196.58,"text":"和声编写：汐月兔"},{"time":197.76,"text":"出品：吹玉计划"},{"time":198.27,"text":"监制：花间有鹿来"},{"time":198.92,"text":"协力：磷元素 P半只金蓝"},{"time":200.03,"text":"人间墨 洒为歌"},{"time":203.7,"text":"谁欲抛身探碧落"},{"time":208.14,"text":"平生诺 平生错"},{"time":211.44,"text":"枝上香魄 换尘色"},{"time":216.69,"text":"谁抚过衾枕余温 叩明月向天问"},{"time":221.19,"text":"隔一梦黄泉离分 我寄人间风霜满身"},{"time":225.66,"text":"到如今天涯繁盛 长烟去又一春"},{"time":230.01,"text":"谁白骨留玉门 谁白发困此生"},{"time":235.54,"text":"语罢清宵泪满桃花樽"},{"time":235.54,"text":"（欲雨天渐昏 昔年埋酒仍温）"},{"time":239.63,"text":"红颜白骨零落成尘"},{"time":239.63,"text":"（繁华散作香尘应是垂泪觉秋深）"},{"time":243.84,"text":"便守孤馆摇红梦良辰"},{"time":243.84,"text":"（明烛赴良辰难遣梦醒离分）"},{"time":248.35,"text":"望尽河山再寻故人"},{"time":248.35,"text":"（泣声掩却漏声何处寻故人）"}]},{"title":"魔法烹调大作战","lyrics":[{"time":0.87,"text":"升起柴禾与炉灶"},{"time":2.73,"text":"备上香辛料来准备炙烤"},{"time":4.84,"text":"难得有食材精妙"},{"time":6.42,"text":"经不住这般烟熏火燎"},{"time":8.53,"text":"快放下手里汤勺"},{"time":10.29,"text":"汤盅这么小根本吃不饱"},{"time":12.43,"text":"奶油汤才是王道"},{"time":13.93,"text":"慢慢煲细细熬"},{"time":16.07,"text":"魔法烹调大作战"},{"time":17.81,"text":"曲编 - 半只金蓝"},{"time":18.74,"text":"作词 - 千草幻星 月星之兔"},{"time":19.78,"text":"调校 - 跨海星尘 星际"},{"time":20.61,"text":"混音 - 倾谙"},{"time":21.52,"text":"曲绘 - 白"},{"time":22.48,"text":"PV - 江筱落"},{"time":23.51,"text":"封面 - 半只金蓝"},{"time":30.95,"text":"柠檬孜然黑胡椒"},{"time":32.88,"text":"迷迭香配罗勒草"},{"time":34.66,"text":"多吃烧烤对生长发育好"},{"time":38.58,"text":"《龙族生活习性》里可没这条"},{"time":42.25,"text":"明明只是你胡闹"},{"time":45.88,"text":"才不是我乱编造"},{"time":47.95,"text":"寡淡汤料没味道"},{"time":49.77,"text":"油花直冒香烤才能管饱"},{"time":53.4,"text":"只顾张嘴等吃又从不掌勺"},{"time":57.2,"text":"不许坏龙嘴巴挑"},{"time":61.63,"text":"不如发起决斗"},{"time":63.7,"text":"难道赌注会是汤和烧烤"},{"time":67.38,"text":"谁去谁留"},{"time":68.96,"text":"那我欣然接受"},{"time":71.23,"text":"可不要指望我会留手"},{"time":77.92,"text":"起手先出瞬发招"},{"time":79.63,"text":"对战魔法师需打断读条"},{"time":81.74,"text":"别放风筝到处跑"},{"time":83.31,"text":"你这是欺负脆皮魔导"},{"time":85.33,"text":"竟然能接下这招"},{"time":86.91,"text":"想来不会轻易被我打倒"},{"time":89.27,"text":"小打小闹太无聊"},{"time":90.73,"text":"快将胜负揭晓"},{"time":92.71,"text":"看来我只有用出"},{"time":94.79,"text":"苍穹暴风雨狂潮"},{"time":96.74,"text":"疾速海啸激荡龙息巨炮"},{"time":100.48,"text":"那我会召唤神圣天佑星耀"},{"time":103.99,"text":"旭日千炎不死鸟"},{"time":107.99,"text":"不准你到处乱跳"},{"time":109.81,"text":"快原地乖乖站好"},{"time":111.68,"text":"吃我一记"},{"time":112.64,"text":"强制禁锢水流笼牢"},{"time":115.44,"text":"亏我走位还勉强算是风骚"},{"time":118.24,"text":"想什么办法都捉不到 （就要让你捉不到）"},{"time":123.63,"text":"情况有点糟糕"},{"time":125.5,"text":"形势貌似对我也不太妙"},{"time":129.26,"text":"这个对手战况难以明了"},{"time":133.13,"text":"比我想象中更加难熬"},{"time":139.89,"text":"到底有几根蓝条"},{"time":141.52,"text":"数不清你放完多少大招"},{"time":143.46,"text":"究竟防御叠多高"},{"time":145.08,"text":"是不是你铠甲穿五套"},{"time":147.29,"text":"基础招式太无聊"},{"time":148.94,"text":"开动脑筋寻找获胜诀窍"},{"time":151.06,"text":"想法确实挺奇妙"},{"time":152.61,"text":"可惜遇上我就难以起效"},{"time":154.89,"text":"我的脾气可不好"},{"time":156.41,"text":"输就输了我又不会嘲笑"},{"time":158.55,"text":"不许你再放嘴炮"},{"time":160.11,"text":"那快快出招一见分晓"},{"time":162.24,"text":"看起来准头不高"},{"time":163.93,"text":"跑来跑去怎么会打得着"},{"time":166.14,"text":"好险别把碗打倒"},{"time":167.6,"text":"差点浪费材料"},{"time":184.47,"text":"是谁肚子在咕咕叫唤"},{"time":187.74,"text":"要不就此休战"},{"time":189.54,"text":"先来考虑吃饭"},{"time":191.48,"text":"不然这么办"},{"time":192.92,"text":"食材我们均摊"},{"time":194.7,"text":"先煮掉一半"},{"time":196.63,"text":"再烤一半"},{"time":199.85,"text":"怎么只剩下空碗"},{"time":201.41,"text":"好像还听见有翅膀扑扇"},{"time":203.52,"text":"让我抬头看一看"},{"time":205.07,"text":"猫头鹰叼着材料逃跑"},{"time":207.32,"text":"技能都还在读条"},{"time":208.91,"text":"要击落飞鸟实在没力道"},{"time":211.15,"text":"今晚菜谱换一换"},{"time":212.63,"text":"把坏龙给红烧"}]},{"title":"黄楼月","lyrics":[{"time":2.97,"text":"醒时同对月 醉时共枕眠"},{"time":6.82,"text":"自有湖光山色任留恋"},{"time":10.32,"text":"少年志在人间 便若清辉相皎洁"},{"time":14.24,"text":"待将功名遂 莫教负此约"},{"time":19.41,"text":"黄楼月"},{"time":21.25,"text":"曲编 - 砖厂浪人"},{"time":22.16,"text":"作词 - 萧暮雨"},{"time":23.03,"text":"调校 - 折v 跨海星尘"},{"time":23.97,"text":"混音 - 虎皮猫P"},{"time":24.86,"text":"曲绘 - 浮空茜"},{"time":25.83,"text":"PV - AyanXMemory_001"},{"time":27.63,"text":"“异时对，黄楼夜景，"},{"time":28.51,"text":"为余浩叹。”"},{"time":33.64,"text":"记得那年城外花开却"},{"time":36.25,"text":"闲来携手同游浣溪前"},{"time":41.08,"text":"顾看峨眉山月挂中天"},{"time":43.71,"text":"护我此行东去万事全"},{"time":48.07,"text":"人道腹有诗书三千卷"},{"time":51.03,"text":"当时共客长安意何限"},{"time":56.0,"text":"而今殿上春风吹未遍"},{"time":58.49,"text":"怎奈山长水阔一为别"},{"time":63.29,"text":"团团天上月 盈盈圆又缺"},{"time":70.52,"text":"孤光千万里 几回伴君眠"},{"time":77.02,"text":"相期知何夜 相见更何年"},{"time":80.7,"text":"古今惟有相思不曾变"},{"time":84.22,"text":"南柯梦何时觉 多少悲欢都过眼"},{"time":88.12,"text":"露华清如雪 空锁楼中燕"},{"time":91.73,"text":"醒时同对月 醉时共枕眠"},{"time":95.42,"text":"往事倏而纷散作云烟"},{"time":98.89,"text":"若他日能得愿 功成放还山林间"},{"time":102.87,"text":"记得归来同此 对床听雨约"},{"time":118.73,"text":"记得元丰二年风雨夜"},{"time":121.11,"text":"静看庭中繁花开又谢"},{"time":125.93,"text":"津前犹自回望人间"},{"time":128.65,"text":"怎知扁舟去后几成诀"},{"time":133.45,"text":"明明阶上雪 萋萋芳草歇"},{"time":140.73,"text":"梦魂千万里 无复与君言"},{"time":146.97,"text":"相期知何夜 相见更何年"},{"time":150.78,"text":"古今惟有相思不曾变"},{"time":154.31,"text":"南柯梦何时觉 多少悲欢都过眼"},{"time":158.31,"text":"但恐清河水 依旧载离别"},{"time":161.75,"text":"醒时同对月 醉时共枕眠"},{"time":165.59,"text":"往事倏而纷散作云烟"},{"time":169.08,"text":"若他日能得愿 功成放还山林间"},{"time":173.04,"text":"记得归来同此 对床听雨约"},{"time":176.8,"text":"梦影今何见 梦醒更何年"},{"time":180.34,"text":"恍然已是湖山经行遍"},{"time":183.83,"text":"岁华衰鬓成雪 久住天涯知已倦"},{"time":187.77,"text":"望断故园路 不见昔时月"},{"time":191.43,"text":"相思夜复夜 相期年逾年"},{"time":195.05,"text":"回首已是人间春去也"},{"time":198.5,"text":"若进退两难全 命里相隔无处见"},{"time":202.53,"text":"惟愿今生因缘 来生复揽结"},{"time":206.28,"text":"今宵独坐床前 夜阑秉烛不得眠"},{"time":210.14,"text":"庭上沥沥秋雨 更谁赴此约"}]}]}