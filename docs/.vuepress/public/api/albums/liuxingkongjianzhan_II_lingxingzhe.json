    {
      "title": "4 涂色游戏",
      "file": "4 涂色游戏.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "4 涂色游戏"
        },
        {
          "time": 3.24,
          "text": "Composer 靘QING"
        },
        {
          "time": 6.13,
          "text": "Lyricist 靘QING"
        },
        {
          "time": 9.05,
          "text": "Vocal 永夜Minus"
        },
        {
          "time": 11.86,
          "text": "Tuning 靘QING"
        },
        {
          "time": 14.72,
          "text": "看到几种颜色"
        },
        {
          "time": 16.44,
          "text": "可你偏偏是灰色"
        },
        {
          "time": 21.93,
          "text": "那几种颜色中"
        },
        {
          "time": 23.71,
          "text": "挑选你合适的配色"
        },
        {
          "time": 28.2,
          "text": "你那眼眶之中"
        },
        {
          "time": 30.54,
          "text": "迷惑闪烁"
        },
        {
          "time": 31.68,
          "text": "像是忧郁的蓝色"
        },
        {
          "time": 35.53,
          "text": "你那脸颊之上"
        },
        {
          "time": 37.78,
          "text": "就用红色充实些温度"
        },
        {
          "time": 43.81,
          "text": "我不喜欢黑色"
        },
        {
          "time": 45.57,
          "text": "刻意选择蓝色填充"
        },
        {
          "time": 50.92,
          "text": "你不喜欢白色"
        },
        {
          "time": 52.85,
          "text": "原因我已经不记得"
        },
        {
          "time": 57.33,
          "text": "像碎片一样"
        },
        {
          "time": 59.6,
          "text": "拼接又会散掉"
        },
        {
          "time": 61.36,
          "text": "颜色会乱掉"
        },
        {
          "time": 63.2,
          "text": "记忆会被抹消"
        },
        {
          "time": 65.06,
          "text": "总在想自己是不是"
        },
        {
          "time": 67.49,
          "text": "已经忘记了重要信号"
        },
        {
          "time": 69.81,
          "text": "回头看一座苍白孤岛"
        },
        {
          "time": 75.83,
          "text": "许多冒险没你会很遗憾"
        },
        {
          "time": 83.09,
          "text": "许多问题会想你怎么看"
        },
        {
          "time": 90.37,
          "text": "我常问自己没你怎么办"
        },
        {
          "time": 97.69,
          "text": "灰色的故事是否有答案"
        },
        {
          "time": 104.92,
          "text": "做梦会想到与你再相见"
        },
        {
          "time": 112.19,
          "text": "那时我们似乎互相讨厌"
        },
        {
          "time": 119.5,
          "text": "你说你永远不可能会变"
        },
        {
          "time": 126.77,
          "text": "我说我也不可能改变"
        },
        {
          "time": 132.38,
          "text": "可是已全部改变"
        },
        {
          "time": 167.37,
          "text": "那几种颜色中"
        },
        {
          "time": 169.43,
          "text": "灰白是他的本色"
        },
        {
          "time": 174.6,
          "text": "上色的回忆中"
        },
        {
          "time": 176.64,
          "text": "迟早有些会褪色"
        },
        {
          "time": 180.99,
          "text": "你那眼眶之中"
        },
        {
          "time": 183.23,
          "text": "迷惑闪烁"
        },
        {
          "time": 184.36,
          "text": "不会淡化的蓝色"
        },
        {
          "time": 188.29,
          "text": "你那脸颊之上"
        },
        {
          "time": 190.48,
          "text": "是否还有吻过的温度"
        }
      ]
    },
