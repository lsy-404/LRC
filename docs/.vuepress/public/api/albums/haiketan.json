02,"text":"登高楼"},{"time":153.63,"text":"望青云迤逦"},{"time":155.66,"text":"载远多少烟雨"},{"time":159.36,"text":"千金买酒与君话（琴棋书画）"},{"time":163.02,"text":"海角共天涯（莫牵挂）"},{"time":166.68,"text":"愿得千万间广厦（纳天下）"},{"time":170.36,"text":"壮哉我华夏（有容乃大）"},{"time":174.01,"text":"纵长路沟壑难平荆途迢迢"},{"time":177.21,"text":"不能消挫中国人的根骨骄傲"},{"time":181.38,"text":"心怀长江黄河迭浪滔滔"},{"time":184.52,"text":"四方城抬首仍有旌旗飘摇"},{"time":188.64,"text":"三股红线结同心穗名平安"},{"time":191.85,"text":"五十六扣四海同胞风雨共担"},{"time":195.99,"text":"曲水转山路弯九九连环"},{"time":199.18,"text":"红彻我大中华的壮美河山"}]},{"title":"寄远书","lyrics":[{"time":7.17,"text":"一盏明月点亮了亭邮"},{"time":11.12,"text":"一纸雪寄往枝头"},{"time":14.52,"text":"一笔江流送远了行舟"},{"time":18.62,"text":"空余南陵水悠悠"},{"time":21.78,"text":"客心久随潮信四飘游"},{"time":25.92,"text":"路过哪一处江楼"},{"time":29.49,"text":"数落花数多离愁"},{"time":33.11,"text":"风中纤缆  怎堪长系留"},{"time":36.85,"text":"我问过客 归心是否藏旧"},{"time":40.47,"text":"马蹄不休扰了谁家红袖"},{"time":44.11,"text":"风紧云轻平添闲愁"},{"time":47.5,"text":"自一别  又是深秋"},{"time":50.24,"text":"行车偶至漫天霞岚映枫晚"},{"time":53.99,"text":"却常憾不得与知己相共看"},{"time":57.71,"text":"就枝择取红叶一片鱼雁传"},{"time":61.6,"text":"酒洒痴心  便渡河与山"},{"time":64.98,"text":"往来书信多叹少年志未满"},{"time":68.58,"text":"愁绪写到信尾又峰回路转"},{"time":72.25,"text":"说那风流传奇到头也只是"},{"time":76.28,"text":"戏园里  几板评弹"},{"time":87.28,"text":"一盏明月点亮了亭邮"},{"time":91.32,"text":"一纸雪寄往枝头"},{"time":94.57,"text":"一笔江流送远了行舟"},{"time":98.56,"text":"空余南陵水悠悠"},{"time":101.75,"text":"客心久随潮信四飘游"},{"time":105.85,"text":"路过哪一处江楼"},{"time":109.44,"text":"数落花数多离愁"},{"time":113.14,"text":"风中纤缆  怎堪长系留"},{"time":116.81,"text":"我问涓流  寄思念能至否"},{"time":120.42,"text":"岁月霜尘老了孤客远游"},{"time":124.07,"text":"沧桑路人许是吾友"},{"time":127.42,"text":"劳河伯  待他优厚"},{"time":130.52,"text":"行文偶至满纸字词笔款款"},{"time":134.04,"text":"辞章虽滥唯此情意非泛泛"},{"time":137.71,"text":"相知何须论及相伴长或短"},{"time":141.57,"text":"推心置腹  纵隔河与山"},{"time":144.96,"text":"往来书信多叹尘途行路难"},{"time":148.59,"text":"忧思写到信尾又峰回路转"},{"time":152.26,"text":"想那英雄轶事终究也不过"},{"time":156.33,"text":"说书摊  半日闲谈"},{"time":160.3,"text":"衣上霜雪化作  笔下的江流"},{"time":163.92,"text":"明月折入一封  寄向天涯的问候"},{"time":166.94,"text":"行车偶至漫天霞岚映枫晚"},{"time":170.44,"text":"却常憾不得与知己相共看"},{"time":174.05,"text":"就枝择取红叶一片鱼雁传"},{"time":177.89,"text":"酒洒痴心  便渡河与山"},{"time":181.33,"text":"往来书信多叹尘途行路难"},{"time":184.99,"text":"忧思写到信尾又峰回路转"},{"time":188.67,"text":"想那英雄轶事终究也不过"},{"time":192.56,"text":"说书摊  半日闲谈"}]},{"title":"少林棍","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":4.0,"text":"调校：B^2"},{"time":7.66,"text":"嚯！"},{"time":13.82,"text":"哈！"},{"time":19.94,"text":"嚯！"},{"time":26.11,"text":"（哈！）挑 残阳一点上嵩山峰"},{"time":28.97,"text":"堂东 落叶起秋风我扫无踪"},{"time":32.24,"text":"快 两相交手我最厉害"},{"time":35.13,"text":"意外 得胜还道句善哉善哉"},{"time":44.55,"text":"嚯！"},{"time":50.71,"text":"（哈！）望 万丈苍崖有华松盖"},{"time":53.59,"text":"发呆 想有朝也能声名在外"},{"time":56.84,"text":"但 师傅又教我莫冲动"},{"time":59.73,"text":"须懂 从一善方成绝世武功"},{"time":63.01,"text":"一 戒杂思多"},{"time":66.09,"text":"二 忌身懒惰"},{"time":69.2,"text":"三 诳语空言不可说"},{"time":73.2,"text":"南无阿弥陀佛"},{"time":76.43,"text":"记要诀 身步相随"},{"time":79.15,"text":"看我 长棍一根不过眉"},{"time":81.47,"text":"虎口上下任番飞"},{"time":83.0,"text":"刺拨劈手云回"},{"time":84.55,"text":"六合镇山招招对"},{"time":86.08,"text":"将往来寒暑追"},{"time":88.75,"text":"心如镜 诸邪不侵"},{"time":91.44,"text":"师说"},{"time":92.2,"text":"“无住不变自古今，虽历万劫而长新”"},{"time":95.28,"text":"霜风移过月影"},{"time":96.85,"text":"天外壑岚任我行"},{"time":98.37,"text":"问道禅宗峻顶"},{"time":100.99,"text":"且披襟"},{"time":109.24,"text":"嚯！"},{"time":115.35,"text":"哈！"},{"time":127.62,"text":"棒 十六招技从永化堂"},{"time":130.51,"text":"洛阳 人皆知我师出柏谷庄"},{"time":133.77,"text":"动 蜻蜓点水轻功提纵"},{"time":136.67,"text":"不动 九图六坐像身定伏龙"},{"time":140.0,"text":"一 戒杂思多"},{"time":143.01,"text":"二 忌身懒惰"},{"time":146.07,"text":"三 诳语空言不可说"},{"time":150.12,"text":"南无阿弥陀佛"},{"time":153.38,"text":"混元棍 直攻取胜"},{"time":156.09,"text":"愿凭 一身武艺救苍生"},{"time":158.38,"text":"助圣主如十三僧"},{"time":159.86,"text":"却难尽三千尘"},{"time":161.45,"text":"百岁过鸟亦不等"},{"time":162.98,"text":"圣主又再几人"},{"time":165.63,"text":"仍糊涂 不求甚悟"},{"time":168.37,"text":"师说"},{"time":169.15,"text":"“如是灭度无量数，实无众生得灭度”"},{"time":172.24,"text":"怀道心而习武"},{"time":173.76,"text":"中华功夫未亡故"},{"time":175.3,"text":"少林棍立此处"},{"time":177.99,"text":"百兵祖"},{"time":190.3,"text":"虽糊涂 略有所悟"},{"time":192.97,"text":"师说"},{"time":193.7,"text":"“如是灭度无量数，实无众生得灭度”"},{"time":196.87,"text":"怀道心而习武"},{"time":198.36,"text":"中华功夫未亡故"},{"time":199.93,"text":"少林棍立此处"},{"time":202.6,"text":"百兵祖"}]},{"title":"当年茶","lyrics":[{"time":28.73,"text":"街道巷尾斑驳骑楼窗仔下"},{"time":28.73,"text":"【街道巷尾骑楼斑驳的窗户外】"},{"time":32.54,"text":"兄弟俩我赶你 你叱我比谁大声"},{"time":32.54,"text":"【兄弟俩你追我赶 吵闹着比谁声音更大】"},{"time":35.84,"text":"阿公泡茶教两人细细讲话"},{"time":35.84,"text":"【阿公泡着茶 让两人小声说话】"},{"time":39.66,"text":"声音再大也盖袂过风吹浪打"},{"time":39.66,"text":"【声音再大也盖不过风吹浪打】"},{"time":43.3,"text":"孬凑做伙的年份 像打翻的碎瓷杯"},{"time":43.3,"text":"【拼凑不起的岁月 像打翻的碎瓷杯】"},{"time":46.83,"text":"转头离家多年 母知各去叨位"},{"time":46.83,"text":"【转身离家多年 不知道各自都去了哪里】"},{"time":50.43,"text":"城市雨落袂停 混着谁的泪水"},{"time":50.43,"text":"【城市的雨下个不停 混着谁的泪水)"},{"time":53.83,"text":"偶然想起 那嘴没饮乾的茶"},{"time":53.83,"text":"【偶然想起 那口没喝完的茶】"},{"time":57.42,"text":"一更更鼓月照山 船行渐远拄着风大"},{"time":57.42,"text":"【一更更鼓月照山 船越走越远 又遇到大风】"},{"time":64.5,"text":"三更更鼓月照窗 人来人往偷窃时间"},{"time":64.5,"text":"【三更更鼓月照窗 人来人往偷走了时间】"},{"time":71.36,"text":"少年似滚水冲入世故"},{"time":71.36,"text":"【少年像滚开的水冲入世故】"},{"time":74.83,"text":"头遍茶的滋味拢是太苦"},{"time":74.83,"text":"【第一泡茶的滋味总是太苦】"},{"time":78.58,"text":"渐渐习惯吞风饮雨"},{"time":78.58,"text":"【渐渐习惯吞风饮雨】"},{"time":81.76,"text":"朋友来斗阵 饮茶甲讲古"},{"time":81.76,"text":"【朋友们来相聚 边喝获边闲聊吧】"},{"time":85.82,"text":"掂起这杯中冷暖人生"},{"time":85.82,"text":"【端起这杯中的冷暖人生】"},{"time":89.11,"text":"苦尽回甘就得入喉细品"},{"time":89.11,"text":"【苦尽甘来需要入喉细品】"},{"time":92.93,"text":"不必满十分浓情"},{"time":92.93,"text":"【不必倒十分满杯太浓的情意】"},{"time":96.04,"text":"冷天茶作酒 淡薄嘛是真"},{"time":96.04,"text":"【冷天以茶代酒 淡淡（的味道）也是真心】"},{"time":114.66,"text":"来回斟酌七八分过往性命"},{"time":114.66,"text":"【来回斟酌七八分过往人生】"},{"time":118.54,"text":"酸甜苦辣拢有 就像那“关公巡城”"},{"time":118.54,"text":"【酸甜苦辣都有 就像是“关公巡城”"},{"time":118.54,"text":"（茶道术语，指分泡七八杯）】"},{"time":121.95,"text":"悬壶高冲点点茶色嘛是打拼"},{"time":121.95,"text":"【“悬壶高冲”（茶道术语）"},{"time":121.95,"text":"冲出的茶色如同一路拼搏的痕迹】"},{"time":125.59,"text":"借春风拂面吹尽风尘心内知影"},{"time":125.59,"text":"【借“春风拂面”（茶道术语，指撇去茶沫）"},{"time":125.59,"text":"吹尽风尘让内心通透】"},{"time":129.11,"text":"每一个孤单的人 纷纷随浪走西东"},{"time":129.11,"text":"【每一个孤单的人 纷纷随浪走西东】"},{"time":132.74,"text":"谁看破心底里 仍漂泊的理想"},{"time":132.74,"text":"【谁看透了内心中 仍在漂泊的理想】"},{"time":136.34,"text":"茶罐装满茶米 有年少时花香"},{"time":136.34,"text":"【获缆装满茶叶 散发年少时闻过的花香】"},{"time":139.72,"text":"经常想起 等我归去的故乡"},{"time":139.72,"text":"【常常想起 等着我回去的故乡】"},{"time":143.37,"text":"一更更鼓月照山 船行渐远拄着风大"},{"time":143.37,"text":"【一更更鼓月照山 船越走越远 又遇到大风】"},{"time":150.45,"text":"三更更鼓月照窗 人来人往偷窃时间"},{"time":150.45,"text":"【三更更鼓月照窗 人来人往偷走了时间】"},{"time":157.38,"text":"少年似滚水冲入世故"},{"time":157.38,"text":"【少年像滚开的水冲入世故】"},{"time":160.68,"text":"头遍茶的滋味拢是太苦"},{"time":160.68,"text":"【第一泡茶的滋味总是太苦】"},{"time":164.58,"text":"渐渐习惯吞风饮雨"},{"time":164.58,"text":"【渐渐习惯吞风饮雨】"},{"time":167.71,"text":"朋友来斗阵 饮茶甲讲古"},{"time":167.71,"text":"【朋友们来相聚 边喝获边闲聊吧】"},{"time":171.73,"text":"掂起这杯中冷暖人生"},{"time":171.73,"text":"【端起这杯中的冷暖人生】"},{"time":175.07,"text":"苦尽回甘就得入喉细品"},{"time":175.07,"text":"【苦尽甘来需要入喉细品】"},{"time":178.84,"text":"不必满十分浓情"},{"time":178.84,"text":"【不必倒十分满杯太浓的情意】"},{"time":182.04,"text":"冷天茶作酒 淡薄嘛是真"},{"time":182.04,"text":"【冷天以茶代酒 淡淡（的味道）也是真心】"},{"time":202.54,"text":"一更更鼓月照山 船行渐远拄着风大"},{"time":202.54,"text":"【一更更鼓月照山 船越走越远 又遇到大风】"},{"time":209.55,"text":"三更更鼓月照窗 人来人往偷窃时间"},{"time":209.55,"text":"【三更更鼓月照窗 人来人往偷走了时间】"},{"time":216.53,"text":"少年似滚水冲入世故"},{"time":216.53,"text":"【少年像滚开的水冲入世故】"},{"time":219.82,"text":"头遍茶的滋味拢是太苦"},{"time":219.82,"text":"【第一泡茶的滋味总是太苦】"},{"time":223.62,"text":"渐渐习惯吞风饮雨"},{"time":223.62,"text":"【渐渐习惯吞风饮雨】"},{"time":226.82,"text":"朋友来斗阵 饮茶甲讲古"},{"time":226.82,"text":"【朋友们来相聚 边喝获边闲聊吧】"},{"time":230.82,"text":"掂起这杯中冷暖人生"},{"time":230.82,"text":"【端起这杯中的冷暖人生】"},{"time":234.14,"text":"苦尽回甘就得入喉细品"},{"time":234.14,"text":"【苦尽甘来需要入喉细品】"},{"time":237.95,"text":"不必满十分浓情"},{"time":237.95,"text":"【不必倒十分满杯太浓的情意】"},{"time":241.06,"text":"冷天茶作酒 淡薄嘛是真"},{"time":241.06,"text":"【冷天以茶代酒 淡淡（的味道）也是真心】"}]},{"title":"我之仅有","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":16.25,"text":"我有一去而路程远"},{"time":20.62,"text":"脚下行过了几个春秋"},{"time":24.8,"text":"我有江湖且也曾渡"},{"time":28.94,"text":"长棹搅扰了几番潮头"},{"time":33.1,"text":"我有乱峰立于九州"},{"time":37.2,"text":"长存天地间几多悠悠"},{"time":41.39,"text":"我有天边御龙潜游"},{"time":45.68,"text":"呼霞成川几许风流"},{"time":50.84,"text":"我有十指握紧清风不堪留"},{"time":55.05,"text":"指隙间有数十脉江河奔走"},{"time":59.08,"text":"我有可凭栏的一百座亭楼"},{"time":63.11,"text":"烟雨靡靡中灯火黯收"},{"time":67.3,"text":"但只得一人与我十指相扣"},{"time":71.48,"text":"五湖四海一道泛舟而远游"},{"time":75.67,"text":"但只得一人和我共上西楼"},{"time":79.87,"text":"远眺银光如霜雪遍披那 连绵的青丘"},{"time":101.36,"text":"我有一去而路程远"},{"time":105.58,"text":"脚下行过了几个春秋"},{"time":109.9,"text":"我有江湖且也曾渡"},{"time":113.84,"text":"长棹搅扰了几番潮头"},{"time":118.12,"text":"我有乱峰立于九州"},{"time":121.97,"text":"长存天地间几多悠悠"},{"time":126.14,"text":"我有天边御龙潜游"},{"time":130.16,"text":"呼霞成川几许风流"},{"time":135.53,"text":"我有满怀踌躇写下诗千首"},{"time":139.85,"text":"令壮志如虹再令痛饮无够"},{"time":143.95,"text":"我有万种忧愁常萦于心头"},{"time":148.18,"text":"如子规长滚热血在喉"},{"time":152.07,"text":"但只得一人对仗我诗千首"},{"time":156.44,"text":"既见行云便发浩歌与君酬"},{"time":160.4,"text":"但只得一人解我万种忧愁"},{"time":164.38,"text":"与我共浇块垒不辞深杯 久醉昏复昼"},{"time":185.86,"text":"我有不知数星罗布在宇宙"},{"time":191.34,"text":"跃入银汉亦如春水向东流"},{"time":195.63,"text":"但只得一人与我十指相扣"},{"time":199.86,"text":"只一人和我共上西楼"},{"time":204.0,"text":"但只得一人对仗我诗千首"},{"time":208.09,"text":"但只得一人解我万种忧愁"},{"time":211.71,"text":"只得一人同我看罗列星宿"},{"time":216.34,"text":"陪我老去这几十春秋 我想这是 我之仅有"}]},{"title":"月夕引","lyrics":[{"time":0.0,"text":"月夕引 - 海鲜面"},{"time":6.61,"text":"词：邪叫教主"},{"time":13.23,"text":"曲：康师傅の海鲜面"},{"time":19.85,"text":"编曲：康师傅の海鲜面"},{"time":26.47,"text":"将词掩"},{"time":28.06,"text":"流萤渐没繁花"},{"time":30.58,"text":"欲乱眼"},{"time":32.04,"text":"道是年华远"},{"time":33.78,"text":"却把红尘轻贱"},{"time":37.51,"text":"何似樽前"},{"time":39.47,"text":"吾亦不识今宵是何年"},{"time":45.7,"text":"谁人识 吾本为世中仙"},{"time":51.93,"text":"望江亭"},{"time":54.0,"text":"叶上霜叠映朱栏迢递"},{"time":59.42,"text":"见有何人 提灯长立"},{"time":62.48,"text":"皓月如白衣"},{"time":65.89,"text":"翡翠台前 拂袖按卷"},{"time":69.03,"text":"夜半游句曲"},{"time":71.65,"text":"瑶窗裁秋枝揽桂影"},{"time":74.06,"text":"佳期再逢月夕"},{"time":92.22,"text":"抛诗卷 银玦落华白露"},{"time":96.29,"text":"点楼轩"},{"time":97.76,"text":"道是月难全"},{"time":99.47,"text":"却假意说团圆"},{"time":103.27,"text":"何拟婵娟"},{"time":105.24,"text":"吾亦残酒相劝忘流年"},{"time":111.45,"text":"谁人劝"},{"time":112.84,"text":"吾心向广寒殿"},{"time":117.61,"text":"遣蜻蜓"},{"time":119.71,"text":"斜卧烟艇更欲小徙倚"},{"time":125.14,"text":"晓风散尽 琼楼玉宇"},{"time":128.19,"text":"高阁闻羌笛"},{"time":131.69,"text":"遥想蟾宫 玉阶冷壁"},{"time":134.81,"text":"断人间烟气"},{"time":137.32,"text":"弄月过垂虹千万里"},{"time":139.8,"text":"也盼灯火迷离"},{"time":144.47,"text":"提灯 不赋词句只高阁长立"},{"time":151.54,"text":"人间迷离 执我玉笛"},{"time":154.55,"text":"试问何所期"},{"time":158.0,"text":"皓色白衣 御风而去"},{"time":161.1,"text":"奈何长相忆"},{"time":163.62,"text":"瑶窗裁秋月过垂虹"},{"time":166.1,"text":"也盼再逢月夕"}]},{"title":"杏月里来凤翎翻","lyrics":[{"time":0.0,"text":"作编曲 : 海鲜面"},{"time":4.96,"text":"作词 : 邪叫教主"},{"time":9.93,"text":"Vocal：洛天依"},{"time":15.46,"text":"恰值这枝头红我看红不过山楂串"},{"time":19.24,"text":"说书人又摆摊"},{"time":21.24,"text":"故事听一段"},{"time":23.16,"text":"讲绣楼会苏三但年少不懂风月关"},{"time":27.03,"text":"为何总道春光"},{"time":28.95,"text":"易将人犯"},{"time":30.84,"text":"空钟响杨柳岸扔骨节洒落青石板"},{"time":34.74,"text":"一地叶影散漫"},{"time":36.68,"text":"时光如絮软"},{"time":38.56,"text":"正仲阳好时节趁杏月里来凤翎翻"},{"time":42.45,"text":"扯纸鸢线轴转"},{"time":44.5,"text":"笑眼弯弯"},{"time":61.9,"text":"里踢外拐，一锅底二锅盖"},{"time":65.79,"text":"钉锤烧卖，再凑副酒盅牙筷"},{"time":69.65,"text":"曾经念着，八仙漂洋过海"},{"time":73.48,"text":"而今故乡，真已在重山之外"},{"time":77.41,"text":"七钩兰花，八把抓抓不到"},{"time":81.26,"text":"九十上脸，飞六彩打花鸡毛"},{"time":85.04,"text":"曾经童谣，唱外帘剪刀抛"},{"time":88.88,"text":"而今词句，叹流光总把人抛"},{"time":92.87,"text":"白日乍看悠缓如手中风车兜兜转"},{"time":96.75,"text":"我猜是常仪她"},{"time":98.69,"text":"醉倒在河畔"},{"time":100.59,"text":"都说春园如海因一色鲜妍百花传"},{"time":104.44,"text":"是否该折纸舟"},{"time":106.43,"text":"邀你共泛"},{"time":108.3,"text":"走出了旧城墙远路数不清悲和欢"},{"time":112.19,"text":"离别像三尺寒"},{"time":114.15,"text":"二月春阳暖"},{"time":116.05,"text":"愁诗总背不完莫负人生几回好玩"},{"time":119.99,"text":"蹴鸾靴趁衣短"},{"time":121.88,"text":"呼朋引伴"},{"time":139.29,"text":"左踢右摆，膝盖头催芳黛"},{"time":143.14,"text":"前应后和，九十九数到一百"},{"time":147.02,"text":"当年扳指，日子算不明白"},{"time":150.95,"text":"今日算来，都换作一声感慨"},{"time":154.84,"text":"花鼓花线，扎一个艳阳天"},{"time":158.65,"text":"云庭云轩，落下个凤翎彩毽"},{"time":162.52,"text":"当年不知，纵情不过当年"},{"time":166.43,"text":"今日说起，今日再难比从前"},{"time":170.3,"text":"空钟响杨柳岸枝头红不过山楂串"},{"time":174.17,"text":"说书人又讲到"},{"time":176.06,"text":"玉堂春意满"},{"time":177.95,"text":"年少不懂悲欢不懂远路难过情关"},{"time":181.86,"text":"长大才知春光"},{"time":183.77,"text":"易将人犯"},{"time":185.71,"text":"走出了旧城墙想起踏过的青石板"},{"time":189.62,"text":"叶影中兜兜转"},{"time":191.59,"text":"斜夕洒河畔"},{"time":193.5,"text":"蹴鸾靴趁衣短好杏月里来凤翎翻"},{"time":197.4,"text":"再回看旧玩伴"},{"time":199.29,"text":"笑眼弯弯"},{"time":216.93,"text":"恰值这枝头红我看红不过山楂串"},{"time":222.21,"text":"说书人又摆摊"},{"time":224.77,"text":"故事听一段"},{"time":227.37,"text":"讲绣楼会苏三但年少不懂风月关"},{"time":232.61,"text":"为何总道春光"},{"time":235.29,"text":"易将人犯"}]},{"title":"桥驿听雨落","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主、果汁凉菜"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":10.0,"text":"调校 : 挨批熊"},{"time":15.0,"text":"视频 : 竹籽"},{"time":20.0,"text":"“细雨落桥，细语于驿--茶客与店主的对话。”"},{"time":28.41,"text":"【菜】"},{"time":28.65,"text":"待到连绵雨初霁"},{"time":31.7,"text":"不巧 今又逢哭丧脸龙王爷"},{"time":35.82,"text":"新裳偏易惹尘泥"},{"time":38.88,"text":"不快 寻巷尾遇茶肆得暂歇"},{"time":43.0,"text":"【叫】"},{"time":43.13,"text":"乌篷推桨渡桥外"},{"time":46.11,"text":"正是 细雨薄织以待素伞开"},{"time":50.25,"text":"门响瞥得有青衫摆"},{"time":53.33,"text":"正好 故事到口就逢听客来"},{"time":57.54,"text":"勿嫌武夷秋叶味清寒"},{"time":60.61,"text":"温水入碗"},{"time":62.46,"text":"绕口香不散"},{"time":64.52,"text":"【菜】"},{"time":64.76,"text":"白罐（儿）撒不知名青茶焙"},{"time":67.85,"text":"想儿时 翠畦田间扑捉白蝶"},{"time":71.87,"text":"我亦曾羡鸟雀四下飞"},{"time":75.19,"text":"而如今 难能安稳又问谁借"},{"time":79.17,"text":"沉香缓步杯沿静欲睡"},{"time":82.33,"text":"苦辛味 盘过喉舌甘香才觉"},{"time":86.4,"text":"再窥天雨一帘何来嫌"},{"time":89.48,"text":"烟柳色 如捧玉碎十里街"},{"time":115.03,"text":"【叫】"},{"time":115.3,"text":"逢雨更觉远山改"},{"time":118.32,"text":"未见 何处春景长留从不败"},{"time":122.5,"text":"也曾顶无檐居四海"},{"time":125.49,"text":"未妨 听我把见闻稍作显摆"},{"time":129.51,"text":"【菜】"},{"time":129.67,"text":"颠沛终求得清净一爿"},{"time":132.83,"text":"抱惑满怀 侧耳请道来"},{"time":136.54,"text":"【叫】"},{"time":136.77,"text":"岳阳采莲歌中闻式微"},{"time":140.02,"text":"秦淮岸 楼头月碎瓦上清辉"},{"time":144.22,"text":"斗城意气少年嗾鹰飞"},{"time":147.25,"text":"渡融江 柳州初霜雁又南归"},{"time":151.29,"text":"【菜】"},{"time":151.4,"text":"两鬓原是渐生秦淮雪"},{"time":154.65,"text":"偶思回 万里之外忽闻歌吹"},{"time":158.56,"text":"离雁总爱将人暇光衔"},{"time":161.62,"text":"才忆起 恍然半生又一岁"},{"time":180.22,"text":"今日感君言或难再逢"},{"time":183.33,"text":"掸衣惜别 只天时当归"},{"time":187.15,"text":"【叫】"},{"time":187.31,"text":"晚秋瓮取夜露酿新醅"},{"time":190.58,"text":"西风送 旧栈灯烛犹落红泪"},{"time":194.69,"text":"几人孤舟蓑笠坐船尾"},{"time":197.87,"text":"几人醉 几人仍将那彩云追"},{"time":201.86,"text":"店前二月柳色十月颓"},{"time":204.96,"text":"世间事 一言难尽也道不对"},{"time":209.11,"text":"闲听雨落恰得与君会"},{"time":212.21,"text":"今日我 淡茶代酒两三杯"}]},{"title":"游戏时间","lyrics":[{"time":7.98,"text":"步步靠近的象棋"},{"time":10.05,"text":"交换眼神的牌底"},{"time":12.14,"text":"心事被我藏匿 在纵横的填字谜"},{"time":16.38,"text":"玩家们已就位 等沙漏倒立"},{"time":20.48,"text":"宣布开局（哒啦哒哒~）"},{"time":24.21,"text":"输赢从没有道理"},{"time":26.46,"text":"因此更让人沉迷"},{"time":28.53,"text":"赌注都被浪费 筹码又何须在意"},{"time":32.72,"text":"押上所有代币 只用来和你"},{"time":36.88,"text":"一起游戏（一起游戏~）"},{"time":40.88,"text":"Ah~ah~ 拼乱了版图 的胡闹国度（胡闹国度~）"},{"time":49.13,"text":"Ah~ah~ 推倒了积木 禁止太严肃（禁止严肃~）"},{"time":57.35,"text":"Ay~ 悬而未决的胜负"},{"time":60.04,"text":"是否忘了计入 心跳的点数"},{"time":65.47,"text":"Ay~ 宝石也自愧不如"},{"time":68.26,"text":"彩色玻璃弹珠"},{"time":73.59,"text":"Ay~ 棋盘上互相追逐"},{"time":76.46,"text":"故意走错一步 就把你拥住"},{"time":81.84,"text":"Ay~ 牵手闯入娃娃屋"},{"time":84.66,"text":"用气球做花束 邀我共舞"},{"time":92.04,"text":"陀螺旋转一圈 宇宙因此晕眩"},{"time":96.17,"text":"掷出二十面骰 命运当作消遣"},{"time":100.2,"text":"乘上玩具火车 私奔去无论在哪的站点"},{"time":104.42,"text":"世界仅供玩乐 在专属游戏的时间"},{"time":112.25,"text":"因你我彼此寻觅"},{"time":114.38,"text":"捉迷藏才会有趣"},{"time":116.48,"text":"奖励若不是你，胜利又有何意义"},{"time":120.68,"text":"攒下许多运气，只用来和你"},{"time":124.8,"text":"一起游戏（哒啦哒哒~）"},{"time":128.96,"text":"Ah~ah~ 马戏团领土 变一个魔术（变个魔术~）"},{"time":137.08,"text":"Ah~ah~ 请锡兵拉开 木偶剧帷幕（拉开帷幕~）"},{"time":145.25,"text":"Ay~ 悬而未决的胜负"},{"time":148.01,"text":"是否忘了计入 心跳的点数"},{"time":153.36,"text":"Ay~ 宝石也自愧不如"},{"time":156.29,"text":"彩色玻璃弹珠"},{"time":161.58,"text":"Ay~ 棋盘上互相追逐"},{"time":164.55,"text":"故意走错一步 就把你拥住"},{"time":169.76,"text":"Ay~ 牵手闯入娃娃屋"},{"time":172.6,"text":"用气球做花束 邀我共舞"},{"time":179.98,"text":"陀螺旋转一圈 宇宙因此晕眩"},{"time":184.14,"text":"掷出二十面骰 命运当作消遣"},{"time":188.12,"text":"心动前先猜拳 取乐不知疲倦"},{"time":192.3,"text":"要认真地耍诈 玩笑绝不敷行"},{"time":196.39,"text":"这里不必再将 大人的角色扮演"},{"time":200.5,"text":"规则只有一条 “别被规则所限”"},{"time":204.54,"text":"乘上玩具火车 私奔去无论在哪的站点"},{"time":208.69,"text":"世界仅供玩乐 在专属我们的时间"}]},{"title":"破军刃","lyrics":[{"time":0.0,"text":"破军刃 - 言和"},{"time":9.82,"text":"词：邪叫教主"},{"time":19.64,"text":"曲：康师傅の海鲜面"},{"time":30.93,"text":"甩手一招 捣马枪"},{"time":33.2,"text":"兵家都道占先机者 为王"},{"time":37.67,"text":"三抛头颅为攒热血洗刃来照"},{"time":41.06,"text":"营帐前明月光"},{"time":45.38,"text":"既张恨天弩"},{"time":46.76,"text":"休道弓前开不足"},{"time":48.63,"text":"或持青锋退强虏 灭你"},{"time":50.89,"text":"百师骑 赌我十步"},{"time":52.73,"text":"号响天边正残霞"},{"time":55.03,"text":"如我带伤眉骨"},{"time":59.54,"text":"自古英雄总是 未及迟暮"},{"time":62.71,"text":"就已作古 身先士卒"},{"time":66.82,"text":"判我永世孽徒 再投狱府"},{"time":70.71,"text":"杀罗刹祭我冥路"},{"time":75.76,"text":"我指天 星汉 化为酒一滴"},{"time":79.3,"text":"长戟破风向西"},{"time":81.28,"text":"辟开征途足千万余里"},{"time":83.61,"text":"一朝趁醉拔倒百人旗"},{"time":86.73,"text":"使君王意气"},{"time":90.24,"text":"我剑舞 荒漠 黄沙肆漫起"},{"time":93.81,"text":"搅寰宇书乱离"},{"time":95.79,"text":"不如由我来再添一笔"},{"time":98.14,"text":"来日趁兴收下连山脊"},{"time":101.32,"text":"玩笑太轻易"},{"time":103.56,"text":"上马即去"},{"time":119.98,"text":"立如林矛 只身闯"},{"time":122.29,"text":"十八翻转双锏更显 风光"},{"time":126.76,"text":"是我劈斩带风引敌寇彻骨凉"},{"time":130.26,"text":"挂满枝三月霜"},{"time":134.51,"text":"命中带吴钩"},{"time":135.91,"text":"万敌丛中取人头"},{"time":137.72,"text":"谁人敢与我试手"},{"time":139.55,"text":"抡斧 三回合 逼你项首"},{"time":141.78,"text":"凯歌回朝正烈阳"},{"time":144.11,"text":"难干战衣血透"},{"time":148.68,"text":"酒中但吁气长 醒时佯狂"},{"time":151.84,"text":"你说思念 也见血光"},{"time":155.89,"text":"易把记忆之中 故人眉眼"},{"time":159.54,"text":"刻画如刀锋般长"},{"time":164.7,"text":"我伐整 河山 打造龙虎韬"},{"time":168.39,"text":"藏千古杀人刀"},{"time":170.43,"text":"又划鸿蒙一线玉峰高"},{"time":172.73,"text":"但不及我挺身翻手招"},{"time":175.86,"text":"胆敢弄虚嚣"},{"time":179.39,"text":"我钺断 江海 掀起千层潮"},{"time":182.92,"text":"以一棍定黑蛟"},{"time":184.91,"text":"虾兵蟹将前也耍大刀"},{"time":187.28,"text":"自诩霸王英姿兴致好"},{"time":190.41,"text":"还不趁势倒"},{"time":192.69,"text":"跪地求饶"},{"time":208.32,"text":"我指天 星汉 化为酒一滴"},{"time":212.12,"text":"长戟破风向西"},{"time":214.02,"text":"辟开征途足千万余里"},{"time":216.25,"text":"一朝趁醉拔倒百人旗"},{"time":219.45,"text":"使君王意气"},{"time":222.93,"text":"我伐整 河山 打造龙虎韬"},{"time":226.62,"text":"藏千古杀人刀"},{"time":228.49,"text":"又划鸿蒙一线玉峰高"},{"time":230.9,"text":"但不及我挺身翻手招"},{"time":234.07,"text":"胆敢弄虚嚣"},{"time":236.34,"text":"弄这虚嚣"}]},{"title":"花田里犯了什么错","lyrics":[{"time":22.82,"text":"桃杏满枝 春色盈窗"},{"time":24.78,"text":"恰是折花好时光"},{"time":26.97,"text":"蝶成对燕成双"},{"time":28.65,"text":"花田盛会上 佳人遇才郎"},{"time":30.53,"text":"题诗赠扇 良缘天降"},{"time":32.41,"text":"别说还是老三样"},{"time":34.52,"text":"总教人心花怒放"},{"time":36.29,"text":"甜的就是糖"},{"time":38.18,"text":"老仆带带路 怎料带的是"},{"time":40.04,"text":"桃花山上小霸王"},{"time":42.19,"text":"请“婿”容易送“婿”却难"},{"time":44.09,"text":"这门亲他要强抢"},{"time":45.75,"text":"挺身救主难 春兰行匆忙"},{"time":47.69,"text":"为有情人做红娘"},{"time":49.53,"text":"寻那桥边雀屏客"},{"time":51.46,"text":"作一番商量"},{"time":53.31,"text":"今晚鼓打 二更时分 准时到西厢"},{"time":57.18,"text":"眼观六路 耳听八方 留意两声响"},{"time":60.94,"text":"休问来人 我拍一声 你就还一掌"},{"time":65.01,"text":"月下灯前得重逢 患难鸳鸯"},{"time":68.15,"text":"虽有红鸾星照佳偶成 尚须凡人费思量"},{"time":72.42,"text":"好事多磨 还得渡风浪"},{"time":75.74,"text":"小女亦怀忠心和义胆 车陷泥中推一掌"},{"time":79.99,"text":"我保的媒 指定不能黄"},{"time":83.83,"text":"戏无波澜不成折~ 花田里犯了什么错~"},{"time":90.93,"text":"哪怕天河万里无通路 愿作鹊仙搭桥梁"},{"time":95.28,"text":"登梅信使 暗送春风吹暖寒夜长"},{"time":110.49,"text":"求圆满 却徒转周章——"},{"time":114.3,"text":"且避耳目 暗入兰房"},{"time":116.24,"text":"相公请先穿女装"},{"time":118.36,"text":"为相见诉衷肠"},{"time":120.18,"text":"放一放身段 不用太阳刚"},{"time":121.95,"text":"三更未至 事生跌宕"},{"time":123.89,"text":"闯来周通小霸王"},{"time":126.0,"text":"昏黑里错掳书生"},{"time":127.91,"text":"共入红罗帐"},{"time":129.6,"text":"刀枪亮堂堂 喜烛明晃晃"},{"time":131.49,"text":"掀开盖头看端详"},{"time":133.52,"text":"“新娘”怎么变成“新郞”?"},{"time":135.44,"text":"一脚踹他下山岗"},{"time":137.25,"text":"山路来何人 僧袍铁蟒杖"},{"time":139.12,"text":"正是鲁达花和尚"},{"time":141.06,"text":"仗义出手平祸殃"},{"time":142.89,"text":"俺自有妙方"},{"time":144.77,"text":"周通再至 免去拜堂 直接入洞房"},{"time":148.6,"text":"不必点灯 洒家趁势 扮一回新娘"},{"time":152.43,"text":"喜床之上 好言相劝 他若敢轻狂"},{"time":156.45,"text":"“奴家”的小拳头就 请他尝尝"},{"time":159.58,"text":"离却禅林何必回首望 红尘亦是修行场"},{"time":163.83,"text":"穿肠酒肉 造怒目金刚"},{"time":167.15,"text":"清规不挡众生凡心向 情仇恩怨是寻常"},{"time":171.44,"text":"提杖扫清 因缘糊涂账"},{"time":175.26,"text":"破晓前也忘不掉~ 花田里犯了什么错~"},{"time":182.37,"text":"休将打扰自诩为多情 果报临头求原谅"},{"time":186.63,"text":"江湖罗汉 惯以戒刀证法除魔障"},{"time":205.2,"text":"人间怨解缘结戏一场 演尽啼笑众生相"},{"time":209.49,"text":"台上台下 哪处不荒唐"},{"time":212.81,"text":"无论身出山林或闺房 豪性自使侠风扬"},{"time":217.12,"text":"涤尘见月 照天地清朗"},{"time":220.9,"text":"鸾风和鸣三拜堂~ 花田里犯了什么错~"},{"time":228.05,"text":"戏里戏外光景只片晌 真情真义久流芳"},{"time":232.39,"text":"起承转合 将这风流热闹再唱响"}]},{"title":"药药药","lyrics":[{"time":24.85,"text":"翻遍了内经和本草"},{"time":27.03,"text":"哪一味才算最地道"},{"time":29.16,"text":"师傅说 不管有什么灵丹妙药"},{"time":32.09,"text":"要花时间慢慢熬"},{"time":34.28,"text":"滚沸三江潮"},{"time":35.6,"text":"这天圆地方是炉灶"},{"time":37.78,"text":"五千年的招牌自成天字第一号（天字一号）"},{"time":42.88,"text":"先练“陈皮”再壮“龙骨”形神兼具"},{"time":44.98,"text":"打出“虎掌”以毒攻毒天下无敌"},{"time":47.13,"text":"心中燃起一团“艾火”烧净人间的积郁"},{"time":51.36,"text":"百病不侵临危不惧"},{"time":53.87,"text":"因凭党参山药白术补益"},{"time":57.11,"text":"这一身浩然正气"},{"time":59.23,"text":"药药药 活国先活人"},{"time":61.39,"text":"治世道 隐疾的病根"},{"time":63.46,"text":"药药药 返璞归本真"},{"time":65.58,"text":"去沉淀 这滚滚红尘"},{"time":67.83,"text":"妙灵丸 抟出日月轮"},{"time":69.91,"text":"仙人散 洒作漫天辰"},{"time":72.01,"text":"化春水 行气成东风"},{"time":74.2,"text":"滋养我 民族精气神 万古长存"},{"time":85.02,"text":"百子柜中藏龙宫宝"},{"time":86.99,"text":"配一方济世的良药"},{"time":89.13,"text":"师傅说 不管是什么灵芝仙草"},{"time":92.31,"text":"要花时间慢慢找"},{"time":94.28,"text":"寻药先问道"},{"time":95.61,"text":"翻过一山比一山高"},{"time":97.78,"text":"五千年精诚之所至传承到今朝（传到今朝）"},{"time":102.95,"text":"飞渡灵岩石斛凌于九霄绝壁"},{"time":104.99,"text":"北岳连横一条龙脊上有黄芪"},{"time":107.14,"text":"你我皆无名辈正如百草寄命于天地"},{"time":111.68,"text":"不惜竭尽蚍蜉之力"},{"time":113.86,"text":"哪怕枯荣只在弹指须臾"},{"time":117.0,"text":"生万代生生不息"},{"time":119.16,"text":"药药药 三辨阴阳证"},{"time":121.31,"text":"治世道 纷扰的杂症"},{"time":123.49,"text":"药药药 心有一杆秤"},{"time":125.61,"text":"去称量 这朗朗乾坤"},{"time":127.83,"text":"妙灵丸 抟出日月轮"},{"time":129.89,"text":"仙人散 洒作漫天辰"},{"time":132.06,"text":"化春水 行气成东风"},{"time":134.28,"text":"滋养我 民族精气神 万古长存"},{"time":140.54,"text":"春生夏长"},{"time":142.74,"text":"秋收冬藏"},{"time":144.43,"text":"尽在这青囊"},{"time":145.78,"text":"“茯苓切片三分白"},{"time":149.98,"text":"朱砂碾粉一片红"},{"time":154.25,"text":"五爪佛手颠倒挂"},{"time":158.57,"text":"小小葫芦巧玲珑”"},{"time":158.57,"text":"【改编越剧《牡丹对药》选段】"},{"time":164.19,"text":"药药药 活国先活人（翻遍了 内经本草）"},{"time":166.32,"text":"治世道 隐疾的病根（熬什么 灵丹妙药）"},{"time":168.5,"text":"药药药 心有一杆秤（三江潮 天地炉灶）"},{"time":170.59,"text":"去称量 这朗朗乾坤（五千年 天字第一号）"},{"time":172.78,"text":"妙灵丸 抟出日月轮（百子柜 龙宫秘宝）"},{"time":174.93,"text":"仙人散 洒作漫天辰（找什么 灵芝仙草）"},{"time":177.01,"text":"化春水 行气成东风（配一方 济世良药）"},{"time":179.22,"text":"滋养我 民族精气神 万古长存（五千年 传承到今朝）"}]},{"title":"蓝脸","lyrics":[{"time":0.0,"text":"作词 : 邪叫"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":3.0,"text":"编曲/混音：西门振"},{"time":6.0,"text":"吉他：Ray雷、海鲜面"},{"time":8.0,"text":"制作：狮三百乐队"},{"time":19.16,"text":"四击头起霸红绸下亮相 打的什么光"},{"time":27.5,"text":"我一声号令震余音回荡 荡不回军帐"},{"time":35.94,"text":"自量纵马江山不过绿林苍莽"},{"time":40.02,"text":"半壶是非浇我透心凉"},{"time":44.23,"text":"十载烟尘演一折就草草收场 多仓皇"},{"time":52.5,"text":"草王盔下怒睁圆目一双 叫好声满堂"},{"time":61.02,"text":"幡然醒才见聚义厅空旷 身不在山岗"},{"time":69.4,"text":"有人在硝烟中看到诗与远方"},{"time":73.34,"text":"而我极目四下皆荒凉"},{"time":77.44,"text":"龙潭虎穴都擅闯但深情不往"},{"time":81.41,"text":"又堪与谁来叙衷肠"},{"time":85.11,"text":"驾驹飞关外 一斗敬结拜"},{"time":89.24,"text":"终会落得英名落败 负我大略雄才"},{"time":93.19,"text":"壮志贯胸怀 二斗上天台"},{"time":97.44,"text":"纵豪情人生哪得逍遥自在 不够痛快"},{"time":101.68,"text":"烈酒不复筛 三斗赴蓬莱"},{"time":106.19,"text":"哪知我曾堆金玉压寨 尸骨却无处葬埋"},{"time":115.23,"text":"再饮一杯来"},{"time":135.87,"text":"草王盔下怒睁圆目一双 叫好声满堂"},{"time":144.62,"text":"幡然醒才见聚义厅空旷 身不在山岗"},{"time":152.54,"text":"有人在硝烟中看到诗与远方"},{"time":156.78,"text":"而我极目四下皆荒凉"},{"time":160.88,"text":"龙潭虎穴都擅闯但深情不往"},{"time":164.67,"text":"又堪与谁来叙衷肠"},{"time":168.36,"text":"兰花瓦三块 一嗓泯凄哀"},{"time":172.47,"text":"虽说只得几尺戏台 我下也下不来"},{"time":176.48,"text":"蟒袍等身裁 二嗓销愁怀"},{"time":180.84,"text":"不如就热泪抹花脸上色彩 做个精怪"},{"time":184.83,"text":"高靴登天外 三嗓重云开"},{"time":189.33,"text":"不是戏文没写清对白 是我看得不明白"},{"time":198.33,"text":"再吼一腔来"},{"time":218.26,"text":"驾驹飞关外 一斗泯凄哀"},{"time":222.25,"text":"断我值得几段念白 断不清人情债"},{"time":226.15,"text":"壮志贯胸怀 二斗销愁怀"},{"time":230.59,"text":"我害怕拖声提腔凭吊旧爱 显得古怪"},{"time":234.65,"text":"烈酒不复筛 三斗重云开"},{"time":239.76,"text":"糊涂前程我横刀自裁 座下都热切期待"},{"time":248.76,"text":"再饮一杯来"}]},{"title":"雁去台","lyrics":[{"time":0.0,"text":"作词 : 邪叫教主"},{"time":1.0,"text":"作曲 : 海鲜面"},{"time":6.55,"text":"调：纳兰寻风"},{"time":8.4,"text":"混：嗷嗷嗷是撒比"},{"time":13.81,"text":"古筝：漠小小"},{"time":17.53,"text":"二胡：柠檬CC露"},{"time":21.04,"text":"笛子：O天气晴朗O"},{"time":26.59,"text":"唱：洛天依"},{"time":31.08,"text":"九重山九十里路去远"},{"time":34.5,"text":"鸿雁排上九重天"},{"time":38.0,"text":"青川迢迢波浪不送归人"},{"time":41.54,"text":"却推我轻舟入风烟"},{"time":45.15,"text":"邀白月我出潇湘泛游"},{"time":48.51,"text":"白月与我两闲闲"},{"time":52.28,"text":"借篱落看西风 黄花又 一年"},{"time":58.9,"text":"幸得来音 回书老友"},{"time":62.5,"text":"春去处落叶卷凉秋"},{"time":66.0,"text":"白鸟渡头 独览江洲"},{"time":69.4,"text":"只憾不能 与君共泛一舟"},{"time":72.48,"text":"道一句 向老友 雁去台"},{"time":75.9,"text":"望向天地间一阵霜惟明月依旧"},{"time":79.5,"text":"若我蓬发白 风雨添消瘦"},{"time":83.05,"text":"愿君莫怅怀 相劝一樽酒"},{"time":86.15,"text":"长啸歌 短昏昼 忆旧游"},{"time":89.5,"text":"与君少年时共携壶逐马上翠丘"},{"time":93.53,"text":"龙山落帽客 常有佳话留"},{"time":97.0,"text":"而今各一涯 也谈笑旧时风流"},{"time":114.54,"text":"九重塔九万里曙云流"},{"time":118.0,"text":"茱萸再贺九重九"},{"time":121.42,"text":"长笛能抒多少游子乡思"},{"time":124.89,"text":"又多少归篷停津口"},{"time":128.66,"text":"邀秋华我入闲庭信步"},{"time":132.04,"text":"我与秋华互称友"},{"time":135.5,"text":"饮罢复又持杯 我酩酊 倚楼"},{"time":142.44,"text":"展信安康 回问老友"},{"time":145.63,"text":"春去后可将寒衣授"},{"time":149.5,"text":"北山薄暮 一派清秋"},{"time":152.87,"text":"只憾不能 与君同登高楼"},{"time":155.72,"text":"道一句 不劳烦 答君问"},{"time":159.36,"text":"故人今日又如何纵经十年离乱"},{"time":163.06,"text":"残菊长抱枝 清骨犹傲然"},{"time":166.5,"text":"一从陶令后 高节仍未换"},{"time":169.92,"text":"长啸歌 以忘忧 雁去台"},{"time":173.0,"text":"凭栏对碧空不必叹北风摧人寿"},{"time":177.03,"text":"古今行过客 几处管弦留"},{"time":180.51,"text":"但插山菊归 且一效旧时风流"},{"time":205.1,"text":"幸得来音 回书老友"},{"time":208.6,"text":"春去处落叶卷凉秋"},{"time":212.0,"text":"莫须摇头 莫须搔首"},{"time":215.39,"text":"何多苦叹 叹光阴不堪留"},{"time":218.4,"text":"道一句 向老友 雁去台"},{"time":222.01,"text":"望向天地间一阵霜惟明月依旧"},{"time":225.83,"text":"若我蓬发白 风雨添消瘦"},{"time":229.0,"text":"愿君莫怅怀 相劝一樽酒"},{"time":232.43,"text":"长啸歌 以忘忧 雁去台"},{"time":235.5,"text":"凭栏对碧空不必叹北风摧人寿"},{"time":239.53,"text":"古今行过客 几处管弦留"},{"time":243.01,"text":"但插山菊归 且一效旧时风流"}]}]}