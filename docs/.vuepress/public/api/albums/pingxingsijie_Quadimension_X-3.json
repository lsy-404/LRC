        },
        {
          "time": 143.29,
          "text": "(一 生 一 刹)谁入写意图画"
        },
        {
          "time": 146.21,
          "text": "(无 蕴 无 华)峭壁间走马 看落雪飞花"
        },
        {
          "time": 149.21,
          "text": "(不 悯 不 怛)浮世千变万化"
        },
        {
          "time": 152.09,
          "text": "(不 威 不 霸)掀起多少风沙"
        },
        {
          "time": 155.01,
          "text": "(亦 道 亦 侠)谁潇洒 仗剑不论海角天涯"
        },
        {
          "time": 161.49,
          "text": "剑意出鞘 我 一念间"
        },
        {
          "time": 163.32,
          "text": "斩断宿怨三千"
        },
        {
          "time": 164.88,
          "text": "刃如光 血如雨"
        },
        {
          "time": 166.36,
          "text": "疾如风 迅如电"
        },
        {
          "time": 167.81,
          "text": "百转 轮回间"
        },
        {
          "time": 169.29,
          "text": "准我一世红颜"
        },
        {
          "time": 170.74,
          "text": "漫自许 离群雁"
        },
        {
          "time": 172.2,
          "text": "不消谁 惦念"
        },
        {
          "time": 173.68,
          "text": "江湖乱 莫等闲"
        },
        {
          "time": 175.15,
          "text": "侠义且看刀尖"
        },
        {
          "time": 176.6,
          "text": "在我心 在我手"
        },
        {
          "time": 178.09,
          "text": "在我身 在我肩"
        },
        {
          "time": 179.6,
          "text": "尘世 皆踏遍"
        },
        {
          "time": 180.93,
          "text": "何求功名尽显"
        },
        {
          "time": 182.44,
          "text": "凡事了 拂衣去"
        },
        {
          "time": 183.93,
          "text": "生做侠客不畏天"
        }
      ]
