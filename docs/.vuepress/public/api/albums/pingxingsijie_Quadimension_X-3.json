        },
        {
          "time": 145.83,
          "text": "究竟是否还仍是我？"
        },
        {
          "time": 152.68,
          "text": "Lema TishNau【摇摇摆摆地跑呀】"
        },
        {
          "time": 156.02,
          "text": "Hyee Apheu【孤独的小花想搭话】"
        },
        {
          "time": 159.7,
          "text": "Vee Pha Rikwa【请不要回答】"
        },
        {
          "time": 162.53,
          "text": "YeSha Lihna【快送她回家】"
        },
        {
          "time": 167.27,
          "text": "Lema TishNau【摇摇摆摆地跑呀】"
        },
        {
          "time": 171.08,
          "text": "Hyee apheu【孤独的小花想搭话】"
