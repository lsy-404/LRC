    {
      "title": "01 一日都市",
      "file": "01 一日都市.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "01 一日都市"
        },
        {
          "time": 5.52,
          "text": "作曲&编曲：小野道"
        },
        {
          "time": 11.04,
          "text": "作词：和田野"
        },
        {
          "time": 16.56,
          "text": "曲绘：TOMATO"
        },
        {
          "time": 22.08,
          "text": "专辑：蝴蝶旅客"
        },
        {
          "time": 27.6,
          "text": "ISRC CN-A23-17-01373"
        },
        {
          "time": 38.65,
          "text": "踏上未知列车"
        },
        {
          "time": 41.05,
          "text": "一直飞到云层最高空"
        },
        {
          "time": 47.97,
          "text": "紊乱的波形中"
        },
        {
          "time": 50.32,
          "text": "猜测前方可能的轮廓"
        },
        {
          "time": 55.76,
          "text": "躲藏在月光背后"
        },
        {
          "time": 60.48,
          "text": "电讯号变得神秘又莫测"
        },
        {
          "time": 65.12,
          "text": "切断通讯穿梭在巨大身影中"
        },
        {
          "time": 71.5,
          "text": "就此邂逅"
        },
        {
          "time": 74.44,
          "text": "你好啊 一日都市"
        },
        {
          "time": 76.55,
          "text": "终于见面了 尽管如此"
        },
        {
          "time": 79.57,
          "text": "天明之后 你说你就要消失"
        },
        {
          "time": 83.33,
          "text": "你好吗 一日都市"
        },
        {
          "time": 85.69,
          "text": "无人知晓你真实的位置"
        },
        {
          "time": 88.94,
          "text": "既然如此 告诉我你的名字"
        },
        {
          "time": 92.59,
          "text": "到那时......"
        },
        {
          "time": 112.02,
          "text": "在城市最高点"
        },
        {
          "time": 114.28,
          "text": "俯瞰没有星辰的夜晚"
        },
        {
          "time": 121.18,
          "text": "遥远的地平线"
        },
        {
          "time": 123.37,
          "text": "指引一个方向的冒险"
        },
        {
          "time": 128.78,
          "text": "如果这一次不能尽兴"
        },
        {
          "time": 134.12,
          "text": "就突然要不告而别"
        },
        {
          "time": 138.21,
          "text": "没关系相信我们总会有一天"
        },
        {
          "time": 144.56,
          "text": "再次遇见"
        },
        {
          "time": 147.36,
          "text": "你好吗 一日都市"
        },
        {
          "time": 149.65,
          "text": "如果提起未来这件事呐"
        },
        {
          "time": 153.09,
          "text": "你是否也会有寂寞的样子"
        },
        {
          "time": 156.87,
          "text": "你好啊 一日都市"
        },
        {
          "time": 159.19,
          "text": "所有真实都终将消逝"
        },
        {
          "time": 162.16,
          "text": "可我一直 在追寻它的影子"
        },
        {
          "time": 165.67,
          "text": "到那时......"
        },
        {
          "time": 184.71,
          "text": "到此为止"
        },
        {
          "time": 186.29,
          "text": "如果现在挽留已太迟"
        },
        {
          "time": 189.22,
          "text": "那再一次感谢与你的相识"
        },
        {
          "time": 193.06,
          "text": "再见吧 一日都市"
        },
        {
          "time": 195.31,
          "text": "重逢总是在下一次对吧"
        },
        {
          "time": 198.64,
          "text": "那么你呐"
        },
        {
          "time": 199.82,
          "text": "想抵达的地方是......"
        }
      ]
    },
    {
      "title": "02 超远距连接",
      "file": "02 超远距连接.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "02 超远距连接"
        },
        {
          "time": 0.43,
          "text": "作曲&编曲：小野道"
        },
        {
          "time": 0.86,
          "text": "作词：泠鸢yousa"
        },
        {
          "time": 1.3,
          "text": "专辑：蝴蝶旅客"
        },
        {
          "time": 1.73,
          "text": "ISRC CN-A23-17-01344"
        },
        {
          "time": 2.6,
          "text": "向遥远的一颗星许愿"
        },
        {
          "time": 6.15,
          "text": "距离十二亿七千光年"
        },
        {
          "time": 10.09,
          "text": "在未谋面的土地凝聚的视线"
        },
        {
          "time": 15.13,
          "text": "我却看不见"
        },
        {
          "time": 17.63,
          "text": "飘荡游曳孤单的世界"
        },
        {
          "time": 21.31,
          "text": "测绘星空拟定了路线"
        },
        {
          "time": 25.19,
          "text": "跟随误差缩减的方向指引"
        },
        {
          "time": 30.16,
          "text": "抵达终点"
        },
        {
          "time": 32.43,
          "text": "一转眼 波段锁定区间"
        },
        {
          "time": 35.38,
          "text": "加载解析界面 数字变换跳跃"
        },
        {
          "time": 39.6,
          "text": "顷刻间 温度升过沸点"
        },
        {
          "time": 42.79,
          "text": "电波律动交叠 穿越拦截后相连"
        },
        {
          "time": 47.17,
          "text": "勇气淬炼 信念汇聚一点"
        },
        {
          "time": 50.35,
          "text": "目光悬停指尖 敲下绝密按键"
        },
        {
          "time": 54.9,
          "text": "一瞬间阻碍通讯的心扉"
        },
        {
          "time": 58.35,
          "text": "现在开始瓦解"
        },
        {
          "time": 62.33,
          "text": "fly above the sky"
        },
        {
          "time": 69.03,
          "text": "and the lights"
        },
        {
          "time": 72.55,
          "text": "in your eyes"
        },
        {
          "time": 75.46,
          "text": "will reach mine"
        },
        {
          "time": 77.4,
          "text": "穿越星云瑰丽的色彩"
        },
        {
          "time": 81.4,
          "text": "忐忑与期许一同运载"
        },
        {
          "time": 84.89,
          "text": "数着表盘回转到原点的时间"
        },
        {
          "time": 89.58,
          "text": "已无法计算"
        },
        {
          "time": 92.2,
          "text": "在脑海中具象的画面"
        },
        {
          "time": 96.08,
          "text": "是心与心的无线连接"
        },
        {
          "time": 99.82,
          "text": "猜测未知的轮廓"
        },
        {
          "time": 103.11,
          "text": "轰然加速抵达终点"
        },
        {
          "time": 108.34,
          "text": "找寻微弱光线 分辨行星边界"
        },
        {
          "time": 112.2,
          "text": "交汇轨迹擦肩 避开未知风险"
        },
        {
          "time": 116.55,
          "text": "闭上眼 冷却过热器械"
        },
        {
          "time": 119.62,
          "text": "失去既定路线 穿越星群后重连"
        },
        {
          "time": 123.89,
          "text": "辗转难眠 调取记忆时点"
        },
        {
          "time": 126.94,
          "text": "练习发声音阶 用歌声去描写"
        },
        {
          "time": 131.38,
          "text": "去描写 与你相聚的情节"
        },
        {
          "time": 135.08,
          "text": "现在开始构建"
        },
        {
          "time": 138.86,
          "text": "try not to cry"
        },
        {
          "time": 145.92,
          "text": "I'll make stars"
        },
        {
          "time": 149.24,
          "text": "by your side"
        },
        {
          "time": 152.13,
          "text": "through the night"
        },
        {
          "time": 154.41,
          "text": "向遥远的一颗星许愿"
        },
        {
          "time": 158.07,
          "text": "距离十二亿七千光年"
        },
        {
          "time": 161.72,
          "text": "在密布尘埃的宇宙逐渐消散"
        },
        {
          "time": 166.74,
          "text": "还能否实现"
        },
        {
          "time": 169.33,
          "text": "阻隔我们相聚的局限"
        },
        {
          "time": 172.97,
          "text": "守护着信赖就能破裂"
        },
        {
          "time": 176.87,
          "text": "只因为你的呼唤"
        },
        {
          "time": 179.93,
          "text": "穿透一切 播散星海"
        },
        {
          "time": 185.28,
          "text": "只需在一转眼 波段锁定区间"
        },
        {
          "time": 188.66,
          "text": "加载解析界面 数字变换跳跃"
        },
        {
          "time": 193.3,
          "text": "顷刻间 温度升过沸点"
        },
        {
          "time": 196.28,
          "text": "电波律动交叠 穿越拦截后相连"
        },
        {
          "time": 200.55,
          "text": "勇气淬炼 信念汇聚一点"
        },
        {
          "time": 203.68,
          "text": "目光悬停指尖 敲下绝密按键"
        },
        {
          "time": 208.1,
          "text": "一瞬间阻碍通讯的心扉"
        },
        {
          "time": 211.74,
          "text": "现在终于瓦解"
        },
        {
          "time": 215.71,
          "text": "find in my mind"
        },
        {
          "time": 222.62,
          "text": "there's a dream"
        },
        {
          "time": 225.91,
          "text": "about to rise"
        },
        {
          "time": 228.89,
          "text": "you and I"
        },
        {
          "time": 230.53,
          "text": "通向未知分界 逃离坍缩湮灭"
        },
        {
          "time": 234.01,
          "text": "度过无数停滞般不变的黑夜"
        },
        {
          "time": 238.51,
          "text": "在耳边 声音清晰未减"
        },
        {
          "time": 241.6,
          "text": "汇聚心中喜悦 在宇宙扩散分裂"
        },
        {
          "time": 245.99,
          "text": "将思念 化作隐形弧线"
        },
        {
          "time": 249.06,
          "text": "译作我们脑内最熟悉的语言"
        },
        {
          "time": 253.37,
          "text": "在眼前 你所守望的星空"
        },
        {
          "time": 257.09,
          "text": "一点一点浮现"
        },
        {
          "time": 259.65,
          "text": "找寻微弱光线 分辨行星边界"
        },
        {
          "time": 263.83,
          "text": "交汇轨迹擦肩 避开未知风险"
        },
        {
          "time": 268.51,
          "text": "闭上眼 冷却过热器械"
        },
        {
          "time": 271.54,
          "text": "失去既定路线 穿越星群后重连"
        },
        {
          "time": 275.81,
          "text": "辗转难眠 调取记忆时点"
        },
        {
          "time": 279.04,
          "text": "练习发声音阶 用歌声去描写"
        },
        {
          "time": 283.44,
          "text": "去描写 与你相聚的情节"
        },
        {
          "time": 286.96,
          "text": "现在开始构建"
        }
