    {
      "title": "06 妈妈说",
      "file": "06 妈妈说.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "06 妈妈说"
        },
        {
          "time": 4.56,
          "text": "作曲&编曲：小野道"
        },
        {
          "time": 9.12,
          "text": "作词：冥凰"
        },
        {
