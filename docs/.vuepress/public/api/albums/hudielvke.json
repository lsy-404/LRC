        },
        {
          "time": 42.42,
          "text": "ISRC CN-A23-17-01342"
        },
        {
          "time": 63.63,
          "text": "起床的感想"
        },
        {
          "time": 65.56,
          "text": "是下午六点过半"
        },
        {
          "time": 71.28,
          "text": "技能都加满"
        },
        {
          "time": 73.11,
          "text": "没有人前来对战"
        },
        {
          "time": 78.34,
          "text": "已经轻松拿下全场最佳过关"
        },
        {
          "time": 82.0,
          "text": "无关人员会跳出来指点江山"
        },
        {
          "time": 85.73,
          "text": "其他看法什么的我并不想谈"
        },
        {
          "time": 89.23,
          "text": "所以晚饭等一下"
        },
        {
          "time": 91.42,
          "text": "该吃些什么 拜托"
        },
        {
          "time": 96.46,
          "text": "不要 想太多"
        },
        {
          "time": 112.1,
          "text": "哦反正加速疾走"
        },
        {
          "time": 113.95,
          "text": "也不能逃脱大气层"
        },
        {
          "time": 117.51,
          "text": "像自我鞭策的借口"
        },
        {
          "time": 119.79,
          "text": "纸上谈兵理论"
        },
        {
          "time": 121.47,
          "text": "脑内矛盾相互拉扯"
        },
        {
          "time": 125.13,
          "text": "生活本来就有千万种"
        },
        {
          "time": 127.27,
          "text": "不想轻信教唆"
        },
        {
          "time": 129.0,
          "text": "忙着每天怒争上游"
        },
        {
          "time": 132.65,
          "text": "道路不同不相为谋"
        },
        {
          "time": 134.74,
          "text": "如果说想要自由必须遵守游戏规则"
        },
        {
          "time": 140.18,
          "text": "那制定者也只能是 我"
        },
        {
          "time": 157.49,
          "text": "街心的广场"
        },
        {
          "time": 159.29,
          "text": "目送情侣们来往"
        },
        {
          "time": 165.02,
          "text": "笑声很夸张"
        },
        {
          "time": 166.74,
          "text": "像爆炸的泡泡糖"
        },
        {
          "time": 172.04,
          "text": "电波锁定在感觉良好的频道"
        },
        {
          "time": 175.74,
          "text": "打开一罐可乐准备重启大脑"
        },
        {
          "time": 179.51,
          "text": "管他有没有机会做人生贏家"
        },
        {
          "time": 182.92,
          "text": "幸福也好寂寞也好"
        },
        {
          "time": 185.31,
          "text": "只要开心就好"
        },
        {
          "time": 190.66,
          "text": "答案 不重要"
        },
        {
          "time": 205.83,
          "text": "穿过无聊人群"
        },
        {
          "time": 207.35,
          "text": "脑内声音反复在提醒"
        },
        {
          "time": 211.16,
          "text": "得不到反而更靠近"
        },
        {
          "time": 213.4,
          "text": "纸上理论谈兵"
        },
        {
          "time": 215.22,
          "text": "却收不到心电感应"
        },
        {
          "time": 218.87,
          "text": "灵魂带我去就去哪里"
        },
        {
          "time": 221.09,
          "text": "想要有所收获"
        },
        {
          "time": 222.72,
          "text": "你却一味暗示不说"
        },
        {
          "time": 226.47,
          "text": "可别怪我无动于衷"
        },
        {
          "time": 228.5,
          "text": "如果说想要快乐有什么人必须听从"
        },
        {
          "time": 233.96,
          "text": "那这个人也只能是我"
        }
      ]
    },
