    {
      "title": "09 苍白梦书",
      "file": "09 苍白梦书.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "09 苍白梦书"
        },
        {
          "time": 9.55,
          "text": "作曲&编曲：小野道"
        },
        {
          "time": 19.11,
          "text": "作词：赭梅奶"
        },
        {
          "time": 28.67,
          "text": "专辑：蝴蝶旅客"
        },
        {
          "time": 38.22,
          "text": "ISRC CN-A23-17-01340"
        },
        {
          "time": 57.34,
          "text": "像是 一个梦"
        },
        {
          "time": 64.32,
          "text": "相同时空 陌生的面容"
        },
        {
          "time": 70.3,
          "text": "信号灯 大雨之中"
        },
        {
          "time": 78.14,
          "text": "破碎的躯体 乌云在翻涌"
        },
        {
          "time": 85.03,
          "text": "旋转着 老摆钟"
        },
        {
          "time": 92.16,
          "text": "划过指缝 是夏夜的风"
        },
        {
          "time": 99.12,
          "text": "是怯惆 或凡庸"
        },
        {
          "time": 105.94,
          "text": "我从来不甘沦为观众"
        },
        {
          "time": 111.15,
          "text": "零星树叶 无声的落下"
        },
        {
          "time": 118.02,
          "text": "点缀了 某朵无名的花"
        },
        {
          "time": 124.97,
          "text": "漂泊的船 能驶到大海吗"
        },
        {
          "time": 133.1,
          "text": "怀揣着那句你未讲的话"
        },
        {
          "time": 138.23,
          "text": "名为爱吧"
        },
        {
          "time": 143.0,
          "text": "伸出这双臂"
        },
        {
          "time": 154.24,
          "text": "这心意 你会懂吧"
        },
        {
          "time": 167.55,
          "text": "儿时 薄荷糖"
        },
        {
          "time": 174.03,
          "text": "统统蒸发 在时间汪洋"
        },
        {
          "time": 179.75,
          "text": "把勇气 装进行囊"
        },
        {
          "time": 187.69,
          "text": "祈求一束光 照进你心房"
        },
        {
          "time": 195.31,
          "text": "被拥抱 被原谅"
        },
        {
          "time": 201.64,
          "text": "人生剧场 为自己拍掌"
        },
        {
          "time": 208.83,
          "text": "这岁月 还很长"
        },
        {
          "time": 215.71,
          "text": "让星辰 点亮每个胸膛"
        },
        {
          "time": 221.19,
          "text": "零星树叶 无声的落下"
        },
        {
