{"slug":"shenqianzhizhou","folder":"深潜之宙","name":"深潜之宙","prefix":"","zh_name":"深潜之宙","en_name":"","suffix":"","year":"2019-12-14","produce":["奶牛组"],"vocal":["苍穹"],"lyricist":["沈病娇"],"composer":["Kinoko蘑菇"],"arranger":["Kinoko蘑菇"],"tuning":["Kinoko蘑菇","瑞安Ryan","木变石"],"illustrator":["星火"],"mixer":["Kinoko蘑菇"],"lyric_maker":["高冷帝佚名(Polaris_Light)"],"release":"[Bilibili](https://www.bilibili.com/video/BV1vJ411r7Nz/)","purchase":"通贩不可用","electronic":"[Dizzylab](https://www.dizzylab.net/d/shenqianzhizhou/) ￥60","cover":"/albums/shenqianzhizhou.jpg","tags":["深潜之宙","奶牛组"],"songs":[{"title":"1 飞鸟","lyrics":[{"time":0.0,"text":"《飞鸟》"},{"time":2.0,"text":"曲/粤语念白/调校：Kinoko蘑菇"},{"time":4.0,"text":"词：沈病娇"},{"time":9.4,"text":"只是你无意间"},{"time":12.68,"text":"轻轻叩动这颗心脏"},{"time":19.01,"text":"代价是 每一次的视线交错"},{"time":22.45,"text":"伴随阵痛当又拔下羽毛"},{"time":28.46,"text":"在切断 或持续性的 时间 里面"},{"time":31.85,"text":"我始终 和你进行这一场宛如恋人的游戏"},{"time":37.97,"text":"而那些想象出来的爱多不美 我承认"},{"time":47.6,"text":"巧合到"},{"time":50.72,"text":"宇宙从这一秒钟开始"},{"time":54.61,"text":"就动荡"},{"time":57.11,"text":"云层 将我拥抱"},{"time":61.35,"text":"身却不能贴近太阳"},{"time":85.96,"text":"我窥见"},{"time":89.23,"text":"情绪死去前的汹涌"},{"time":95.31,"text":"总觉得不应该 只是这样"},{"time":100.23,"text":"那么是谁藏着 没说"},{"time":109.64,"text":"就眼睁睁地无可奈何地观望着"},{"time":112.95,"text":"直到疯了"},{"time":119.36,"text":"就满身疲惫带着诸多的不相信"},{"time":123.36,"text":"我们数次擦肩而过也一定能够在某个遥远星系完成救赎"},{"time":131.21,"text":"所以趁现在 悲切地唱着这首歌"},{"time":137.6,"text":"直到结束"},{"time":148.75,"text":"巧合到"},{"time":152.03,"text":"宇宙从这一秒钟开始"},{"time":156.53,"text":"就动荡"},{"time":158.53,"text":"云层 将我拥抱"},{"time":162.56,"text":"身却不能贴近太阳"},{"time":167.17,"text":"盲目是个伪命题"},{"time":178.55,"text":"丢失爱的轨迹"}]},{"title":"2 不公开的第三种结果","lyrics":[{"time":0.0,"text":"《不公开的第三种结果》"},{"time":2.0,"text":"曲/调校：Kinoko蘑菇"},{"time":4.0,"text":"词：沈病娇"},{"time":25.14,"text":"也没有一首歌 适合拥抱"},{"time":33.16,"text":"我喜欢的 无非是拼凑不起的幻想"},{"time":41.27,"text":"灯与影 自以为互相成全"},{"time":45.57,"text":"于是打消所有怀疑"},{"time":49.47,"text":"仿佛被爱 是值得快乐的事情"},{"time":58.65,"text":"情绪爬出骨骼"},{"time":59.98,"text":"心是冷的"},{"time":60.76,"text":"交付我仅存的感官"},{"time":62.91,"text":"自残一般去欣赏"},{"time":64.29,"text":"有什么温热着"},{"time":67.02,"text":"梦就不要醒"},{"time":69.73,"text":"沉寂的 还激烈的 不言而喻的"},{"time":74.63,"text":"留给自己"},{"time":76.88,"text":"让那些 无法共鸣的 都断在空气里"},{"time":83.27,"text":"放弃掉一部分意义"},{"time":86.34,"text":"败坏的 还滋生的 极度自恋的"},{"time":91.34,"text":"某个自己"},{"time":93.49,"text":"在完全透明的镜中 我看见自己"},{"time":104.59,"text":"夜熄灭后的夜 带来快慰"},{"time":112.77,"text":"那就趁乱 去伪造一场小小的误会"},{"time":120.71,"text":"或许是 潜台词悉数瓦解"},{"time":125.0,"text":"才表现得如此果决"},{"time":128.83,"text":"听得清楚 蜷缩在角落的呜咽"},{"time":138.39,"text":"在轻颤的眉睫"},{"time":139.3,"text":"痛是真的"},{"time":140.41,"text":"就算是徒劳的宣泄"},{"time":142.46,"text":"也让我从中获得"},{"time":143.94,"text":"未见光的喜悦"},{"time":163.16,"text":"孤独是被放任肆意的错误隐喻"},{"time":171.47,"text":"横亘在沉默中间的矜持"},{"time":175.86,"text":"长出缠绵悱恻的刺"},{"time":179.78,"text":"所以你看 连呼吸 都显得 动魄惊心"},{"time":199.08,"text":"梦就不要醒"},{"time":201.64,"text":"沉寂的 还激烈的 不言而喻的"},{"time":206.38,"text":"留给自己"},{"time":208.58,"text":"让那些 无法共鸣的 都断在空气里"},{"time":215.11,"text":"放弃掉一部分意义"},{"time":218.07,"text":"败坏的 还滋生的 极度自恋的"},{"time":223.01,"text":"某个自己"},{"time":225.1,"text":"在完全透明的镜中 我是我自己"}]},{"title":"3 现代浪漫传奇","lyrics":[{"time":0.0,"text":"《现代浪漫传奇》"},{"time":2.0,"text":"曲：Kinoko蘑菇"},{"time":4.0,"text":"词：沈病娇"},{"time":6.0,"text":"吉他：磁带君"},{"time":8.0,"text":"贝斯：詹俊杰"},{"time":10.0,"text":"调校：瑞安Ryan"},{"time":30.04,"text":"愚钝 恍神 色令智昏"},{"time":33.97,"text":"万般猜测中 误解 可能更迷人"},{"time":40.2,"text":"予取 予求 故意放任"},{"time":43.77,"text":"只贪图你一个吻"},{"time":49.07,"text":"残暴 温柔 诸多隐忍"},{"time":51.37,"text":"踹开那心门  怎样 去引火焚身"},{"time":56.37,"text":"不闻 不问 试图蒙混"},{"time":62.11,"text":"偏爱这份造作天真"},{"time":68.91,"text":"可总是那样美丽"},{"time":73.92,"text":"在阳光下 在暗地里 滋生的情意"},{"time":79.31,"text":"太过甜腻但意犹未尽"},{"time":83.93,"text":"如此忘乎所以"},{"time":86.68,"text":"可就是那样美丽"},{"time":88.92,"text":"彼此相爱 彼此欺骗 也不想分离"},{"time":96.32,"text":"虚构一个童话来沉溺"},{"time":98.67,"text":"暂时忘记追究生命的意义"},{"time":128.86,"text":"晦涩 迷幻 抱着取暖"},{"time":132.37,"text":"世上只剩下 你我 才有了灵感"},{"time":138.65,"text":"爱我 憎我 喜忧参半"},{"time":142.39,"text":"不回避所有的缺憾"},{"time":187.43,"text":"可总是那样美丽"},{"time":192.19,"text":"在阳光下 在暗地里 滋生的情意"},{"time":197.5,"text":"太过甜腻但意犹未尽"},{"time":202.39,"text":"如此忘乎所以"},{"time":204.65,"text":"可就是那样美丽"},{"time":207.31,"text":"彼此相爱 彼此欺骗 也不想分离"},{"time":215.23,"text":"虚构一个童话来沉溺"},{"time":217.54,"text":"暂时忘记追究生命的意义"},{"time":227.71,"text":"可还有什么意义"},{"time":232.21,"text":"若你我是真的投入沉迷"},{"time":237.35,"text":"我甚至愿意顺从"},{"time":242.16,"text":"这一开始就由你定下规则的游戏"},{"time":257.15,"text":"我的渴慕分裂出藤蔓的枝节"},{"time":261.83,"text":"并不优雅地缠绕住全身"},{"time":266.74,"text":"如果喊你的名字而你恰好在等"},{"time":271.83,"text":"冲动嫉妒占有都流窜进血液藏得更深"},{"time":278.9,"text":"更深 更深"}]},{"title":"4 忍痛","lyrics":[{"time":0.0,"text":"《忍痛》"},{"time":2.0,"text":"曲/调校：Kinoko蘑菇"},{"time":4.0,"text":"词：沈病娇"},{"time":6.0,"text":"吉他：磁带君"},{"time":8.0,"text":"贝斯：詹俊杰"},{"time":27.15,"text":"不痛不痒的永远"},{"time":32.0,"text":"组成爱的字眼"},{"time":38.69,"text":"不想辩证 尽管都是谎言"},{"time":50.98,"text":"伤痕 背叛 孤注一掷的恩典"},{"time":56.69,"text":"怎么不敢抬头看我的脸"},{"time":62.6,"text":"你在黑夜里放火 点燃残喘的我"},{"time":75.14,"text":"所有情绪还有恻隐揉皱"},{"time":80.77,"text":"不动声色 却将痛楚全捕获"},{"time":85.55,"text":"还能如何假装无动于衷"},{"time":97.15,"text":"这些 那些 你要的 不要的"},{"time":102.86,"text":"杜撰的故事 只能取悦观众"},{"time":109.69,"text":"这些 那些 属于我 珍贵的"},{"time":115.84,"text":"被亲手剖开 咽喉内的呼救"},{"time":126.98,"text":"抽丝剥茧 血肉淋漓"},{"time":133.24,"text":"难道还定名温柔"},{"time":139.69,"text":"竟是这样 细碎快乐的痛"},{"time":176.74,"text":"倦怠麻木到生厌"},{"time":182.07,"text":"有谁对我规劝"},{"time":188.69,"text":"怜惜施舍 溢出伤口鲜艳"},{"time":195.09,"text":"刺穿心脏的渴求 等待成全"},{"time":236.85,"text":"是这样吗 就该如此吧"},{"time":242.76,"text":"有无数理由逃走"},{"time":248.58,"text":"偏偏看着果实熟烂熟透"},{"time":253.24,"text":"就让起始 结尾 衔接异样 如鲠在喉"},{"time":265.77,"text":"昨日种种 亦如今后"},{"time":277.46,"text":"这些 那些 你要的 不要的"},{"time":282.9,"text":"杜撰的故事 只能取悦观众"},{"time":289.52,"text":"这些 那些 属于我 珍贵的"},{"time":295.85,"text":"被亲手剖开 咽喉内的呼救"},{"time":307.09,"text":"抽丝剥茧 血肉淋漓"},{"time":313.14,"text":"难道还定名温柔"},{"time":319.08,"text":"竟是这样 细碎快乐的痛"}]},{"title":"5 珊瑚姬","lyrics":[{"time":0.0,"text":"《珊瑚姬》"},{"time":2.0,"text":"曲：Kinoko蘑菇"},{"time":4.0,"text":"词：沈病娇"},{"time":6.0,"text":"长笛：KEN"},{"time":8.0,"text":"调校：木变石"},{"time":10.0,"text":"「在他准备走的前一天，"},{"time":12.0,"text":"这片海下起了雨。"},{"time":14.0,"text":"没完没了的雨下个不停，"},{"time":16.0,"text":"他们在深海之中紧紧拥抱。"},{"time":18.0,"text":"时间过得这样快，"},{"time":20.0,"text":"她还以为距离那次救起他不过短短一个昼夜。"},{"time":22.0,"text":"男人总是有很多的理由，或者是借口——"},{"time":24.0,"text":"几乎是出于本能的，她不想拆穿他。"},{"time":26.0,"text":"“我想带你去看阳光下的海，"},{"time":28.0,"text":"落在海面上细碎的光比珍珠钻石还漂亮。”"},{"time":30.0,"text":"而第二天是真的很晴朗，"},{"time":32.0,"text":"他说得一点没错。"},{"time":34.0,"text":"错的是她什么都相信。」"},{"time":35.44,"text":"窥视 邂逅 迷恋"},{"time":41.46,"text":"眼神 唇角 弧线"},{"time":47.43,"text":"失措的 心动 一瞬间"},{"time":53.4,"text":"难言喻 真相 谎言"},{"time":59.38,"text":"沉入无边海域 守着珍珠贝壳的誓言"},{"time":65.2,"text":"随之起舞旋转 痛也踮起脚尖"},{"time":71.7,"text":"就这一次让我 扮演只属于你的女眷"},{"time":77.49,"text":"潮汐吞噬海岸 许诺无人兑现"},{"time":115.54,"text":"我的执念 深陷 相遇那天"},{"time":127.59,"text":"你曾真的 对我 疼惜垂怜"},{"time":139.58,"text":"禁锢手指的对戒 对我说爱意多热烈"},{"time":153.07,"text":"她的心一定很急切"},{"time":196.0,"text":"阳光下的倒影"},{"time":202.01,"text":"闪耀斑驳泪滴"},{"time":207.8,"text":"还能够继续 迷恋你"},{"time":213.92,"text":"还听见一声 叹息"},{"time":225.15,"text":"消失前 就已..."},{"time":227.15,"text":"「眼泪不是武器，爱才是。她都知道。"},{"time":229.15,"text":"当风再次掠过海面，什么也不会留下。"},{"time":231.15,"text":"就仿佛，一切从未发生。」"}]}]}