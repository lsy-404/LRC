t":"一声相思唤不得"},{"time":169.04,"text":"怕两生残情一身罪业"},{"time":173.88,"text":"焚尽君身三尺雪"},{"time":176.95,"text":"雨打繁华谢"},{"time":178.55,"text":"伞底偷安可否一借？"},{"time":182.4,"text":"三千长阶淌入永世的风波"},{"time":185.71,"text":"命如空盏尝来不苦又不涩"},{"time":189.18,"text":"风中高阁朱楼残火"},{"time":192.03,"text":"犹照少年颜色"},{"time":194.72,"text":"一片丹心燃碎了金池山河"},{"time":198.31,"text":"白马飞花可曾被春秋入墨？"},{"time":201.69,"text":"夜深梦拙无家无我"},{"time":204.57,"text":"谁挑灯怜赠一缕温柔恻"},{"time":207.72,"text":"无梦也无家"},{"time":208.9,"text":"快马何曾到天涯"},{"time":211.4,"text":"弱冠好年华"},{"time":212.26,"text":"冷了琴弦负了落花"},{"time":214.15,"text":"这一杯酒洒"},{"time":215.09,"text":"意冷心乏"},{"time":217.39,"text":"消造化不为人间只为他"},{"time":248.16,"text":"若深恩藏情仇"},{"time":251.04,"text":"鬼神陌路史笔痴讹"},{"time":254.52,"text":"若至善存凶恶"},{"time":257.45,"text":"干丈心机一枝梅香可度得？"},{"time":261.88,"text":"不是冤家不作巫山客"},{"time":265.07,"text":"狂夜春风如昨"},{"time":268.21,"text":"辗转娑婆此心可负不可错"},{"time":271.96,"text":"人间好处与君说"},{"time":274.71,"text":"三千长阶淌入永世的风波"},{"time":277.71,"text":"命如空盏尝来不苦又不涩"},{"time":281.03,"text":"风中高阁朱楼残火"},{"time":284.03,"text":"犹照少年颜色"},{"time":286.91,"text":"一片丹心燃碎了金池山河"},{"time":290.28,"text":"白马飞花可曾被春秋入墨？"},{"time":293.61,"text":"夜深梦拙无家无我"},{"time":296.83,"text":"谁挑灯怜赠一缕温柔恻"},{"time":306.79,"text":"By：虎啸ROAR_8(:з」∠)_"}]},{"title":"6 Sofution","lyrics":[{"time":1.9,"text":"I fall in darkness(我沉入黑暗)"},{"time":5.23,"text":"I taste the bitter harshness（我品尝到这苦涩感）"},{"time":8.55,"text":"I expel myself（我放逐自我）"},{"time":10.79,"text":"just let me drown（让我独自）"},{"time":13.95,"text":"in loneliness（沉沦于孤单）"},{"time":20.42,"text":"作曲：喻川"},{"time":24.0,"text":"编曲：喻川"},{"time":28.0,"text":"调校：喻川"},{"time":32.0,"text":"混音：喻川"},{"time":36.0,"text":"作词：喻川"},{"time":40.4,"text":"曲绘: 山荷"},{"time":43.42,"text":"life sometimes gets a bit unfair"},{"time":47.14,"text":"light hides underneath the cloud"},{"time":50.23,"text":"leave me alone and let me burn out"},{"time":53.55,"text":"i'm exhausted"},{"time":57.05,"text":"please bear in mind how much you deserve"},{"time":60.19,"text":"keep on trying to survive"},{"time":63.35,"text":"i will be there to help and save"},{"time":66.5,"text":"just believe in"},{"time":71.3,"text":"now leave and keep on going"},{"time":72.71,"text":"now leave and keep on chasing"},{"time":74.18,"text":"now be what you were asked to be and don't look back"},{"time":77.44,"text":"now leave and give up saving"},{"time":79.03,"text":"now turn and catch the timing"},{"time":80.52,"text":"now do what you were asked to do and don't look back"},{"time":83.72,"text":"is this what i really want"},{"time":87.68,"text":"is this what i've been pursuing"},{"time":90.82,"text":"i didn't know"},{"time":92.68,"text":"but now i do"},{"time":96.52,"text":"try your best to tear me apart"},{"time":100.93,"text":"show off all your strength and power"},{"time":104.2,"text":"if not i will then climb up higher"},{"time":107.27,"text":"higher higher out of  rcach"},{"time":110.66,"text":"understand each other or not"},{"time":113.86,"text":"we must fight until the last star falls from sky"},{"time":116.93,"text":"until the twilight appears again"},{"time":120.32,"text":"until one of us dies"},{"time":150.63,"text":"我坠入命运的不公"},{"time":153.63,"text":"云层遮挡住的光"},{"time":156.59,"text":"熄灭之前最后的明亮"},{"time":159.91,"text":"疲惫彷徨"},{"time":163.24,"text":"人多少值得一点希望"},{"time":166.44,"text":"多少能决定存亡"},{"time":169.64,"text":"生于黑暗却引领光"},{"time":172.97,"text":"坚持信仰"},{"time":177.55,"text":"别回头一直向前"},{"time":178.99,"text":"别转身前路不变"},{"time":180.78,"text":"做你所心所愿不论是谁在背面"},{"time":183.66,"text":"向前看一直向前"},{"time":185.32,"text":"心不变前路不变"},{"time":186.99,"text":"做你所思所想不论是谁在眼前"},{"time":190.19,"text":"我曾经走向反方向"},{"time":194.09,"text":"我以为这是我心所想"},{"time":197.29,"text":"现在已经"},{"time":198.83,"text":"不会再迷茫"},{"time":203.45,"text":"我铸就不碎裂的墙"},{"time":207.34,"text":"我承受所有的力量"},{"time":210.28,"text":"若这不能够引领死亡"},{"time":213.55,"text":"则成为永远盾防"},{"time":216.87,"text":"言语思想已没所谓"},{"time":220.01,"text":"事到如今都已经无路可退"},{"time":223.27,"text":"一直到黑夜黎明都破碎"},{"time":226.54,"text":"会是谁一去不回"},{"time":233.6,"text":"By：虎啸ROAR_8(:з」∠)_"}]}]}