        {
          "time": 177.02,
          "text": "耀眼的大海反射着波光"
        },
        {
          "time": 182.35,
          "text": "落ちてくる夢を受け止めて"
        },
        {
          "time": 182.35,
          "text": "接住从天而降的梦境"
        },
        {
          "time": 187.36,
          "text": "記憶も消え去って"
        },
        {
          "time": 187.36,
          "text": "记忆也随之消散"
        },
        {
          "time": 190.49,
          "text": "金色で"
        },
        {
          "time": 190.49,
          "text": "伴随着金黄"
        },
        {
          "time": 192.74,
          "text": "どこにいても僕の運命（さだめ）をたどる"
        },
        {
          "time": 192.74,
          "text": "无论身在何处都追寻着我的宿命"
        },
        {
          "time": 197.93,
          "text": "一人だけでも"
        },
        {
          "time": 197.93,
          "text": "哪怕只有孤身一人"
        },
        {
          "time": 200.21,
          "text": "前に進もう"
        },
        {
          "time": 200.21,
          "text": "也要向前迈进"
        },
        {
          "time": 205.23,
          "text": "一望無垠（いちぼうむぎん）"
        },
        {
          "time": 205.23,
          "text": "一望无垠"
        },
        {
          "time": 208.38,
          "text": "澄み渡る空から 光を浴びて"
        },
        {
          "time": 208.38,
          "text": "沐浴着澄澈天空洒下的光芒"
        },
        {
          "time": 213.37,
          "text": "雨の後で、心の曇りも"
        },
        {
          "time": 213.37,
          "text": "雨过天晴，心中的阴霾也"
        },
        {
          "time": 218.58,
          "text": "吹き飛ばされた"
        },
        {
          "time": 218.58,
          "text": "被一扫而空"
        },
        {
          "time": 221.84,
          "text": "青色で"
        },
        {
          "time": 221.84,
          "text": "伴随着蔚蓝"
        },
        {
          "time": 223.94,
          "text": "じめじめした海風と倶に"
        },
        {
          "time": 223.94,
          "text": "与潮湿的海风一道"
        },
        {
          "time": 228.98,
          "text": "物語を抱き"
        },
        {
          "time": 228.98,
          "text": "拥抱着故事"
        },
        {
          "time": 231.62,
          "text": "前へ行こう"
        },
        {
          "time": 231.62,
          "text": "向前迈进吧"
        },
