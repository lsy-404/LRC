    {
      "title": "且趁轻弦",
      "file": "且趁轻弦.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "且趁轻弦"
        },
        {
          "time": 3.12,
          "text": "曲：枫音"
        },
        {
          "time": 5.02,
          "text": "词：萧暮雨"
        },
        {
          "time": 6.9,
          "text": "调：莫米兔"
        },
        {
          "time": 8.8,
          "text": "绘：万点水"
        },
        {
          "time": 10.65,
          "text": "摄影：络米"
        },
        {
          "time": 12.55,
          "text": "PV：安二"
        },
        {
          "time": 15.96,
          "text": "人潮熙攘 趁闲暇 捧一杯奶茶"
        },
        {
          "time": 20.54,
          "text": "桥畔水行处 花鸟声悠扬"
        },
        {
          "time": 24.62,
          "text": "谁卧在阶前 晒着太阳"
        },
        {
          "time": 28.38,
          "text": "惊醒后的步伐 略显匆忙"
        },
        {
          "time": 32.32,
          "text": "镜头微缩 定格住好时光"
        },
        {
          "time": 36.03,
          "text": "胶片轻滑 被遗落的过往"
        },
        {
          "time": 39.75,
          "text": "忘了也罢 继续向前方"
        },
        {
          "time": 43.59,
          "text": "反正明天路还很长"
        },
        {
          "time": 48.26,
          "text": "晚来风穿过旧街坊"
        },
        {
          "time": 52.17,
          "text": "待钟声寻回檐外夕阳"
        },
        {
          "time": 56.13,
          "text": "年少时那抹芬香"
        },
        {
          "time": 59.53,
          "text": "漫漫岁月间不散场"
        },
        {
          "time": 74.84,
          "text": "“哼--哼-哼-en-"
        },
        {
          "time": 90.06,
          "text": "哼--哼-哼-en-”"
        },
        {
          "time": 99.72,
          "text": "街景微晃 杯底部折射出盛夏"
        },
        {
          "time": 104.32,
          "text": "汽笛与叫卖声 计较短长"
        },
        {
          "time": 108.39,
          "text": "斜晖乘班车 驶向远方"
        },
        {
          "time": 111.98,
          "text": "身后灯火渐将 城市点亮"
        },
        {
          "time": 116.5,
          "text": "青石瓦 披上了 新衣装"
        },
        {
          "time": 120.5,
          "text": "看风物 寻常处 被谁拍下"
        },
        {
          "time": 124.48,
          "text": "随即和亲友分享"
        },
        {
          "time": 128.1,
          "text": "又会装饰了谁的年华"
        },
        {
          "time": 131.41,
          "text": "漫步长街 光与影相望"
        },
        {
          "time": 134.99,
          "text": "随意哼唱 将思虑抛下"
        },
        {
          "time": 138.84,
          "text": "邂逅或分别 只一瞬难忘"
        },
        {
          "time": 142.7,
          "text": "旋律歇时 不记她的模样"
        },
        {
          "time": 147.32,
          "text": "窗外烟花绽放"
        },
        {
          "time": 150.85,
          "text": "数筷子今夜缺了一双"
        },
        {
          "time": 155.19,
          "text": "谁顺着河灯去流浪"
        },
        {
          "time": 158.79,
          "text": "有风处即故乡"
        },
        {
          "time": 161.25,
          "text": "“月亮粑粑 肚里坐个爹爹"
        },
        {
          "time": 165.01,
          "text": "爹爹出来买菜 肚里坐个奶奶"
        },
        {
          "time": 168.88,
          "text": "奶奶出来绣花 绣只糍粑"
        },
        {
          "time": 172.52,
          "text": "糍粑跌得井里 变只蛤蟆”"
        },
        {
          "time": 177.24,
          "text": "傍着月儿走过石桥"
        },
        {
          "time": 181.11,
          "text": "蓦然忆得孩时歌谣"
        },
        {
          "time": 184.68,
          "text": "归路太远 模糊了记号"
        },
        {
          "time": 188.99,
          "text": "只剩那一抹浅笑"
        },
        {
          "time": 192.82,
          "text": "转过身 街灯恰来照"
        },
        {
          "time": 196.63,
          "text": "像童年 为梦谱上新调"
        },
        {
          "time": 200.66,
          "text": "漫画偷带进学校"
        },
        {
          "time": 204.15,
          "text": "却没被岁月藏好"
        },
        {
          "time": 207.32,
          "text": "零零碎碎 拼凑青春容貌"
        },
        {
          "time": 211.37,
          "text": "走走停停 追赶着分秒"
        },
        {
          "time": 215.14,
          "text": "可是梦啊 越长大越少"
        },
        {
          "time": 218.91,
          "text": "只愿今夜 能将烦恼尽抛"
        },
        {
          "time": 223.45,
          "text": "暖风吹向云霄"
        },
        {
          "time": 227.06,
          "text": "城市早已渐渐睡着"
        },
        {
          "time": 231.26,
          "text": "远方传来些许喧嚣"
        },
        {
          "time": 234.81,
          "text": "谁仍站在高台凝眺"
        }
      ]
    },
    {
      "title": "再走走",
      "file": "再走走.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "再走走"
        },
        {
          "time": 2.8,
          "text": "曲：砖厂浪人"
        },
        {
          "time": 4.96,
          "text": "词：浮青雀"
        },
        {
          "time": 7.33,
          "text": "调：陌生来访"
        },
        {
          "time": 16.76,
          "text": "当风的波涛 依随大树的根系 蜷缩向海岸"
        },
        {
          "time": 25.59,
          "text": "芦苇丛折身处 只余撤落的积雪"
        },
        {
          "time": 35.1,
          "text": "我们从坚实的土地 陷进绵软的草滩"
        },
        {
          "time": 43.9,
          "text": "从沉闷的夜 跌入摇橹船的平缓"
        },
        {
          "time": 52.22,
          "text": "当冬阳隐没 执住掌心的冷峭"
        },
        {
          "time": 58.11,
          "text": "嶙峋石壁上斜翘的雪松 青针也旧谙"
        },
        {
          "time": 70.97,
          "text": "野迹木梯 穿满叶与红须的斑斓"
        },
        {
          "time": 79.46,
          "text": "孩子们跨越溪道 践履过泥泞洞雨"
        },
        {
          "time": 88.61,
          "text": "就能听见竹浪在耳边呼喊——"
        },
        {
          "time": 97.03,
          "text": "啊 故乡的江湖 你的寂寞 已皆数入我耳"
        },
        {
          "time": 105.93,
          "text": "几岁春秋未见 是否记得 儿女的巧笑嫣然"
        },
        {
          "time": 115.32,
          "text": "尚未能乘舟 在你的胸怀 共舀流水的命脉"
        },
        {
          "time": 124.25,
          "text": "啊啊 再走走 就要离散"
        },
        {
          "time": 132.68,
          "text": "啊 稍远的山头 一夜落雪 是不是你双鬓斑白"
        },
        {
          "time": 142.02,
          "text": "几许风雨如晦 不曾忘却 你的关爱"
        },
        {
          "time": 150.91,
          "text": "啊啊啊 再走走 就不知再几载"
        },
        {
          "time": 176.72,
          "text": "当烟雾凝结 挽住螭吻的飞檐"
        },
        {
          "time": 182.62,
          "text": "砚山石街上磨拭的墨点 沾衣又湿眼"
        },
        {
          "time": 195.31,
          "text": "枯莲立池 雕画雨与伞沿的黑白"
        },
        {
          "time": 204.01,
          "text": "女儿们步入窄巷 溅踩出鞋底花月"
        },
        {
          "time": 213.11,
          "text": "就能瞥见母亲慢织出的词阕"
        },
        {
          "time": 221.48,
          "text": "啊 故乡的山水 你的静待 足以使我流连"
        },
        {
          "time": 230.22,
          "text": "几季夏冬未变 可有裁剪 儿女的细语温言"
        },
        {
          "time": 239.73,
          "text": "尚未能拣梅 在你的指尖 共书幼时的依恋"
        },
        {
          "time": 248.78,
          "text": "啊啊 再走走 就要别面"
        },
        {
          "time": 257.02,
          "text": "啊 故乡的江湖 你的寂寞 已皆数入我耳"
        },
        {
          "time": 265.87,
          "text": "几岁春秋未见 是否记得 儿女的巧笑嫣然"
        },
        {
          "time": 275.36,
          "text": "尚未能乘舟 在你的胸怀 共舀流水的命脉"
        },
        {
          "time": 284.3,
          "text": "啊啊 再走走 就要离散"
        },
        {
          "time": 292.66,
          "text": "啊 稍远的山头 一夜落雪 是不是你双鬓斑白"
        },
        {
          "time": 302.0,
          "text": "几许风雨如晦 不曾忘却 你的关爱"
        },
        {
          "time": 310.93,
          "text": "啊啊啊 再走走 就不知何时相见"
        }
      ]
    },
    {
      "title": "冰灯儿心里亮",
      "file": "冰灯儿心里亮.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "冰灯儿心里亮"
        },
        {
          "time": 1.67,
          "text": "曲：野良犬"
        },
        {
          "time": 3.59,
          "text": "词：苏栗无"
        },
        {
          "time": 5.41,
          "text": "调：哈士奇"
        },
        {
          "time": 7.35,
          "text": "绘：小林"
        },
        {
          "time": 9.4,
          "text": "摄影：上官宛凝"
        },
        {
          "time": 11.33,
          "text": "PV：步杨"
        },
        {
          "time": 46.82,
          "text": "叮当"
        },
        {
          "time": 47.91,
          "text": "北风划破长空 还作响"
        },
        {
          "time": 51.23,
          "text": "故乡 梦中不似他乡"
        },
        {
          "time": 56.03,
          "text": "日头映我冬来 颊上花霜"
        },
        {
          "time": 62.12,
          "text": "车窗"
        },
        {
          "time": 63.26,
          "text": "飞越稻花或是 红高粱"
        },
        {
          "time": 66.62,
          "text": "热望 黑土白雪无疆"
        },
        {
          "time": 71.37,
          "text": "梦醒后折不弯的 铁脊梁"
        },
        {
          "time": 77.62,
          "text": "远方 问千里外路是何方"
        },
        {
          "time": 85.3,
          "text": "丈量 世纪间静默的铿锵"
        },
        {
          "time": 92.96,
          "text": "夜长 沉睡了多少辈倔强"
        },
        {
          "time": 97.01,
          "text": "心里还透着亮"
        },
        {
          "time": 100.7,
          "text": "问我 乳名恳切故土之上"
        },
        {
          "time": 105.45,
          "text": "可会遗忘"
        },
        {
          "time": 107.85,
          "text": "明灯 寄霓虹于冰封"
        },
        {
          "time": 112.45,
          "text": "绝处风光的交锋"
        },
        {
          "time": 116.34,
          "text": "越酸楚越要汹涌"
        },
        {
          "time": 120.43,
          "text": "慰我归途奔波面容"
        },
        {
          "time": 124.6,
          "text": "游遍天涯几重 生生轮转枯又荣"
        },
        {
          "time": 131.82,
          "text": "闯南走北乡音何处不能有相逢"
        },
        {
          "time": 154.5,
          "text": "大江"
        },
        {
          "time": 155.37,
          "text": "滚滚浇出岸上 麦穗黄"
        },
        {
          "time": 158.71,
          "text": "回荡"
        },
        {
          "time": 160.89,
          "text": "嚼过时代苦长"
        },
        {
          "time": 163.51,
          "text": "熬一锅酸甜山楂 裹着糖"
        },
        {
          "time": 169.59,
          "text": "远方 问千里外路是何方"
        },
        {
          "time": 177.3,
          "text": "丈量 世纪间静默的铿锵"
        },
        {
          "time": 185.04,
          "text": "夜长 沉睡了多少辈倔强"
        },
        {
          "time": 189.17,
          "text": "心里还透着亮"
        },
        {
          "time": 192.76,
          "text": "问我 乳名恳切故土之上"
        },
        {
          "time": 197.52,
          "text": "可会遗忘"
        },
        {
          "time": 200.11,
          "text": "明灯 寄霓虹于冰封"
        },
        {
          "time": 204.63,
          "text": "绝处风光的交锋"
        },
        {
          "time": 208.56,
          "text": "越酸楚越要汹涌"
        },
        {
          "time": 212.76,
          "text": "慰我归途奔波面容"
        },
        {
          "time": 216.78,
          "text": "游遍天涯几重 生生轮转枯又荣"
        },
        {
          "time": 223.94,
          "text": "闯南走北乡音何处不能有相逢"
        },
        {
          "time": 246.18,
          "text": "镌刻 最剔透的懵懂"
        },
        {
          "time": 250.65,
          "text": "我胸中有春光涌"
        },
        {
          "time": 254.57,
          "text": "照过大地照苍穹"
        },
        {
          "time": 258.86,
          "text": "抵我来时斑驳疮冻"
        },
        {
          "time": 262.82,
          "text": "撒遍人间欢歌 心火四海都无穷"
        },
        {
