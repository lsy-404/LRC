        },
        {
          "time": 15.83,
          "text": "像一个 身穿着外套的玻璃瓶"
        },
        {
          "time": 19.6,
          "text": "刚好能听清碎的声音"
        },
        {
          "time": 23.19,
          "text": "像一个 被装在盒子的纪念品"
        },
        {
          "time": 26.91,
          "text": "模糊的日期都听不清"
        },
        {
          "time": 31.35,
          "text": "我的身影 分布在每个健忘的人群"
        },
        {
          "time": 38.01,
          "text": "多少世界 太干净"
        },
        {
          "time": 41.77,
          "text": "那就让我唯一的声音 干净地 安静着"
        },
        {
          "time": 46.1,
          "text": "我不见得 怎么还不变呢"
        },
        {
          "time": 49.31,
          "text": "你的融化把我涂成了配色"
        },
        {
          "time": 53.05,
          "text": "可是我的温热 永远被耗费着"
        },
        {
          "time": 56.75,
          "text": "我的消失 消失 被停在了哪一刻"
        },
        {
          "time": 60.9,
          "text": "还是分开 还是不太明白"
        },
        {
          "time": 64.13,
          "text": "所谓"
        },
        {
          "time": 64.62,
          "text": "爱 爱 爱 爱"
        },
        {
          "time": 66.24,
          "text": "比脸更苍白"
        },
        {
          "time": 67.77,
          "text": "可是我的期待 只配一天天变坏"
        },
        {
          "time": 71.26,
          "text": "我只想站在 站在 你不在的时间外"
        },
        {
          "time": 89.7,
          "text": "像一个 裂开着皮肤的碎皮球"
        },
        {
          "time": 93.4,
          "text": "怎么拍我都不太清醒"
        },
        {
          "time": 97.07,
          "text": "像一个 被装在盒子的纪念品"
        },
        {
          "time": 100.71,
          "text": "模糊的日期都听不清"
        },
        {
          "time": 105.16,
          "text": "我的身影 沉默在乌云出没的楼群"
        },
        {
          "time": 111.88,
          "text": "多少世界 太干净"
        },
        {
          "time": 115.52,
          "text": "那就让我唯一的声音 干净地 消失吧"
        },
        {
          "time": 120.0,
          "text": "没固定的 全都没所谓了"
        },
        {
          "time": 123.15,
          "text": "每天变得变得比泪更多余"
        },
        {
          "time": 126.86,
          "text": "所以我的问题 总是待被处理"
        },
        {
          "time": 130.26,
          "text": "又总被忘在 忘在 谁潮湿的记忆里"
        },
        {
          "time": 134.68,
          "text": "我转动着 回复无解的河"
        },
        {
          "time": 137.81,
          "text": "刚好放弃了 关于你不变的规则"
        },
        {
          "time": 141.68,
          "text": "杀死我的意外 怎么还不重来"
