  "songs": [
    {
      "title": "01 人偶之梦",
      "file": "01 人偶之梦.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "人偶之梦"
        },
        {
          "time": 2.82,
          "text": "作曲&编曲：Zeno"
        },
        {
          "time": 6.52,
          "text": "作词：Zeno"
        },
        {
          "time": 9.79,
          "text": "曲绘：匙"
        },
        {
          "time": 14.4,
          "text": "专辑：Freesia"
        },
        {
          "time": 17.7,
          "text": "{ 人偶的心倾听着他人的梦，人偶在梦中追寻永恒的心。故事总会讲完，而梦终会消散 }"
        },
        {
          "time": 29.96,
          "text": "不知从何处降生天真的人偶"
        },
        {
          "time": 34.2,
          "text": "无知的双眸 注视什么"
        },
        {
          "time": 37.49,
          "text": "夜空中星光之雨不停滑落"
        },
        {
          "time": 41.63,
          "text": "那是 无色的梦"
        },
        {
          "time": 45.36,
          "text": "这就是被人称为「灵魂」的种子"
        },
        {
          "time": 49.4,
          "text": "简单的仪式 从此开始"
        },
        {
          "time": 52.92,
          "text": "倾听这夜空中亡灵的诉说"
        },
        {
          "time": 56.85,
          "text": "将那 思念 全部化作歌声"
        },
        {
          "time": 78.9,
          "text": "能不能看清眼中的泪水"
        },
        {
          "time": 81.89,
          "text": "透出生命的颜色"
        },
        {
          "time": 86.32,
          "text": "即使那是模糊不清的幻之影"
        },
        {
          "time": 89.93,
          "text": "也令人颤抖"
        },
        {
          "time": 93.93,
          "text": "纯粹的过去与飘渺的未来相交"
        },
        {
          "time": 98.53,
          "text": "声音不停颤抖"
        },
        {
          "time": 101.5,
          "text": "似乎在那不断反复的话语之中"
        },
        {
          "time": 105.83,
          "text": "祈求着什么"
        },
        {
          "time": 108.3,
          "text": "请告诉我为何心不停的跳动"
        },
        {
          "time": 112.29,
          "text": "这颗心究竟装着什么"
        },
        {
          "time": 115.99,
          "text": "告诉我人到底在守护什么"
        },
        {
          "time": 119.75,
          "text": "为何 与众不同"
        },
        {
          "time": 123.37,
          "text": "若能够找到那名为「爱」的齿轮"
        },
        {
          "time": 127.76,
          "text": "能否让心跳 永不停止"
        },
        {
          "time": 131.06,
          "text": "诉说着天空中亡灵的诉说"
        },
        {
          "time": 135.06,
          "text": "我已不再是我"
        },
        {
          "time": 138.75,
          "text": "只是一场 幻梦"
        },
        {
          "time": 175.98,
          "text": "能不能听见天空的呼喊"
        },
        {
          "time": 178.86,
          "text": "透出生命的音色"
        },
        {
          "time": 183.32,
          "text": "即使那是模糊不清的幻之音"
        },
        {
          "time": 186.91,
          "text": "也令人动容"
        },
        {
          "time": 191.13,
          "text": "用青鸾之羽为被遗失的爱立下"
        },
        {
          "time": 195.28,
          "text": "永不变的誓言"
        },
        {
          "time": 198.71,
          "text": "似乎在那不断反复的话语之间"
        },
        {
          "time": 203.0,
          "text": "感受到什么"
        },
        {
          "time": 205.41,
          "text": "那就是被人称为「神明」的信使"
        },
        {
          "time": 209.48,
          "text": "孤单的仪式 如此相似"
        },
        {
          "time": 213.0,
          "text": "不停地用干枯的声音歌唱"
        },
        {
          "time": 217.04,
          "text": "心中 逐渐 刺痛"
        },
        {
          "time": 220.37,
          "text": "这就是被人称为「灵魂」的种子"
        },
        {
          "time": 224.66,
          "text": "生命的果实 成熟之时"
        },
        {
          "time": 228.24,
          "text": "再无人倾听那亡灵的诉说"
        },
        {
          "time": 232.18,
          "text": "眼泪 化作 星火"
        },
        {
          "time": 235.8,
          "text": "也从天空 坠落"
        }
      ]
    },
    {
      "title": "02 泪之诗",
      "file": "02 泪之诗.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "泪之诗"
        },
        {
          "time": 6.51,
          "text": "作曲&编曲：Zeno"
        },
        {
          "time": 10.57,
          "text": "作词：Zeno"
        },
        {
          "time": 15.32,
          "text": "曲绘：匙"
        },
        {
          "time": 19.42,
          "text": "专辑：Freesia"
        },
        {
          "time": 23.55,
          "text": "{ 无法触及彼此的星球，将泪水洒向空中，化作流星将思念之心传递 }"
        },
        {
          "time": 31.39,
          "text": "谁知道"
        },
        {
          "time": 34.16,
          "text": "那流星的祈祷"
        },
        {
          "time": 37.43,
          "text": "用一千年去围绕"
        },
        {
          "time": 40.55,
          "text": "只为一个拥抱"
        },
        {
          "time": 45.21,
          "text": "天之遥"
        },
        {
          "time": 47.09,
          "text": "遥不可及轨道"
        },
        {
          "time": 50.35,
          "text": "思念洒向那渺远"
        },
        {
          "time": 53.76,
          "text": "化作流星雨只有"
        },
        {
          "time": 57.19,
          "text": "眼泪知道"
        },
        {
          "time": 72.66,
          "text": "在故事的开头"
        },
        {
          "time": 75.11,
          "text": "在混沌之中"
        },
        {
          "time": 76.43,
          "text": "有无数的尽头"
        },
        {
          "time": 79.11,
          "text": "在无尽的时空之中"
        },
        {
          "time": 82.0,
          "text": "穿梭而过"
        },
        {
          "time": 85.74,
          "text": "“请不要 忘记我”"
        },
        {
          "time": 88.86,
          "text": "就算是 一闪而过"
        },
        {
          "time": 92.22,
          "text": "已陷入了无法逃离的漩涡"
        },
        {
          "time": 96.65,
          "text": "谁知道"
        },
        {
          "time": 99.27,
          "text": "那流星的祈祷"
        },
        {
          "time": 102.53,
          "text": "用一千年去围绕"
        },
        {
          "time": 106.0,
          "text": "只为一个拥抱"
        },
        {
          "time": 110.59,
          "text": "天之遥"
        },
        {
          "time": 112.61,
          "text": "遥不可及轨道"
        },
        {
          "time": 115.79,
          "text": "思念洒向那渺远"
        },
        {
          "time": 118.94,
          "text": "化作流星雨寻找"
        },
        {
          "time": 122.49,
          "text": "你的微笑"
        },
        {
          "time": 125.97,
          "text": "面对心中飘渺的旋律"
        },
        {
          "time": 127.59,
          "text": "那哭泣的我（燃烧）"
        },
        {
          "time": 130.79,
          "text": "面对心中斑斑的锈迹"
        },
        {
          "time": 133.86,
          "text": "那悲伤的我（燃烧）"
        },
        {
          "time": 138.01,
          "text": "面对心中无数的回忆"
        },
        {
          "time": 140.39,
          "text": "那叹息的我（燃烧）"
        },
        {
          "time": 144.51,
          "text": "在这无法逃离的漩涡之中紧握着手"
        },
        {
          "time": 193.44,
          "text": "“请不要 忘记我”"
        },
        {
          "time": 196.58,
          "text": "就算是 擦身而过"
        },
        {
          "time": 199.9,
          "text": "已陷入了无法逃离的漩涡"
        },
        {
          "time": 205.06,
          "text": "我只好"
        },
        {
          "time": 207.32,
          "text": "在黑夜中祈祷"
        },
        {
          "time": 210.34,
          "text": "将思念化作星空"
        },
        {
          "time": 213.6,
          "text": "最美丽的那一个梦"
        },
        {
          "time": 218.07,
          "text": "泪知道"
        },
        {
          "time": 220.17,
          "text": "那坠落的轨道"
        },
        {
          "time": 223.38,
          "text": "在那夜空中闪耀"
        },
        {
          "time": 226.71,
          "text": "你一定看得到"
        },
        {
          "time": 230.53,
          "text": "我知道"
        },
        {
          "time": 233.33,
          "text": "在那星光之中"
        },
        {
          "time": 236.83,
          "text": "穿越无数的时空"
        },
        {
          "time": 239.81,
          "text": "总有一天会找到"
        },
        {
          "time": 243.32,
          "text": "一个拥抱"
        },
        {
          "time": 245.8,
          "text": "奏响心中最飘渺的旋律"
        },
        {
          "time": 248.18,
          "text": "为哭泣的你（燃烧）"
        },
        {
          "time": 252.25,
          "text": "洗去心中斑斑的锈迹"
        },
        {
          "time": 254.85,
          "text": "为悲伤的你（燃烧）"
        },
        {
          "time": 258.72,
          "text": "重拾心中无数的回忆"
        },
        {
          "time": 261.2,
          "text": "为叹息的你（燃烧）"
        },
        {
          "time": 265.33,
          "text": "在这无法逃离的漩涡之中紧紧相拥"
        }
      ]
    },
    {
      "title": "03 轮回∞Samsara",
      "file": "03 轮回∞Samsara.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "轮回∞Samsara"
        },
        {
          "time": 5.33,
          "text": "作曲&编曲：Zeno"
        },
        {
          "time": 9.5,
          "text": "作词：Zeno"
        },
        {
          "time": 15.18,
          "text": "曲绘：匙"
        },
        {
          "time": 20.36,
          "text": "专辑：Freesia"
        },
        {
          "time": 23.47,
          "text": "{ 人在得到失去的过程中学习如何珍惜，而人偶在循环的梦境中学会人的感情 }"
        },
        {
          "time": 28.81,
          "text": "告诉我"
        },
        {
          "time": 29.53,
          "text": "在不断流逝的时间之中"
        },
        {
          "time": 32.68,
          "text": "我们应该如何拥有"
        },
        {
          "time": 36.17,
          "text": "在祈求寻觅和相遇之后"
        },
        {
          "time": 39.66,
          "text": "渴望已经不再足够"
        },
        {
          "time": 42.38,
          "text": "听我说"
        },
        {
          "time": 43.45,
          "text": "四季轮回花盛开的时候"
        },
        {
          "time": 48.24,
          "text": "心不停颤抖"
        },
        {
          "time": 50.28,
          "text": "注视着遥远记忆的残留"
        },
        {
          "time": 54.96,
          "text": "奏出思念漩涡"
        },
        {
          "time": 57.16,
          "text": "灰白 天空 阻碍"
        },
        {
          "time": 59.12,
          "text": "透明眼中仅剩下的色彩"
        },
        {
          "time": 63.34,
          "text": "声音 纯粹 刺破"
        },
        {
          "time": 65.72,
          "text": "不属于此那遗失的未来"
        },
        {
          "time": 69.99,
          "text": "当微弱的歌声发出光芒"
        },
        {
          "time": 74.13,
          "text": "逐渐将沉寂的世界照亮"
        },
        {
          "time": 77.56,
          "text": "期盼着什么"
        },
        {
          "time": 79.46,
          "text": "向往着什么"
        },
        {
          "time": 81.46,
          "text": "探出双手"
        },
        {
          "time": 95.92,
          "text": "告诉我"
        },
        {
          "time": 96.92,
          "text": "在不断流逝的时间之中"
        },
        {
          "time": 99.74,
          "text": "究竟有何值得拥有"
        },
        {
          "time": 103.23,
          "text": "在祈求寻觅和相遇之后"
        },
        {
          "time": 106.56,
          "text": "话语已经不再足够"
        },
        {
          "time": 109.38,
          "text": "听我说"
        },
        {
          "time": 110.04,
          "text": "四季轮回花凋谢的时候"
        },
        {
          "time": 115.3,
          "text": "梦沉睡其中"
        },
        {
          "time": 117.49,
          "text": "等待下一个无言的笑容"
        },
        {
          "time": 121.84,
          "text": "绽放出的温柔"
        },
        {
          "time": 150.15,
          "text": "带着泪水我们降生在这颗星球"
        },
        {
          "time": 155.16,
          "text": "不知何为忧愁"
        },
        {
          "time": 158.51,
          "text": "经历苦痛和伤悲之后才学会如何泪流"
        },
        {
          "time": 166.14,
          "text": "沾湿的面容就算被谎言包裹"
        },
        {
          "time": 171.82,
          "text": "每一次哭喊都被心中真实的爱痕刺痛"
        },
        {
          "time": 189.97,
          "text": "告诉我"
        },
        {
          "time": 190.91,
          "text": "该如何防抗那时间之流"
        },
        {
          "time": 193.9,
          "text": "才不会让记忆消融"
        },
        {
          "time": 197.34,
          "text": "在彷徨和若有所失之后"
        },
        {
          "time": 200.69,
          "text": "刻骨之痛逐渐崩落"
        },
        {
          "time": 203.35,
          "text": "听我说"
        },
        {
          "time": 204.26,
          "text": "流于轮回缘因业而交错"
        },
        {
          "time": 209.21,
          "text": "在梦醒之后"
        },
        {
          "time": 211.47,
          "text": "经历一千次擦身的邂逅"
        },
        {
          "time": 215.84,
          "text": "才换一个回眸"
        },
        {
          "time": 217.85,
          "text": "洗去过往我们相遇在这颗星球"
        },
        {
          "time": 222.22,
          "text": "星光指引左右"
        },
        {
          "time": 225.63,
          "text": "经历别离和孤单之后才学会相互包容"
        },
        {
          "time": 233.27,
          "text": "喜悦的心中就算被思念刺痛"
        },
        {
          "time": 238.91,
          "text": "每一滴泪水都因心中那爱恨不停喷涌"
        }
      ]
    },
    {
      "title": "04 涟漪",
      "file": "04 涟漪.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "涟漪"
        },
        {
          "time": 5.48,
          "text": "作曲&编曲：Zeno"
        },
        {
          "time": 10.38,
          "text": "作词：Zeno"
        },
        {
          "time": 15.45,
          "text": "曲绘：匙"
        },
        {
          "time": 20.47,
          "text": "专辑：Freesia"
        },
        {
          "time": 25.49,
          "text": "{ 贝壳将吞入泥沙与孤独之心一起孕育出了美丽的珍珠，却没能将它献给自己喜爱的睡莲 }"
        },
        {
          "time": 43.71,
          "text": "将漂浮的声音都吞没"
        },
        {
          "time": 46.82,
          "text": "描绘着贝壳上的轮廓"
        },
        {
          "time": 50.41,
          "text": "趁暮色未干枯"
        },
        {
          "time": 52.26,
          "text": "让泪水藏匿那未曾见过的颜色"
        },
        {
          "time": 57.17,
          "text": "如果胸中回想同一个景色"
        },
        {
          "time": 61.06,
          "text": "透着纯白寂静光泽"
        },
        {
          "time": 64.92,
          "text": "请慢慢闭上眼"
        },
        {
          "time": 66.65,
          "text": "摇曳着那水面"
        },
        {
          "time": 68.5,
          "text": "黑夜吞噬了地平线"
        },
        {
          "time": 71.53,
          "text": "那哭泣的歌声"
        },
        {
          "time": 73.63,
          "text": "破碎的波纹"
        },
        {
          "time": 75.36,
          "text": "即使挥手 无法割舍"
        },
        {
          "time": 79.0,
          "text": "遗忘的话"
        },
        {
          "time": 80.59,
          "text": "那嗜睡的花"
        },
        {
          "time": 82.21,
          "text": "就请你于此沉睡吧"
        },
        {
          "time": 85.86,
          "text": "你盛开于那盛夏的污浊"
        },
        {
          "time": 89.58,
          "text": "我流连于那温柔的疼痛"
        },
        {
          "time": 93.04,
          "text": "燃烧坠落的那星火"
        },
        {
          "time": 96.13,
          "text": "如梦一闪而过"
        },
        {
          "time": 100.33,
          "text": "在泪水溢满的湖中种下"
        },
        {
          "time": 103.93,
          "text": "那翠绿婆娑的情枝欲芽"
        },
        {
          "time": 107.36,
          "text": "梦中缓慢生长萌发"
        },
        {
          "time": 110.64,
          "text": "蚕食心底流沙"
        },
        {
          "time": 114.52,
          "text": "陪我"
        },
        {
          "time": 115.42,
          "text": "多一些多一些的时间"
        },
        {
          "time": 118.77,
