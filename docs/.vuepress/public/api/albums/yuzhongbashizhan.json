    {
      "title": "7 雨中巴士站",
      "file": "7 雨中巴士站.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "雨中巴士站"
        },
        {
          "time": 4.0,
          "text": "作词 : 46_P"
        },
        {
          "time": 6.0,
          "text": "作曲 : 46_P"
        },
        {
          "time": 46.0,
          "text": "追逐最后残余的"
        },
        {
