    {
      "title": "1 来自盛夏的话语",
      "file": "1 来自盛夏的话语.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "来自盛夏的话语"
        },
        {
          "time": 4.0,
          "text": "作词 : 46_P"
        },
        {
          "time": 6.0,
          "text": "作曲 : 46_P"
        },
        {
          "time": 31.4,
          "text": "这是她初醒样子"
        },
        {
          "time": 36.81,
          "text": "拥抱未知"
        },
        {
          "time": 39.5,
          "text": "吐出那悲欢故事"
        },
        {
          "time": 44.64,
          "text": "在这里 又一次 停止"
        },
        {
          "time": 49.12,
          "text": "Wu..."
        },
        {
          "time": 51.03,
          "text": "彼此间 再一次 认识"
        },
        {
          "time": 55.72,
          "text": "诉说着 话不息"
        },
        {
          "time": 60.69,
          "text": "来自盛夏的点滴"
        },
        {
          "time": 63.75,
          "text": "等待未知旅途的你"
        },
        {
          "time": 66.62,
          "text": "光芒散布在脚下和天际"
        },
        {
          "time": 70.27,
          "text": "种子沉睡不醒"
        },
        {
          "time": 72.98,
          "text": "这夜晚也悄然来临"
        },
        {
          "time": 76.52,
          "text": "澄澈的声音接近"
        },
        {
          "time": 79.4,
          "text": "倾诉着这不为人知物语"
        }
      ]
    },
    {
      "title": "2 地平线观测",
      "file": "2 地平线观测.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "地平线观测"
        },
        {
          "time": 4.0,
          "text": "作词 : 46_P"
        },
        {
          "time": 6.0,
          "text": "作曲 : 46_P"
        },
        {
          "time": 14.83,
          "text": "当破晓 你又会见到"
        },
        {
          "time": 22.35,
          "text": "怎样的 景色呐"
        },
        {
          "time": 50.32,
          "text": "我们一起约定好"
        },
        {
          "time": 53.32,
          "text": "在这个初夏"
        },
        {
          "time": 56.25,
          "text": "山脚下"
        },
        {
          "time": 59.64,
          "text": "风微潮"
        },
        {
          "time": 62.73,
          "text": "在古老的传说中"
        },
        {
          "time": 65.5,
          "text": "于日出时分观看到的地平线"
        },
        {
          "time": 71.9,
          "text": "会迷惑视线"
        },
        {
          "time": 76.79,
          "text": "碎芒浮现在身旁"
        },
        {
          "time": 80.87,
          "text": "空中弥漫着"
        },
        {
          "time": 83.78,
          "text": "在那心中回荡"
        },
        {
          "time": 87.21,
          "text": "地平线发出"
        },
        {
          "time": 89.05,
          "text": "绮丽光芒 两人身旁"
        },
        {
          "time": 92.83,
          "text": "顷刻之间"
        },
        {
          "time": 93.76,
          "text": "被尘封的名为爱的视角"
        },
        {
          "time": 96.85,
          "text": "绽放喧嚣"
        },
        {
          "time": 99.52,
          "text": "当视线遮挡 不再困惘"
        },
        {
          "time": 102.9,
          "text": "能够抓住吗"
        },
        {
          "time": 105.19,
          "text": "再一次地"
        },
        {
          "time": 108.35,
          "text": "观望"
        },
        {
          "time": 110.29,
          "text": "地平线的光芒"
        },
        {
          "time": 124.3,
          "text": "草穗摇动在坡道"
        },
        {
          "time": 127.07,
          "text": "青色与微响"
        },
        {
          "time": 130.2,
          "text": "山顶上"
        },
        {
          "time": 133.55,
          "text": "雨飘洒"
        },
        {
          "time": 136.7,
          "text": "埋藏在灵魂深处"
        },
        {
          "time": 139.54,
          "text": "如同魔法般印刻的未名之花"
        },
        {
          "time": 145.62,
          "text": "盛开于街道"
        },
        {
          "time": 150.6,
          "text": "夜晚布置的剧场"
        },
        {
          "time": 154.6,
          "text": "繁星未倾下"
        },
        {
          "time": 157.83,
          "text": "黎明投出怀抱"
        },
        {
          "time": 161.03,
          "text": "眼角泪滴落下"
        },
        {
          "time": 162.85,
          "text": "成为棱角"
        },
        {
          "time": 164.46,
          "text": "最终散场"
        },
        {
          "time": 166.7,
          "text": "刺眼瞬间"
        },
        {
          "time": 167.57,
          "text": "消失于身边的一抹淡光"
        },
        {
          "time": 170.71,
          "text": "留下苍茫"
        },
        {
          "time": 173.38,
          "text": "当微笑离场"
        },
        {
          "time": 175.35,
          "text": "温柔洒下"
        },
        {
          "time": 176.7,
          "text": "又能记住吗"
        },
        {
          "time": 179.09,
          "text": "再一次地 追望"
        },
        {
          "time": 186.08,
          "text": "零零碎碎拾起回忆"
        },
        {
          "time": 187.59,
          "text": "在每个穿梭的夜晚"
        },
        {
          "time": 189.14,
          "text": "不断询问自我意义"
        },
        {
          "time": 190.69,
          "text": "地平线也丢失答案"
        },
        {
          "time": 192.17,
          "text": "最后的结局仍然存在"
        },
        {
          "time": 210.32,
          "text": "地平线留下"
        },
        {
          "time": 212.11,
          "text": "轻柔光芒"
        },
        {
          "time": 213.67,
          "text": "一人身旁"
        },
        {
          "time": 216.12,
          "text": "转瞬湮灭"
        },
        {
          "time": 216.84,
          "text": "被打开的名为爱的视角"
        },
        {
          "time": 219.79,
          "text": "停止喧嚣"
        },
        {
          "time": 222.42,
          "text": "当视线遮挡"
        },
        {
          "time": 224.41,
          "text": "不再困惘"
        },
        {
          "time": 226.11,
          "text": "能够抓住吗"
        },
        {
          "time": 228.3,
          "text": "再一次地"
        },
        {
          "time": 231.38,
          "text": "观赏"
        },
        {
          "time": 233.2,
          "text": "这最后的剧场"
        }
      ]
    },
