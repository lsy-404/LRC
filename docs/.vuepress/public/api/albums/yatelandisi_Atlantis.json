ime":23.72,"text":"像在等待着什么降临"},{"time":30.11,"text":"忽然间 一束光划过天际"},{"time":37.21,"text":"好像要撕裂大地"},{"time":43.71,"text":"耀眼的光如此灿烂美丽"},{"time":49.56,"text":"仿佛 一位公主降临"},{"time":58.07,"text":"走出灰烬的那少女"},{"time":61.13,"text":"歌唱着动人旋律"},{"time":65.04,"text":"难道真的有星外神明"},{"time":71.65,"text":"发出恒心般的引力"},{"time":75.17,"text":"令我无法抗拒"},{"time":78.62,"text":"难道是我注定命运"},{"time":87.65,"text":"听 是海浪的声音"},{"time":92.21,"text":"澎湃又热情"},{"time":95.86,"text":"是在迎接着我的贵宾"},{"time":101.15,"text":"听 是海鸟的欢鸣"},{"time":105.9,"text":"愉快又开心"},{"time":109.5,"text":"在欢送着特别的你"},{"time":116.03,"text":"渐渐的 与你越来越熟悉"},{"time":121.63,"text":"已决定永远追随你"},{"time":130.0,"text":"耀眼的光如此圣洁美丽"},{"time":135.3,"text":"仿佛 以为公主降临"},{"time":143.71,"text":"走出灰烬的那少女"},{"time":147.39,"text":"歌唱着动人旋律"},{"time":150.81,"text":"难道真的有星外神明"},{"time":156.83,"text":"发出恒心般的引力"},{"time":160.58,"text":"令我无法抗拒"},{"time":164.32,"text":"一定是我命中注定"},{"time":172.71,"text":"演唱：海伊"},{"time":174.35,"text":"作曲、编曲、作词：Ddickky、天钦"},{"time":175.59,"text":"调校：Napstian"},{"time":176.93,"text":"曲绘：Jinko_神子"},{"time":178.3,"text":"专辑：亚特兰蒂斯Atlantis"},{"time":201.34,"text":"与你距离越来越近"},{"time":205.37,"text":"好像曾经一心同体"},{"time":208.9,"text":"难道只是我错误记忆"},{"time":215.54,"text":"从你到来的那天起"},{"time":219.22,"text":"对我似有共鸣"},{"time":222.29,"text":"谁来告诉我原因"},{"time":231.0,"text":"听 是海流的声音"},{"time":248.56,"text":"已不再平静"}]}]}