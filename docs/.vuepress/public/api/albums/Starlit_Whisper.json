  "songs": [
    {
      "title": "1 Chasing the shadow.",
      "file": "1 Chasing the shadow..lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "Chasing the shadow."
        },
        {
          "time": 60.0,
          "text": "作曲/编曲：胧"
        }
      ]
    },
    {
      "title": "2 Shadow Trace",
      "file": "2 Shadow Trace.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "Shadow Trace"
        },
        {
          "time": 10.0,
          "text": "演唱：星尘"
        },
        {
          "time": 12.0,
          "text": "作曲/编曲/作词：胧"
        },
        {
          "time": 14.0,
          "text": "调校：Creuzer"
        },
        {
          "time": 20.42,
          "text": "如梦追影 是谁在旧梦刻下了痕迹"
        },
        {
          "time": 25.88,
          "text": "岁月无声的在旧时光里拼凑着内心的归依"
        },
        {
          "time": 32.27,
          "text": "背负命运的重力 追逐微弱的光影"
        },
        {
          "time": 37.33,
          "text": "破碎梦境的回音 化作不息的涟漪"
        },
        {
          "time": 42.47,
          "text": "如果我 不再囿于过去"
        },
        {
          "time": 47.32,
          "text": "你的身影 却仍在心底"
        },
        {
          "time": 52.95,
          "text": "倒影出斑驳风景"
        },
        {
          "time": 54.85,
          "text": "当一场大雨 淋湿记忆"
        },
        {
          "time": 57.42,
          "text": "旧日的风也唤醒了长鸣"
        },
        {
          "time": 60.1,
          "text": "透明的雨滴 悄落在夜里"
        },
        {
          "time": 62.59,
          "text": "化作微光填满孤寂"
        },
        {
          "time": 65.41,
          "text": "如影追随的情绪"
        },
        {
          "time": 67.93,
          "text": "埋进心底让时间慢慢的淡去"
        },
        {
          "time": 71.3,
          "text": "期许在新生的轨迹里"
        },
        {
          "time": 75.91,
          "text": "寻回属于我们 崭新的自己"
        },
        {
          "time": 81.29,
          "text": "加速前行 告别了昨日褪色的叹息"
        },
        {
          "time": 86.58,
          "text": "执念藏心底 流淌进血液里成为动力与勇气"
        },
        {
          "time": 92.85,
          "text": "背负命运的重力 追逐微弱的光影"
        },
        {
          "time": 97.88,
          "text": "破碎梦境的回音 化作不息的涟漪"
        },
        {
          "time": 103.08,
          "text": "如果我 能看清这段距离"
        },
        {
          "time": 108.04,
          "text": "你的呼吸 却仍在心底支撑我继续前行"
        },
        {
          "time": 115.35,
          "text": "当一场大雨 冲淡回忆"
        },
        {
          "time": 118.1,
          "text": "才发现泪已散作了潮汐"
        },
        {
          "time": 120.64,
          "text": "漫长的夜里 微光在靠近"
        },
        {
          "time": 123.13,
          "text": "驱散了伤痛的余影"
        },
        {
          "time": 125.99,
          "text": "未曾说出的秘密"
        },
        {
          "time": 128.61,
          "text": "埋进心底让时间慢慢的淡去"
        },
        {
          "time": 131.98,
          "text": "你终将随风飘然远行"
        },
        {
          "time": 136.5,
          "text": "寻回属于我们无垠的梦境与共鸣"
        },
        {
          "time": 160.68,
          "text": "被夜色吞噬的身影渐渐远离"
        },
        {
          "time": 166.0,
          "text": "若命运早已定下结局"
        },
        {
          "time": 171.25,
          "text": "如何填补残缺的心"
        },
        {
          "time": 174.02,
          "text": "如被时间带走的影"
        },
        {
          "time": 176.29,
          "text": "请别让回忆 将我唤醒"
        },
        {
          "time": 180.98,
          "text": "当光影褪尽 黯然无息"
        },
        {
          "time": 183.96,
          "text": "流转的时针却停在原地"
        },
        {
          "time": 186.63,
          "text": "破碎的回音 无人能听清"
        },
        {
          "time": 189.11,
          "text": "在黑暗中漂泊无依"
        },
        {
          "time": 191.84,
          "text": "如影消散的过去"
        },
        {
          "time": 194.38,
          "text": "埋藏进时间模糊的缝隙里"
        },
        {
          "time": 197.77,
          "text": "如果你还在梦的彼岸里"
        },
        {
          "time": 202.48,
          "text": "等待彼此携手到天明"
        },
        {
          "time": 205.73,
          "text": "Free myself take me to sea"
        },
        {
          "time": 210.18,
          "text": "漂泊着的心 再微弱也能够穿越时光的距离"
        },
        {
          "time": 215.9,
          "text": "Just free myself take me to sea"
        },
        {
          "time": 221.05,
          "text": "紧握的 是那从未散去的约定"
        }
      ]
    },
    {
      "title": "3 热岛之人",
      "file": "3 热岛之人.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "热岛之人"
        },
        {
          "time": 0.6,
          "text": "一步一印 横过车道"
        },
        {
          "time": 4.39,
          "text": "一双球鞋 接踵一双蹦跳"
        },
        {
          "time": 7.89,
          "text": "回头有你 在肩后环抱"
        },
        {
          "time": 10.71,
          "text": "拉着我 追循月色 踏乱影奔跑"
        },
        {
          "time": 17.0,
          "text": "演唱：星尘"
        },
        {
          "time": 20.0,
          "text": "作曲/编曲：胧"
        },
        {
          "time": 23.0,
          "text": "作词：林檎"
        },
        {
          "time": 26.0,
          "text": "调校：血焰玖蝶"
        },
        {
          "time": 30.09,
          "text": "一拍一音 如何合刷"
        },
        {
          "time": 33.75,
          "text": "一场雨泪 躲寻过攀爬架"
        },
        {
          "time": 37.15,
          "text": "数顾教室 也曾堵网吧"
        },
        {
          "time": 40.07,
          "text": "撺掇谁 四五成团 谱青春喧哗"
        },
        {
          "time": 44.0,
          "text": "日练夜忙 指茧破皮"
        },
        {
          "time": 47.36,
          "text": "胃液翻涌 走路都崎岖"
        },
        {
          "time": 50.9,
          "text": "身体摔成沙砾"
        },
        {
          "time": 52.84,
          "text": "又随波浪接住 淤积回忆"
        },
        {
          "time": 58.15,
          "text": "谁是孤岛无梦沉寂在大海"
        },
        {
          "time": 61.87,
          "text": "海角会不期漂流到一块"
        },
        {
          "time": 65.58,
          "text": "从此愿望落了地"
        },
        {
          "time": 67.95,
          "text": "满城市间升腾起热气旋澎湃"
        },
        {
          "time": 73.13,
          "text": "雨带摆动 不下来"
        },
        {
          "time": 92.11,
          "text": "多云时阴 局部大雾"
        },
        {
          "time": 95.89,
          "text": "前行 恐怕碰壁或歧途"
        },
        {
          "time": 99.6,
          "text": "嘴唇干燥 有苦不轻诉"
        },
        {
          "time": 102.99,
          "text": "闷踩着平均律 学步"
        },
        {
          "time": 106.45,
          "text": "日练夜忙 指茧破皮"
        },
        {
          "time": 109.74,
          "text": "头疼欲裂 告罄止痛剂"
        },
        {
          "time": 113.15,
          "text": "灵魂快将离体"
        },
        {
          "time": 115.19,
          "text": "恍若飞鸟俯瞰 群居生命"
        },
        {
          "time": 119.86,
          "text": "没有人 是孤岛无梦沉寂在大海"
        },
        {
          "time": 124.18,
          "text": "海角会不期漂流到一块"
        },
        {
          "time": 127.9,
          "text": "从此愿望落了地"
        },
        {
          "time": 130.15,
          "text": "满城市间升腾起热气旋澎湃"
        },
        {
          "time": 135.36,
          "text": "雨云渐散 不再"
        },
        {
          "time": 170.45,
          "text": "海平面有天消融极冰盖"
        },
        {
          "time": 173.71,
          "text": "水淹满地球将物种择汰"
        },
        {
          "time": 177.37,
          "text": "孤岛沙砾也无碍"
        },
        {
          "time": 179.65,
          "text": "与你同奏一首曲"
        },
        {
          "time": 181.71,
          "text": "唱开迷漫的未来"
        },
        {
          "time": 184.61,
          "text": "悠远深海永埋传说的陆块"
        },
        {
          "time": 188.26,
          "text": "如心锚重见故城未荒败"
        },
        {
          "time": 191.99,
          "text": "黑暗中总有处海底缆所接亮能退守"
        },
        {
          "time": 196.51,
          "text": "永远的舞台"
        },
        {
          "time": 199.51,
          "text": "有你我故 梦存在"
        }
      ]
    },
    {
      "title": "4 勿忘草",
      "file": "4 勿忘草.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "勿忘草"
        },
        {
          "time": 6.0,
          "text": "演唱：星尘"
        },
        {
          "time": 7.0,
          "text": "作曲/编曲/作词：Aya-亚夜-"
        },
        {
          "time": 8.0,
          "text": "调校：跨海星尘"
        },
        {
          "time": 11.6,
          "text": "曾经一起去学校的路上"
        },
        {
          "time": 14.65,
          "text": "害怕说话的我有一点紧张"
        },
        {
          "time": 17.55,
          "text": "人来人往我不敢发出声响"
        },
        {
          "time": 20.31,
          "text": "所以我低下头回到了路旁"
        },
        {
          "time": 29.2,
          "text": "人生像没有结局的戏"
        },
        {
          "time": 32.12,
          "text": "台词却被我遗忘殆尽"
        },
        {
          "time": 35.02,
          "text": "之后的剧情成了谜"
        },
        {
          "time": 37.88,
          "text": "还没到终章只剩下我自己"
        },
        {
          "time": 41.13,
          "text": "告诉我 一切会变好吗？"
        },
        {
          "time": 44.84,
          "text": "会的吧"
        },
        {
          "time": 46.6,
          "text": "雨还是没停下"
        },
        {
          "time": 50.96,
          "text": "是啊"
        },
        {
          "time": 52.42,
          "text": "滴答滴答"
        },
        {
          "time": 54.14,
          "text": "是我的眼泪吗？"
        },
        {
          "time": 56.41,
          "text": "是的吧"
        },
        {
          "time": 58.34,
          "text": "雨会和它一起停下吗？"
        },
        {
          "time": 62.75,
          "text": "会吧"
        },
        {
          "time": 64.14,
          "text": "追赶着我的风 和云的裂缝"
        },
        {
          "time": 67.79,
          "text": "我试着闭上眼 让这世界朦胧"
        },
        {
          "time": 70.63,
          "text": "我害怕我的眼瞳"
        },
        {
          "time": 72.5,
          "text": "玷污了天空"
        },
        {
          "time": 75.3,
          "text": "好想变得轻松"
        },
        {
          "time": 78.22,
          "text": "只需要做着梦"
        },
        {
          "time": 90.63,
          "text": "如果人生还会这样继续"
        },
        {
          "time": 93.76,
          "text": "害怕错过什么也不想失去"
        },
        {
          "time": 96.47,
          "text": "这个世界有自己的秩序"
        },
        {
          "time": 98.98,
          "text": "可是我啊 只剩下想消失的欲"
        },
        {
          "time": 102.58,
          "text": "告诉我 一切会变好吗？"
        },
        {
          "time": 106.18,
          "text": "会的吧"
        },
        {
          "time": 107.93,
          "text": "雨还是没停下"
        },
        {
          "time": 112.39,
          "text": "是啊"
        },
        {
          "time": 114.27,
          "text": "遇见你 那天的雨也是"
        },
        {
          "time": 117.99,
          "text": "没停下"
        },
        {
          "time": 119.75,
          "text": "停下的是我们的步伐"
        },
        {
          "time": 124.01,
          "text": "讽刺吧"
        },
        {
          "time": 125.41,
          "text": "在膨胀的冲动 自卑下的痛"
        },
        {
          "time": 129.13,
          "text": "我试着闭上眼 让这思绪朦胧"
        },
        {
          "time": 132.06,
          "text": "我讨厌我的珍重"
        },
        {
          "time": 133.87,
          "text": "没有人感动"
        },
        {
          "time": 136.7,
          "text": "好想变得轻松"
        },
        {
          "time": 139.68,
          "text": "只需要做着梦"
        },
        {
          "time": 163.47,
          "text": "你留下的空洞 让思念失重"
        },
        {
          "time": 167.25,
          "text": "我却还是不想被你寻找到行踪"
        },
        {
          "time": 170.19,
          "text": "我害怕你的眼瞳"
        },
        {
          "time": 172.05,
          "text": "不属于这梦"
        },
        {
          "time": 174.88,
          "text": "好想变得轻松"
        },
        {
          "time": 177.84,
          "text": "和你望着天空"
        },
        {
          "time": 180.79,
          "text": "每一次想起你"
        },
        {
          "time": 183.57,
          "text": "和你走过的痕迹"
        },
        {
          "time": 186.61,
          "text": "那是原本的自己"
        }
      ]
    },
    {
      "title": "5 半梦",
      "file": "5 半梦.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "半梦"
        },
        {
          "time": 0.54,
          "text": "晚风的夏夜"
        },
        {
          "time": 3.36,
          "text": "带走了思念"
        },
        {
          "time": 5.77,
          "text": "沉醉的旧梦"
        },
        {
          "time": 8.43,
          "text": "淹没在雨中"
        },
        {
          "time": 11.21,
          "text": "淡忘的情绪"
        },
        {
          "time": 13.82,
          "text": "沉入了夜里"
        },
        {
          "time": 16.38,
          "text": "将盛夏的我交给时间"
        },
        {
          "time": 24.0,
          "text": "演唱：星尘、赤羽、诗岸、海伊、苍穹"
        },
        {
          "time": 27.0,
          "text": "作曲/编曲/作词：胧"
        },
        {
          "time": 30.0,
          "text": "调校：瑞安Ryan"
        },
        {
          "time": 35.0,
          "text": "阳光洒在课桌边"
        },
        {
          "time": 36.6,
          "text": "铃声在午后轻盘旋"
        },
        {
          "time": 40.09,
          "text": "是谁借桌角偷写下 答案"
        },
        {
          "time": 45.29,
          "text": "翻开泛黄的纸笺"
        },
        {
          "time": 47.34,
          "text": "竟是写满回忆的夏天"
        },
        {
          "time": 50.43,
          "text": "那时微笑的脸像藏住了心愿"
        },
        {
          "time": 55.24,
          "text": "傍晚的风 融进暮色里"
        },
        {
          "time": 60.39,
          "text": "听你说着未来的梦与坏天气"
        },
        {
          "time": 65.77,
          "text": "我笑着掩饰情绪"
        },
        {
          "time": 67.29,
          "text": "心跳却乱成了旋律"
        },
        {
          "time": 69.73,
          "text": "翻开夏夜的日记"
        },
        {
          "time": 72.46,
          "text": "却只剩一半回忆"
        },
        {
          "time": 75.12,
          "text": "那页未写的姓名"
        },
        {
          "time": 77.68,
          "text": "隐藏在旧梦中未提"
        },
        {
          "time": 80.53,
          "text": "告别停在无言里"
        },
        {
          "time": 82.96,
          "text": "仍记得你眼中的倒影"
        },
        {
          "time": 86.67,
          "text": "青春像斜阳微光"
        },
        {
          "time": 89.31,
          "text": "一半梦一半叹息"
        },
        {
          "time": 103.7,
          "text": "还记得在那一天"
        },
        {
          "time": 105.49,
          "text": "树影晃动日光的画面"
        },
        {
          "time": 108.69,
          "text": "不管山盟多遥远"
        },
        {
          "time": 111.0,
          "text": "我们曾悄悄许下心愿"
        },
        {
          "time": 114.12,
          "text": "流光溢彩的夏天"
        },
        {
          "time": 116.21,
          "text": "如同藏在青涩中的一瞬间"
        },
        {
          "time": 119.67,
          "text": "那时你爱笑的脸"
        },
        {
          "time": 121.53,
          "text": "填满了我整个世界"
        },
        {
          "time": 124.25,
          "text": "傍晚的风 吹散了誓言"
        },
        {
          "time": 129.62,
          "text": "静静走在你常走过的那条街"
        },
        {
          "time": 134.95,
          "text": "写下一半青春一半错过一半的纪念"
        },
        {
          "time": 138.94,
          "text": "翻开夏夜的日记"
        },
        {
          "time": 141.55,
          "text": "字里行间的秘密"
        },
        {
          "time": 144.22,
          "text": "那页未明的心绪"
        },
        {
          "time": 146.82,
          "text": "回荡在旧梦中清晰"
        },
        {
          "time": 149.68,
          "text": "告别停留在风里"
        },
        {
          "time": 152.18,
          "text": "仍记得你熟悉的声音"
        },
        {
          "time": 155.75,
          "text": "青春像斜阳微光"
        },
        {
          "time": 158.54,
          "text": "半梦半醒半谜"
        },
        {
          "time": 184.02,
          "text": "当夕阳透过熟悉的街角"
        },
        {
          "time": 186.85,
          "text": "光影若能将回忆"
        },
        {
          "time": 189.43,
          "text": "慢慢 拉长几秒"
        },
        {
          "time": 192.05,
          "text": "胸口不安的心跳"
        },
        {
          "time": 194.69,
          "text": "不会被轻易抹掉"
        },
        {
          "time": 197.29,
          "text": "等到迟来的雨季"
        },
        {
          "time": 199.95,
          "text": "才读懂你的迟疑"
        },
        {
          "time": 202.72,
          "text": "再见夏夜的日记"
        },
        {
          "time": 205.38,
          "text": "褪去了雨后的迷"
        },
        {
          "time": 207.97,
          "text": "那页抹去的字迹"
        },
        {
          "time": 210.72,
          "text": "才明白句句都是你"
        },
        {
          "time": 213.52,
          "text": "回忆写不出结局"
        },
        {
          "time": 216.0,
          "text": "淹没风声一半的话语"
        },
        {
          "time": 219.71,
          "text": "难言难醒难再续"
        },
        {
          "time": 225.03,
          "text": "LaLaLaLa LaLaLaLa"
        },
        {
          "time": 231.97,
          "text": "等待日暮的倒影"
        },
        {
          "time": 234.7,
          "text": "幻作雨后的回音"
        },
        {
          "time": 237.4,
          "text": "藏在夏夜日记里"
        },
        {
          "time": 239.96,
          "text": "在梦中静静的延续"
        },
        {
          "time": 243.36,
          "text": "一半梦一半清醒"
        }
