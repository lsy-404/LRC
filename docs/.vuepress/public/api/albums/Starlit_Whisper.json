    {
      "title": "7 Shadow Trace -Japanese Ver-",
      "file": "7 Shadow Trace -Japanese Ver-.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "Shadow Trace -Japanese Ver-"
        },
        {
          "time": 10.0,
          "text": "演唱：星尘"
        },
        {
          "time": 12.0,
          "text": "作曲/编曲：胧"
        },
        {
          "time": 14.0,
          "text": "作词：阿卡娜"
        },
        {
          "time": 16.0,
          "text": "调校：血焰玖蝶"
        },
        {
          "time": 20.42,
          "text": "儚横い 夢に湖れ続けて"
        },
        {
          "time": 20.42,
          "text": "如梦追影 是谁在旧梦刻下了痕迹"
        },
        {
          "time": 25.88,
          "text": "ぎわめいた 心の叫びも遠くなる"
        },
        {
          "time": 25.88,
          "text": "岁月无声的在旧时光里拼凑着内心的归依"
        },
        {
          "time": 32.27,
          "text": "何を求めて 何を背負って"
        },
        {
          "time": 32.27,
          "text": "背负命运的重力 追逐微弱的光影"
        },
        {
          "time": 37.33,
          "text": "微かな光に手を伸ばした"
        },
        {
          "time": 37.33,
          "text": "破碎梦境的回音 化作不息的涟漪"
        },
        {
          "time": 42.47,
          "text": "星か廻り出せば"
        },
        {
          "time": 42.47,
          "text": "如果我 不再囿于过去"
        },
        {
          "time": 47.32,
          "text": "過去には 囚われず"
        },
        {
          "time": 47.32,
          "text": "你的身影 却仍在心底"
        },
        {
          "time": 52.95,
          "text": "君と一緒なら"
        },
        {
          "time": 52.95,
          "text": "倒影出斑驳风景"
        },
        {
          "time": 54.85,
          "text": "大雨に打たれて"
        },
        {
          "time": 54.85,
          "text": "当一场大雨 淋湿记忆"
        },
        {
          "time": 57.42,
          "text": "ぼやけてた答えには"
        },
        {
          "time": 57.42,
          "text": "旧日的风也唤醒了长鸣"
        },
        {
          "time": 60.1,
          "text": "あの時の 思い出が"
        },
        {
          "time": 60.1,
          "text": "透明的雨滴 悄落在夜里"
        },
        {
          "time": 62.59,
          "text": "詰まっているんだな"
        },
        {
          "time": 62.59,
          "text": "化作微光填满孤寂"
        },
        {
          "time": 65.41,
          "text": "締め付けられて"
        },
        {
          "time": 65.41,
          "text": "如影追随的情绪"
        },
        {
          "time": 67.93,
          "text": "胸の奥には蘇る"
        },
        {
          "time": 67.93,
          "text": "埋进心底让时间慢慢的淡去"
        },
        {
          "time": 71.3,
          "text": "火花が光り出す"
        },
        {
          "time": 71.3,
          "text": "期许在新生的轨迹里"
        },
        {
          "time": 75.91,
          "text": "自分らしさを描いて"
        },
        {
          "time": 75.91,
          "text": "寻回属于我们 崭新的自己"
        },
        {
          "time": 81.29,
          "text": "前だけ 見つめるシグナルから"
        },
        {
          "time": 81.29,
          "text": "加速前行 告别了昨日褪色的叹息"
        },
        {
          "time": 86.58,
          "text": "色褪せた 昔の無力を振り払う"
        },
        {
          "time": 86.58,
          "text": "执念藏心底 流淌进血液里成为动力与勇气"
        },
        {
          "time": 92.85,
          "text": "何を求めて 何を背負って"
        },
        {
          "time": 92.85,
          "text": "背负命运的重力 追逐微弱的光影"
        },
        {
          "time": 97.88,
          "text": "虚像を破れ 光の先へ"
        },
        {
          "time": 97.88,
          "text": "破碎梦境的回音 化作不息的涟漪"
        },
        {
          "time": 103.08,
          "text": "遥か 彼方にいても"
        },
        {
          "time": 103.08,
          "text": "如果我 能看清这段距离"
        },
        {
          "time": 108.04,
          "text": "シンクロしてゆくんだ 君と一緒なら"
        },
        {
          "time": 108.04,
          "text": "你的呼吸 却仍在心底支撑我继续前行"
        },
        {
          "time": 115.35,
          "text": "大雨の 後には"
        },
        {
          "time": 115.35,
          "text": "当一场大雨 冲淡回忆"
        },
        {
          "time": 118.1,
          "text": "晴れ渡る青空が"
        },
        {
          "time": 118.1,
          "text": "才发现泪已散作了潮汐"
        },
        {
          "time": 120.64,
          "text": "暗闇を 突き破る"
        },
        {
          "time": 120.64,
          "text": "漫长的夜里 微光在靠近"
        },
        {
          "time": 123.13,
          "text": "傷を癒してく"
        },
        {
          "time": 123.13,
          "text": "驱散了伤痛的余影"
        },
        {
          "time": 125.99,
          "text": "言えない秘密"
        },
        {
          "time": 125.99,
          "text": "未曾说出的秘密"
        },
        {
          "time": 128.61,
          "text": "明かされないまま薄れ"
        },
        {
          "time": 128.61,
          "text": "埋进心底让时间慢慢的淡去"
        },
        {
          "time": 131.98,
          "text": "君も君の道を"
        },
        {
          "time": 131.98,
          "text": "你终将随风飘然远行"
        },
        {
          "time": 136.5,
          "text": "風に流され無限の夢へ"
        },
        {
          "time": 136.5,
          "text": "寻回属于我们无垠的梦境与共鸣"
        },
        {
          "time": 160.68,
          "text": "闇に飲まれて僕たちは"
        },
        {
          "time": 160.68,
          "text": "被夜色吞噬的身影渐渐远离"
        },
        {
          "time": 166.0,
          "text": "このまま終わるのか"
        },
        {
          "time": 166.0,
          "text": "若命运早已定下结局"
        },
        {
          "time": 171.25,
          "text": "空いた心には"
        },
        {
          "time": 171.25,
          "text": "如何填补残缺的心"
        },
        {
          "time": 174.02,
          "text": "過ぎ去る時間が"
        },
        {
          "time": 174.02,
          "text": "如被时间带走的影"
        },
        {
          "time": 176.29,
          "text": "今もまだ 叫んでる"
        },
        {
          "time": 176.29,
          "text": "请别让回忆 将我唤醒"
        },
        {
          "time": 180.98,
          "text": "残酷に 止まった"
        },
        {
          "time": 180.98,
          "text": "当光影褪尽 黯然无息"
        },
        {
          "time": 183.96,
          "text": "時の歯車は今"
        },
        {
          "time": 183.96,
          "text": "流转的时针却停在原地"
        },
        {
          "time": 186.63,
          "text": "何もかも 閉じ込めて"
        },
        {
          "time": 186.63,
          "text": "破碎的回音 无人能听清"
        },
        {
          "time": 189.11,
          "text": "彷徨い続けた"
        },
        {
          "time": 189.11,
          "text": "在黑暗中漂泊无依"
        },
        {
          "time": 191.84,
          "text": "消えてく影を"
        },
        {
          "time": 191.84,
          "text": "如影消散的过去"
        },
        {
          "time": 194.38,
          "text": "手放してさようならと"
        },
        {
          "time": 194.38,
          "text": "埋藏进时间模糊的缝隙里"
        },
        {
          "time": 197.77,
          "text": "手を振って 微笑むから"
        },
        {
          "time": 197.77,
          "text": "如果你还在梦的彼岸里"
        },
        {
          "time": 202.48,
          "text": "また 夜明けの向こうへ"
        },
        {
          "time": 202.48,
          "text": "等待彼此携手到天明"
        },
        {
          "time": 205.73,
          "text": "Free myself take me to sea"
        },
        {
          "time": 210.18,
          "text": "弱くても 時を超えて見せると信じた"
        },
        {
          "time": 210.18,
          "text": "漂泊着的心 再微弱也能够穿越时光的距离"
        },
        {
          "time": 215.9,
          "text": "Just free myself take me to sea"
        },
        {
          "time": 221.05,
          "text": "君の手を取って離さない"
        },
        {
          "time": 221.05,
          "text": "紧握的 是那从未散去的约定"
        }
      ]
    },
    {
