        {
          "time": 75.12,
          "text": "那页未写的姓名"
        },
        {
          "time": 77.68,
          "text": "隐藏在旧梦中未提"
        },
        {
          "time": 80.53,
          "text": "告别停在无言里"
        },
        {
          "time": 82.96,
          "text": "仍记得你眼中的倒影"
        },
        {
          "time": 86.67,
          "text": "青春像斜阳微光"
        },
        {
          "time": 89.31,
          "text": "一半梦一半叹息"
        },
        {
          "time": 103.7,
          "text": "还记得在那一天"
        },
        {
          "time": 105.49,
          "text": "树影晃动日光的画面"
        },
        {
          "time": 108.69,
          "text": "不管山盟多遥远"
        },
        {
          "time": 111.0,
          "text": "我们曾悄悄许下心愿"
        },
        {
          "time": 114.12,
          "text": "流光溢彩的夏天"
        },
        {
          "time": 116.21,
          "text": "如同藏在青涩中的一瞬间"
        },
        {
          "time": 119.67,
          "text": "那时你爱笑的脸"
        },
        {
          "time": 121.53,
          "text": "填满了我整个世界"
        },
        {
          "time": 124.25,
          "text": "傍晚的风 吹散了誓言"
        },
        {
          "time": 129.62,
          "text": "静静走在你常走过的那条街"
        },
        {
          "time": 134.95,
          "text": "写下一半青春一半错过一半的纪念"
        },
        {
          "time": 138.94,
          "text": "翻开夏夜的日记"
        },
        {
          "time": 141.55,
          "text": "字里行间的秘密"
        },
        {
          "time": 144.22,
          "text": "那页未明的心绪"
        },
        {
          "time": 146.82,
          "text": "回荡在旧梦中清晰"
        },
        {
          "time": 149.68,
          "text": "告别停留在风里"
        },
        {
          "time": 152.18,
          "text": "仍记得你熟悉的声音"
        },
        {
          "time": 155.75,
          "text": "青春像斜阳微光"
        },
        {
          "time": 158.54,
          "text": "半梦半醒半谜"
        },
        {
          "time": 184.02,
          "text": "当夕阳透过熟悉的街角"
        },
        {
          "time": 186.85,
          "text": "光影若能将回忆"
        },
        {
          "time": 189.43,
          "text": "慢慢 拉长几秒"
        },
        {
          "time": 192.05,
          "text": "胸口不安的心跳"
        },
        {
          "time": 194.69,
          "text": "不会被轻易抹掉"
        },
        {
          "time": 197.29,
          "text": "等到迟来的雨季"
        },
        {
          "time": 199.95,
          "text": "才读懂你的迟疑"
        },
        {
          "time": 202.72,
          "text": "再见夏夜的日记"
        },
        {
          "time": 205.38,
          "text": "褪去了雨后的迷"
        },
        {
          "time": 207.97,
          "text": "那页抹去的字迹"
        },
        {
          "time": 210.72,
          "text": "才明白句句都是你"
        },
        {
          "time": 213.52,
          "text": "回忆写不出结局"
        },
        {
          "time": 216.0,
          "text": "淹没风声一半的话语"
        },
        {
          "time": 219.71,
          "text": "难言难醒难再续"
        },
        {
          "time": 225.03,
          "text": "LaLaLaLa LaLaLa"
        },
        {
          "time": 231.97,
          "text": "等待日暮的倒影"
        },
        {
          "time": 234.7,
          "text": "幻作雨后的回音"
        },
        {
          "time": 237.4,
          "text": "藏在夏夜日记里"
        },
        {
          "time": 239.96,
          "text": "在梦中静静的延续"
        },
        {
          "time": 243.36,
          "text": "一半梦一半清醒"
        }
      ]
    }
  ]
}
