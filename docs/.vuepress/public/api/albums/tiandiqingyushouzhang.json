  "songs": [
    {
      "title": "傲娇少女日记",
      "file": "傲娇少女日记.lrc",
      "lyrics": [
        {
          "time": 0.57,
          "text": "曲：MiDiCat"
        },
        {
          "time": 2.99,
          "text": "词：溯回"
        },
        {
          "time": 5.31,
          "text": "绘：Tico"
        },
        {
          "time": 8.63,
          "text": "调：血焰玖蝶"
        },
        {
          "time": 11.65,
          "text": "混：DJ鱼谷"
        },
        {
          "time": 15.81,
          "text": "是 谁笨到没救"
        },
        {
          "time": 17.97,
          "text": "还用偶遇这种借口 来邂逅"
        },
        {
          "time": 23.41,
          "text": "还没 来得及开口"
        },
        {
          "time": 25.84,
          "text": "意识就悄悄出走"
        },
        {
          "time": 27.54,
          "text": "视线会在哪颗衬衣纽扣上停留"
        },
        {
          "time": 31.41,
          "text": "这 心思太沉重"
        },
        {
          "time": 33.61,
          "text": "全都藏进捕梦网中 够不够"
        },
        {
          "time": 39.12,
          "text": "还 在梦里懵懂"
        },
        {
          "time": 41.46,
          "text": "想把秘密说出口"
        },
        {
          "time": 43.16,
          "text": "你这次又会不会读懂"
        },
        {
          "time": 45.98,
          "text": "乱了步调 按捺不住紧张心跳 一切都乱套"
        },
        {
          "time": 50.49,
          "text": "搅拌着酸涩思绪在心里偷偷读秒"
        },
        {
          "time": 54.79,
          "text": "等你出现在午后小雨淋湿的街角"
        },
        {
          "time": 58.28,
          "text": "听不见窗外雨点在喧闹"
        },
        {
          "time": 78.0,
          "text": "看那 热烈聚光灯"
        },
        {
          "time": 80.4,
          "text": "烘托过分亲昵气氛 等一等"
        },
        {
          "time": 85.8,
          "text": "想问 偷跑的晚风"
        },
        {
          "time": 88.25,
          "text": "借一个使坏的吻"
        },
        {
          "time": 89.9,
          "text": "将与你有关情绪都装点到失真"
        },
        {
          "time": 93.81,
          "text": "将你我凑成我们"
        },
        {
          "time": 96.03,
          "text": "借不经意玩笑口吻 偷偷确认"
        },
        {
          "time": 101.44,
          "text": "一切恰如其分"
        },
        {
          "time": 103.86,
          "text": "脑中太灼热念头随氤氲水汽悄悄升腾"
        },
        {
          "time": 108.42,
          "text": "闭眼听见 按捺不住小鹿乱撞 心动的讯号"
        },
        {
          "time": 112.88,
          "text": "藏不住你闪烁眼底触手可及的笑"
        },
        {
          "time": 117.21,
          "text": "想尝尝你嘴角沾上橙子汽水味道"
        },
        {
          "time": 120.76,
          "text": "心情在手掌心偷偷舞蹈"
        },
        {
          "time": 125.01,
          "text": "hu~ 请你请你快醒来"
        },
        {
          "time": 128.86,
          "text": "wu~ 敲敲你榆木脑袋"
        },
        {
          "time": 132.55,
          "text": "其实这些独白也没多么重要"
        },
        {
          "time": 136.68,
          "text": "只是这烦恼"
        },
        {
          "time": 138.59,
          "text": "只想你知道"
        },
        {
          "time": 139.91,
          "text": "烦恼烦恼全给我走开"
        },
        {
          "time": 143.92,
          "text": "心思还想要留给谁猜"
        },
        {
          "time": 147.39,
          "text": "你开场白有点老套"
        },
        {
          "time": 149.91,
          "text": "开口却没有预料"
        },
        {
          "time": 152.26,
          "text": "胸口扑通直跳"
        },
        {
          "time": 155.65,
          "text": "牵着手跨过心跳喧嚣"
        },
        {
          "time": 159.49,
          "text": "秘密都让晚风它知晓"
        },
        {
          "time": 163.56,
          "text": "让情绪就暂停在这一秒"
        },
        {
          "time": 165.99,
          "text": "而我的心意"
        },
        {
          "time": 169.89,
          "text": "已无处可逃"
        }
      ]
    },
    {
      "title": "呓想",
      "file": "呓想.lrc",
      "lyrics": [
        {
          "time": 0.81,
          "text": "打开 紧闭的窗"
        },
        {
          "time": 5.29,
          "text": "想要融化 在过分柔软日光"
        },
        {
          "time": 15.99,
          "text": "曲/混：清风疾行"
        },
        {
          "time": 21.21,
          "text": "词：溯回"
        },
        {
          "time": 27.12,
          "text": "绘：曦子"
        },
        {
          "time": 32.75,
          "text": "调：不朽之言"
        },
        {
          "time": 37.79,
          "text": "抬头仰望 走失的候鸟 在何方"
        },
        {
          "time": 43.45,
          "text": "沿着那 曲折蜿蜒纹理 生长"
        },
        {
          "time": 48.84,
          "text": "徘徊兜转 已经空无一物心房"
        },
        {
          "time": 53.96,
          "text": "换季的风 吹走就被遗忘"
        },
        {
          "time": 60.27,
          "text": "在凝固的梦中徜徉"
        },
        {
          "time": 62.97,
          "text": "它轻轻安睡在昏暗无光的长廊"
        },
        {
          "time": 73.91,
          "text": "独白 随着流浪"
        },
        {
          "time": 78.28,
          "text": "堆积的意识 催化着凌乱幻想"
        },
        {
          "time": 85.0,
          "text": "残破麦田滚落下"
        },
        {
          "time": 88.98,
          "text": "色块拼凑出的意象"
        },
        {
          "time": 90.91,
          "text": "编成无谓的冗长诗行"
        },
        {
          "time": 96.27,
          "text": "冬夜 不断延长"
        },
        {
          "time": 100.43,
          "text": "借它诉说着"
        },
        {
          "time": 102.62,
          "text": "被砂砾磨砺得干涩的声嗓"
        },
        {
          "time": 107.67,
          "text": "意识瓶中摇晃"
        },
        {
          "time": 110.0,
          "text": "穿过枯败荒原悄悄造访"
        },
        {
          "time": 115.63,
          "text": "何种模样"
        },
        {
          "time": 121.14,
          "text": "瞥见落幕前的微光"
        },
        {
          "time": 124.02,
          "text": "填满那空白眼眶"
        },
        {
          "time": 126.8,
          "text": "还没消磨尽的旧时光"
        },
        {
          "time": 129.47,
          "text": "刻在透明色身体上"
        },
        {
          "time": 132.38,
          "text": "（瞥见落幕前的微光"
        },
        {
          "time": 135.06,
          "text": "填满那空白眼眶"
        },
        {
          "time": 137.6,
          "text": "还没消磨尽的旧时光"
        },
        {
          "time": 140.54,
          "text": "刻在透明色身体上）"
        },
        {
          "time": 143.23,
          "text": "冲刷到失真的回想"
        },
        {
          "time": 146.02,
          "text": "拼贴零散片段 将浮动的心点亮"
        },
        {
          "time": 154.07,
          "text": "对白 还在流浪"
        },
        {
          "time": 158.67,
          "text": "抽空了意象 卷起雪白色海浪"
        },
        {
          "time": 165.34,
          "text": "手中的青涩果实"
        },
        {
          "time": 169.26,
          "text": "装满还未成熟忧伤"
        },
        {
          "time": 171.14,
          "text": "留在那路口徘徊张望"
        },
        {
          "time": 176.54,
          "text": "冬夜 还有多长"
        },
        {
          "time": 180.75,
          "text": "向它描绘着"
        },
        {
          "time": 183.02,
          "text": "笔触下逐渐褪色的理想乡"
        },
        {
          "time": 188.1,
          "text": "期待着这一场"
        },
        {
          "time": 190.34,
          "text": "摇晃在意识溶液的远航"
        },
        {
          "time": 195.9,
          "text": "向着何方"
        }
      ]
    },
    {
      "title": "回忆随想",
      "file": "回忆随想.lrc",
      "lyrics": [
        {
          "time": 0.28,
          "text": "曲/词/调/混：Grid格子"
        },
        {
          "time": 5.57,
          "text": "绘：小鱼"
        },
        {
          "time": 11.29,
          "text": "终于有了机会"
        },
        {
          "time": 12.7,
          "text": "过去的错与对"
        },
        {
          "time": 14.21,
          "text": "那些不愿提及的也能够好好面对"
        },
        {
          "time": 17.01,
          "text": "如何苦涩的现实"
        },
        {
          "time": 18.41,
          "text": "不过被烧成灰"
        },
        {
          "time": 21.92,
          "text": "（回忆）"
        },
        {
          "time": 22.76,
          "text": "那时的天很黑"
        },
        {
          "time": 24.1,
          "text": "他们燃起的火堆"
        },
        {
          "time": 25.43,
          "text": "照亮了少年也照亮了梦寐"
        },
        {
          "time": 28.26,
          "text": "问少年何时 归 来后却告别谁"
        },
        {
          "time": 34.2,
          "text": "抬头瞥见火光"
        },
        {
          "time": 36.52,
          "text": "前方的光让他不再迷茫"
        },
        {
          "time": 40.11,
          "text": "可过往时的火"
        },
        {
          "time": 41.73,
          "text": "如今散落漫天星光"
        },
        {
          "time": 45.21,
          "text": "那是曾梦想的世界"
        },
        {
          "time": 50.91,
          "text": "所以甘心蛰伏于长夜"
        },
        {
          "time": 56.41,
          "text": "可终有一天失去了一切"
        },
        {
          "time": 62.47,
          "text": "抵达却已是新的世界"
        },
        {
          "time": 90.31,
          "text": "问少年何时归"
        },
        {
          "time": 91.8,
          "text": "的你又何时归"
        },
        {
          "time": 93.25,
          "text": "每个梦是美的无论遍地鬼魅"
        },
        {
          "time": 96.06,
          "text": "可这样醒来吧"
        },
        {
          "time": 97.56,
          "text": "无论它有多美"
        },
        {
          "time": 101.1,
          "text": "也 不过是一滴泪"
        },
        {
          "time": 103.1,
          "text": "它将我向前推"
        },
        {
          "time": 104.55,
          "text": "现实与乌托邦在身边筑起壁垒"
        },
        {
          "time": 107.4,
          "text": "是否燃尽所有我"
        },
        {
          "time": 108.84,
          "text": "就能驱散所有黑"
        },
        {
          "time": 113.8,
          "text": "那是曾梦想的世界"
        },
        {
          "time": 118.61,
          "text": "所以甘心蛰伏于长夜"
        },
        {
          "time": 124.27,
          "text": "可终有一天失去了一切"
        },
        {
          "time": 129.92,
          "text": "抵达却已是新的世界"
        }
      ]
