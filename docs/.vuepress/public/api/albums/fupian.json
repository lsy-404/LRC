  "songs": [
    {
      "title": "1 坏胎",
      "file": "1 坏胎.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "01 坏胎"
        },
        {
          "time": 1.04,
          "text": "曲 复响"
        },
        {
          "time": 1.69,
          "text": "词 沈病娇"
        },
        {
          "time": 2.44,
          "text": "绘 蛋花花花。"
        },
        {
          "time": 3.19,
          "text": "歌 星尘Minus"
        },
        {
          "time": 3.91,
          "text": "·其之壹·"
        },
        {
          "time": 4.69,
          "text": "「我已知晓犯下的罪，且不需要原谅。」"
        },
        {
          "time": 6.94,
          "text": "手指被划开  温热地灌溉  花开"
        },
        {
          "time": 12.16,
          "text": "时间堆积  泛滥成灾"
        },
        {
          "time": 18.99,
          "text": "啼哭声期待  锋利地切割  脐带"
        },
        {
          "time": 24.14,
          "text": "彻夜狂欢  坏的小孩"
        },
        {
          "time": 30.65,
          "text": "惩罚也值得喝彩  残忍也值得崇拜"
        },
        {
          "time": 36.62,
          "text": "耻辱也值得留白  肉眼中溃败"
        },
        {
          "time": 41.61,
          "text": "一天一天不知疲累"
        },
        {
          "time": 44.49,
          "text": "一点一点吞咽入胃"
        },
        {
          "time": 47.59,
          "text": "他们说  他们说纯真是罪"
        },
        {
          "time": 50.99,
          "text": "不知进退  事与愿违"
        },
        {
          "time": 54.54,
          "text": "失控的梦境中"
        },
        {
          "time": 56.61,
          "text": "浸满了爱意的柔软羊水"
        },
        {
          "time": 61.69,
          "text": "相对抑或绝对 去摧毁"
        },
        {
          "time": 66.96,
          "text": "神不会拒绝  自私的愿望  咀嚼"
        },
        {
          "time": 72.19,
          "text": "钟摆晃动  光影明灭"
        },
        {
          "time": 79.06,
          "text": "赌上你誓约  虔诚的红月  失约"
        },
        {
          "time": 84.28,
          "text": "拥抱好眠  抛弃一切"
        },
        {
          "time": 101.75,
          "text": "一天一天不知疲累"
        },
        {
          "time": 104.49,
          "text": "一点一点吞咽入胃"
        },
        {
          "time": 107.56,
          "text": "他们说  他们说纯真是罪"
        },
        {
          "time": 110.98,
          "text": "不知进退  事与愿违"
        },
        {
          "time": 114.56,
          "text": "失控的梦境中"
        },
        {
          "time": 116.63,
          "text": "浸满了爱意的柔软羊水"
        },
        {
          "time": 121.68,
          "text": "相对抑或绝对 去摧毁"
        },
        {
          "time": 129.27,
          "text": "心愿都实现  在漫长亵渎结束之前"
        },
        {
          "time": 135.26,
          "text": "我已将真理  编织成  另种谎言"
        },
        {
          "time": 141.3,
          "text": "心愿都实现  在生命重新诞下之前"
        },
        {
          "time": 147.19,
          "text": "真理本就是  谎言"
        },
        {
          "time": 153.66,
          "text": "又为何故做无谓  又如何掩饰流泪"
        },
        {
          "time": 159.58,
          "text": "又凭何欣然下坠  放任着破碎"
        },
        {
          "time": 167.76,
          "text": "一天一天不知疲累"
        },
        {
          "time": 170.59,
          "text": "一点一点吞咽入胃"
        },
        {
          "time": 173.58,
          "text": "他们说  他们说纯真是罪"
        },
        {
          "time": 176.96,
          "text": "不知进退  事与愿违"
        },
        {
          "time": 180.57,
          "text": "原始的痛觉中  扼杀和孕育"
        },
        {
          "time": 184.57,
          "text": "难定义错对"
        },
        {
          "time": 187.75,
          "text": "至此无需防备"
        },
        {
          "time": 190.78,
          "text": "「おいで。」"
        }
      ]
    },
    {
      "title": "2 标本",
      "file": "2 标本.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "02 标本"
        },
        {
          "time": 0.03,
          "text": "曲 复响"
        },
        {
          "time": 0.2,
          "text": "词 沈病娇"
        },
        {
          "time": 0.36,
          "text": "绘 蛋花花花。"
        },
        {
          "time": 0.51,
          "text": "歌 星尘Minus"
        },
        {
          "time": 0.66,
          "text": "·其之贰·"
        },
        {
          "time": 0.79,
          "text": "「每一个摇摇欲坠的梦境中，她亲眼目睹自己被推落。」"
        },
        {
          "time": 1.05,
          "text": "眼是倦的"
        },
        {
          "time": 5.81,
          "text": "心是醒的"
        },
        {
          "time": 10.15,
          "text": "手在冒汗"
        },
        {
          "time": 14.53,
          "text": "有什么"
        },
        {
          "time": 16.33,
          "text": "突然间就停了"
        },
        {
          "time": 19.97,
          "text": "让我能轻盈地"
        },
        {
          "time": 24.75,
          "text": "彻底脱离了自己"
        },
        {
          "time": 29.22,
          "text": "曾经失态的追逐沦为一个谜"
        },
        {
          "time": 49.73,
          "text": "坠落"
        },
        {
          "time": 50.82,
          "text": "下沉"
        },
        {
          "time": 53.55,
          "text": "雨水模糊光影"
        },
        {
          "time": 55.95,
          "text": "诱骗走失的鲸"
        },
        {
          "time": 58.64,
          "text": "雾状的遗憾"
        },
        {
          "time": 62.24,
          "text": "舍不得飘散"
        },
        {
          "time": 67.89,
          "text": "情绪与我无关"
        },
        {
          "time": 72.1,
          "text": "冷眼旁观"
        },
        {
          "time": 77.84,
          "text": "伪装的释然"
        },
        {
          "time": 81.57,
          "text": "也不必令谁难堪"
        },
        {
          "time": 86.52,
          "text": "就像无事发生般"
        },
        {
          "time": 91.36,
          "text": "任由伤口暗自去溃烂"
        },
        {
          "time": 101.65,
          "text": "临近涨潮前夕"
        },
        {
          "time": 106.38,
          "text": "混沌天地无边无垠"
        },
        {
          "time": 111.43,
          "text": "啊"
        },
        {
          "time": 112.34,
          "text": "就蜷缩沉溺"
        },
        {
          "time": 115.32,
          "text": "私语声"
        },
        {
          "time": 117.03,
          "text": "溶解在空气里"
        },
        {
          "time": 120.93,
          "text": "找到我的踪迹"
        },
        {
          "time": 124.33,
          "text": "不要留下痕迹"
        },
        {
          "time": 130.19,
          "text": "我们只好沉迷"
        },
        {
          "time": 133.95,
          "text": "玩这一出游戏"
        },
        {
          "time": 137.24,
          "text": "彷佛上瘾"
        },
        {
          "time": 140.87,
          "text": "认真"
        },
        {
          "time": 142.08,
          "text": "猜想"
        },
        {
          "time": 144.7,
          "text": "摧毁一切后果"
        },
        {
          "time": 147.12,
          "text": "否定所有前因"
        },
        {
          "time": 149.85,
          "text": "无数个炎夏"
        },
        {
          "time": 153.45,
          "text": "我应该在那"
        },
        {
          "time": 159.18,
          "text": "放任孤单继续"
        },
        {
          "time": 163.3,
          "text": "履行彻夜的孤单"
        },
        {
          "time": 169.02,
          "text": "沮丧很柔软"
        },
        {
          "time": 172.65,
          "text": "随呼吸爬行缓慢"
        },
        {
          "time": 177.74,
          "text": "直到这身躯学会"
        },
        {
          "time": 182.52,
          "text": "不畏惧任何残忍的勇敢"
        },
        {
          "time": 187.32,
          "text": "直到永恒都寂然"
        },
        {
          "time": 192.12,
          "text": "气泡破碎才哭喊"
        },
        {
          "time": 195.74,
          "text": "不是吗"
        }
      ]
    },
    {
      "title": "3 青黄",
      "file": "3 青黄.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "03 青黄"
        },
        {
          "time": 0.18,
          "text": "·其之叁·"
        },
        {
          "time": 0.41,
          "text": "「再多相处一会儿把，暧昧形成风暴的样子，想给你看。」"
        },
        {
          "time": 0.68,
          "text": "曲 复响"
        },
        {
          "time": 0.94,
          "text": "词 沈病娇"
        },
        {
          "time": 1.21,
          "text": "绘 蛋花花花。"
        },
        {
          "time": 1.48,
          "text": "歌 星尘Minus"
        },
        {
          "time": 2.21,
          "text": "学会用泪滴当做武器"
        },
        {
          "time": 6.89,
          "text": "(可怜兮兮)"
        },
        {
          "time": 8.62,
          "text": "舍弃愤怒  豢养一个怪物"
        },
        {
          "time": 12.88,
          "text": "猜不到谜底"
        },
        {
          "time": 17.29,
          "text": "嗯~"
        },
        {
          "time": 21.45,
          "text": "清醒着杀死残余睡意"
        },
        {
          "time": 26.19,
          "text": "(上演烂戏)"
        },
        {
          "time": 27.87,
          "text": "辗转反侧  空虚漩涡之中"
        },
        {
          "time": 32.28,
          "text": "你的眼睛"
        },
        {
          "time": 34.78,
          "text": "(天旋地转  总难免  意犹未尽)"
        },
        {
          "time": 40.35,
          "text": "然后讲述故事的原因"
        },
        {
          "time": 46.3,
          "text": "就请你好好回忆"
        },
        {
          "time": 49.44,
          "text": "难以启齿的信"
        },
        {
          "time": 53.07,
          "text": "青色苹果不合常理的甜腻"
        },
        {
          "time": 59.03,
          "text": "从无限渴慕分裂出的妒忌"
        },
        {
          "time": 66.31,
          "text": "跳舞  漂浮"
        },
        {
          "time": 72.65,
          "text": "跳舞  漂浮"
        },
        {
          "time": 79.14,
          "text": "你害我绕不过你名字"
        },
        {
          "time": 83.73,
          "text": "(透明的刺)"
        },
        {
          "time": 85.44,
          "text": "到此为止  反正早已吞咽"
        },
        {
          "time": 89.69,
          "text": "太饱和的自私"
        },
        {
          "time": 94.09,
          "text": "嗯~"
        },
        {
          "time": 98.22,
          "text": "窃喜着哼唱我的歌谣"
        },
        {
          "time": 103.01,
          "text": "(些许好笑)"
        },
        {
          "time": 104.64,
          "text": "昏庸妄想  对我哀声讨饶"
        },
        {
          "time": 108.58,
          "text": "怎么一笔勾销"
        },
        {
          "time": 111.08,
          "text": "(迷幻灯光  像绳索  窒息缠绕)"
        },
        {
          "time": 117.03,
          "text": "开始编造更完美的谎"
        },
        {
          "time": 123.01,
          "text": "只为了瞒过一切"
        },
        {
          "time": 126.2,
          "text": "耍尽所有花招"
        },
        {
          "time": 129.88,
          "text": "升腾烟圈模糊本来的面貌"
        },
        {
          "time": 135.9,
          "text": "你皱眉低头沉默也像毒药"
        },
        {
          "time": 149.07,
          "text": "穿行过"
        },
        {
          "time": 153.87,
          "text": "鲜黄的风"
        },
        {
          "time": 156.68,
          "text": "迷踪失影"
        },
        {
          "time": 161.86,
          "text": "灵与肉"
        },
        {
          "time": 166.65,
          "text": "彷佛遗留"
        },
        {
          "time": 170.6,
          "text": "上个世纪"
        },
        {
          "time": 174.68,
          "text": "开始编造更完美的谎"
        },
        {
          "time": 180.69,
          "text": "只为了瞒过一切"
        },
        {
          "time": 183.83,
          "text": "耍尽所有花招"
        },
        {
          "time": 187.46,
          "text": "升腾烟圈模糊本来的面貌"
        },
        {
          "time": 193.44,
          "text": "流着血的心想找借口动摇"
        },
        {
          "time": 200.69,
          "text": "跳舞  漂浮"
        },
        {
