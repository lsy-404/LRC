    {
      "title": "4 症结",
      "file": "4 症结.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "04 症结"
        },
        {
          "time": 0.0,
          "text": "啊是的"
        },
        {
          "time": 1.64,
          "text": "没有过一句真话"
        },
        {
          "time": 4.96,
          "text": "你乖乖听着"
        },
        {
          "time": 7.03,
          "text": "我继续说着"
        },
        {
          "time": 10.88,
          "text": "我发现"
        },
        {
          "time": 12.59,
          "text": "好爱这样的世界"
        },
        {
          "time": 16.0,
          "text": "越夸夸其谈"
        },
        {
          "time": 18.06,
          "text": "越有人追随"
        },
        {
          "time": 22.19,
          "text": "请问  请问"
        },
        {
          "time": 24.29,
          "text": "从云层坠落"
        },
        {
          "time": 26.36,
          "text": "痛不痛"
        },
        {
          "time": 27.75,
          "text": "太多面孔"
        },
        {
          "time": 29.84,
          "text": "善良疯了般失序汹涌"
        },
        {
          "time": 33.23,
          "text": "放开手  放开手"
        },
        {
          "time": 36.7,
          "text": "(温柔地  自顾自苦笑着)"
        },
        {
          "time": 38.75,
          "text": "放开手  放开手"
        },
        {
          "time": 42.24,
          "text": "(追问着  还有呢还有呢)"
        },
        {
          "time": 44.4,
          "text": "承认我做错了某些"
        },
        {
          "time": 47.46,
          "text": "承认后悔"
        },
        {
          "time": 49.37,
          "text": "悔恨处理得"
        },
        {
          "time": 51.2,
          "text": "不够干净"
        },
        {
          "time": 52.94,
          "text": "不够决绝"
        },
        {
          "time": 55.33,
          "text": "感情上无数狂热者"
        },
        {
          "time": 58.44,
          "text": "感情饥渴"
        },
        {
          "time": 60.33,
          "text": "渴望去拥有"
        },
        {
          "time": 62.23,
          "text": "不该得到"
        },
        {
          "time": 63.97,
          "text": "不该奢望"
        },
        {
          "time": 65.99,
          "text": "那总是"
        },
        {
          "time": 67.73,
          "text": "因为无可奈何的"
        },
        {
          "time": 71.21,
          "text": "用不完借口"
        },
        {
          "time": 73.2,
          "text": "便捷的愧疚"
        },
        {
          "time": 77.05,
          "text": "堆满了"
        },
        {
          "time": 78.79,
          "text": "是说廉价的伤口"
        },
        {
          "time": 82.22,
          "text": "认定的喜欢"
        },
        {
          "time": 84.31,
          "text": "认定的扑空"
        },
        {
          "time": 88.4,
          "text": "不必  不必"
        },
        {
          "time": 90.52,
          "text": "深情的目光"
        },
        {
          "time": 92.56,
          "text": "很动容"
        },
        {
          "time": 93.96,
          "text": "浮于表面"
        },
        {
          "time": 95.99,
          "text": "谁不是维持孤影自怜"
        },
        {
          "time": 99.46,
          "text": "多轻松  多轻松"
        },
        {
          "time": 102.97,
          "text": "（留给我  筛选着挑剔着）"
        },
        {
          "time": 104.98,
          "text": "多轻松  多轻松"
        },
        {
          "time": 108.47,
          "text": "（不歇业  卖力地演出中）"
        },
        {
          "time": 110.15,
          "text": "让饱胀的倾诉欲"
        },
        {
          "time": 112.93,
          "text": "一镜到底"
        },
        {
          "time": 114.65,
          "text": "有什么复杂的心思"
        },
        {
          "time": 117.89,
          "text": "伪装得像临时起意"
        },
        {
          "time": 121.22,
          "text": "我恶作剧的嫌隙"
        },
        {
          "time": 123.94,
          "text": "放弃清洗"
        },
        {
          "time": 125.68,
          "text": "归属在谁掌控之中"
        },
        {
          "time": 128.94,
          "text": "被赐予恶魔的姓名"
        },
        {
