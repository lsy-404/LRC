    {
      "title": "1 ЯενοιυτιοΠ",
      "file": "1 ЯενοιυτιοΠ.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "作词 : 雍雁P"
        },
        {
          "time": 0.03,
          "text": "作曲 : 雍雁P"
        },
        {
          "time": 0.06,
          "text": "编曲 : 雍雁P"
        },
        {
          "time": 0.09,
          "text": "【ft. 星尘Infinity】"
        },
        {
          "time": 0.1,
          "text": "（……这对干部是一种重新学习的极好机会）"
        },
        {
          "time": 4.84,
          "text": "（……除老弱病残者外都应这样做）"
        },
        {
          "time": 8.77,
          "text": "（……在职干部也应……）"
        },
        {
          "time": 23.66,
          "text": "这年满九岁的她"
        },
        {
          "time": 26.88,
          "text": "将世界分一分"
        },
        {
          "time": 30.17,
          "text": "电波刺向眼中的吻"
        },
        {
          "time": 33.72,
          "text": "或浪漫的纷争"
        },
        {
          "time": 37.73,
          "text": "要是没见到戈壁一抹灰云"
        },
        {
          "time": 42.25,
          "text": "那漫过锅沿的钢铁"
        },
        {
          "time": 45.81,
          "text": "要谁来尝"
        },
        {
          "time": 49.66,
          "text": "去吧我们"
        },
        {
          "time": 50.97,
          "text": "追追追追追追追追"
        },
        {
          "time": 53.96,
          "text": "被染红的左臂怎么回退"
        },
        {
          "time": 57.39,
          "text": "如果我能看见沃土千里"
        },
        {
          "time": 60.91,
          "text": "养秩序的盆栽"
        },
        {
          "time": 64.23,
          "text": "来"
        },
        {
          "time": 64.67,
          "text": "追追追追追追追追"
        },
        {
          "time": 67.53,
          "text": "钢筋水泥保暖她的信仰"
        },
        {
          "time": 71.02,
          "text": "再用一步跃进跟随希望"
        },
        {
          "time": 74.64,
          "text": "探昨日的富强"
        },
        {
          "time": 111.72,
          "text": "这地球中央避风港"
        },
        {
          "time": 115.14,
          "text": "夜空有她的智慧照亮"
        },
        {
          "time": 118.88,
          "text": "我想寻一间避风港"
        },
        {
          "time": 121.93,
          "text": "还是泡沫的空有多凉"
        },
        {
          "time": 125.71,
          "text": "青春期的她向西去矫枉"
        },
        {
          "time": 129.02,
          "text": "说这红杏是个流氓"
        },
        {
          "time": 132.43,
          "text": "有罪的不是谁的思想"
        },
        {
          "time": 135.72,
          "text": "只是隔壁那堵白墙"
        },
        {
          "time": 141.6,
          "text": "去吧我们"
        },
        {
          "time": 142.94,
          "text": "追追追追追追追追"
        },
        {
          "time": 145.87,
          "text": "追上再限时十年的颓废"
        },
        {
          "time": 149.46,
          "text": "万人共飨或李代桃僵"
        },
        {
          "time": 152.89,
          "text": "换麦芽的卑微"
        },
        {
          "time": 156.12,
          "text": "再"
        },
        {
          "time": 156.56,
          "text": "追追追追追追追追"
        },
        {
          "time": 159.44,
          "text": "配给好眼泪再想后悔"
        },
        {
          "time": 163.0,
          "text": "再用一场革命来歌颂她"
        },
        {
          "time": 166.51,
          "text": "她的洁白无瑕"
        },
        {
          "time": 183.59,
          "text": "她风华正茂满眼宏观褒奖"
        },
        {
          "time": 186.85,
          "text": "大概能和我一样"
        },
        {
          "time": 190.32,
          "text": "脐带缝好一颗子弹在手掌"
        },
        {
          "time": 193.6,
          "text": "不我发誓我没有枪"
        },
        {
          "time": 197.23,
          "text": "我发誓我没有枪"
        },
        {
          "time": 226.26,
          "text": "追追追追追追追追"
        },
        {
          "time": 229.26,
          "text": "追上她批评再附加斗嘴"
        },
        {
          "time": 232.65,
          "text": "如果今夜喜剧血液充沛"
        },
        {
          "time": 236.29,
          "text": "留时代的余晖"
        },
        {
          "time": 239.96,
          "text": "追追追追追追追追"
        },
        {
          "time": 242.91,
          "text": "追到竭力要高声赞扬"
        },
        {
          "time": 246.46,
          "text": "特色满溢再加一场疯狂"
        },
        {
          "time": 249.98,
          "text": "请给我一把枪"
        }
      ]
