    {
      "title": "人间流浪日记",
      "file": "人间流浪日记.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "人间流浪日记"
        },
        {
          "time": 2.36,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 4.56,
          "text": "作曲：苗茁、瞳荧"
        },
        {
          "time": 6.89,
          "text": "编曲：苗茁"
        },
        {
          "time": 9.1,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 11.42,
          "text": "演唱/和声：言和"
        },
        {
          "time": 13.81,
          "text": "混音：CFMing"
        },
        {
          "time": 20.7,
          "text": "记忆里最纯粹的快乐 是水上高高飞起的石头"
        },
        {
          "time": 25.22,
          "text": "击碎未来静谧的高楼 投向波光粼粼的白昼"
        },
        {
          "time": 29.72,
          "text": "小孩她无忧无愁 滑青草跌入河流"
        },
        {
          "time": 34.34,
          "text": "湍急的浪花挟裹 容不得她想回头"
        },
        {
          "time": 38.96,
          "text": "这世界 水木明瑟 疯了仙病了魔 人被欲望挫磨"
        },
        {
          "time": 43.31,
          "text": "而人们 各自奔波 为了生为了活 造了梦点了火"
        },
        {
          "time": 47.94,
          "text": "她抱紧怀中空白书册 只能 漂泊"
        },
        {
          "time": 52.48,
          "text": "任由无法赎回的旧日慢慢褪色"
        },
        {
          "time": 57.29,
          "text": "随心流浪吧 那小小的我"
        },
        {
          "time": 61.71,
          "text": "追随黎明去看那湖光山色"
        },
        {
          "time": 66.36,
          "text": "风架起藩篱 时晷挂上锁"
        },
        {
          "time": 70.96,
          "text": "枯败荆棘林 新绿正闪烁"
        },
        {
          "time": 77.85,
          "text": "可是为什么温暖会生锈 怀念要等到失去以后"
        },
        {
          "time": 82.29,
          "text": "街头艺人笑着唱歌 围观的路人要哭着听呢"
        },
        {
          "time": 86.88,
          "text": "无法决定失去或拥有 却被要求感恩和知足"
        },
        {
          "time": 91.5,
          "text": "他们亲手将星星拽落 荒诞的说是因为爱着"
        },
        {
          "time": 96.13,
          "text": "置若罔闻的是或否 发生在鳞次栉比的灯与楼"
        },
        {
          "time": 100.52,
          "text": "肩摩毂击的去或留 谱写着殊途同归的苦与愁"
        },
        {
          "time": 105.18,
          "text": "阳光穿过云层将世界晒透 刺鸟在历史扉页上唱歌"
        },
        {
          "time": 109.76,
          "text": "莺飞草长的人间百般萧索 我们一路颠沛无处可躲"
        },
        {
          "time": 114.55,
          "text": "众人的簇拥 缭乱鲜花丛 无法掩盖腐烂的魂魄"
        },
        {
          "time": 118.8,
          "text": "爱令他出众 也使他平庸 直到磕磕绊绊学会取舍"
        },
        {
          "time": 123.45,
          "text": "无时不悲欢 无时不离合 除了回忆一无所有"
        },
        {
          "time": 127.89,
          "text": "拼拼凑凑 似是又有勇气继续远游"
        },
        {
          "time": 131.95,
          "text": "我和孤独牵手 不再被温暖左右"
        },
        {
          "time": 136.08,
          "text": "仍会为善意感动 却不再眷恋温柔"
        },
        {
          "time": 140.85,
          "text": "用成长交换快乐 哼不成调的小歌"
        },
        {
          "time": 145.59,
          "text": "和全宇宙擦肩 做所有人的过客"
        },
        {
          "time": 150.28,
          "text": "我和孤独牵手 将世界抛到脑后"
        },
        {
          "time": 154.55,
          "text": "永远残破的月亮 七零八落的诗歌"
        },
        {
          "time": 158.92,
          "text": "站在迟暮的黄昏 抬手拽一握星河"
        },
        {
          "time": 163.77,
          "text": "只写人间不写活着 我怕你会哭的"
        },
        {
          "time": 169.4,
          "text": "我们重逢在岁末 须臾尔尔 今又如昨"
        },
        {
          "time": 173.78,
          "text": "只是烂陈不堪的行李多了几页敝帚自珍的诗歌"
        },
        {
          "time": 178.33,
          "text": "于是孤独啊 乘上列车 奔向下一抹春色"
        },
        {
          "time": 182.86,
          "text": "请别忘了 带上完整的躯壳 和支离破碎的我"
        }
      ]
    },
