        },
        {
          "time": 79.09,
          "text": "混音：CFMing"
        },
        {
          "time": 94.06,
          "text": "春日消融于芦苇"
        },
        {
          "time": 96.85,
          "text": "齿轮声计算经纬"
        },
        {
          "time": 99.38,
          "text": "扫去上世纪残卷上厚重尘灰"
        },
        {
          "time": 105.34,
          "text": "宇宙坍缩成一枚"
        },
        {
          "time": 108.21,
          "text": "文明抖落长雀尾"
        },
        {
          "time": 110.86,
          "text": "遗忘的角落里谁还固执等待着谁"
        },
        {
          "time": 116.35,
          "text": "晴空落泪 日光败退"
        },
        {
          "time": 119.09,
          "text": "裁决者为世界立墓碑"
        },
        {
          "time": 122.0,
          "text": "群星陨落着祭奠旧日不落余晖"
        },
        {
          "time": 127.68,
          "text": "阳光枯萎 黑暗低垂"
        },
        {
          "time": 130.48,
          "text": "冰霜笼罩土壤 巨龙低鸣演蜕 （时间推动星辉）"
        },
        {
