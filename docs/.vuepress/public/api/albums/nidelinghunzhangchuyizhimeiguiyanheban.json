        },
        {
          "time": 149.93,
          "text": "霜雪冻结爱与罪"
        },
        {
          "time": 152.78,
          "text": "岁月轮回"
        },
        {
          "time": 155.51,
          "text": "光芒黯淡仍追随"
        },
        {
          "time": 158.31,
          "text": "星河盈满花卉"
        },
        {
