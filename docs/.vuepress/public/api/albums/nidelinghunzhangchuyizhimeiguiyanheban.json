    {
      "title": "为什么我们如此忌讳提起死亡",
      "file": "为什么我们如此忌讳提起死亡.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "为什么我们如此忌讳提起死亡"
        },
        {
          "time": 0.1,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 0.2,
          "text": "作曲/编曲：CFMing"
        },
        {
          "time": 0.3,
          "text": "混音：CFMing"
        },
        {
          "time": 0.4,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 0.5,
          "text": "演唱/和声：言和"
        },
        {
          "time": 0.6,
          "text": "吉他：CFMing"
        },
        {
          "time": 0.7,
          "text": "和声编写：烂兔子"
        },
        {
          "time": 1.59,
          "text": "为什么我们如此忌讳提起死亡"
        },
        {
          "time": 5.08,
          "text": "为什么我们将痛苦归咎于成长"
        },
        {
          "time": 7.93,
          "text": "为什么吝啬表达爱 却任恶意飞扬"
        },
        {
          "time": 13.41,
          "text": "为什么人们避让残暴 苛刻善良"
        },
        {
          "time": 16.29,
          "text": "为什么拒绝被定义还模式化生长"
        },
        {
          "time": 19.37,
          "text": "为什么世界跟课本里讲的不一样"
        },
        {
          "time": 36.17,
          "text": "我似乎总喜欢沉浸突如其来的悲伤"
        },
        {
          "time": 39.25,
          "text": "疑问喜欢在夜深人静时疯长"
        },
        {
          "time": 41.74,
          "text": "或许都怪 此刻引起潮汐反应的月亮"
        },
        {
          "time": 47.37,
          "text": "想这一生砸入深海 推起过寥寥波浪"
        },
        {
          "time": 50.29,
          "text": "称不上平庸 也算不上什么天才模样"
        },
        {
          "time": 53.15,
          "text": "却也不知天高地厚 妄问俗常"
        },
        {
          "time": 58.8,
          "text": "幼时 懵懂 好奇存在与消亡"
        },
        {
          "time": 61.63,
          "text": "万物 周而复始规律生长"
        },
        {
          "time": 64.39,
          "text": "年少无畏 质疑悖论与思想"
        },
        {
          "time": 67.23,
          "text": "规则 潜移默化 逻辑 换柱偷梁"
        },
        {
          "time": 70.03,
          "text": "为什么我们如此忌讳提起死亡"
        },
        {
          "time": 72.83,
          "text": "是因为害怕人们争先恐后模仿"
        },
        {
          "time": 75.67,
          "text": "可如果生活足够幸福 我怎么会畅想"
        },
        {
          "time": 78.49,
          "text": "大声呐喊是我对痛苦情绪的典当"
        },
        {
          "time": 81.36,
          "text": "所以啊我们何必忌讳提起死亡"
        },
        {
          "time": 84.05,
          "text": "归根结底勇气和胆怯对峙称量"
        },
        {
          "time": 86.92,
          "text": "让眼泪尽情流淌 让情绪痛快释放"
        },
        {
          "time": 90.0,
          "text": "做个异类怪物也无妨 任他笑疯狂"
        },
        {
          "time": 116.66,
          "text": "这个世界自诩自私的人总是最善良"
        },
        {
          "time": 119.79,
          "text": "自诩冷漠的人又最容易受伤"
        },
        {
          "time": 122.2,
          "text": "柔软必须用言语包装 才敢冠冕堂皇"
        },
        {
          "time": 127.92,
          "text": "做个白日梦 畅想某个未来扬名一方"
        },
        {
          "time": 130.67,
          "text": "其实宇宙浩渺无极 没人在乎我模样"
        },
        {
          "time": 133.55,
          "text": "那又干嘛非要遵循 这条条框框"
        },
        {
          "time": 139.19,
          "text": "后来 摆烂 放纵本质与现象"
        },
        {
          "time": 142.06,
          "text": "一切 随俗浮沉 不辩不抢"
        },
        {
          "time": 144.91,
          "text": "现在重新 捡起困惑与主张"
        },
        {
          "time": 147.66,
          "text": "我们被情感支配 双标理所应当"
        },
        {
          "time": 150.56,
          "text": "为什么我们如此忌讳提起死亡"
        },
        {
          "time": 153.27,
          "text": "是因为害怕人们争先恐后模仿"
        },
        {
          "time": 156.02,
          "text": "可如果生活足够幸福 我怎么会畅想"
        },
        {
          "time": 158.89,
          "text": "大声呐喊是我对痛苦情绪的典当"
        },
        {
          "time": 161.79,
          "text": "所以啊我们何必忌讳提起死亡"
        },
        {
          "time": 164.5,
          "text": "归根结底勇气和胆怯对峙称量"
        },
        {
          "time": 167.47,
          "text": "让眼泪尽情流淌 让情绪痛快释放"
        },
        {
          "time": 170.54,
          "text": "做个异类怪物也无妨 任他笑疯狂"
        },
        {
          "time": 175.33,
          "text": "我们总无法抑制恐惧死亡"
        },
        {
          "time": 179.49,
          "text": "我们大多痛苦源自成长"
        },
        {
          "time": 185.63,
          "text": "我们总令爱我们的人受伤"
        },
        {
          "time": 188.78,
          "text": "我们谀媚残暴辜负善良"
        },
        {
          "time": 191.23,
          "text": "我们做得糟糕说得漂亮"
        },
        {
          "time": 195.87,
          "text": "我们一遍遍重复想要死亡"
        },
        {
          "time": 201.35,
          "text": "偏偏还固执相信爱与理想"
        },
        {
          "time": 206.45,
          "text": "为什么我们如此忌讳提起死亡"
        },
        {
          "time": 209.69,
          "text": "是因为害怕人们争先恐后模仿"
        },
        {
          "time": 212.47,
          "text": "可如果生活足够幸福 我怎么会畅想"
        },
        {
          "time": 215.34,
          "text": "大声呐喊是我对痛苦情绪的典当"
        },
        {
          "time": 218.37,
          "text": "所以啊我们何必忌讳提起死亡"
        },
        {
          "time": 221.0,
          "text": "尝试拥抱自己 学会放任悲伤"
        },
        {
          "time": 223.8,
          "text": "这一程跌跌撞撞 魂魄遍体鳞伤"
        },
        {
          "time": 226.99,
          "text": "明天无所谓什么样 何必顾忌如何收场"
        }
      ]
