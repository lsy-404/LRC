    {
      "title": "上世纪残卷",
      "file": "上世纪残卷.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "星辰破碎"
        },
        {
          "time": 3.28,
          "text": "黄昏怒放后枯萎"
        },
        {
          "time": 6.09,
          "text": "时之轮拉下幕帷"
        },
        {
          "time": 8.76,
          "text": "霜雪冻结爱与罪"
        },
        {
          "time": 11.72,
          "text": "风信消退"
        },
        {
          "time": 14.54,
          "text": "王权者弋窃玫瑰"
        },
        {
          "time": 17.24,
          "text": "诗歌吟诵了千百回"
        },
        {
          "time": 20.03,
          "text": "灵魂永不可赎回"
        },
        {
          "time": 23.54,
          "text": "黎明囿囚于墙围"
        },
        {
          "time": 26.23,
          "text": "纯真炽热且深邃"
        },
        {
          "time": 28.81,
          "text": "若希望的翅膀也被心脏染黑"
        },
        {
          "time": 34.68,
          "text": "巨龙会祭献年岁"
        },
        {
          "time": 37.58,
          "text": "与他的神明相会"
        },
        {
          "time": 40.43,
          "text": "深渊下白骨缝隙间绽出蓝色花蕊"
        },
        {
          "time": 45.82,
          "text": "晴空落泪 日光败退"
        },
        {
          "time": 48.63,
          "text": "温柔就良善吞服伤悲"
        },
        {
          "time": 51.52,
          "text": "苍鹭衔着王冠觊觎那最后余晖"
        },
        {
          "time": 57.02,
          "text": "生命衰颓 干涸泉水"
        },
        {
