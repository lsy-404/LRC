          "time": 0.25,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 0.5,
          "text": "作曲/编曲：西门振"
        },
        {
          "time": 0.75,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 1.0,
          "text": "演唱：言和"
        },
        {
          "time": 1.25,
          "text": "和声：洛天依、言和、乐正绫、乐正龙牙、徵羽摩柯、墨清弦"
        },
        {
          "time": 1.5,
          "text": "吉他：疯疯疯哥有节操"
        },
        {
          "time": 1.75,
          "text": "混音：CFMing"
        },
        {
          "time": 2.49,
          "text": "时光匆匆离我而去 牢笼一瞬倾塌"
        },
        {
          "time": 7.58,
          "text": "星空 遥远至极 伸手便到达"
        },
        {
          "time": 12.96,
          "text": "风吹过 云坠 雨落下 草木生新芽"
        },
        {
          "time": 18.15,
          "text": "是我正在同你告别呀"
        },
        {
          "time": 34.01,
          "text": "阳光填充无限大 破烂身躯早已无法再容纳"
        },
        {
          "time": 39.28,
          "text": "不必劳神费力去隐藏 反复霉变的伤疤"
        },
        {
          "time": 44.59,
          "text": "我们在回忆里相聚 而灵魂在遗忘后自由潇洒"
        },
        {
          "time": 49.66,
          "text": "倒挂在游云的尾巴 偷浇湿一片叶 摘最爱一朵花"
        },
        {
          "time": 54.79,
          "text": "撞入了东方 用大密度的孤独换晚霞"
        },
        {
          "time": 59.94,
          "text": "用力投掷给过去 冻结泥泞沼泽才好出发"
        },
        {
          "time": 65.17,
          "text": "时光列车它慢慢走 只有我倒步伐"
        },
        {
          "time": 70.42,
          "text": "揉皱 恬谧的冬 开烂漫的夏"
        },
        {
          "time": 75.53,
          "text": "岁月啊 涂抹过往纷杂 一切会放下"
        },
        {
          "time": 80.81,
          "text": "如果恰好想起我 不如笑一笑吧"
        },
        {
          "time": 86.0,
          "text": "生命是仅一次的冒险 爱恨都勇敢吧"
        },
        {
          "time": 90.98,
          "text": "真诚且热烈地活着 让离开装聋作哑"
        },
        {
          "time": 96.53,
          "text": "阳光撞碎缱绻云雾 明日遍布繁花"
        },
        {
          "time": 101.68,
          "text": "向昨日鞠躬 赴我的天涯"
        },
        {
          "time": 117.56,
          "text": "拂晓能否快走几下 别让我的朋友在长夜哭啦"
        },
        {
          "time": 122.75,
          "text": "亲爱的 请你放心吧 我走向死亡时 足够坦然和豁达"
        },
        {
          "time": 127.83,
          "text": "无需再害怕 和谁期望有着强烈落差"
        },
        {
          "time": 133.0,
          "text": "明天碎成玻璃渣 谁还在乎毁灭后的惩罚"
        },
        {
          "time": 138.15,
          "text": "时光匆匆离我而去 牢笼一瞬倾塌"
        },
        {
          "time": 143.32,
          "text": "星空 遥远至极 伸手便到达"
        },
        {
          "time": 148.56,
          "text": "风吹过 云坠成雨落下 草木生新芽"
        },
        {
          "time": 153.7,
          "text": "是我在另一维度 同你告别啦"
        },
        {
          "time": 159.0,
          "text": "时光列车它慢慢走 只有我倒步伐"
        },
        {
          "time": 164.26,
          "text": "揉皱 恬谧的冬 开烂漫的夏"
        },
        {
          "time": 169.42,
          "text": "岁月啊 涂抹过往纷杂 一切会放下"
        },
        {
          "time": 174.6,
          "text": "如果恰好想起我 不如笑一笑吧"
        },
        {
          "time": 179.9,
          "text": "生命是仅一次的冒险 爱恨都勇敢吧"
