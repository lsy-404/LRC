        {
          "time": 137.76,
          "text": "岁月迷失街景 偏停驻爱人坟茔"
        },
        {
          "time": 144.56,
          "text": "背靠柔软草茎 没错过群星"
        },
        {
          "time": 151.57,
          "text": "待月亮闭上眼睛 荆棘等夜莺"
        },
        {
          "time": 158.31,
          "text": "白蔷薇挂上绯色碑铭 一声长鸣"
        },
        {
          "time": 165.2,
          "text": "痛苦剥出蝴蝶 快乐无所遁形"
        },
        {
          "time": 172.38,
          "text": "我们长夜举杯 和诗歌畅饮高兴"
        },
        {
          "time": 179.3,
          "text": "风 卷起自由去往无限定"
