    {
      "title": "3 调味家",
      "file": "3 调味家.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "演唱：海伊"
        },
        {
          "time": 2.93,
          "text": "作曲&编曲：星辉P"
        },
        {
          "time": 5.99,
