          "text": "演唱：minus"
        },
        {
          "time": 4.11,
          "text": "作曲&编曲&作词&调教：Zeno"
        },
        {
          "time": 6.3,
          "text": "曲绘：QNZY"
        },
        {
          "time": 8.52,
          "text": "身侧迷雾看不清 孤声鸟语为谁鸣"
        },
        {
          "time": 12.86,
          "text": "水中涟漪因浮生 从日出直到月明"
        },
        {
          "time": 17.17,
          "text": "风中飘着谁的歌曲 盛着无果的悲喜"
        },
        {
          "time": 21.64,
          "text": "手中圆套不住无缘的心"
        },
        {
          "time": 25.71,
          "text": "啦噫呀呀噫呀啦哟喂"
        },
        {
          "time": 27.96,
          "text": "蝴蝶振翅 扑腾"
        },
        {
          "time": 31.07,
          "text": "扑腾 无数微尘"
        },
        {
          "time": 34.44,
          "text": "啦噫呀呀噫呀啦哟喂"
        },
        {
          "time": 36.76,
          "text": "情池干涸 不渡"
        },
        {
          "time": 40.11,
          "text": "不如 埋一叶莲蓬"
        },
        {
          "time": 61.14,
          "text": "林着细雨千层音 青石板路万转迷"
        },
        {
