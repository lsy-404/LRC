        },
        {
          "time": 29.63,
          "text": "广场上飞过和平鸽"
        },
        {
          "time": 33.79,
          "text": "留下神秘信件一折"
        },
        {
          "time": 37.21,
          "text": "\"小姐，请您光临做客”"
        },
        {
          "time": 40.66,
          "text": "眼前浮现奇妙光泽"
        },
        {
          "time": 44.63,
          "text": "拨开雾霭  重新染上色彩"
        },
        {
          "time": 48.1,
          "text": "小小女孩  无意造访古宅"
        },
        {
          "time": 51.68,
          "text": "提起裙摆  脚步轻轻地踩"
        },
        {
          "time": 55.1,
          "text": "噗通一摔  还好发髻没有歪"
        },
        {
          "time": 58.81,
          "text": "初来乍到的人难免有些害羞"
        },
        {
          "time": 61.76,
          "text": "就好像果味碳酸邂逅青涩的气泡酒"
        },
        {
          "time": 65.5,
          "text": "一千零一名士兵朝我投来目光考究"
        },
        {
          "time": 68.97,
          "text": "我该要  向谁呼救"
        },
        {
          "time": 71.92,
          "text": "快点跑"
        },
        {
          "time": 73.28,
          "text": "哎呀呀  扑克牌  穿过宝石走廊"
        },
        {
          "time": 76.73,
          "text": "哎呀呀  马戏团  表演即将开场"
        },
        {
          "time": 80.34,
          "text": "哒啦  哒啦  哒啦  哒啦  哒啦"
        },
        {
          "time": 84.07,
          "text": "混入人群悄悄躲藏  别声张"
        },
        {
          "time": 89.56,
          "text": "没有时间用来惆怅"
        },
        {
          "time": 92.85,
          "text": "快把勇气装进行囊"
        },
        {
          "time": 96.32,
          "text": "千万别害怕会受伤"
        },
        {
          "time": 99.93,
          "text": "一路前行才是成长"
        },
        {
          "time": 103.58,
          "text": "无名街巷  眼前白雾茫茫"
        },
        {
          "time": 107.16,
          "text": "借来星光  指引迷途方向"
        },
        {
          "time": 110.72,
          "text": "独自远航  难免遇上风浪"
        },
        {
          "time": 114.35,
          "text": "幸好还有  递来的温热手掌"
        },
        {
          "time": 117.8,
          "text": "初来乍到的人难免有些害羞"
        },
        {
          "time": 120.88,
          "text": "就好像果味碳酸邂逅青涩的气泡酒"
        },
        {
          "time": 124.46,
          "text": "一千零一夜朝夕相伴或许不算太久"
        },
        {
          "time": 127.75,
          "text": "好孩子  无需担忧"
        },
        {
          "time": 130.78,
          "text": "慢慢走"
        },
        {
          "time": 132.24,
          "text": "哎呀呀  这世界  总要去闯一闯"
        },
        {
          "time": 135.87,
          "text": "哎呀呀  牵着我  亲爱的小帽匠"
        },
        {
          "time": 139.61,
          "text": "嘟噜  嘟噜  嘟噜  嘟噜  嘟噜"
        },
        {
          "time": 143.0,
          "text": "没有目的的旅途  太疯狂"
        },
        {
          "time": 161.29,
          "text": "心慌慌"
        },
        {
          "time": 162.73,
          "text": "哎呀呀  森林里  有没有大灰狼"
        },
        {
          "time": 166.38,
          "text": "哎呀呀  吟游者  短笛配上诗行"
        },
        {
          "time": 170.12,
          "text": "滴答  滴答  滴答  滴答  滴答"
        },
        {
          "time": 173.62,
          "text": "挥挥手告别我的  幻想乡"
        }
      ]
