    {
      "title": "1 Whispering Snowflakes",
      "file": "1 Whispering Snowflakes.lrc",
      "lyrics": [
        {
          "time": 0.01,
          "text": "演唱：星尘&海伊"
        },
        {
          "time": 4.01,
          "text": "作曲&编曲：BITMAN"
        },
        {
          "time": 7.56,
          "text": "作词：大九_LM"
        },
        {
          "time": 12.47,
          "text": "（星尘）我听见窗外落雪纷纷"
        },
        {
          "time": 16.18,
          "text": "隐秘地 述说着 多情深"
        },
        {
          "time": 23.65,
          "text": "远道而来的一回殉身"
        },
        {
          "time": 27.23,
          "text": "向大地献上它真诚的亲吻"
        },
        {
          "time": 34.39,
          "text": "（海伊）我望见屋内火光炙热"
        },
        {
          "time": 38.77,
          "text": "倒映着 角落相依的恋人"
        },
        {
          "time": 45.02,
          "text": "毯下十指相扣的天真"
        },
        {
          "time": 49.85,
          "text": "还是为命运转过头噤声"
        },
        {
          "time": 55.83,
          "text": "（星尘&海伊）甜蜜的话像晶莹雪花"
