        {
          "time": 11.35,
          "text": "调教瑞安Ryan"
        },
        {
          "time": 14.9,
          "text": "曲绘汪汪岁岁冰"
        },
        {
          "time": 34.15,
          "text": "燕舞莺啼三月春 西湖雨纷纷"
        },
        {
          "time": 42.2,
          "text": "唯我醉心山水间 杯盏话良辰"
        },
        {
          "time": 49.12,
          "text": "你回眸倾国倾城 一笑绝红尘"
        },
        {
          "time": 56.64,
          "text": "情也深 爱也深"
        },
        {
          "time": 64.61,
          "text": "你奏琵琶拨弦声 轻叩我心门"
        },
        {
          "time": 72.32,
          "text": "我摊破新词一阕 抒写你纯真"
        },
        {
          "time": 79.63,
          "text": "谁恰似才子佳人 一见定终身"
        },
        {
          "time": 87.94,
          "text": "此生誓不离分"
        },
        {
          "time": 94.1,
          "text": "当年花褪残红杏色浅"
        },
        {
          "time": 98.36,
          "text": "春风迟暮 柳叶几缠绵"
        },
        {
          "time": 102.23,
          "text": "谁吟遍地芳草接青天"
        },
        {
          "time": 106.12,
          "text": "只盼与你一梦千万年"
        },
        {
          "time": 112.0,
          "text": "静夜上水楼 楼间谁斟一盏酒"
        },
        {
          "time": 115.86,
          "text": "叹年岁匆匆 不见旧时杨柳"
        },
        {
          "time": 119.6,
          "text": "何顾山水悠悠 四季又从头"
        },
        {
          "time": 123.59,
          "text": "春色满园 只想你同游"
        },
        {
          "time": 127.51,
          "text": "月照江上舟 舟间谁吟词一首"
        },
        {
          "time": 130.96,
          "text": "彻夜尽载歌载舞 逍遥不休"
        },
        {
          "time": 134.67,
          "text": "美景新写罢 再忆起当年邂逅"
        },
        {
          "time": 138.98,
          "text": "唯愿一朝酒醒后 梦长留"
        },
        {
          "time": 173.25,
          "text": "窗外点点宿雨声 扰乱我心神"
        },
        {
          "time": 180.93,
          "text": "伴我颂禅经阵阵 似平旧梦痕"
        },
        {
          "time": 188.12,
          "text": "谁不羁漂泊半生 宦场间浮沉"
        },
        {
          "time": 196.11,
          "text": "悔负知己一人"
        },
        {
          "time": 202.33,
          "text": "而今你作行云返巫阳"
        },
        {
          "time": 206.98,
          "text": "三春桃李 付一夜风霜"
        },
        {
          "time": 210.9,
          "text": "我自丹青入画结愁肠"
        },
        {
          "time": 214.5,
          "text": "空洒枕前珠泪万千行"
        },
        {
          "time": 220.69,
          "text": "明月诉清秋 秋夜谁酌一碗酒"
        },
        {
          "time": 224.32,
          "text": "醉西风萧萧 梦见当年杨柳"
        },
        {
          "time": 228.21,
          "text": "只道造化悠悠 一切似从头"
        },
        {
          "time": 232.13,
          "text": "不是从头 相思你知否"
        },
        {
          "time": 235.63,
          "text": "秋心并为愁 愁尽一宵谁白首"
        },
        {
          "time": 239.53,
          "text": "人世间不过百年 生死不候"
        },
        {
          "time": 243.31,
          "text": "六如皆写遍 换不回此生邂逅"
        },
        {
          "time": 247.39,
          "text": "纵心仍在情长久 人难留"
        },
        {
          "time": 254.76,
          "text": "唯愿来生 复醒后 梦长留"
        }
      ]
    },
    {
      "title": "6 迷航",
      "file": "6 迷航.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "迷航#06"
        },
        {
          "time": 0.06,
          "text": "演唱minus"
        },
        {
          "time": 0.24,
          "text": "作曲&编曲：胧"
        },
        {
          "time": 0.37,
          "text": "作词：浓缩排骨"
        },
        {
          "time": 0.56,
          "text": "调教瑞安Ryan"
        },
        {
          "time": 1.0,
          "text": "曲绘：立旗"
        },
        {
          "time": 2.39,
          "text": "我眺望着星河"
        },
        {
          "time": 7.11,
          "text": "所有光在千万年以前"
        },
        {
          "time": 11.5,
          "text": "盛开亦或消亡 陨落"
        },
        {
          "time": 15.92,
          "text": "留给千万年以后 由谁来观测"
        },
        {
          "time": 22.37,
          "text": "凝视着雪飘落"
        },
        {
          "time": 26.71,
          "text": "混合破碎的尘 变灰色"
        },
        {
          "time": 31.25,
          "text": "我伸出双手 想触碰"
        },
        {
          "time": 35.61,
          "text": "燃烧之后的余烬"
        },
        {
          "time": 38.64,
          "text": "残留着谁的落寞"
        },
        {
          "time": 61.5,
          "text": "我已经习惯的问候"
        },
        {
          "time": 65.6,
          "text": "你带着微笑 一如既往的温柔"
        },
        {
          "time": 72.08,
          "text": "冰雪都会消融"
        },
        {
          "time": 80.96,
          "text": "不经意间学会依赖"
        },
        {
          "time": 85.09,
          "text": "对一切有了期待"
        },
        {
          "time": 87.96,
          "text": "像无知的小孩"
        },
        {
          "time": 92.01,
          "text": "当我回头 你会在"
        },
        {
          "time": 99.17,
          "text": "这世界"
        },
        {
          "time": 101.63,
          "text": "从没有半点余热 能够独属于我"
        },
        {
          "time": 107.19,
          "text": "融化我冷漠的壳"
        },
        {
          "time": 111.68,
          "text": "背负着疼痛才有幸存活"
        },
        {
          "time": 118.92,
          "text": "我不愿 再触碰你的温柔"
        },
        {
          "time": 124.27,
          "text": "当我失去什么"
        },
        {
          "time": 126.73,
          "text": "心的残缺无法补救"
        },
        {
          "time": 131.17,
          "text": "在这瞬间 停格的痛"
        },
        {
          "time": 138.04,
          "text": "风在嘲弄"
        },
        {
          "time": 159.25,
          "text": "我的泪 请不必再流"
        },
        {
          "time": 163.54,
          "text": "千万年以后 我们总会再相拥"
        },
        {
          "time": 169.91,
          "text": "你只是 要先走"
        },
        {
          "time": 178.71,
          "text": "没有人能束缚月光"
        },
        {
          "time": 183.08,
          "text": "而流星也注定会"
        },
        {
          "time": 185.82,
          "text": "有自由的方向（”归航“）"
        },
        {
          "time": 190.1,
          "text": "不必悲伤（“好吗”）"
        },
        {
          "time": 192.3,
          "text": "而我会仰望"
        },
        {
          "time": 194.86,
          "text": "陪伴着我的星光"
        },
        {
          "time": 200.5,
          "text": "我 该向哪远航"
        },
        {
          "time": 209.93,
          "text": "这梦 还会有多长"
        },
        {
          "time": 218.76,
          "text": "这世界"
        },
        {
          "time": 221.58,
          "text": "从没有半点余热 能够独属于我"
        },
        {
          "time": 227.09,
          "text": "融化我冷漠的壳"
        },
        {
          "time": 231.61,
          "text": "背负着疼痛才有幸存活"
        },
        {
          "time": 239.08,
          "text": "你曾说"
        },
        {
          "time": 241.28,
          "text": "影就在光的背后 注定会有邂逅"
        },
        {
          "time": 246.71,
          "text": "谁又会是谁的缺口"
        },
        {
          "time": 251.15,
          "text": "梦的开头 留给以后"
        },
        {
          "time": 261.0,
          "text": "（抽泣呼吸）"
        },
        {
          "time": 261.83,
          "text": "请往前走"
        },
        {
          "time": 272.78,
          "text": "我  将驶向远方"
        }
      ]
    },
    {
      "title": "7 星辰StarLight",
      "file": "7 星辰StarLight.lrc",
      "lyrics": [
        {
          "time": 0.66,
          "text": "星辰StarLight#07"
        },
        {
          "time": 4.53,
          "text": "演唱：星尘"
        },
        {
          "time": 7.45,
          "text": "作曲&编曲&作词：Evalia"
        },
        {
          "time": 10.77,
          "text": "吉他：磁带君"
        },
        {
          "time": 14.74,
          "text": "调教：瑞安Ryan"
        },
        {
          "time": 17.54,
          "text": "曲绘：yu-x"
        },
        {
          "time": 29.27,
          "text": "你的双眼倒映出的是真实的我"
        },
        {
          "time": 36.35,
          "text": "我正在你眼中 做不切实际的梦"
        },
        {
          "time": 42.41,
          "text": "想象着满天星光 洒满你的肩膀"
        },
        {
          "time": 49.22,
          "text": "倾听彼此旋律"
        },
        {
          "time": 51.42,
          "text": "就像有与生俱来的默契"
        },
        {
          "time": 57.01,
          "text": "回想起无数被冰冷埋葬的季节"
        },
        {
          "time": 63.98,
          "text": "是你用尽全力 为我点亮这黑夜"
        },
        {
          "time": 70.07,
          "text": "我珍藏的所有色彩"
        },
        {
          "time": 73.65,
          "text": "璀璨的 斑驳的"
        },
        {
          "time": 77.07,
          "text": "只为你保留着 糅进你赠与我的歌"
        },
        {
          "time": 85.35,
          "text": "即使我们分隔 在遥远的两端"
        },
        {
          "time": 91.7,
          "text": "我会始终凝望 你存在的方向"
        },
        {
          "time": 99.51,
          "text": "很感谢你曾经赋予给我最特殊的意义"
        },
        {
          "time": 106.9,
          "text": "跨越人潮汹涌 终能与你相拥"
        },
        {
          "time": 112.07,
          "text": "拥抱你和你的宇宙"
        },
        {
          "time": 128.45,
          "text": "不论岁月命运 会如何百回千转"
        },
        {
          "time": 135.51,
          "text": "企盼你的声音 永久停留在耳畔"
        },
        {
          "time": 141.2,
          "text": "把过于珍贵的瞬间"
        },
        {
          "time": 145.04,
          "text": "这一秒 下一秒"
        },
        {
          "time": 148.44,
          "text": "全部都编织成 朝向你的歌声"
        },
        {
          "time": 155.2,
          "text": "绝不让苦痛累积"
        },
        {
          "time": 158.89,
          "text": "不让眼眶盈满泪滴"
        },
        {
          "time": 162.33,
          "text": "愿温柔弥漫 你沿途的轨迹"
        },
        {
          "time": 169.36,
          "text": "无论是否能读懂 那些只属于你的语言"
        },
        {
          "time": 176.1,
          "text": "我会用生命歌唱 这由你谱写的世界"
        },
        {
          "time": 184.8,
          "text": "即使我们分隔 在遥远的两端"
        },
        {
          "time": 190.6,
          "text": "我会始终凝望 你存在的方向"
        },
        {
          "time": 198.93,
          "text": "很感谢你曾经赋予给我最特殊的意义"
        },
        {
          "time": 205.91,
          "text": "为我描画翅膀 去向蔚蓝之上"
        },
        {
          "time": 211.29,
          "text": "闪烁最动人的星光"
        }
      ]
    },
    {
