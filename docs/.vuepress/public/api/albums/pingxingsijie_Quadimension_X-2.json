        },
        {
          "time": 11.45,
          "text": "曲绘：大汉Jax"
        },
        {
          "time": 16.2,
          "text": "（赤羽）明月勾上弦 天外天 影流连"
        },
        {
          "time": 23.7,
          "text": "流云卷 潜入夜 问清风 求何解"
        },
        {
          "time": 31.46,
          "text": "南柯一梦间 抬望眼 旧故园"
        },
        {
          "time": 39.04,
          "text": "雨潇潇 风烈烈 竹影摇曳声不绝"
        },
        {
          "time": 46.77,
          "text": "千里长 万里远 日融冰 身披雪"
        },
        {
          "time": 54.19,
          "text": "飞尘散 不鸣蝉 思归乡 薄暮烟"
        },
        {
          "time": 61.95,
          "text": "千里长 万里远 梦吾乡 梦旧颜"
        },
        {
          "time": 69.44,
          "text": "枕残云 饮琼露 星垂野"
        },
        {
          "time": 77.51,
          "text": "云吐金 虹架天 万里潮来鲸翻"
        },
        {
          "time": 85.12,
          "text": "人间不足愁 黄鸟枕书眠"
        },
        {
          "time": 89.14,
          "text": "不见月 嫦娥还负约"
        },
        {
          "time": 93.19,
          "text": "浮朝霁 辉左界 腾光灿灿九天"
        },
        {
          "time": 100.63,
          "text": "绛云如绵 清风寻旧梦"
        },
        {
          "time": 104.76,
          "text": "好眠"
        },
        {
          "time": 138.35,
          "text": "（苍穹）吾心安故园 不可归 不可念"
        },
        {
          "time": 146.16,
          "text": "无雁处 寄心苦 不眠时 酌斗壶"
        },
        {
          "time": 154.11,
          "text": "离恨镜流年 寒日暮 孤云远"
        },
        {
          "time": 161.34,
          "text": "月初上 天欲晓 千里关山饮清夜"
        },
        {
