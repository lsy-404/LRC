    {
      "title": "张小北",
      "file": "张小北.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "张小北"
        },
        {
          "time": 1.24,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 2.0,
          "text": "作曲/编曲：斯大王"
        },
        {
          "time": 2.7,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 3.38,
          "text": "演唱：言和AI"
        },
        {
          "time": 4.0,
          "text": "和声：言和AI、言和V3"
        },
        {
          "time": 4.57,
          "text": "童声：李雨昕、瞳荧、荟小荟"
        },
        {
          "time": 5.18,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 5.82,
          "text": "母带：炑云煊"
        },
        {
          "time": 11.29,
          "text": "今天难得有空出门遛弯"
        },
        {
          "time": 13.56,
          "text": "回家路上看到一张试卷"
        },
        {
          "time": 15.93,
          "text": "它跟着风流浪不知疲倦"
        },
        {
          "time": 18.5,
          "text": "直到意外落地被我捡"
        },
        {
          "time": 21.09,
          "text": "纸面上鲜红分数有些刺眼"
        },
        {
          "time": 23.66,
          "text": "让我想起不爱学习那几年"
        },
        {
          "time": 26.16,
          "text": "名字很熟悉 家好像离得不远"
        },
        {
          "time": 28.19,
          "text": "于是我就这样贸贸然 闯入他的人间"
        },
        {
          "time": 31.41,
          "text": "姑且叫他张小北"
        },
        {
          "time": 32.99,
          "text": "小时候一起玩过几回"
        },
        {
          "time": 35.08,
          "text": "今年也已十七岁"
        },
        {
          "time": 36.44,
          "text": "勉强也算是最好年岁"
        },
        {
          "time": 40.68,
          "text": "爸爸是个好脾气的赌鬼"
        },
        {
          "time": 42.95,
          "text": "反复为自己投机取巧的想法后悔"
        },
        {
          "time": 45.68,
          "text": "妈妈在他很小的时候就离开"
        },
        {
          "time": 48.03,
          "text": "从此门前那颗枣树再没人摘"
        },
        {
          "time": 51.08,
          "text": "有个姐姐今年刚刚十八"
        },
        {
          "time": 53.13,
          "text": "早在几年前就许了人家"
        },
        {
          "time": 56.02,
          "text": "现在带着个白胖的娃娃"
        },
        {
          "time": 58.15,
          "text": "咿咿呀呀已经学会说话"
        },
        {
          "time": 61.11,
          "text": "他说也知道好好学习是我唯一办法"
        },
        {
          "time": 63.36,
          "text": "可努力过才知道有些命运早就定下"
        },
        {
          "time": 66.06,
          "text": "那些遥不可及的梦 梦里做做就得啦"
        },
        {
          "time": 68.51,
          "text": "鸡汤里找慰藉 也要看现实 我又不傻"
        },
        {
          "time": 73.51,
          "text": "也许吧 这就是故事终点"
        },
        {
          "time": 78.28,
          "text": "也许吧 人总要成熟一点"
        },
        {
          "time": 83.22,
          "text": "也许我们早就知道明天"
        },
        {
          "time": 88.4,
          "text": "却还要义无反顾的向前"
        },
        {
          "time": 93.99,
          "text": "下学期可能转上技校学点技术"
        },
        {
          "time": 96.41,
          "text": "找个好工厂三班倒着也算知足"
        },
        {
          "time": 98.84,
          "text": "稍微攒一点钱去相亲挂个媳妇"
        },
        {
          "time": 101.42,
          "text": "结婚养娃柴米油盐到人生结束"
        },
        {
          "time": 104.03,
          "text": "哪有资格谈论这样幸不幸福"
        },
        {
          "time": 106.5,
          "text": "有些选择我自己都没法做主"
        },
        {
          "time": 108.84,
          "text": "世界太多人跳不出世俗束缚"
        },
        {
          "time": 111.42,
          "text": "承受不起流言又想成为特殊"
        },
        {
          "time": 113.86,
          "text": "他问为什么你看起来比我还悲伤"
        },
        {
          "time": 119.06,
          "text": "这种人生已经算不错的模样"
        },
        {
          "time": 123.91,
          "text": "承认普通接受平庸然后随波流淌"
        },
        {
          "time": 129.2,
          "text": "成为别人故事中的稀疏平常"
        },
        {
          "time": 136.84,
          "text": "也许吧 这就是故事终点"
        },
        {
          "time": 141.49,
          "text": "也许吧 人总要成熟一点"
        },
        {
          "time": 146.49,
          "text": "也许我们早就知道明天"
        },
        {
          "time": 151.51,
          "text": "却还要义无反顾的向前"
        },
        {
          "time": 156.73,
          "text": "也许吧 这就是故事终点"
        },
        {
          "time": 161.72,
          "text": "也许吧 人总要成熟一点"
        },
        {
          "time": 166.39,
          "text": "也许我们早就知道明天"
        },
        {
          "time": 171.85,
          "text": "却还得义无反顾的向前"
        },
        {
          "time": 176.97,
          "text": "向前......"
        },
        {
          "time": 178.6,
          "text": "他的名字叫张小北"
        },
        {
          "time": 181.9,
          "text": "普普通通一小辈"
        },
        {
          "time": 184.42,
          "text": "五线城市人十七岁"
        },
        {
          "time": 186.77,
          "text": "已然看透人生结尾"
        }
      ]
    },
    {
      "title": "明安",
      "file": "明安.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "明安"
        },
        {
          "time": 1.66,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 3.21,
          "text": "作曲/编曲：烂兔子"
        },
        {
          "time": 4.7,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 6.09,
          "text": "演唱/和声：言和AI"
        },
        {
          "time": 7.34,
          "text": "口琴：笛呆子囚牛"
        },
        {
          "time": 8.71,
          "text": "童声：瞳荧"
        },
        {
          "time": 9.87,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 10.84,
          "text": "母带：炑云煊"
        },
        {
          "time": 27.27,
          "text": "追屋檐下蝴蝶 闯入田野高高谷垛"
        },
        {
          "time": 33.2,
          "text": "同孩童玩闹着 为新衣添上花一朵"
        },
        {
          "time": 39.2,
          "text": "村里伯伯给的糖 会有些奇奇怪怪的涩"
        },
        {
          "time": 44.81,
          "text": "也许这就是奶奶说 人生要吃的苦吧"
        },
        {
          "time": 51.29,
          "text": "游戏总是很快乐 如果不痛就好了"
        },
        {
          "time": 57.22,
          "text": "可也总听人叹息 不如意十有八九呢"
        },
        {
          "time": 63.21,
          "text": "月亮在催日落"
        },
        {
          "time": 65.76,
          "text": "传来呼唤声起起落落"
        },
        {
          "time": 69.96,
          "text": "“明安 明安"
        },
        {
          "time": 73.51,
          "text": "该回家吃饭咯”"
        },
        {
          "time": 75.97,
          "text": "盛夏 摇晃 烛火"
        },
        {
          "time": 80.68,
          "text": "大大蒲扇慢慢摇 蛐蛐轻些说"
        },
        {
          "time": 87.13,
          "text": "“我的明安快快睡"
        },
        {
          "time": 89.9,
          "text": "阿爸阿妈都在梦里等着"
        },
        {
          "time": 95.27,
          "text": "乖咯”"
        },
        {
          "time": 99.15,
          "text": "蓝蓝的天 盛着白云朵"
        },
        {
          "time": 105.26,
          "text": "彩虹桥通向哪儿呢"
        },
        {
          "time": 111.18,
          "text": "风铃叮当 是谁归来了"
        },
        {
          "time": 117.87,
          "text": "是远行的你咯"
        },
        {
          "time": 123.14,
          "text": "蓝蓝的天 盛着白云朵"
        },
        {
          "time": 128.9,
          "text": "花儿呀 开满了山坡"
        },
        {
          "time": 135.09,
          "text": "他们都说 一路辛苦了"
        },
        {
          "time": 142.01,
          "text": "到家好好休息吧"
        },
        {
          "time": 174.26,
          "text": "院里的老槐树 开开落落有十次了"
        },
        {
          "time": 180.34,
          "text": "爬最高的山坡 看天烧上红色的火"
        },
        {
          "time": 186.21,
          "text": "远方究竟多远呢？"
        },
        {
          "time": 188.8,
          "text": "才能够变成星星一颗"
        },
        {
          "time": 192.7,
          "text": "如果我也去了远方"
        },
        {
          "time": 194.98,
          "text": "你们回头 是否就能看到我"
        },
        {
          "time": 201.36,
          "text": "等待太过漫长 想着想着眼泪掉了"
        },
        {
          "time": 207.09,
          "text": "我猜这种感觉 应该是老人说的寂寞"
        },
        {
          "time": 213.24,
          "text": "顺着东方一直走"
        },
        {
          "time": 215.78,
          "text": "是不是就能回家咯"
        },
        {
          "time": 219.74,
          "text": "奶奶 你看"
        },
        {
          "time": 223.22,
          "text": "明安变聪明啦"
        },
        {
          "time": 225.66,
          "text": "盛夏 摇晃 灯火"
        },
        {
          "time": 230.68,
          "text": "大大的月亮坠落 车辆轻些说"
        },
        {
          "time": 236.76,
          "text": "“明安宝贝睡着了"
        },
        {
          "time": 239.71,
          "text": "奶奶你们等等我"
        },
        {
          "time": 242.49,
          "text": "明安也来咯”"
        },
        {
          "time": 249.17,
          "text": "蓝蓝的天 盛着白云朵"
        },
        {
          "time": 255.08,
          "text": "彩虹桥通向哪儿呢"
        },
        {
