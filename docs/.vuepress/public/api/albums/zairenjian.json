    {
      "title": "黎明",
      "file": "黎明.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "黎明"
        },
        {
          "time": 1.33,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 2.73,
          "text": "作曲/编曲：斯大王"
        },
        {
          "time": 3.85,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 5.15,
          "text": "演唱/和声：言和AI"
        },
        {
          "time": 6.34,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 7.53,
          "text": "母带：炑云煊"
        },
        {
          "time": 19.97,
          "text": "接电话时我刚躺下还没睡醒"
        },
        {
          "time": 24.54,
          "text": "太阳悄悄露头落下雾蒙蒙的影"
        },
        {
          "time": 29.28,
          "text": "见到她时投影仪正放着电影"
        },
        {
          "time": 33.85,
          "text": "我们俩就靠在一起聊到天明"
        },
        {
          "time": 38.86,
          "text": "她从小就漂亮"
        },
        {
          "time": 40.69,
          "text": "是邻居会羡慕的模样"
        },
        {
          "time": 43.79,
          "text": "早早确定理想"
        },
        {
          "time": 45.56,
          "text": "天南海北一个人去闯"
        },
        {
          "time": 48.29,
          "text": "少女的期待与忧愁收进行李箱"
        },
        {
          "time": 52.81,
          "text": "随一张张车票流入梦中的远方"
        },
        {
          "time": 58.49,
          "text": "她总是开心的尝试各种性格"
        },
        {
          "time": 62.66,
          "text": "尽管大多是我没听过的角色"
        },
        {
          "time": 67.34,
          "text": "诠释不同人物总能令她快乐"
        },
        {
          "time": 72.13,
          "text": "偶尔也吐槽剧情无厘头转折"
        },
        {
          "time": 77.36,
          "text": "她说近几年面试总是碰壁"
        },
        {
          "time": 79.44,
          "text": "确定好的剧组又开始延期"
        },
        {
          "time": 81.63,
          "text": "这些年杂七杂八的龙套经历"
        },
        {
          "time": 84.28,
          "text": "都变成没人看的冗长简历"
        },
        {
          "time": 86.72,
          "text": "“努力了十年从来没火过"
        },
        {
          "time": 88.89,
          "text": "也不知到底在坚持些什么"
        },
        {
          "time": 91.49,
          "text": "直到今天又被信用卡催了"
        },
        {
          "time": 93.61,
          "text": "才开始怀疑是否从未被上天眷顾过”"
        },
        {
          "time": 98.88,
          "text": "她站在群山之中等待黎明"
        },
        {
          "time": 103.25,
          "text": "天空触手可及又远如蜃景"
        },
        {
          "time": 108.21,
          "text": "周遭只剩月下被拉长的影"
        },
        {
          "time": 113.06,
          "text": "和倒映着星光闪烁的眼睛"
        },
        {
          "time": 127.97,
          "text": "她说“其实我早已经看不清楚未来"
        },
        {
          "time": 132.23,
          "text": "意气风发的离开 蓬头垢面的归来"
        },
        {
          "time": 137.46,
          "text": "也曾有想过放弃可怎么甘心失败"
        },
        {
          "time": 141.7,
          "text": "命运它不就仗着我喜欢一个劲使坏”"
        },
        {
          "time": 146.76,
          "text": "她聊到这里眼泪终于掉下来"
        },
        {
          "time": 151.37,
          "text": "我抱了抱她此刻安慰都苍白"
        },
        {
          "time": 156.39,
          "text": "因为我也解不出现实和热爱"
