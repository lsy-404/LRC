    {
      "title": "小贩",
      "file": "小贩.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "小贩"
        },
        {
          "time": 2.05,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 3.63,
          "text": "作曲/编曲：斯大王"
        },
        {
          "time": 4.82,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 5.92,
          "text": "演唱/和声：言和AI"
        },
        {
          "time": 7.11,
          "text": "吉他：litterzy"
        },
        {
          "time": 8.26,
          "text": "小提琴：庞阔"
        },
        {
          "time": 9.61,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 11.19,
          "text": "母带：炑云煊"
        },
        {
          "time": 18.97,
          "text": "见过夏日新生的晖和冬日凛冽的风"
        },
        {
          "time": 22.46,
          "text": "也别过扫街的阿姨和捡垃圾的老翁"
        },
        {
          "time": 25.8,
          "text": "稀稀疏疏的道路 逐渐鼎沸人潮声"
        },
        {
          "time": 28.94,
          "text": "明月缺了圆圆了缺 老树枯了叶红了枫"
        },
        {
          "time": 32.51,
          "text": "人间漂泊的人难免有些磕磕碰碰"
        },
        {
          "time": 35.67,
          "text": "为了心中的柔软不叫苦也不喊疼"
        },
        {
          "time": 38.8,
          "text": "盼望远方的人踏上属于他的征程"
        },
        {
          "time": 42.0,
          "text": "就算点在明日的灯 会击溃昨日的梦"
        },
        {
          "time": 45.02,
          "text": "无人在意的角落藏着太多无人知的牺牲"
        },
        {
          "time": 51.01,
          "text": "诗人赞颂的伟大总能在最最平庸中相逢"
        },
        {
          "time": 57.34,
          "text": "艺术家们寻求的浪漫其实叫做普通"
        },
        {
          "time": 63.82,
          "text": "在每一丝寻常里浑然天成"
        },
        {
          "time": 71.02,
          "text": "粗糙的掌 皲裂的纹 和衣而睡的清晨"
        },
        {
          "time": 77.16,
          "text": "肆虐的雪 忙碌的影 斑驳陆离的年轮"
        },
        {
          "time": 84.29,
          "text": "跌落黄昏 埋入曾经 无忧无虑的青春"
        },
        {
          "time": 90.68,
          "text": "不是能被看到的苦才叫做众生"
        },
        {
          "time": 113.27,
          "text": "熬过春日挣出的绿和秋日晕开的虹"
        },
        {
          "time": 116.81,
          "text": "慢慢悠悠的小镇闯入行色匆匆的城"
        },
        {
          "time": 120.16,
          "text": "兵荒马乱的街道 喧闹后归于寂静"
        },
        {
          "time": 123.15,
          "text": "衣服新了旧旧了新 缝缝补补又过一冬"
        },
        {
          "time": 126.91,
          "text": "被定义的英雄、平凡、伟大只是虚称"
        },
        {
          "time": 129.97,
          "text": "不是只有奉献与爱才值得被歌颂"
        },
        {
          "time": 133.17,
          "text": "有时渺小与认命也是另一种英勇"
        },
        {
          "time": 136.36,
          "text": "因为能够发声的人 往往无法代表大众"
        },
        {
          "time": 139.3,
          "text": "那些因习惯而不起眼容易被忽略的感动"
        },
        {
          "time": 145.35,
          "text": "一无所有偏保留着对生活最真挚的虔诚"
        },
        {
          "time": 151.79,
          "text": "他们囿囚于泥潭仍有骄傲藏在心中"
        },
        {
          "time": 158.04,
          "text": "一点一点积存着 直至某日飞向苍穹"
        },
        {
          "time": 163.97,
          "text": "粗糙的掌 皲裂的纹 和衣而睡的清晨"
        },
        {
          "time": 170.07,
          "text": "肆虐的雪 忙碌的影 斑驳陆离的年轮"
        },
        {
          "time": 177.03,
          "text": "跌落黄昏 埋入曾经 无忧无虑的青春"
        },
        {
          "time": 183.38,
          "text": "不是能被看到的苦才叫做众生"
        },
        {
          "time": 215.15,
          "text": "粗糙的掌 皲裂的纹 和衣而睡的清晨"
