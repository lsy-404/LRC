    {
      "title": "大山",
      "file": "大山.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "大山"
        },
        {
          "time": 2.84,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 5.34,
          "text": "作曲/编曲：烂兔子"
        },
        {
          "time": 7.53,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 8.96,
          "text": "演唱/和声：言和AI"
        },
        {
          "time": 9.93,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 11.26,
          "text": "母带：炑云煊"
        },
        {
          "time": 28.96,
          "text": "浮云如朝露"
        },
        {
          "time": 31.77,
          "text": "窗间过白马"
        },
        {
          "time": 35.24,
          "text": "硕果压弯枝桠"
        },
        {
          "time": 38.14,
          "text": "雀鸟留此做家"
        },
        {
          "time": 41.5,
          "text": "后来有了人家"
        },
        {
          "time": 44.4,
          "text": "还会赶牛放鸭"
        },
        {
          "time": 47.4,
          "text": "坊间 袅袅炊烟 托起傍晚云霞"
        },
        {
          "time": 54.36,
          "text": "最早参军的那个少年"
        },
        {
          "time": 57.61,
          "text": "样子早记不清啦"
        },
        {
          "time": 60.59,
          "text": "等到山下挂白纱"
        },
        {
          "time": 62.5,
          "text": "飘到山上被兔子带回家"
        },
        {
          "time": 66.98,
          "text": "有个路过的老人家"
        },
        {
          "time": 70.23,
          "text": "喜欢咬文嚼字说风雅"
        },
        {
          "time": 73.27,
          "text": "望着月一夜白了头发"
        },
        {
          "time": 76.58,
          "text": "喂了蚊子一茬又一茬"
        },
        {
          "time": 80.29,
          "text": "大山不懂爱啊恨啊"
        },
        {
          "time": 83.01,
          "text": "什么贪呀欲呀 其实都无差"
        },
        {
          "time": 86.1,
          "text": "乏了倦了合眼便睡去罢"
        },
        {
          "time": 89.38,
          "text": "谁知睁眼又是谁的天下"
        },
        {
          "time": 94.31,
          "text": "送冬又入夏 落叶后又生新芽"
        },
        {
          "time": 100.45,
          "text": "云送小雨惊泥巴 扰醒蘑菇花"
        },
        {
          "time": 106.41,
          "text": "林间霜雪打 岁月里谁去谁留下"
        },
        {
          "time": 112.82,
          "text": "朝赶暮走自成一方天涯"
        },
        {
          "time": 131.92,
          "text": "每日都来眺望的娃娃"
        },
        {
          "time": 134.97,
          "text": "望到月亮高高挂"
        },
        {
          "time": 138.06,
          "text": "直到熟悉的他"
        },
        {
          "time": 139.68,
          "text": "坐上陌生的车 笑得有点傻"
        },
        {
          "time": 144.42,
          "text": "开心说要离开大山"
        },
        {
          "time": 147.72,
          "text": "找那去了远方的爸妈"
        },
        {
          "time": 150.84,
          "text": "很久很久以后"
        },
        {
          "time": 152.42,
          "text": "他离开的地方 新开了一束花"
        },
        {
          "time": 157.6,
          "text": "大山不懂离啊愁啊"
        },
        {
          "time": 160.42,
          "text": "什么思呀念呀 其实都无差"
        },
        {
          "time": 163.83,
          "text": "顶多偶尔放空时会长出一棵草或开上一朵花"
        },
        {
          "time": 171.76,
          "text": "送冬又入夏 落叶后又生新芽"
        },
        {
          "time": 177.89,
          "text": "云送小雨惊泥巴 扰醒蘑菇花"
        },
        {
          "time": 183.95,
          "text": "林间霜雪打 岁月里谁去谁留下"
        },
        {
          "time": 190.22,
          "text": "朝赶暮走自成一方天涯"
        },
        {
          "time": 195.93,
          "text": "送冬又入夏 落叶后又生新芽"
        },
        {
          "time": 201.84,
          "text": "云送小雨惊泥巴 扰醒蘑菇花"
        },
        {
