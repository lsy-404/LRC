  "songs": [
    {
      "title": "化风",
      "file": "化风.lrc",
      "lyrics": [
        {
          "time": 1.0,
          "text": "我终如风随心奔向云霭"
        },
        {
          "time": 6.62,
          "text": "脱于樊笼之间 奔向天地之外"
        },
        {
          "time": 14.01,
          "text": "化风"
        },
        {
          "time": 15.25,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 16.19,
          "text": "作曲/编曲：烂兔子"
        },
        {
          "time": 17.23,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 17.74,
          "text": "演唱/和声：言和AI"
        },
        {
          "time": 18.27,
          "text": "吉他：烂兔子"
        },
        {
          "time": 18.54,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 18.92,
          "text": "母带：炑云煊"
        },
        {
          "time": 20.07,
          "text": "第一缕风 停留林深抚叶摇摆"
        },
        {
          "time": 25.63,
          "text": "听雨洗尘 森林焕新色彩"
        },
        {
          "time": 31.1,
          "text": "山河织络 自然于此抽枝生脉"
        },
        {
          "time": 36.91,
          "text": "优胜劣汰 长过数千万载"
        },
        {
          "time": 42.44,
          "text": "第二缕风 掠过极地扬雪纷白"
        },
        {
          "time": 47.85,
          "text": "粒子涣散 夜空缀粉添黛"
        },
        {
          "time": 53.52,
          "text": "晨昏交叠 时光于此悄然停摆"
        },
        {
          "time": 58.94,
          "text": "海岸线震荡 缝入无极海"
        },
        {
          "time": 64.82,
          "text": "若能如风随心奔向云霭"
        },
        {
          "time": 70.21,
          "text": "奈何困于樊笼 梦远在天地外"
        },
        {
          "time": 75.94,
          "text": "只有自我感怀 只好惺惺作态"
        },
        {
          "time": 81.3,
          "text": "看他们固执己见歌颂称“爱”"
        },
        {
          "time": 121.11,
          "text": "第三缕风 漫步平原青环草带"
        },
        {
          "time": 126.79,
          "text": "御光驰骋 大地潇洒荡骀"
        },
        {
          "time": 132.34,
          "text": "日升月降 生命于此降猝逾迈"
        },
        {
          "time": 138.22,
          "text": "生死定成败 亘古不曾改"
        },
        {
          "time": 143.4,
          "text": "第四缕风 击落浪花沉入深海"
        },
        {
          "time": 148.89,
          "text": "寂静长鸣 黑暗流光溢彩"
        },
        {
          "time": 154.73,
          "text": "潮汐碰撞 传奇于此只是常态"
        },
        {
          "time": 160.06,
          "text": "昼夜一口吞 并入万星台"
        },
        {
          "time": 166.03,
          "text": "灵魂如风随心奔向云霭"
        },
        {
          "time": 171.31,
          "text": "困于樊笼之中 梦在天地之外"
        },
        {
          "time": 177.09,
          "text": "只有朽骨烂骸 只能居安佯败"
        },
        {
          "time": 182.26,
          "text": "待某日化风去再入星坠海"
        },
        {
          "time": 188.32,
          "text": "我终如风随心奔向云霭"
        },
        {
          "time": 193.08,
          "text": "脱于樊笼之间 奔向天地之外"
        },
        {
          "time": 199.16,
          "text": "褪去浊骨凡胎 舍弃朽骨烂骸"
        },
        {
          "time": 204.47,
          "text": "于某日化风去定入星坠海"
        }
      ]
    },
    {
      "title": "在人间",
      "file": "在人间.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "在人间"
        },
        {
          "time": 3.08,
          "text": "制作人/作词：瞳荧"
        },
        {
          "time": 4.29,
          "text": "作曲/编曲：斯大王"
        },
        {
          "time": 5.81,
          "text": "调校：纳兰寻风"
        },
        {
          "time": 7.16,
          "text": "演唱/和声：言和AI、言和V3"
        },
        {
          "time": 8.38,
          "text": "混音：沈钰博、烂兔子"
        },
        {
          "time": 9.64,
          "text": "母带：炑云煊"
        },
        {
          "time": 20.56,
          "text": "这一路走了很久很久"
        },
        {
          "time": 25.4,
          "text": "走到少年老 走到年轮旧"
        },
        {
          "time": 30.47,
          "text": "梦结束在街口 或绽放枝头"
        },
        {
          "time": 34.93,
          "text": "星月还在 只有云悠悠"
        },
        {
          "time": 40.27,
          "text": "这一路好像没走太久"
        },
        {
          "time": 44.8,
          "text": "情感没腐朽 回忆没生锈"
        },
        {
          "time": 49.98,
          "text": "距意气斥方遒 没几个春秋"
        },
        {
          "time": 54.64,
          "text": "怎么能走到厌倦以后"
        },
        {
          "time": 59.71,
          "text": "赶公交的青年不喜不忧"
        },
        {
          "time": 64.52,
          "text": "拖行李的姑娘不甘泪流"
        },
        {
          "time": 69.29,
          "text": "拐角处的商贩忙碌整宿"
        },
        {
          "time": 74.13,
          "text": "活下去从来不需任何理由"
        },
        {
          "time": 82.62,
          "text": "你在人间走一走"
        },
        {
          "time": 84.99,
          "text": "（有温暖也有寒流）"
        },
        {
          "time": 87.2,
          "text": "为何奔波为何停留"
        },
        {
          "time": 89.75,
          "text": "（是生活亦是所求）"
        },
        {
          "time": 92.79,
          "text": "熬过苦累悲痛迷茫不必再深究"
        },
        {
          "time": 97.39,
          "text": "你的存在你的意义因爱或被爱而不朽"
        },
        {
          "time": 102.29,
          "text": "在人间走一走"
        },
        {
          "time": 104.88,
          "text": "（从婴提走到白头）"
        },
        {
          "time": 106.66,
          "text": "理想与梦是烂借口"
        },
        {
          "time": 109.64,
          "text": "（一直前行便足够）"
        },
        {
          "time": 112.08,
          "text": "我见过人情狠厉与旷世温柔"
        },
        {
          "time": 117.01,
          "text": "都不及你最初望入人间时的清澈眼眸"
        },
        {
          "time": 128.1,
          "text": "这一路也许跌撞太久"
        },
        {
          "time": 133.01,
          "text": "邂逅一丝甜 痛才被感受"
        },
        {
          "time": 138.04,
          "text": "苦难有了缺口 幸福才写就"
        },
        {
          "time": 142.44,
          "text": "向镜里自己挥手 如同老友"
        },
        {
          "time": 147.92,
          "text": "被囚困的生物没收自由"
        },
        {
          "time": 152.61,
          "text": "傻笑着的孩童睡在土楼"
        },
        {
          "time": 157.85,
          "text": "斑驳了的大山守着星宿"
        },
        {
          "time": 162.4,
          "text": "如日复日沉默转动的地球"
        },
        {
          "time": 170.75,
          "text": "你在人间走一走"
        },
        {
          "time": 173.13,
          "text": "（有温暖也有寒流）"
        },
        {
          "time": 175.38,
          "text": "为何奔波为何停留"
        },
        {
          "time": 177.93,
          "text": "（是生活亦是所求）"
        },
        {
          "time": 180.91,
          "text": "熬过苦累悲痛迷茫不必再深究"
        },
        {
