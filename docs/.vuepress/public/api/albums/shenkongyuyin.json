    {
      "title": "5 Revolt.Rain",
      "file": "5 Revolt.Rain.lrc",
      "lyrics": [
        {
          "time": 1.1,
          "text": "漫无目的 徘徊落雨的街头"
        },
        {
          "time": 3.82,
          "text": "追逐的远梦 消逝夜空深处"
        },
        {
          "time": 6.78,
          "text": "阴云密布 来去影痕都匆匆"
        },
        {
          "time": 9.5,
          "text": "在迷城 独自沉沦漂流"
        },
        {
          "time": 14.12,
          "text": "Revolt.Rain"
        },
        {
          "time": 15.5,
          "text": "作编曲：云极"
        },
        {
          "time": 16.94,
          "text": "作词：Kevinz"
        },
        {
          "time": 18.33,
          "text": "调教：Creuzer"
        },
        {
          "time": 23.97,
          "text": "嘈杂的乐声 青红皂白无来由"
        },
        {
          "time": 28.89,
          "text": "侵蚀我的体肤 如同窃笑的蛀虫"
        },
        {
          "time": 35.26,
          "text": "浮躁的偶像 眼耳鼻舌身 如出一辙庸碌"
        },
        {
          "time": 40.27,
          "text": "流水线上 擦不出 新的火种"
        },
        {
          "time": 46.4,
          "text": "彷徨到不知所踪"
        },
        {
          "time": 48.86,
          "text": "痉挛般的低吼 在远处"
        },
        {
          "time": 52.06,
          "text": "仿若引信 为我指路 到尽头"
        },
        {
          "time": 57.54,
          "text": "逃出普罗众生缄默的囚笼"
        },
        {
          "time": 60.39,
          "text": "漆黑的利刃 淬着反逆的火"
        },
        {
          "time": 63.23,
          "text": "醒在琴弦边缘 声嘶力竭的歌"
        },
        {
          "time": 66.04,
          "text": "锋利地溢出了星河"
        },
        {
          "time": 68.89,
          "text": "击出娑婆世界淋漓的弹孔"
        },
        {
          "time": 71.65,
          "text": "失真的瀑布 汇成离岸流"
        },
        {
          "time": 75.82,
          "text": "共振每次呼吸"
        },
        {
          "time": 77.18,
          "text": "开浪劈波 纵横狂乱风球中"
        },
        {
          "time": 82.6,
          "text": "一度动摇我的 是什么缘由"
        },
        {
          "time": 88.2,
          "text": "呼唤杳无音信 也成为伤痛"
        },
        {
          "time": 93.86,
          "text": "从那天 这万籁俱寂 荒芜的围城 便容不下你我"
        },
        {
          "time": 99.58,
          "text": "跌跌撞撞 行将被黑潮淹没"
        },
        {
          "time": 128.26,
          "text": "迎着雨声仰起头"
        },
        {
          "time": 130.8,
          "text": "黎明藏在雷声的背后"
        },
        {
          "time": 133.91,
          "text": "旧的痕迹 也能化作 新湍流"
        },
        {
          "time": 139.54,
          "text": "逐渐和鸣 矢志不渝的弹奏"
        },
        {
          "time": 142.23,
          "text": "天桥的疾风 忽而掀起颤抖"
        },
        {
          "time": 145.02,
          "text": "喉咙里的风暴 正在酝酿着"
        },
        {
          "time": 147.91,
          "text": "俯冲向这颗 顽固星球"
        },
        {
          "time": 152.2,
          "text": "此处仪态方正禁闭的高阁"
        },
        {
          "time": 155.01,
          "text": "要用聒噪的勇气与愤怒 玷污"
        },
        {
          "time": 157.9,
          "text": "凿开岩灰铸的躯壳"
        },
        {
          "time": 159.22,
          "text": "才发现有炽热的心"
        },
        {
          "time": 161.78,
          "text": "想跳动得 鲜活"
        },
        {
          "time": 163.53,
          "text": "乘着流光溢彩共鸣的音波"
        },
        {
          "time": 166.27,
          "text": "逆着噪声拼凑起完整协奏"
        },
        {
          "time": 168.41,
          "text": "去高歌"
        },
        {
          "time": 169.31,
          "text": "看 那里即将诞生"
        },
        {
          "time": 171.72,
          "text": "尘封至今 清晰白昼的轮廓"
        },
        {
          "time": 176.01,
          "text": "恍惚抽离出灵魂 寻回了来处"
        },
        {
          "time": 181.55,
          "text": "畅想在旷野试锋"
        },
        {
          "time": 183.05,
          "text": "流星大步 击破枷锁"
        },
        {
          "time": 186.07,
          "text": "随波逐流不如亲自写规则"
        },
        {
          "time": 188.97,
          "text": "奔向狂风 这舞台灯光在闪烁"
        },
        {
          "time": 191.89,
          "text": "足音放肆清澈 星辰激荡合辙"
        },
        {
          "time": 194.38,
          "text": "夜明时 炽热心声 会响彻"
        }
      ]
