    {
      "title": "3 银河偏航日志",
      "file": "3 银河偏航日志.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "银河偏航日志"
        },
        {
          "time": 3.08,
          "text": "作编曲词：鸽稀拉"
        },
        {
          "time": 9.1,
          "text": "调教：木变石"
        },
        {
          "time": 15.28,
          "text": "山山：航路通畅 信号频闪"
        },
        {
          "time": 21.26,
          "text": "核对坐标 校准角度 填充能量"
        },
        {
          "time": 24.3,
          "text": "安全巡航"
        },
        {
          "time": 27.36,
          "text": "参数正常 心跳平缓"
        },
        {
          "time": 33.33,
          "text": "规避风险 维持匀速 修正偏转"
        },
        {
          "time": 36.35,
          "text": "路线闭环"
        },
        {
          "time": 38.13,
          "text": "重复接收着固有波长"
        },
        {
          "time": 44.55,
          "text": "怎能捕获更精彩的频段"
        },
        {
          "time": 49.8,
          "text": "于是我"
        },
        {
          "time": 50.9,
          "text": "深呼吸 遥望 遥望 亿万里之外的微光"
        },
        {
          "time": 57.0,
          "text": "偶然间 听到 繁星于 真空里轻轻地哼唱"
        },
        {
          "time": 62.95,
          "text": "深呼吸 呼唤 呼唤 着远方"
        },
        {
          "time": 66.29,
          "text": "期待某天 会听见回响"
        },
        {
          "time": 69.92,
          "text": "且盼望 且流浪"
        },
        {
          "time": 99.75,
          "text": "天依：引力震荡 误将咖啡洒满罗盘"
        },
        {
          "time": 105.67,
          "text": "导航失灵 一头撞进星云牧场"
        },
        {
          "time": 111.72,
          "text": "陨石在发芽 甲板在开花 警报着急得说胡话"
        },
        {
          "time": 117.5,
          "text": "虽有点混乱 也不必紧张"
        },
        {
          "time": 121.8,
          "text": "而我正漂浮在宇宙鱼缸"
        },
        {
          "time": 128.54,
          "text": "幻想能够逃脱时间循环"
        },
        {
          "time": 133.69,
          "text": "于是我"
        },
        {
          "time": 134.92,
          "text": "深呼吸 遥望 遥望 亿万里之外的微光"
        },
        {
          "time": 140.97,
          "text": "偶然间 听到 繁星于 真空里轻轻地哼唱"
        },
        {
          "time": 146.87,
          "text": "深呼吸 呼唤 呼唤 着远方"
        },
        {
          "time": 150.29,
          "text": "期待某天 会听见回响"
        },
        {
          "time": 153.93,
          "text": "且燃烧 且冲撞"
        },
        {
          "time": 157.84,
          "text": "合唱：于是我"
        },
        {
          "time": 158.93,
          "text": "伸出手 触碰 触碰 指缝间流转的摇光"
        },
        {
          "time": 164.92,
          "text": "才发现 自己 成为了 旋转着的银河中央"
        },
        {
          "time": 170.84,
          "text": "伸出手 挥舞 挥舞 着航向"
        },
        {
          "time": 174.35,
          "text": "每步足迹 都化作星芒"
        },
        {
          "time": 177.95,
          "text": "且盼望 且流浪"
        },
        {
          "time": 183.9,
          "text": "且梦想 且绽放"
        }
      ]
    },
