{"time":82.27,"text":"谁能够明白我"},{"time":85.27,"text":"这光景已苍白诉说"},{"time":89.1,"text":"谁能够回应我"},{"time":92.27,"text":"所有期许不会成空"},{"time":95.97,"text":"我的呼吸脉搏"},{"time":98.97,"text":"就像那枯萎的花只是未凋落"},{"time":103.9,"text":"我早已不再奢求些什么"},{"time":123.93,"text":"又一次浸没 又一次摆脱 又一次被迫"},{"time":130.33,"text":"灰色的眼中 映出了太多苦衷"},{"time":138.0,"text":"沉眠是美梦的开头"},{"time":144.47,"text":"遗憾是醒来的颤动"},{"time":151.37,"text":"用力握紧的双手"},{"time":154.73,"text":"不能够忍受这伤痛"},{"time":158.17,"text":"该如何寻求着解脱"},{"time":164.47,"text":"谁能够取代我"},{"time":167.6,"text":"承担一切别无所求"},{"time":171.37,"text":"谁能够回应我"},{"time":174.47,"text":"逃避也无妨是借口"},{"time":178.33,"text":"将一切都摆脱"},{"time":181.37,"text":"就像那枯萎的花终将会凋落"},{"time":186.73,"text":"我何时能够打破命运枷锁"},{"time":193.87,"text":"拜托了带走我"},{"time":196.77,"text":"终结这残酷的苟活"},{"time":200.67,"text":"拜托了告诉我"},{"time":203.6,"text":"命运曲折又是为何"},{"time":207.47,"text":"至少在这一刻"},{"time":210.5,"text":"将所有悲惨颜色点缀成花朵"},{"time":215.27,"text":"我已接受这残酷的结果"}]},{"title":"5 深蓝","lyrics":[{"time":12.47,"text":"听风雨交替 浪花在共鸣"},{"time":17.53,"text":"却又褪去 吞噬所有回音"},{"time":22.33,"text":"待霜寒堆砌 涌流都停息"},{"time":28.1,"text":"世界一片静谧"},{"time":31.07,"text":"微茫逐渐消隐"},{"time":34.37,"text":"极境的浮冰"},{"time":36.77,"text":"倒映深蓝的长夜无垠"},{"time":41.53,"text":"湮灭了多少希冀"},{"time":45.47,"text":"又封存了多少流转光阴"},{"time":51.87,"text":"余热待熄"},{"time":56.53,"text":"沉沦注定 深渊废墟之中的喘息"},{"time":61.3,"text":"将我幽禁在这片海底"},{"time":66.0,"text":"等待神明的降临"},{"time":69.13,"text":"迷离 暗流阻隔所有的企及"},{"time":75.4,"text":"目光开始模糊不清"},{"time":80.53,"text":"思绪幻化漂浮泡影都散去"},{"time":92.2,"text":"啊"},{"time":110.8,"text":"泛起往昔的涟漪"},{"time":114.5,"text":"翻阅回忆 寻求虚伪宁静"},{"time":121.7,"text":"请将我的心燃烧成灰烬"},{"time":126.4,"text":"融化悬空冰莹"},{"time":128.93,"text":"这天际有些致郁有些不明晰"},{"time":135.3,"text":"被纷乱繁絮遮蔽这心境"},{"time":139.93,"text":"这心境有些空虚有些不甘心"},{"time":144.73,"text":"呻吟就此沉寂"},{"time":151.33,"text":"或许曾经 我会站在海边去聆听"},{"time":158.6,"text":"所有生灵起伏的合鸣"},{"time":163.33,"text":"一片温馨的境地"},{"time":166.37,"text":"如今沉郁和孤独分割内心"},{"time":172.7,"text":"我已身处深海墓地"},{"time":177.8,"text":"连同幻想埋葬一起都逝去"},{"time":187.37,"text":"深蓝的心 幽邃镜中映出的窒息"},{"time":194.57,"text":"腐朽身躯溢出的悲鸣"},{"time":199.1,"text":"等待魂灵的注意"},{"time":202.4,"text":"繁星终有一天会穿过极境"},{"time":208.7,"text":"当我伸手就能触及"},{"time":213.8,"text":"可我早已闭上眼睛"},{"time":218.6,"text":"连叹息也无痕迹"}]},{"title":"6 倘若明天降临","lyrics":[{"time":3.27,"text":"梦站在街道 浮现消逝的景象"},{"time":9.3,"text":"熄灭的灯火 埋葬多少悲伤"},{"time":13.17,"text":"寒风已掠过脸庞"},{"time":16.9,"text":"心有多迷茫 犹如在荒原飘荡"},{"time":23.0,"text":"目光所及的远方 和异想乡"},{"time":26.87,"text":"全化作悲凉哀伤"},{"time":30.2,"text":"希望在手心 温暖了整个胸膛"},{"time":37.1,"text":"失望冻结了心跳 那一刻温热不再流淌"},{"time":47.2,"text":"倘若明天降临 是否会有黎明"},{"time":51.07,"text":"或许还保留希冀"},{"time":53.9,"text":"等到明天来临 阳光终于升起"},{"time":57.93,"text":"或许阴翳将散去"},{"time":60.7,"text":"戳破梦境 在清晨中渐苏醒"},{"time":67.57,"text":"当前的心情 沉浸在那一束温馨"},{"time":102.6,"text":"星闪烁微光 夜色中如此明亮"},{"time":108.6,"text":"在光年之外 白昼或许存在"},{"time":112.57,"text":"阳光会穿过阴霾"},{"time":116.47,"text":"夜有多漫长 足够反复地回想"},{"time":122.4,"text":"心中的航向 远方是何模样"},{"time":126.13,"text":"是冰川还是热浪"},{"time":129.6,"text":"失望透过窗 塞满了整个心房"},{"time":136.53,"text":"希望从眼眶流下 落在心间倏忽地发芽"},{"time":148.33,"text":"倘若明天降临 世界依旧寂静"},{"time":152.2,"text":"一切都杳无生机"},{"time":155.0,"text":"等到明天来临 梦醒来再哭泣"},{"time":159.1,"text":"一切都离我远去"},{"time":161.87,"text":"戳破梦境 在冰冷中渐苏醒"},{"time":168.7,"text":"木讷的躯体"},{"time":170.7,"text":"所有热情全都耗尽"},{"time":175.9,"text":"为何而活着 为何死去"},{"time":179.33,"text":"我梦见站在废墟之地"},{"time":182.87,"text":"身后的脚印都散去"},{"time":186.33,"text":"何寻存在的证明"},{"time":189.1,"text":"伤痕累计 伤痛不语 伤疤褪去"},{"time":194.0,"text":"或许已经忘记"},{"time":195.97,"text":"生命的意义 早已经铭刻在心"},{"time":205.8,"text":"啦"},{"time":220.9,"text":"这世界的光景 犹如末日侵袭"},{"time":226.07,"text":"残余慌恐和悲剧"},{"time":228.9,"text":"在无人的境地"},{"time":230.87,"text":"独自找寻生机"},{"time":233.0,"text":"或许还保留希冀"},{"time":235.8,"text":"若明天会降临 从美梦中清醒"},{"time":240.17,"text":"一定释怀而哭泣"},{"time":243.07,"text":"等明天终来临 曙光划破天际"},{"time":247.53,"text":"昼夜会再次交替"},{"time":250.37,"text":"每当夜晚安心地入梦睡去"},{"time":257.17,"text":"美好的愿景 让我们在明天相聚"}]},{"title":"7 启程","lyrics":[{"time":14.6,"text":"晨曦残留下冰莹"},{"time":17.77,"text":"雪花弥漫而飘零"},{"time":21.0,"text":"极夜吞噬了黎明"},{"time":24.3,"text":"一切陷入死寂"},{"time":27.53,"text":"我的故事已终抵"},{"time":30.57,"text":"最后不完美结局"},{"time":33.87,"text":"苍白的光景 目光之中的倒影"},{"time":41.07,"text":"无声的寒风刺痛干涸的眼睛"},{"time":46.27,"text":"星星一眨眼就从视线中离去"},{"time":53.8,"text":"美梦注定被现实残忍代替"},{"time":59.47,"text":"我的叹息逐渐散去 思绪被抽离"},{"time":66.0,"text":"这世界早已经破碎成陨星"},{"time":72.27,"text":"背负所有希冀 不过是幻想沉溺"},{"time":78.27,"text":"这颗心早已经不再以温热回应"},{"time":85.0,"text":"心跳声被暂停 伸出的双手已触碰不到边际"},{"time":120.2,"text":"眼前浮现的幻影"},{"time":123.4,"text":"她的伫立的身躯"},{"time":126.6,"text":"最后铸下的剑柄"},{"time":129.8,"text":"重燃起我的心"},{"time":133.07,"text":"她的故事已终抵"},{"time":136.2,"text":"为我照亮的黎明"},{"time":139.4,"text":"前方多艰巨也不愿在此停息"},{"time":146.6,"text":"一瞬的余光瞥见星星的轨迹"},{"time":151.8,"text":"或许光年之外尚存一线生机"},{"time":159.47,"text":"拥抱内心绝不能就此放弃"},{"time":165.07,"text":"挽救生息破除荆棘 打开新结局"},{"time":177.77,"text":"这世界早已经破碎成陨星"},{"time":184.27,"text":"背负所有希冀 汇聚在我的手心"},{"time":190.27,"text":"我不会再忘记 明天终将会降临"},{"time":197.0,"text":"下一站在哪里 眺望着星星的踪迹"},{"time":200.2,"text":"我寻觅 旅行的意义"},{"time":203.9,"text":"故事的结局 是否也焕然一新"},{"time":209.67,"text":"这颗心早已经不畏惧任何风雪雨霁"},{"time":215.9,"text":"会终抵我心中描绘的群星指引"}]},{"title":"8 可我又为何还在这儿哭泣呢","lyrics":[{"time":1.2,"text":"穿过人来人往"},{"time":4.77,"text":"喧嚣充斥耳旁"},{"time":8.17,"text":"何处传来的话 “你还好吗”"},{"time":15.0,"text":"雨滴打湿脸庞"},{"time":18.47,"text":"目光也被遮挡"},{"time":21.07,"text":"我的近况是否无恙 无法回答"},{"time":27.27,"text":"告诉我现在的我 是否能被称作幸福吗"},{"time":34.5,"text":"每天仍在重复地写着 没有灵魂的歌"},{"time":40.9,"text":"这一切是否值得 倾注所有悲伤去镌刻"},{"time":48.3,"text":"可我又为何还在这儿哭泣呢"},{"time":55.13,"text":"整个生命中最美丽的"},{"time":58.57,"text":"是遇见你的时刻"},{"time":61.97,"text":"星光之中浮现的景色"},{"time":65.4,"text":"是你全力地唱着"},{"time":68.87,"text":"唱出我心中被遗忘的"},{"time":72.3,"text":"最初的决心与炽热"},{"time":75.7,"text":"未知的旅程 再一次地等着"},{"time":79.67,"text":"我做出选择"},{"time":82.6,"text":"依循着星愿的歌声"},{"time":85.97,"text":"踏上新的旅程"},{"time":104.17,"text":"醒来擦拭眼角"},{"time":107.67,"text":"门扉透过余光"},{"time":111.07,"text":"恍惚什么遗忘 心空荡荡"},{"time":117.87,"text":"梦中描绘的光"},{"time":121.3,"text":"现实又在何方"},{"time":123.87,"text":"可我仍然还在寻找 一个回答"},{"time":130.17,"text":"努力着也期许着 你的歌声被用心听着"},{"time":137.33,"text":"唱着我的心酸和苦涩"},{"time":141.07,"text":"唱着你的颜色"},{"time":143.73,"text":"我依然会继续地 倾注所有心声去镌刻"},{"time":151.27,"text":"因你还在这 唱着我的故事呢"},{"time":157.9,"text":"你说生命中最美丽的 是我眼中的温热"},{"time":164.9,"text":"还是我一路上追逐的美梦成真的澄澈"},{"time":171.7,"text":"辗转难眠的每个夜晚"},{"time":175.17,"text":"泪水在眼眶里打转"},{"time":178.67,"text":"所有的喜欢"},{"time":180.3,"text":"所有期盼过后只剩下遗憾"},{"time":184.97,"text":"心中的孤单"},{"time":186.73,"text":"话语的零散"},{"time":188.5,"text":"难以传达出我的伤感"},{"time":192.3,"text":"这份心脏都快凝结的痛觉"},{"time":195.7,"text":"只能用泪水倾泻"},{"time":198.7,"text":"星星的明灭"},{"time":200.67,"text":"顺转的时间"},{"time":202.0,"text":"我的眼泪已不再下坠"},{"time":205.97,"text":"即便再伤悲 也该拥抱明天"},{"time":244.5,"text":"你说生命中最美丽的 是星闪耀的时刻"},{"time":252.27,"text":"还是追逐星空的每时每分"},{"time":259.17,"text":"我的生命中最动容的 是你远航的时刻"},{"time":265.97,"text":"还是跨过所有的坎坷 一起哭着也笑着"},{"time":272.87,"text":"汇聚我心中所有期许愈烈的深切与铭心"},{"time":279.77,"text":"将这些思绪谱写旋律"},{"time":283.13,"text":"传达出我的悲泣"},{"time":286.53,"text":"跟随着星愿的停息"},{"time":289.97,"text":"不会再哭泣"}]}]}