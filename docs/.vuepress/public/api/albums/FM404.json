    {
      "title": "1 失恋特工队",
      "file": "1 失恋特工队.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "01 失恋特工队"
        },
        {
          "time": 3.2,
          "text": "唱：星尘"
        },
        {
          "time": 6.4,
          "text": "作曲&编曲：烂兔子"
        },
        {
          "time": 9.6,
          "text": "作词：3120"
        },
        {
          "time": 12.8,
          "text": "调校：烂兔子"
        },
        {
          "time": 16.0,
          "text": "曲绘：tiko"
        },
        {
          "time": 19.2,
          "text": "专辑：FM40.4"
        },
        {
          "time": 22.4,
          "text": "非常抱歉生错在这个时代"
        },
        {
          "time": 25.75,
          "text": "纯爱的人已经变成了怪胎"
        },
        {
          "time": 29.28,
          "text": "跨不过那道名为现实的障碍"
        },
        {
          "time": 32.66,
          "text": "将要破碎的心一直被伤害"
        },
        {
          "time": 35.64,
          "text": "倾注了自己全部的爱"
        },
        {
          "time": 38.17,
          "text": "才不是为了成为预备的存在"
        },
        {
          "time": 42.47,
          "text": "带上你的伪善和被爱的满足感"
        },
        {
          "time": 46.18,
          "text": "快一点从我的身边离开"
        },
        {
          "time": 50.09,
          "text": "来 来 大家一起到这里来"
        },
        {
          "time": 53.34,
          "text": "为了回到独自一个人而喝彩"
        },
        {
          "time": 57.11,
          "text": "快 快 大脑神经速度加到最快"
        },
        {
          "time": 59.99,
          "text": "是不是想要被自我的同情掩埋"
        },
        {
          "time": 78.93,
          "text": "抛开那些不合实际的妄想"
        },
        {
          "time": 80.8,
          "text": "丢掉那些侥幸心理的希望"
        },
        {
          "time": 82.71,
          "text": "不必去迎合那些人的目光"
        },
        {
          "time": 84.17,
          "text": "将所有自卑埋葬"
        },
        {
          "time": 86.18,
          "text": "找回失去已久本来的模样"
        },
        {
          "time": 87.84,
          "text": "重新计划向前行进的方向"
        },
        {
          "time": 89.5,
          "text": "继续坚持仅剩的一丝倔强"
        },
        {
          "time": 91.12,
          "text": "就像从前一样"
        },
        {
          "time": 106.86,
          "text": "曾经以为有那么一个瞬间"
        },
        {
          "time": 110.42,
          "text": "那是只为我而绽放的笑颜"
        },
        {
          "time": 113.79,
          "text": "时间持续了大概只有一两天"
        },
        {
          "time": 117.33,
          "text": "又恢复和平时一样的冷淡"
        },
        {
          "time": 120.53,
          "text": "经历了一次次的失败"
        },
        {
          "time": 122.51,
          "text": "才不是为了那看不到的未来"
        },
        {
          "time": 127.49,
          "text": "带上你的伪善和被爱的满足感"
        },
        {
          "time": 130.72,
          "text": "快一点从我的身边离开"
        },
        {
          "time": 134.76,
          "text": "来 来 大家一起到这里来"
        },
        {
          "time": 137.94,
          "text": "为了回到独自一个人而喝彩"
        },
        {
          "time": 141.35,
          "text": "快 快 大脑神经速度加到最快"
        },
        {
          "time": 144.85,
          "text": "是不是想要抹消掉自己的存在"
        },
        {
          "time": 170.53,
          "text": "收起只停留在脚下的视线"
        },
        {
          "time": 173.86,
          "text": "重新回到一成不变的世界"
        },
        {
          "time": 177.29,
          "text": "疼痛的心是作战前的试炼"
        },
        {
          "time": 180.79,
          "text": "它将持续很长一段时间"
        },
        {
          "time": 184.36,
          "text": "整装回归到所有人的视野"
        },
        {
          "time": 187.67,
          "text": "不要再被怜悯的眼光识别"
        },
        {
          "time": 191.18,
          "text": "快加入失恋特工队的实战"
        },
        {
          "time": 194.56,
          "text": "终有天心中的梦将实现"
        },
        {
          "time": 198.56,
          "text": "来 来 大家一起到这里来"
        },
        {
          "time": 201.82,
          "text": "为了回到独自一个人而喝彩"
        },
        {
          "time": 204.87,
          "text": "快 快 停止接收那些怜悯的爱"
        },
        {
          "time": 208.71,
          "text": "收拾好残局对明天再保留点"
        },
        {
          "time": 211.98,
          "text": "保留点新的期待"
        }
      ]
    },
    {
      "title": "2 失心",
      "file": "2 失心.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "02 失心"
        },
        {
          "time": 2.17,
          "text": "唱：星尘"
        },
        {
          "time": 4.35,
          "text": "作曲&编曲：Zeno"
        },
        {
          "time": 6.52,
          "text": "作词：七月六"
        },
        {
          "time": 8.7,
          "text": "调校：Zeno"
        },
        {
          "time": 10.87,
          "text": "曲绘：骸鸦"
        },
        {
          "time": 13.05,
          "text": "专辑：FM40.4"
        },
        {
          "time": 15.23,
          "text": "无形之中 定下规则太多种"
        },
        {
          "time": 17.85,
          "text": "拿一潭死水叫我心动"
        },
        {
          "time": 20.89,
          "text": "不知谁说 疯子在右也在左"
        },
        {
          "time": 23.43,
          "text": "还故作深刻 费劲叫人琢磨"
        },
        {
          "time": 26.64,
          "text": "不听不说 多数人沉默"
        },
        {
          "time": 28.63,
          "text": "最显眼那个 枷锁太多"
        },
        {
          "time": 31.5,
          "text": "又或者 甘愿隐没 抛光了特色"
        },
        {
          "time": 34.65,
          "text": "卑微地被人覆盖性格"
        },
        {
          "time": 37.09,
          "text": "那样就真了 算了"
        },
        {
          "time": 42.51,
          "text": "我要所有人自我保持着内核"
        },
        {
          "time": 45.6,
          "text": "要世界失去所有规则"
        },
        {
          "time": 48.19,
          "text": "派对如果少了失心的人多无味"
        },
        {
          "time": 51.8,
          "text": "无色 没变革"
        },
        {
          "time": 53.75,
          "text": "现在就一起唱旧世界的哀歌"
        },
        {
          "time": 56.7,
          "text": "闭上眼再也不会觉得痛了"
        },
        {
          "time": 60.15,
          "text": "忘了 你我做不成领军者"
        },
        {
          "time": 63.11,
          "text": "睁眼醒了 新的法则"
        },
        {
          "time": 76.87,
          "text": "别用平庸 再去掩饰白日梦"
        },
        {
          "time": 79.53,
          "text": "大胆做懦夫足够英雄"
        },
        {
          "time": 82.45,
          "text": "心底的话 醉了才敢说出口"
        },
        {
          "time": 85.0,
          "text": "干脆就别说 甘当脚下蛆虫"
        },
        {
          "time": 87.65,
          "text": "不听不说 学旁人沉默"
        },
        {
          "time": 90.36,
          "text": "最显眼那个 枪口太多"
        },
        {
          "time": 92.66,
          "text": "还是说 不甘隐没 暴露着特色"
        },
        {
          "time": 95.54,
          "text": "任由人嘲笑你的性格"
        },
        {
          "time": 98.46,
          "text": "世界就好了 算了"
        },
        {
          "time": 104.1,
          "text": "我要所有人自我放肆地脆弱"
        },
        {
          "time": 107.06,
          "text": "要世界失去所有冷漠"
        },
        {
          "time": 109.51,
          "text": "派对如果少了失心的人多无味"
        },
        {
          "time": 113.27,
          "text": "无色 没粉墨"
        },
        {
          "time": 115.01,
          "text": "现在就一起唱旧世界的哀歌"
        },
        {
          "time": 118.09,
          "text": "闭上眼大声哭喊觉得痛了"
        },
        {
          "time": 121.51,
          "text": "忘了 你我做不成革命者"
        },
        {
          "time": 124.41,
          "text": "别挣扎了 新的法则 罢了"
        },
        {
          "time": 140.28,
          "text": "夺走了我的眼还要我受谴责"
        },
        {
          "time": 143.4,
          "text": "（不看不说就会好的）"
        },
        {
          "time": 145.68,
          "text": "拿着鲜血去当什么黑色幽默"
        },
        {
          "time": 148.84,
          "text": "（锁住自我才能存活）"
        },
        {
          "time": 151.27,
          "text": "还说内心不够惊艳不够执着"
        },
        {
          "time": 154.39,
          "text": "（那样不如不要好了）"
        },
        {
          "time": 156.84,
          "text": "一副躯壳 是不是正好开新篇 就上演"
        },
        {
          "time": 160.25,
          "text": "（偏偏就上演）"
        },
        {
          "time": 162.77,
          "text": "我要所有人自我保持着内核"
        },
        {
          "time": 165.57,
          "text": "要世界失去所有规则"
        },
        {
          "time": 168.27,
          "text": "派对如果少了失心的人多无味"
        },
        {
          "time": 171.7,
          "text": "无色 没变革"
        },
        {
          "time": 173.69,
          "text": "现在就一起唱旧世界的哀歌"
        },
        {
          "time": 176.69,
          "text": "闭上眼再也不会觉得痛了"
        },
        {
          "time": 180.1,
          "text": "笑了 你我是那个革命者"
        },
        {
          "time": 183.09,
          "text": "睁眼醒了 新的法则 在这儿"
        }
      ]
    },
