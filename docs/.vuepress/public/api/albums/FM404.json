    {
      "title": "7 活！",
      "file": "7 活！.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "07 活！"
        },
        {
          "time": 3.75,
          "text": "唱：星尘"
        },
        {
          "time": 7.51,
          "text": "作曲&编曲：烂兔子"
        },
        {
          "time": 11.26,
          "text": "作词：七月六"
        },
        {
          "time": 15.02,
          "text": "调校：烂兔子"
        },
        {
          "time": 18.77,
          "text": "曲绘：骸鸦"
        },
        {
          "time": 22.53,
          "text": "专辑：FM40.4"
        },
        {
          "time": 26.29,
          "text": "一些话说不说都是照样没用"
        },
        {
          "time": 33.15,
          "text": "世界不会特意去听谁的梦"
        },
        {
          "time": 39.77,
          "text": "说的做的总差一点感觉"
        },
        {
          "time": 43.07,
          "text": "后退上前怎么才能够好些"
        },
        {
          "time": 46.33,
          "text": "尽管大声喊不会露出胆怯"
        },
        {
          "time": 49.79,
          "text": "勇气竟被你谢绝"
        },
        {
          "time": 54.7,
          "text": "再多执着到头变成笨拙"
        },
        {
          "time": 57.87,
          "text": "自欺欺人就赖好事多磨"
        },
        {
          "time": 61.22,
          "text": "听谁说"
        },
        {
          "time": 62.03,
          "text": "听谁说"
        },
        {
          "time": 62.94,
          "text": "拿出故事一则"
        },
        {
          "time": 64.76,
          "text": "用喧嚣搪塞我沉默"
        },
        {
          "time": 67.75,
          "text": "庸人的挣扎难道做得不够多"
        },
        {
          "time": 71.26,
          "text": "反正到时候也不如看老天脸色"
        },
        {
          "time": 74.58,
          "text": "谁还能苛责我"
        },
        {
          "time": 76.28,
          "text": "自己不愿放过"
        },
        {
          "time": 77.96,
          "text": "还念什么好死不如赖活"
        },
        {
          "time": 94.81,
          "text": "我的话说不说都是照样白说"
        },
        {
          "time": 101.48,
          "text": "风儿难道能懂火焰的焦灼"
        },
        {
          "time": 108.09,
          "text": "不听不问意思就是拒绝"
        },
        {
          "time": 111.32,
          "text": "太过了解又觉得超出界限"
        },
        {
          "time": 114.71,
          "text": "尽管张开手渴望靠近一点"
        },
        {
          "time": 118.12,
          "text": "一点竟差个世界"
        },
        {
          "time": 122.97,
          "text": "再多执着到头变成笨拙"
        },
        {
          "time": 126.08,
          "text": "自欺欺人就赖好事多磨"
        },
        {
          "time": 129.63,
          "text": "听他说"
        },
        {
          "time": 130.45,
          "text": "听她说"
        },
        {
          "time": 131.35,
          "text": "拿出故事多则"
        },
        {
          "time": 133.14,
          "text": "用常规敷衍我特色"
        },
        {
          "time": 136.14,
          "text": "庸人的挣扎已经做得足够多"
        },
        {
          "time": 139.45,
          "text": "但是到时候总是要看老天脸色"
        },
        {
          "time": 142.85,
          "text": "你别再苛责我"
        },
        {
          "time": 144.49,
          "text": "我把自己放过"
        },
        {
          "time": 146.25,
          "text": "再继续说好死不如赖活"
        },
        {
          "time": 192.8,
          "text": "够不到橄榄枝的叶"
        },
        {
          "time": 196.37,
          "text": "尽做无用告解"
        },
        {
          "time": 199.56,
          "text": "态度够卑贱"
        },
        {
          "time": 201.39,
          "text": "够坚决"
        },
        {
          "time": 203.13,
          "text": "还怎么惊艳"
        },
        {
          "time": 206.43,
          "text": "哈一"
        },
        {
          "time": 213.86,
          "text": "骁勇者不多言"
        },
        {
          "time": 216.4,
          "text": "无畏不收敛"
        },
        {
          "time": 219.67,
          "text": "多少笨拙是铿锵的执着"
        },
        {
          "time": 222.71,
          "text": "咽下脆弱毕竟好事多磨"
        },
        {
          "time": 226.29,
          "text": "听我说"
        },
        {
          "time": 227.1,
          "text": "听我说"
        },
        {
          "time": 228.07,
          "text": "我是故事那则"
        },
        {
          "time": 229.81,
          "text": "让伤口凝结成焰火"
        },
        {
          "time": 232.84,
          "text": "华丽的挣扎已经做得足够多"
        },
        {
          "time": 236.29,
          "text": "什么时候才轮到老天看我脸色"
        },
        {
          "time": 239.55,
          "text": "我要我的快乐"
        },
        {
          "time": 241.19,
          "text": "自己来定法则"
        },
        {
          "time": 242.93,
          "text": "不死也不做那个赖活者"
        }
      ]
    },
