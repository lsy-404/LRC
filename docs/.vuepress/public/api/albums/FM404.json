    {
      "title": "4 北洋",
      "file": "4 北洋.lrc",
      "lyrics": [
        {
          "time": 0.0,
          "text": "04 北洋"
        },
        {
          "time": 3.85,
          "text": "唱：星尘"
        },
        {
          "time": 7.71,
          "text": "作曲&编曲：烂兔子"
        },
        {
          "time": 11.57,
          "text": "作词：十八"
        },
        {
          "time": 15.42,
          "text": "调校：烂兔子"
        },
        {
          "time": 19.28,
          "text": "曲绘：骸鸦"
        },
        {
          "time": 23.14,
          "text": "专辑：FM40.4"
        },
        {
          "time": 27.0,
          "text": "东方惊起一条沉睡巨龙  大胆革新洋务运动"
        },
        {
          "time": 33.28,
          "text": "复我中华文治武功  光明磊落数少年英雄"
        },
        {
          "time": 39.73,
          "text": "新式枪炮握在手中  脚踏北洋波涛汹涌"
        },
        {
          "time": 46.1,
          "text": "方刚血气驰策刀锋  守土开疆报国尽忠"
        },
        {
          "time": 52.49,
          "text": "金銮殿上  万岁吾皇"
        },
        {
          "time": 55.28,
          "text": "背水一战  岂能彷徨"
        },
        {
