.4,"text":"冥处有迷雾  来去路斑驳"},{"time":179.27,"text":"静声月夜长  闻风知魂魄"},{"time":195.42,"text":"有鸦不见啼  有人不见影"},{"time":211.22,"text":"剪纸焚于火  烈酒喂黄土"}]},{"title":"07 生死一舞的爱语","lyrics":[{"time":0.0,"text":"生死一舞的爱语"},{"time":4.7,"text":"音乐制作：MeLo、绿无"},{"time":8.59,"text":"曲绘：零届0rz"},{"time":13.43,"text":"Vocal：星尘"},{"time":25.2,"text":"我在大漠中汲踽"},{"time":29.29,"text":"朝向你在的海域"},{"time":33.19,"text":"日夜交替  大风吹起"},{"time":42.04,"text":"我一生所有旦夕"},{"time":46.15,"text":"都觊觎她的美丽"},{"time":50.24,"text":"哭哭啼啼  惹你怜惜"},{"time":58.92,"text":"我是龙舌兰的花朵"},{"time":63.2,"text":"愿为你生死一舞"},{"time":67.45,"text":"祈求着能得你轻抚"},{"time":75.81,"text":"时光挟着崇拜回溯"},{"time":79.85,"text":"第一眼就怦然心动"},{"time":84.14,"text":"还管它什么对错"},{"time":92.95,"text":"我在星野里穿梭"},{"time":96.88,"text":"被黑夜侵袭沉默"},{"time":101.1,"text":"你所爱的  假装是我"},{"time":109.49,"text":"被你的眼神捕获"},{"time":113.79,"text":"妄想着被你吞没"},{"time":118.08,"text":"你所爱的  一定是我"},{"time":126.27,"text":"我是龙舌兰的花朵"},{"time":130.96,"text":"酿着爱情的毒果"},{"time":135.24,"text":"这一杯叫做脆弱"},{"time":143.69,"text":"如我赤裸  涕泪滂沱"},{"time":152.18,"text":"你是囚我于生的枷锁"},{"time":177.56,"text":"我是龙舌兰的花朵"},{"time":181.79,"text":"只为你生死一舞"},{"time":186.03,"text":"乞求着你的爱抚"},{"time":195.05,"text":"狂风大作 以爱焚我"},{"time":202.85,"text":"笑着枯萎 不惧坠落"}]},{"title":"08 百里芭蕉百里花","lyrics":[{"time":0.0,"text":"百里芭蕉百里花"},{"time":3.27,"text":"音乐制作：MeLo、绿无"},{"time":6.29,"text":"曲绘：万代"},{"time":10.57,"text":"Vocal：星尘"},{"time":20.4,"text":"昨夜芭蕉雨打了花"},{"time":25.01,"text":"落地成了个她"},{"time":30.63,"text":"窗框勾勒出一幅画"},{"time":35.69,"text":"有女倩兮戴簪花"},{"time":42.4,"text":"弯腰作揖呀少年郎"},{"time":47.25,"text":"她手呀撩起那芭蕉"},{"time":51.66,"text":"微敛了眉目难掩下"},{"time":57.58,"text":"少年沉醉的模样"},{"time":64.92,"text":"提笔翻覆错落成画"},{"time":69.41,"text":"深深浅浅走过脸庞鬓发"},{"time":74.76,"text":"墨黑的芭蕉墨白的她"},{"time":79.8,"text":"唇上一抹绛朱砂"},{"time":84.19,"text":"再抬眼时雨势做大"},{"time":88.55,"text":"凝眸处再没有人家"},{"time":93.84,"text":"徒留纸上墨色的人啊"},{"time":100.06,"text":"笑晏如花"},{"time":128.05,"text":"浅白的衣裳浅水洼"},{"time":132.65,"text":"正说着悄悄话"},{"time":138.0