.0,"text":"沉溺在神的砂海"},{"time":2.4,"text":"音乐制作：MeLo、绿无"},{"time":6.18,"text":"曲绘：鲨鱼卡Sayuki"},{"time":11.57,"text":"Vocal：星尘"},{"time":20.39,"text":"听静脉里流动的声音  细碎沙哑"},{"time":28.45,"text":"它在沉睡中匍匐  伺机勃发"},{"time":35.34,"text":"看时光缝隙里的灰尘  生根发芽"},{"time":42.0,"text":"想要开出一朵花  拼命挣扎"},{"time":49.82,"text":"沉重而灼热的孤独感  开始融化"},{"time":57.85,"text":"它从瞳孔中溢出  变得可怕"},{"time":64.91,"text":"梦化身成帕耳忒诺珀  立于砂崖"},{"time":71.47,"text":"遵循神的指引  和它融为一体"},{"time":82.96,"text":"就让我沉没在神的砂之海"},{"time":86.38,"text":"杂音也能唱出歌来"},{"time":89.98,"text":"会有人乘风破浪为我而来"},{"time":93.63,"text":"爱慕着我最美的洁白"},{"time":97.44,"text":"来吧  快走进我的砂之海"},{"time":101.1,"text":"我早已经迫不及待"},{"time":104.9,"text":"若你能不被丛林法则打败"},{"time":108.62,"text":"我将只为你盛开"},{"time":135.17,"text":"听血液里沸腾的声音  鼓动耳膜"},{"time":142.27,"text":"它在五感中驻足  露出笑容"},{"time":150.02,"text":"看痛楚和欢喜摩擦着  缠绵悱恻"},{"time":156.67,"text":"就要沉溺其中 我已万众瞩目"},{"time":167.79,"text":"就让我沉没在神的砂之海"},{"time":171.28,"text":"杂音也能唱出歌来"},{"time":175.0,"text":"你们都乘风破浪为我而来"},{"time":178.53,"text":"臣服于我最美的洁白"},{"time":182.31,"text":"来吧  快走进我的砂之海"},{"time":186.02,"text":"我早已经迫不及待"},{"time":189.69,"text":"若你能不被丛林法则打败"},{"time":193.39,"text":"我将只为你盛开"},{"time":197.72,"text":"就算溺亡在神的砂之海"},{"time":200.69,"text":"也心甘情愿被淹埋"},{"time":204.35,"text":"曾接受过众星捧月的爱戴"},{"time":208.1,"text":"都是众神对我的告白"},{"time":211.71,"text":"从此我盛开在神的砂之海"},{"time":215.31,"text":"无人能再将我迫害"},{"time":219.05,"text":"我就是这个世界的主宰"},{"time":222.79,"text":"决定是否给你宠爱"}]}]}